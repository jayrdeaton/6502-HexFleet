000552r 2               ; --- The canvas ---
000552r 2               
000552r 2               ; SetTile - all of tile X's pixel bytes to A. Keeps X.
000552r 2               SetTile:
000552r 2  9D 00 20 9D  .repeat 16, I
000556r 2  00 21 9D 00  
00055Ar 2  22 9D 00 23  
000582r 2                 sta CT_ROWS + I * 256,x
000582r 2               .endrepeat
000582r 2  60             rts
000583r 2               
000583r 2               ; CanvasReset - forget every tile (layer 1 is about to be cleared).
000583r 2               CanvasReset:
000583r 2  A2 FE          ldx #POOL_TILES - 1
000585r 2               @tile:
000585r 2  9E 00 1C       stz TILE_STATE,x
000588r 2  A9 00          lda #0
00058Ar 2  20 rr rr       jsr SetTile
00058Dr 2  CA             dex
00058Er 2  E0 FF          cpx #$FF
000590r 2  D0 F3          bne @tile
000592r 2  64 52          stz ALLOC
000594r 2  9C F0 0F       stz POOL_HI
000597r 2  A9 00          lda #<CELLMAP
000599r 2  85 48          sta PTR0
00059Br 2  A9 10          lda #>CELLMAP
00059Dr 2  85 49          sta PTR0+1
00059Fr 2  A2 05          ldx #5                            ; 1200 bytes fit in 5 pages
0005A1r 2  A0 00          ldy #0
0005A3r 2  98             tya
0005A4r 2               @page:
0005A4r 2  91 48          sta (PTR0),y
0005A6r 2  C8             iny
0005A7r 2  D0 FB          bne @page
0005A9r 2  E6 49          inc PTR0+1
0005ABr 2  CA             dex
0005ACr 2  D0 F6          bne @page
0005AEr 2  60             rts
0005AFr 2               
0005AFr 2               ; CanvasBegin - start a new drawing. What's on screen stays until
0005AFr 2               ; CanvasFlush, which replaces it in one go, so nothing blinks.
0005AFr 2               CanvasBegin:
0005AFr 2  64 52          stz ALLOC
0005B1r 2  64 A1          stz PFILL
0005B3r 2  A9 04          lda #CANVAS_SUB
0005B5r 2  85 A0          sta PATTR
0005B7r 2  AE F0 0F       ldx POOL_HI
0005BAr 2               @tile:
0005BAr 2  BD 00 1C       lda TILE_STATE,x
0005BDr 2  F0 0A          beq @next
0005BFr 2  A9 01          lda #1
0005C1r 2  9D 00 1C       sta TILE_STATE,x
0005C4r 2  A9 00          lda #0
0005C6r 2  20 rr rr       jsr SetTile
0005C9r 2               @next:
0005C9r 2  CA             dex
0005CAr 2  E0 FF          cpx #$FF
0005CCr 2  D0 EC          bne @tile
0005CEr 2  60             rts
0005CFr 2               
0005CFr 2               ; CanvasPlot - pixel (PX, PY) in value PINK. A full pool drops it.
0005CFr 2               CanvasPlot:
0005CFr 2  A5 4F          lda PY
0005D1r 2  4A             lsr a
0005D2r 2  4A             lsr a
0005D3r 2  4A             lsr a
0005D4r 2  AA             tax
0005D5r 2  A5 4E          lda PX
0005D7r 2  4A             lsr a
0005D8r 2  4A             lsr a
0005D9r 2  4A             lsr a
0005DAr 2  18             clc
0005DBr 2  7D rr rr       adc RowLo,x
0005DEr 2  85 4C          sta CMAP
0005E0r 2  BD rr rr       lda RowHi,x
0005E3r 2  69 10          adc #>CELLMAP
0005E5r 2  85 4D          sta CMAP+1
0005E7r 2  B2 4C          lda (CMAP)
0005E9r 2  D0 30          bne @have
0005EBr 2                 ; a new cell: find a free tile
0005EBr 2  A6 52          ldx ALLOC
0005EDr 2               @find:
0005EDr 2  E0 FF          cpx #POOL_TILES
0005EFr 2  B0 08          bcs @full
0005F1r 2  BD 00 1C       lda TILE_STATE,x
0005F4r 2  F0 06          beq @got
0005F6r 2  E8             inx
0005F7r 2  80 F4          bra @find
0005F9r 2               @full:
0005F9r 2  86 52          stx ALLOC
0005FBr 2  60             rts
0005FCr 2               @got:
0005FCr 2  86 52          stx ALLOC
0005FEr 2  EC F0 0F       cpx POOL_HI
000601r 2  90 03          bcc @below
000603r 2  8E F0 0F       stx POOL_HI
000606r 2               @below:
000606r 2  8A             txa
000607r 2  1A             inc a
000608r 2  92 4C          sta (CMAP)
00060Ar 2  A5 4C          lda CMAP
00060Cr 2  9D 00 1D       sta TILE_LO,x
00060Fr 2  A5 4D          lda CMAP+1
000611r 2  9D 00 1E       sta TILE_HI,x
000614r 2  A9 03          lda #3
000616r 2  9D 00 1C       sta TILE_STATE,x
000619r 2  80 0E          bra @fresh
00061Br 2               @have:
00061Br 2  3A             dec a
00061Cr 2  AA             tax
00061Dr 2  BD 00 1C       lda TILE_STATE,x
000620r 2  C9 01          cmp #1
000622r 2  D0 0E          bne @plot
000624r 2  A9 02          lda #2
000626r 2  9D 00 1C       sta TILE_STATE,x
000629r 2               @fresh:
000629r 2  A5 A1          lda PFILL
00062Br 2  F0 05          beq @plot
00062Dr 2  A9 FF          lda #$FF
00062Fr 2  20 rr rr       jsr SetTile
000632r 2               @plot:
000632r 2  A5 A0          lda PATTR
000634r 2  9D 00 1F       sta TILE_ATTR,x
000637r 2  DA             phx
000638r 2                 ; which of the tile's 16 bytes: two a row, four pixels each
000638r 2  A5 4F          lda PY
00063Ar 2  29 07          and #7
00063Cr 2  0A             asl a
00063Dr 2  85 50          sta PMASK
00063Fr 2  A5 4E          lda PX
000641r 2  29 04          and #4
000643r 2  4A             lsr a
000644r 2  4A             lsr a
000645r 2  05 50          ora PMASK
000647r 2  A8             tay
000648r 2  B9 rr rr       lda CtLo,y
00064Br 2  85 4A          sta PTR1
00064Dr 2  B9 rr rr       lda CtHi,y
000650r 2  85 4B          sta PTR1+1
000652r 2  A5 4E          lda PX
000654r 2  29 03          and #3
000656r 2  A8             tay
000657r 2  B9 rr rr       lda PixClear,y
00065Ar 2  85 50          sta PMASK
00065Cr 2  84 40          sty T0
00065Er 2  A5 51          lda PINK
000660r 2  0A             asl a
000661r 2  0A             asl a
000662r 2  05 40          ora T0
000664r 2  AA             tax
000665r 2  7A             ply
000666r 2  B1 4A          lda (PTR1),y
000668r 2  25 50          and PMASK
00066Ar 2  1D rr rr       ora PixBits,x
00066Dr 2  91 4A          sta (PTR1),y
00066Fr 2  60             rts
000670r 2               
000670r 2               ; CanvasFlush - show the drawing: new tiles in, old ones out.
000670r 2               CanvasFlush:
000670r 2  9C F1 0F       stz HI_SET
000673r 2  AE F0 0F       ldx POOL_HI
000676r 2  9C F0 0F       stz POOL_HI
000679r 2               @tile:
000679r 2  BD 00 1C       lda TILE_STATE,x
00067Cr 2  D0 03          bne @used
00067Er 2  4C rr rr       jmp @next
000681r 2               @used:
000681r 2  C9 01          cmp #1
000683r 2  D0 2E          bne @drawn
000685r 2                 ; stale: its cell goes blank and the tile is free again
000685r 2  BD 00 1D       lda TILE_LO,x
000688r 2  85 4C          sta CMAP
00068Ar 2  BD 00 1E       lda TILE_HI,x
00068Dr 2  85 4D          sta CMAP+1
00068Fr 2  A9 00          lda #0
000691r 2  92 4C          sta (CMAP)
000693r 2  9E 00 1C       stz TILE_STATE,x
000696r 2  DA             phx
000697r 2  A6 4D          ldx CMAP+1                        ; its color byte too: it holds the high tile bit
000699r 2  A5 4C          lda CMAP
00069Br 2  20 rr rr       jsr VAddr
00069Er 2  9C 00 9C       stz VC_DATA
0006A1r 2  A5 4D          lda CMAP+1
0006A3r 2  38             sec
0006A4r 2  E9 08          sbc #>CELLMAP - >V_L1NAME
0006A6r 2  AA             tax
0006A7r 2  A5 4C          lda CMAP
0006A9r 2  20 rr rr       jsr VAddr
0006ACr 2  9C 00 9C       stz VC_DATA
0006AFr 2  FA             plx
0006B0r 2  4C rr rr       jmp @next
0006B3r 2               @drawn:
0006B3r 2  AD F1 0F       lda HI_SET                        ; counting down, the first one kept is the top
0006B6r 2  D0 06          bne @topKnown
0006B8r 2  EE F1 0F       inc HI_SET
0006BBr 2  8E F0 0F       stx POOL_HI
0006BEr 2               @topKnown:
0006BEr 2                 ; its pixels: pool tile x is at V_POOL + x * 16
0006BEr 2  8A             txa
0006BFr 2  0A             asl a
0006C0r 2  0A             asl a
0006C1r 2  0A             asl a
0006C2r 2  0A             asl a
0006C3r 2  85 40          sta T0
0006C5r 2  8A             txa
0006C6r 2  4A             lsr a
0006C7r 2  4A             lsr a
0006C8r 2  4A             lsr a
0006C9r 2  4A             lsr a
0006CAr 2  18             clc
0006CBr 2  69 28          adc #>V_POOL
0006CDr 2  DA             phx
0006CEr 2  AA             tax
0006CFr 2  A5 40          lda T0
0006D1r 2  20 rr rr       jsr VAddr
0006D4r 2  FA             plx
0006D5r 2  BD 00 20 8D  .repeat 16, I
0006D9r 2  00 9C BD 00  
0006DDr 2  21 8D 00 9C  
000735r 2                 lda CT_ROWS + I * 256,x
000735r 2                 sta VC_DATA
000735r 2               .endrepeat
000735r 2                 ; its color (CELLMAP sits at the same address as the attribute table)
000735r 2  BD 00 1E       lda TILE_HI,x
000738r 2  DA             phx
000739r 2  BC 00 1D       ldy TILE_LO,x
00073Cr 2  AA             tax
00073Dr 2  98             tya
00073Er 2  20 rr rr       jsr VAddr
000741r 2  FA             plx
000742r 2  BD 00 1F       lda TILE_ATTR,x
000745r 2  E0 80          cpx #128                          ; patterns past 255 use the attribute's top bit
000747r 2  90 02          bcc @low
000749r 2  09 80          ora #$80
00074Br 2               @low:
00074Br 2  8D 00 9C       sta VC_DATA
00074Er 2  BD 00 1C       lda TILE_STATE,x
000751r 2  C9 03          cmp #3
000753r 2  D0 1C          bne @next
000755r 2  A9 02          lda #2
000757r 2  9D 00 1C       sta TILE_STATE,x
00075Ar 2                 ; a new cell also needs its name
00075Ar 2  BD 00 1E       lda TILE_HI,x
00075Dr 2  38             sec
00075Er 2  E9 08          sbc #>CELLMAP - >V_L1NAME
000760r 2  DA             phx
000761r 2  BC 00 1D       ldy TILE_LO,x
000764r 2  AA             tax
000765r 2  98             tya
000766r 2  20 rr rr       jsr VAddr
000769r 2  FA             plx
00076Ar 2  8A             txa
00076Br 2  18             clc
00076Cr 2  69 80          adc #128
00076Er 2  8D 00 9C       sta VC_DATA
000771r 2               @next:
000771r 2  CA             dex
000772r 2  E0 FF          cpx #$FF
000774r 2  F0 03          beq @done
000776r 2  4C rr rr       jmp @tile
000779r 2               @done:
000779r 2  60             rts
00077Ar 2               
00077Ar 2               CanvasClear:
00077Ar 2  20 rr rr       jsr CanvasBegin
00077Dr 2  4C rr rr       jmp CanvasFlush
000780r 2               
000780r 2               ; ReadGlyph - character A's 8 rows from the font into GLYPH.
000780r 2               ReadGlyph:
000780r 2  85 40          sta T0
000782r 2  64 41          stz T1
000784r 2  06 40          asl T0
000786r 2  26 41          rol T1
000788r 2  06 40          asl T0
00078Ar 2  26 41          rol T1
00078Cr 2  06 40          asl T0
00078Er 2  26 41          rol T1
000790r 2  A5 40          lda T0
000792r 2  8D 01 9C       sta VC_REG                        ; a read address: no write bit
000795r 2  A5 41          lda T1
000797r 2  18             clc
000798r 2  69 18          adc #>V_FONT
00079Ar 2  8D 01 9C       sta VC_REG
00079Dr 2  A2 00          ldx #0
