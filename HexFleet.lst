0008DEr 2  A9 06          lda #JUMP_RANGE
0008E0r 2               @draw:
0008E0r 2  85 8D          sta RANGE
0008E2r 2  4C rr rr       jmp DrawRange
0008E5r 2               @notMove:
0008E5r 2  C9 01          cmp #PH_AIM
0008E7r 2  D0 09          bne @clear
0008E9r 2  20 rr rr       jsr IsFlak
0008ECr 2  D0 04          bne @clear
0008EEr 2  A9 05          lda #FLAK_RANGE
