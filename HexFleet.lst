0014C8r 2  A6 FB          ldx AI_I
0014CAr 2  BD rr rr       lda DirQ,x
0014CDr 2  20 rr rr       jsr TimesK
0014D0r 2  8D 62 09       sta AI_HQ
0014D3r 2  A6 FB          ldx AI_I
0014D5r 2  BD rr rr       lda DirR,x
0014D8r 2  20 rr rr       jsr TimesK
0014DBr 2  8D 63 09       sta AI_HS
0014DEr 2  20 rr rr       jsr HexStep
0014E1r 2  90 24          bcc @shorter
0014E3r 2  AD 64 09       lda AI_OC
0014E6r 2  85 B0          sta HD_C1
0014E8r 2  AD 65 09       lda AI_OR
0014EBr 2  85 B1          sta HD_R1
