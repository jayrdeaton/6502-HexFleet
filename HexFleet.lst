000EA3r 2  BD 08 08       lda SHIP_INK,x
000EA6r 2  85 78          sta TXT_INK
000EA8r 2  BD 00 08       lda SHIP_FACTION,x
000EABr 2  0A             asl a
000EACr 2  85 AB          sta MN_I
000EAEr 2  A8             tay
