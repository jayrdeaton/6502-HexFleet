001A86r 2  A2 rr          ldx #<TxtNotSaved
001A88r 2  A0 rr          ldy #>TxtNotSaved
001A8Ar 2  80 0A          bra @say
001A8Cr 2               @saved:
001A8Cr 2  A9 06          lda #INK_GREEN
001A8Er 2  85 78          sta TXT_INK
001A90r 2  A9 0B          lda #ROW_MSG1
001A92r 2  A2 rr          ldx #<TxtSaved
001A94r 2  A0 rr          ldy #>TxtSaved
001A96r 2               @say:
001A96r 2  20 rr rr       jsr Print
001A99r 2  4C rr rr       jmp ShowOver
001A9Cr 2               @done:
001A9Cr 2  60             rts
001A9Dr 2               
001A9Dr 1               .include "src/link.asm"
001A9Dr 2               ; =============================================================================
001A9Dr 2               ;   link.asm - two machines, one battle, over the serial port
001A9Dr 2               ; =============================================================================
001A9Dr 2               ;   Each player plans on their own machine. Turns need no dice, so once both
001A9Dr 2               ;   machines hold both plans they each play the same turn and get the same
001A9Dr 2               ;   result, and only the plans cross the cable.
001A9Dr 2               ;
001A9Dr 2               ;   Everything is sent as 11-byte frames: $A5, type, turn, 6 bytes, a 2-byte check.
001A9Dr 2               ;   A frame that arrives damaged is dropped, and whatever it carried is sent
001A9Dr 2               ;   again until the other machine answers, so a noisy cable only costs time.
001A9Dr 2               ;     HELLO  finds the other machine: who it is, its ship, how far along it is.
001A9Dr 2               ;     PLAN   a turn's orders, and a checksum of the battle so far: two machines
001A9Dr 2               ;            that disagree stop and say so rather than play on.
001A9Dr 2               ;     ACK    that turn's plan arrived.
001A9Dr 2               ;   A machine plays the turn once it has the other's plan and knows its own got
001A9Dr 2               ;   through. Received bytes go into a ring from the interrupt (SysIrq, in
001A9Dr 2               ;   sound.asm), so nothing is lost while a turn is playing.
001A9Dr 2               ; =============================================================================
001A9Dr 2               
001A9Dr 2               .segment "CART"
001A9Dr 2               
001A9Dr 2               ; SerialQuiet - no serial interrupts: another machine calling must not reach the
001A9Dr 2               ; keyboard buffer while this one isn't linked.
001A9Dr 2               SerialQuiet:
001A9Dr 2  AD 0D 03       lda HW_PRESENT
001AA0r 2  29 10          and #HW_SC
001AA2r 2  F0 08          beq @done
001AA4r 2  AD 02 90       lda SC_CMD
001AA7r 2  09 02          ora #SC_CMD_RXIRQ_OFF
001AA9r 2  8D 02 90       sta SC_CMD
001AACr 2               @done:
001AACr 2  60             rts
001AADr 2               
001AADr 2               .segment "BANK00"
0019C8r 2               
0019C8r 2               FRAME_SYNC    = $A5
0019C8r 2               FRAME_SIZE    = 11
0019C8r 2               FR_HELLO      = 1
0019C8r 2               FR_PLAN       = 2
0019C8r 2               FR_ACK        = 3
0019C8r 2               LINK_VERSION  = 1
0019C8r 2               LINK_RESEND   = 20                 ; frames between tries
0019C8r 2               POLL_BYTES    = 40                 ; bytes handled a frame at most
0019C8r 2               BAD_SYNC      = 1                  ; LINK_BAD
0019C8r 2               BAD_VERSION   = 2
0019C8r 2               
0019C8r 2  4C 49 4E 4B  TxtLink:       .asciiz "LINK"
0019CCr 2  00           
0019CDr 2  20 4C 49 4E  TxtLinked:     .asciiz " LINKED"
0019D1r 2  4B 45 44 00  
0019D5r 2  4C 49 4E 4B  TxtLinking:    .asciiz "LINKING"
0019D9r 2  49 4E 47 00  
0019DDr 2  57 41 49 54  TxtWaitOther:  .asciiz "WAITING FOR"
0019E1r 2  49 4E 47 20  
0019E5r 2  46 4F 52 00  
0019E9r 2  4F 54 48 45  TxtOtherCart:  .asciiz "OTHER CART"
0019EDr 2  52 20 43 41  
0019F1r 2  52 54 00     
0019F4r 2  42 2F 58 3A  TxtQuit:       .asciiz "B/X: QUIT"
0019F8r 2  20 51 55 49  
0019FCr 2  54 00        
0019FEr 2  4E 4F 20 53  TxtNoSerial:   .asciiz "NO SERIAL"
001A02r 2  45 52 49 41  
001A06r 2  4C 00        
001A08r 2  4F 55 54 20  TxtOutOfSync:  .asciiz "OUT OF SYNC"
001A0Cr 2  4F 46 20 53  
001A10r 2  59 4E 43 00  
001A14r 2  4F 54 48 45  TxtWrongCart:  .asciiz "OTHER BUILD"
001A18r 2  52 20 42 55  
001A1Cr 2  49 4C 44 00  
001A20r 2  59 4F 55 52  TxtOrders:     .asciiz "YOUR ORDERS"
001A24r 2  20 4F 52 44  
001A28r 2  45 52 53 00  
001A2Cr 2  4F 54 48 45  TxtOtherReady: .asciiz "OTHER READY"
001A30r 2  52 20 52 45  
001A34r 2  41 44 59 00  
001A38r 2  59 4F 55 20  TxtYouLose:    .asciiz "YOU LOSE"
001A3Cr 2  4C 4F 53 45  
001A40r 2  00           
001A41r 2               
001A41r 2               ; IsLink - Z set in a linked game.
001A41r 2               IsLink:
001A41r 2  A5 E6          lda OPP
001A43r 2  C9 03          cmp #OPP_LINK
001A45r 2  60             rts
001A46r 2               
001A46r 2               ; --- Starting and stopping ---
001A46r 2               
001A46r 2               LinkOn:
001A46r 2  78             sei
001A47r 2  9C 00 0E       stz RX_HEAD
001A4Ar 2  9C 01 0E       stz RX_TAIL
001A4Dr 2  20 4E A0       jsr InitSC
001A50r 2  58             cli
001A51r 2  9C 12 0E       stz PARSE_N
001A54r 2  9C 13 0E       stz LINK_UP
001A57r 2  9C 14 0E       stz LINK_BAD
001A5Ar 2  9C 0E 0E       stz HAVE_HELLO
001A5Dr 2  9C 0F 0E       stz PEER_HAS
001A60r 2  9C 15 0E       stz HAVE_PLAN
001A63r 2  9C 16 0E       stz PEER_ACK
001A66r 2  A9 01          lda #1
001A68r 2  8D 04 0E       sta LINK_ON
001A6Br 2  AD 00 08       lda SHIP_FACTION
001A6Er 2  8D 06 0E       sta MY_FACTION
001A71r 2  8D 07 0E       sta TITLE_F
001A74r 2  AD 01 08       lda SHIP_FACTION+1
001A77r 2  8D 08 0E       sta TITLE_F+1
001A7Ar 2  60             rts
001A7Br 2               
001A7Br 2               ; LinkOff - back to a machine on its own, with the title's ships as they were.
001A7Br 2               LinkOff:
001A7Br 2  AD 04 0E       lda LINK_ON
001A7Er 2  F0 12          beq @done
001A80r 2  9C 04 0E       stz LINK_ON
001A83r 2  20 rr rr       jsr SerialQuiet
001A86r 2  AD 07 0E       lda TITLE_F
001A89r 2  8D 00 08       sta SHIP_FACTION
001A8Cr 2  AD 08 0E       lda TITLE_F+1
001A8Fr 2  8D 01 08       sta SHIP_FACTION+1
001A92r 2               @done:
001A92r 2  60             rts
001A93r 2               
001A93r 2               NewNonce:
001A93r 2  20 rr rr       jsr Rnd
001A96r 2  8D 09 0E       sta MY_NONCE
001A99r 2  20 rr rr       jsr Rnd
001A9Cr 2  8D 0A 0E       sta MY_NONCE+1
001A9Fr 2  60             rts
001AA0r 2               
001AA0r 2               EnterLink:
001AA0r 2  AD 0D 03       lda HW_PRESENT
001AA3r 2  29 10          and #HW_SC
001AA5r 2  D0 07          bne @card
001AA7r 2  A2 rr          ldx #<TxtNoSerial
001AA9r 2  A0 rr          ldy #>TxtNoSerial
001AABr 2  4C rr rr       jmp LinkFail
001AAEr 2               @card:
001AAEr 2  20 rr rr       jsr LinkOn
001AB1r 2  20 rr rr       jsr NewNonce
001AB4r 2  A9 06          lda #ST_LINK
001AB6r 2  85 6E          sta STATE
001AB8r 2  A9 01          lda #1
001ABAr 2  8D 10 0E       sta LINK_T
001ABDr 2  20 rr rr       jsr ClearMessages
001AC0r 2  A9 02          lda #INK_WHITE
001AC2r 2  85 78          sta TXT_INK
001AC4r 2  A9 0B          lda #ROW_MSG1
001AC6r 2  A2 rr          ldx #<TxtLinking
001AC8r 2  A0 rr          ldy #>TxtLinking
001ACAr 2  20 rr rr       jsr Print
001ACDr 2  A9 03          lda #INK_GRAY
001ACFr 2  85 78          sta TXT_INK
001AD1r 2  A9 0D          lda #ROW_MSG2
001AD3r 2  A2 rr          ldx #<TxtWaitOther
001AD5r 2  A0 rr          ldy #>TxtWaitOther
001AD7r 2  20 rr rr       jsr Print
001ADAr 2  A9 0E          lda #ROW_MSG3
001ADCr 2  A2 rr          ldx #<TxtOtherCart
001ADEr 2  A0 rr          ldy #>TxtOtherCart
001AE0r 2  20 rr rr       jsr Print
001AE3r 2                 ; falls through
001AE3r 2               
001AE3r 2               PrintQuit:
001AE3r 2  A9 03          lda #INK_GRAY
001AE5r 2  85 78          sta TXT_INK
001AE7r 2  A9 13          lda #ROW_MSG6
001AE9r 2  A2 rr          ldx #<TxtQuit
001AEBr 2  A0 rr          ldy #>TxtQuit
001AEDr 2  4C rr rr       jmp Print
001AF0r 2               
001AF0r 2               ; LinkFail - the message X (low), Y (high), and back to the menu from there.
001AF0r 2               LinkFail:
001AF0r 2  DA             phx
001AF1r 2  5A             phy
001AF2r 2  A9 04          lda #ST_OVER
001AF4r 2  85 6E          sta STATE
001AF6r 2  20 rr rr       jsr SoundOff
001AF9r 2  20 rr rr       jsr HideMarkers
001AFCr 2  20 rr rr       jsr UploadSprites
001AFFr 2  20 rr rr       jsr CanvasClear
001B02r 2  20 rr rr       jsr ClearMessages
001B05r 2  A9 09          lda #INK_RED
001B07r 2  85 78          sta TXT_INK
001B09r 2  7A             ply
001B0Ar 2  FA             plx
001B0Br 2  A9 0D          lda #ROW_MSG2
001B0Dr 2  20 rr rr       jsr Print
001B10r 2  A9 02          lda #INK_WHITE
001B12r 2  85 78          sta TXT_INK
001B14r 2  A9 0E          lda #ROW_MSG3
001B16r 2  A2 rr          ldx #<TxtFireMenu
001B18r 2  A0 rr          ldy #>TxtFireMenu
001B1Ar 2  4C rr rr       jmp Print
001B1Dr 2               
001B1Dr 2               LinkBroken:
001B1Dr 2  AD 14 0E       lda LINK_BAD
001B20r 2  C9 02          cmp #BAD_VERSION
001B22r 2  F0 07          beq @version
001B24r 2  A2 rr          ldx #<TxtOutOfSync
001B26r 2  A0 rr          ldy #>TxtOutOfSync
001B28r 2  4C rr rr       jmp LinkFail
001B2Br 2               @version:
001B2Br 2  A2 rr          ldx #<TxtWrongCart
001B2Dr 2  A0 rr          ldy #>TxtWrongCart
001B2Fr 2  4C rr rr       jmp LinkFail
001B32r 2               
001B32r 2               ; --- Each frame ---
001B32r 2               
001B32r 2               LinkFrame:
001B32r 2  20 rr rr       jsr LinkPoll
001B35r 2  AD 14 0E       lda LINK_BAD
001B38r 2  D0 E3          bne LinkBroken
001B3Ar 2  AD 0E 0E       lda HAVE_HELLO
001B3Dr 2  F0 05          beq @waiting
001B3Fr 2  AD 0F 0E       lda PEER_HAS
001B42r 2  D0 15          bne LinkGo
001B44r 2               @waiting:
001B44r 2  A5 6C          lda EV_SWAP
001B46r 2  F0 03          beq @timer
001B48r 2  4C rr rr       jmp EnterTitle
001B4Br 2               @timer:
001B4Br 2  CE 10 0E       dec LINK_T
001B4Er 2  D0 08          bne @done
001B50r 2  A9 14          lda #LINK_RESEND
001B52r 2  8D 10 0E       sta LINK_T
001B55r 2  4C rr rr       jmp SendHello
001B58r 2               @done:
001B58r 2  60             rts
001B59r 2               
001B59r 2               ; LinkGo - both machines know each other: the lower number takes the first seat.
001B59r 2               LinkGo:
001B59r 2  A9 01          lda #1
001B5Br 2  8D 13 0E       sta LINK_UP
001B5Er 2  A2 01          ldx #1
001B60r 2  AD 09 0E       lda MY_NONCE
001B63r 2  CD 0B 0E       cmp PEER_NONCE
001B66r 2  AD 0A 0E       lda MY_NONCE+1
001B69r 2  ED 0C 0E       sbc PEER_NONCE+1
001B6Cr 2  B0 02          bcs @seat
001B6Er 2  A2 00          ldx #0
001B70r 2               @seat:
001B70r 2  8E 05 0E       stx MY_SEAT
001B73r 2  AD 06 0E       lda MY_FACTION
001B76r 2  9D 00 08       sta SHIP_FACTION,x
001B79r 2  8A             txa
001B7Ar 2  49 01          eor #1
001B7Cr 2  AA             tax
001B7Dr 2  AD 0D 0E       lda PEER_FACTION
001B80r 2  9D 00 08       sta SHIP_FACTION,x
001B83r 2  20 rr rr       jsr SendHello
001B86r 2  4C rr rr       jmp StartBattle
001B89r 2               
001B89r 2               ; LinkNewTurn - nothing heard yet for this turn.
001B89r 2               LinkNewTurn:
001B89r 2  9C 15 0E       stz HAVE_PLAN
001B8Cr 2  9C 16 0E       stz PEER_ACK
001B8Fr 2  60             rts
001B90r 2               
001B90r 2               ; EnterLinkWait - orders are in: send them and wait for the other machine.
001B90r 2               EnterLinkWait:
001B90r 2  A9 07          lda #ST_WAIT
001B92r 2  85 6E          sta STATE
001B94r 2  20 rr rr       jsr HideMarkers
001B97r 2  20 rr rr       jsr UploadSprites
001B9Ar 2  20 rr rr       jsr CanvasClear
001B9Dr 2  20 rr rr       jsr ClearMessages
001BA0r 2  A9 02          lda #INK_WHITE
001BA2r 2  85 78          sta TXT_INK
001BA4r 2  A9 0D          lda #ROW_MSG2
001BA6r 2  A2 rr          ldx #<TxtOrdersIn
001BA8r 2  A0 rr          ldy #>TxtOrdersIn
001BAAr 2  20 rr rr       jsr Print
001BADr 2  A9 03          lda #INK_GRAY
001BAFr 2  85 78          sta TXT_INK
001BB1r 2  A9 0E          lda #ROW_MSG3
001BB3r 2  A2 rr          ldx #<TxtWaitOther
001BB5r 2  A0 rr          ldy #>TxtWaitOther
001BB7r 2  20 rr rr       jsr Print
001BBAr 2  A9 10          lda #ROW_MSG4
001BBCr 2  A2 rr          ldx #<TxtOtherCart
001BBEr 2  A0 rr          ldy #>TxtOtherCart
001BC0r 2  20 rr rr       jsr Print
001BC3r 2  20 rr rr       jsr PrintQuit
001BC6r 2  A9 14          lda #LINK_RESEND
001BC8r 2  8D 10 0E       sta LINK_T
001BCBr 2  4C rr rr       jmp SendPlan
001BCEr 2               
001BCEr 2               LinkWaitFrame:
001BCEr 2  20 rr rr       jsr LinkPoll
001BD1r 2  AD 14 0E       lda LINK_BAD
001BD4r 2  F0 03          beq @fine
001BD6r 2  4C rr rr       jmp LinkBroken
001BD9r 2               @fine:
001BD9r 2  AD 15 0E       lda HAVE_PLAN
001BDCr 2  F0 35          beq @waiting
001BDEr 2  AD 16 0E       lda PEER_ACK
001BE1r 2  F0 30          beq @waiting
001BE3r 2                 ; both machines have both plans
001BE3r 2  AD 05 0E       lda MY_SEAT
001BE6r 2  49 01          eor #1
001BE8r 2  AA             tax
001BE9r 2  AD 17 0E       lda PEER_PLAN
001BECr 2  9D 24 08       sta PLAN_C,x
001BEFr 2  AD 18 0E       lda PEER_PLAN+1
001BF2r 2  9D 28 08       sta PLAN_R,x
001BF5r 2  AD 19 0E       lda PEER_PLAN+2
001BF8r 2  9D 2C 08       sta AIM_C,x
001BFBr 2  AD 1A 0E       lda PEER_PLAN+3
001BFEr 2  9D 30 08       sta AIM_R,x
001C01r 2  AD 1B 0E       lda PEER_PLAN+4
001C04r 2  29 01          and #1
001C06r 2  9D 34 08       sta PLAN_WEAPON,x
001C09r 2  AD 1B 0E       lda PEER_PLAN+4
001C0Cr 2  4A             lsr a
001C0Dr 2  9D 84 09       sta PLAN_SPECIAL,x
001C10r 2  4C rr rr       jmp PlayTurn
001C13r 2               @waiting:
001C13r 2  A5 6C          lda EV_SWAP
001C15r 2  F0 03          beq @timer
001C17r 2  4C rr rr       jmp EnterTitle
001C1Ar 2               @timer:
001C1Ar 2  CE 10 0E       dec LINK_T
001C1Dr 2  D0 08          bne @done
001C1Fr 2  A9 14          lda #LINK_RESEND
001C21r 2  8D 10 0E       sta LINK_T
001C24r 2  4C rr rr       jmp SendPlan
001C27r 2               @done:
001C27r 2  60             rts
001C28r 2               
001C28r 2               ; --- Sending ---
001C28r 2               
001C28r 2               ; SendFrame - TX_FRAME, with its sync and checksum.
001C28r 2               SendFrame:
001C28r 2  A9 A5          lda #FRAME_SYNC
001C2Ar 2  8D 30 0E       sta TX_FRAME
001C2Dr 2  A9 30          lda #<TX_FRAME
001C2Fr 2  A2 0E          ldx #>TX_FRAME
001C31r 2  20 rr rr       jsr FrameCheck
001C34r 2  AD 1D 0E       lda CK_A
001C37r 2  8D 39 0E       sta TX_FRAME + FRAME_SIZE - 2
001C3Ar 2  AD 1E 0E       lda CK_B
001C3Dr 2  8D 3A 0E       sta TX_FRAME + FRAME_SIZE - 1
001C40r 2  A2 00          ldx #0
001C42r 2               @send:
001C42r 2  BD 30 0E       lda TX_FRAME,x
001C45r 2  20 rr rr       jsr SendByte
001C48r 2  E8             inx
001C49r 2  E0 0B          cpx #FRAME_SIZE
001C4Br 2  D0 F5          bne @send
001C4Dr 2  60             rts
001C4Er 2               
001C4Er 2               ; FrameCheck - CK_A, CK_B = the check of the frame at A (low), X (high). Two sums,
001C4Er 2               ; the second over the first, so a frame put together from the pieces of two
001C4Er 2               ; others, after a lost byte, doesn't pass by chance.
001C4Er 2               FrameCheck:
001C4Er 2  85 43          sta SV_PTR
001C50r 2  86 44          stx SV_PTR+1
001C52r 2  A9 5A          lda #$5A
001C54r 2  8D 1D 0E       sta CK_A
001C57r 2  A9 A5          lda #$A5
001C59r 2  8D 1E 0E       sta CK_B
001C5Cr 2  A0 01          ldy #1
001C5Er 2               @byte:
001C5Er 2  B1 43          lda (SV_PTR),y
001C60r 2  18             clc
001C61r 2  6D 1D 0E       adc CK_A
001C64r 2  8D 1D 0E       sta CK_A
001C67r 2  18             clc
001C68r 2  6D 1E 0E       adc CK_B
001C6Br 2  8D 1E 0E       sta CK_B
001C6Er 2  C8             iny
001C6Fr 2  C0 09          cpy #FRAME_SIZE - 2
001C71r 2  D0 EB          bne @byte
001C73r 2  60             rts
001C74r 2               
001C74r 2               ; SendByte - A out of the serial port, once the last byte has gone. Not the
001C74r 2               ; Kernal's routine: while it waits it puts arriving bytes in the keyboard buffer,
001C74r 2               ; where they'd read as key presses. Here they go in the ring. Keeps X.
001C74r 2               SendByte:
001C74r 2  48             pha
001C75r 2  78             sei
001C76r 2               @wait:
001C76r 2  AD 01 90       lda SC_STATUS
001C79r 2  8D 1C 0E       sta LINK_S
001C7Cr 2  29 08          and #SC_STATUS_RDRF
001C7Er 2  F0 0E          beq @noByte
001C80r 2  DA             phx
001C81r 2  AD 00 90       lda SC_DATA
001C84r 2  AE 00 0E       ldx RX_HEAD
001C87r 2  9D 00 0D       sta RX_BUF,x
001C8Ar 2  EE 00 0E       inc RX_HEAD
001C8Dr 2  FA             plx
001C8Er 2               @noByte:
001C8Er 2  AD 1C 0E       lda LINK_S
001C91r 2  29 10          and #SC_STATUS_TDRE
001C93r 2  F0 E1          beq @wait
001C95r 2  68             pla
001C96r 2  8D 00 90       sta SC_DATA
001C99r 2  58             cli
001C9Ar 2  60             rts
001C9Br 2               
001C9Br 2               ; SendHello - who this machine is, and how far along: 0 looking, 1 has heard the
001C9Br 2               ; other machine, 2 has started.
001C9Br 2               SendHello:
001C9Br 2  A9 01          lda #FR_HELLO
001C9Dr 2  8D 31 0E       sta TX_FRAME+1
001CA0r 2  9C 32 0E       stz TX_FRAME+2
001CA3r 2  AD 09 0E       lda MY_NONCE
001CA6r 2  8D 33 0E       sta TX_FRAME+3
001CA9r 2  AD 0A 0E       lda MY_NONCE+1
001CACr 2  8D 34 0E       sta TX_FRAME+4
001CAFr 2  AD 06 0E       lda MY_FACTION
001CB2r 2  8D 35 0E       sta TX_FRAME+5
001CB5r 2  AD 13 0E       lda LINK_UP
001CB8r 2  F0 04          beq @notUp
001CBAr 2  A9 02          lda #2
001CBCr 2  80 03          bra @stage
001CBEr 2               @notUp:
001CBEr 2  AD 0E 0E       lda HAVE_HELLO
001CC1r 2               @stage:
001CC1r 2  8D 36 0E       sta TX_FRAME+6
001CC4r 2  A9 01          lda #LINK_VERSION
001CC6r 2  8D 37 0E       sta TX_FRAME+7
001CC9r 2  9C 38 0E       stz TX_FRAME+8
001CCCr 2  4C rr rr       jmp SendFrame
001CCFr 2               
001CCFr 2               SendPlan:
001CCFr 2  AE 05 0E       ldx MY_SEAT
001CD2r 2  A9 02          lda #FR_PLAN
001CD4r 2  8D 31 0E       sta TX_FRAME+1
001CD7r 2  A5 73          lda TURN
001CD9r 2  8D 32 0E       sta TX_FRAME+2
001CDCr 2  BD 24 08       lda PLAN_C,x
001CDFr 2  8D 33 0E       sta TX_FRAME+3
001CE2r 2  BD 28 08       lda PLAN_R,x
001CE5r 2  8D 34 0E       sta TX_FRAME+4
001CE8r 2  BD 2C 08       lda AIM_C,x
001CEBr 2  8D 35 0E       sta TX_FRAME+5
001CEEr 2  BD 30 08       lda AIM_R,x
001CF1r 2  8D 36 0E       sta TX_FRAME+6
001CF4r 2  BD 84 09       lda PLAN_SPECIAL,x
001CF7r 2  0A             asl a
001CF8r 2  1D 34 08       ora PLAN_WEAPON,x
001CFBr 2  8D 37 0E       sta TX_FRAME+7
001CFEr 2  20 rr rr       jsr StateSum
001D01r 2  8D 38 0E       sta TX_FRAME+8
001D04r 2  4C rr rr       jmp SendFrame
001D07r 2               
001D07r 2               ; SendAck - turn A's plan arrived.
001D07r 2               SendAck:
001D07r 2  8D 32 0E       sta TX_FRAME+2
001D0Ar 2  A9 03          lda #FR_ACK
001D0Cr 2  8D 31 0E       sta TX_FRAME+1
001D0Fr 2  A2 03          ldx #3
001D11r 2               @clear:
001D11r 2  9E 30 0E       stz TX_FRAME,x
001D14r 2  E8             inx
001D15r 2  E0 09          cpx #FRAME_SIZE - 2
001D17r 2  D0 F8          bne @clear
001D19r 2  4C rr rr       jmp SendFrame
001D1Cr 2               
001D1Cr 2               ; StateSum - A = a checksum of everything a turn is played from.
001D1Cr 2               StateSum:
001D1Cr 2  A9 00          lda #0
001D1Er 2  18             clc
001D1Fr 2  A2 01          ldx #NUM_SHIPS - 1
001D21r 2               @ship:
001D21r 2  7D 10 08       adc SHIP_HP_LO,x
001D24r 2  7D 14 08       adc SHIP_HP_HI,x
001D27r 2  7D 18 08       adc SHIP_C,x
001D2Ar 2  7D 1C 08       adc SHIP_R,x
001D2Dr 2  7D 0C 08       adc SHIP_ALIVE,x
001D30r 2  7D 80 09       adc SPECIAL_WAIT,x
001D33r 2  7D 88 09       adc CLOAKED,x
001D36r 2  CA             dex
001D37r 2  10 E8          bpl @ship
001D39r 2  A2 05          ldx #NUM_MINES - 1
001D3Br 2               @mine:
001D3Br 2  7D A0 09       adc MINE_OWNER,x
001D3Er 2  7D A6 09       adc MINE_C,x
001D41r 2  7D AC 09       adc MINE_R,x
001D44r 2  CA             dex
001D45r 2  10 F4          bpl @mine
001D47r 2  60             rts
001D48r 2               
001D48r 2               ; --- Receiving ---
001D48r 2               
001D48r 2               ; LinkPoll - take what has arrived, a limited amount a frame.
001D48r 2               LinkPoll:
001D48r 2  AD 04 0E       lda LINK_ON
001D4Br 2  F0 32          beq @done
001D4Dr 2  A9 28          lda #POLL_BYTES
001D4Fr 2  8D 11 0E       sta LINK_N
001D52r 2               @next:
001D52r 2  AE 01 0E       ldx RX_TAIL
001D55r 2  EC 00 0E       cpx RX_HEAD
001D58r 2  F0 25          beq @done
001D5Ar 2  BD 00 0D       lda RX_BUF,x
001D5Dr 2  EE 01 0E       inc RX_TAIL
001D60r 2  AE 12 0E       ldx PARSE_N
001D63r 2  D0 04          bne @inFrame
001D65r 2  C9 A5          cmp #FRAME_SYNC
001D67r 2  D0 11          bne @count
001D69r 2               @inFrame:
001D69r 2  9D 20 0E       sta FRAME,x
001D6Cr 2  E8             inx
001D6Dr 2  8E 12 0E       stx PARSE_N
001D70r 2  E0 0B          cpx #FRAME_SIZE
001D72r 2  D0 06          bne @count
001D74r 2  9C 12 0E       stz PARSE_N
001D77r 2  20 rr rr       jsr TakeFrame
001D7Ar 2               @count:
001D7Ar 2  CE 11 0E       dec LINK_N
001D7Dr 2  D0 D3          bne @next
001D7Fr 2               @done:
001D7Fr 2  60             rts
001D80r 2               
001D80r 2               ; TakeFrame - check a whole frame and act on it.
001D80r 2               TakeFrame:
001D80r 2  A9 20          lda #<FRAME
001D82r 2  A2 0E          ldx #>FRAME
001D84r 2  20 rr rr       jsr FrameCheck
001D87r 2  AD 1D 0E       lda CK_A
001D8Ar 2  CD 29 0E       cmp FRAME + FRAME_SIZE - 2
001D8Dr 2  D0 23          bne @done
001D8Fr 2  AD 1E 0E       lda CK_B
001D92r 2  CD 2A 0E       cmp FRAME + FRAME_SIZE - 1
001D95r 2  D0 1B          bne @done
001D97r 2  AD 21 0E       lda FRAME+1
001D9Ar 2  C9 01          cmp #FR_HELLO
001D9Cr 2  F0 69          beq TakeHello
001D9Er 2  C9 02          cmp #FR_PLAN
001DA0r 2  F0 11          beq TakePlan
001DA2r 2  C9 03          cmp #FR_ACK
001DA4r 2  D0 0C          bne @done
001DA6r 2  AD 22 0E       lda FRAME+2
001DA9r 2  C5 73          cmp TURN
001DABr 2  D0 05          bne @done
001DADr 2  A9 01          lda #1
001DAFr 2  8D 16 0E       sta PEER_ACK
001DB2r 2               @done:
001DB2r 2  60             rts
001DB3r 2               
001DB3r 2               TakePlan:
001DB3r 2  AD 13 0E       lda LINK_UP
001DB6r 2  F0 0C          beq @done
001DB8r 2  AD 22 0E       lda FRAME+2
001DBBr 2  C5 73          cmp TURN
001DBDr 2  F0 06          beq @now
001DBFr 2  1A             inc a                            ; last turn's, when our answer got lost
001DC0r 2  C5 73          cmp TURN
001DC2r 2  F0 3D          beq @answer
001DC4r 2               @done:
001DC4r 2  60             rts
001DC5r 2               @now:
001DC5r 2  A5 6E          lda STATE                        ; after the battle the state has moved on
001DC7r 2  C9 04          cmp #ST_OVER
001DC9r 2  F0 36          beq @answer
001DCBr 2  20 rr rr       jsr StateSum
001DCEr 2  CD 28 0E       cmp FRAME+8
001DD1r 2  F0 06          beq @same
001DD3r 2  A9 01          lda #BAD_SYNC
001DD5r 2  8D 14 0E       sta LINK_BAD
001DD8r 2  60             rts
001DD9r 2               @same:
001DD9r 2  AD 15 0E       lda HAVE_PLAN
001DDCr 2  D0 23          bne @answer
001DDEr 2  A2 04          ldx #4
001DE0r 2               @copy:
001DE0r 2  BD 23 0E       lda FRAME+3,x
001DE3r 2  9D 17 0E       sta PEER_PLAN,x
001DE6r 2  CA             dex
001DE7r 2  10 F7          bpl @copy
001DE9r 2  A9 01          lda #1
001DEBr 2  8D 15 0E       sta HAVE_PLAN
001DEEr 2  A5 6E          lda STATE
001DF0r 2  C9 02          cmp #ST_PLAN
001DF2r 2  D0 0D          bne @answer
001DF4r 2  A9 03          lda #INK_GRAY
001DF6r 2  85 78          sta TXT_INK
001DF8r 2  A9 0C          lda #ROW_READY
001DFAr 2  A2 rr          ldx #<TxtOtherReady
001DFCr 2  A0 rr          ldy #>TxtOtherReady
001DFEr 2  20 rr rr       jsr Print
001E01r 2               @answer:
001E01r 2  AD 22 0E       lda FRAME+2
001E04r 2  4C rr rr       jmp SendAck
001E07r 2               
001E07r 2               TakeHello:
001E07r 2  AD 27 0E       lda FRAME+7
001E0Ar 2  C9 01          cmp #LINK_VERSION
001E0Cr 2  F0 06          beq @version
001E0Er 2  A9 02          lda #BAD_VERSION
001E10r 2  8D 14 0E       sta LINK_BAD
001E13r 2  60             rts
001E14r 2               @version:
001E14r 2  AD 13 0E       lda LINK_UP
001E17r 2  F0 1A          beq @looking
001E19r 2                 ; already playing: it may not know yet
001E19r 2  AD 23 0E       lda FRAME+3
001E1Cr 2  CD 0B 0E       cmp PEER_NONCE
001E1Fr 2  D0 4E          bne @done
001E21r 2  AD 24 0E       lda FRAME+4
001E24r 2  CD 0C 0E       cmp PEER_NONCE+1
001E27r 2  D0 46          bne @done
001E29r 2  AD 26 0E       lda FRAME+6
001E2Cr 2  C9 02          cmp #2
001E2Er 2  B0 3F          bcs @done
001E30r 2  4C rr rr       jmp SendHello
001E33r 2               @looking:
001E33r 2  AD 23 0E       lda FRAME+3
001E36r 2  CD 09 0E       cmp MY_NONCE
001E39r 2  D0 11          bne @other
001E3Br 2  AD 24 0E       lda FRAME+4
001E3Er 2  CD 0A 0E       cmp MY_NONCE+1
001E41r 2  D0 09          bne @other
001E43r 2  9C 0E 0E       stz HAVE_HELLO                   ; the same number: both pick again
001E46r 2  9C 0F 0E       stz PEER_HAS
001E49r 2  4C rr rr       jmp NewNonce
001E4Cr 2               @other:
001E4Cr 2  AD 23 0E       lda FRAME+3
001E4Fr 2  8D 0B 0E       sta PEER_NONCE
001E52r 2  AD 24 0E       lda FRAME+4
001E55r 2  8D 0C 0E       sta PEER_NONCE+1
001E58r 2  AD 25 0E       lda FRAME+5
001E5Br 2  29 03          and #3
001E5Dr 2  8D 0D 0E       sta PEER_FACTION
001E60r 2  A9 01          lda #1
001E62r 2  8D 0E 0E       sta HAVE_HELLO
001E65r 2  AD 26 0E       lda FRAME+6
001E68r 2  F0 06          beq @answer
001E6Ar 2  A9 01          lda #1
001E6Cr 2  8D 0F 0E       sta PEER_HAS
001E6Fr 2               @done:
001E6Fr 2  60             rts
001E70r 2               @answer:
001E70r 2  4C rr rr       jmp SendHello
001E73r 2               
001E73r 1               .include "src/sound.asm"
001E73r 2               ; =============================================================================
001E73r 2               ;   sound.asm - sound effects and music on the SID
001E73r 2               ; =============================================================================
001E73r 2               ;   The HexFleet app's sounds and music, rebuilt for the SID's three voices
001E73r 2               ;   (tools/build-sound.mjs holds them). Music plays on all three. An effect takes
001E73r 2               ;   over voice 3, or voice 2 when it needs a second voice or 3 is busy with
001E73r 2               ;   something that matters more, and the music picks the voice up again at its
001E73r 2               ;   next note.
001E73r 2               ;
001E73r 2               ;   A timer interrupt runs SoundTick 60 times a second from bank 3, so the sound
001E73r 2               ;   keeps time however busy the game is. The game only leaves requests in a queue.
001E73r 2               ;   This fixed-bank half holds those calls and the interrupt handler.
001E73r 2               ; =============================================================================
001E73r 2               
001E73r 2               .segment "CART"
001AADr 2               
001AADr 2               TIMER_FRAME   = 16600              ; a 60th of a second, less the time to restart it
001AADr 2               REQ_LASER_OFF = $F0
001AADr 2               REQ_ALL_OFF   = $F1
001AADr 2               SOUND_BANK    = 3
001AADr 2               
001AADr 2               ; SoundInit - silence, then start the timer and take over the interrupt.
001AADr 2               SoundInit:
001AADr 2  A2 6F          ldx #S_VARS_END - S_REG - 1
001AAFr 2               @clear:
001AAFr 2  9E 00 0F       stz S_REG,x
001AB2r 2  CA             dex
001AB3r 2  10 FA          bpl @clear
001AB5r 2  64 D7          stz SND_LASER
001AB7r 2  A9 0F          lda #15
001AB9r 2  8D 32 0F       sta S_MASTER
001ABCr 2  A9 01          lda #1
001ABEr 2  8D 2D 0F       sta MUS_ON
001AC1r 2  AD 00 03       lda IRQ_PTR
001AC4r 2  8D 02 0E       sta OLD_IRQ
001AC7r 2  AD 01 03       lda IRQ_PTR+1
001ACAr 2  8D 03 0E       sta OLD_IRQ+1
001ACDr 2  78             sei
001ACEr 2  A9 rr          lda #<SysIrq
001AD0r 2  8D 00 03       sta IRQ_PTR
001AD3r 2  A9 rr          lda #>SysIrq
001AD5r 2  8D 01 03       sta IRQ_PTR+1
001AD8r 2  AD 0D 03       lda HW_PRESENT
001ADBr 2  29 40          and #HW_SID
001ADDr 2  F0 2B          beq @noSid
001ADFr 2  A2 18          ldx #$18
001AE1r 2               @sid:
001AE1r 2  9E 00 98       stz SID_V1_FREQ_LO,x
001AE4r 2  CA             dex
001AE5r 2  10 FA          bpl @sid
001AE7r 2  AD 0D 03       lda HW_PRESENT
001AEAr 2  29 20          and #HW_GPIO
001AECr 2  F0 1C          beq @noSid
001AEEr 2  A9 01          lda #1
001AF0r 2  8D 31 0F       sta S_ON
001AF3r 2  AD 0B 94       lda GPIO_ACR
001AF6r 2  29 DF          and #%11011111                   ; timer 2 counts clock cycles
001AF8r 2  8D 0B 94       sta GPIO_ACR
001AFBr 2  A9 A0          lda #GPIO_IER_SET | GPIO_INT_T2
001AFDr 2  8D 0E 94       sta GPIO_IER
001B00r 2  A9 D8          lda #<TIMER_FRAME
001B02r 2  8D 08 94       sta GPIO_T2CL
001B05r 2  A9 40          lda #>TIMER_FRAME
001B07r 2  8D 09 94       sta GPIO_T2CH
001B0Ar 2               @noSid:
001B0Ar 2  58             cli
001B0Br 2  60             rts
001B0Cr 2               
001B0Cr 2               ; SysIrq - the machine's interrupt handler from now on: serial bytes while linked,
001B0Cr 2               ; the keyboard as the Kernal handles it, and the sound timer. The sound runs with
001B0Cr 2               ; interrupts back on, so a long tick can't make the serial port lose a byte.
001B0Cr 2               SysIrq:
001B0Cr 2  48             pha
001B0Dr 2  DA             phx
001B0Er 2  5A             phy
001B0Fr 2  BA             tsx
001B10r 2  BD 04 01       lda $104,x                       ; the saved flags: a BRK is the Kernal's
001B13r 2  29 10          and #$10
001B15r 2  D0 6C          bne @brk
001B17r 2  AD 04 0E       lda LINK_ON
001B1Ar 2  F0 13          beq @keys
001B1Cr 2  AD 01 90       lda SC_STATUS
001B1Fr 2  29 08          and #SC_STATUS_RDRF
001B21r 2  F0 0C          beq @keys
001B23r 2  AD 00 90       lda SC_DATA
001B26r 2  AE 00 0E       ldx RX_HEAD
001B29r 2  9D 00 0D       sta RX_BUF,x
001B2Cr 2  EE 00 0E       inc RX_HEAD
001B2Fr 2               @keys:
001B2Fr 2  AD 0D 03       lda HW_PRESENT
001B32r 2  29 20          and #HW_GPIO
001B34r 2  F0 49          beq @exit
001B36r 2  AD 0D 94       lda GPIO_IFR
001B39r 2  29 10          and #GPIO_INT_CB1
001B3Br 2  F0 08          beq @ps2
001B3Dr 2  AD 00 94       lda GPIO_PORTB
001B40r 2  20 06 A0       jsr WriteBuffer
001B43r 2  80 0D          bra @timer
001B45r 2               @ps2:
001B45r 2  AD 0D 94       lda GPIO_IFR
001B48r 2  29 02          and #GPIO_INT_CA1
001B4Ar 2  F0 06          beq @timer
001B4Cr 2  AD 01 94       lda GPIO_PORTA
001B4Fr 2  20 06 A0       jsr WriteBuffer
001B52r 2               @timer:
001B52r 2  AD 0D 94       lda GPIO_IFR
001B55r 2  29 20          and #GPIO_INT_T2
001B57r 2  F0 26          beq @exit
001B59r 2  A9 D8          lda #<TIMER_FRAME
001B5Br 2  8D 08 94       sta GPIO_T2CL
001B5Er 2  A9 40          lda #>TIMER_FRAME
001B60r 2  8D 09 94       sta GPIO_T2CH                    ; also clears the flag
001B63r 2  AD 2A 0F       lda S_BUSY
001B66r 2  D0 17          bne @exit                        ; the last tick is still running
001B68r 2  EE 2A 0F       inc S_BUSY
001B6Br 2  A5 3A          lda BANKSHDW
001B6Dr 2  48             pha
001B6Er 2  A9 03          lda #SOUND_BANK
001B70r 2  8D 00 E0       sta BANK
001B73r 2  58             cli
001B74r 2  20 rr rr       jsr SoundTick
001B77r 2  78             sei
001B78r 2  68             pla
001B79r 2  8D 00 E0       sta BANK
001B7Cr 2  9C 2A 0F       stz S_BUSY
001B7Fr 2               @exit:
001B7Fr 2  7A             ply
001B80r 2  FA             plx
001B81r 2  68             pla
001B82r 2  40             rti
001B83r 2               @brk:
001B83r 2  7A             ply
001B84r 2  FA             plx
001B85r 2  68             pla
001B86r 2  6C 02 0E       jmp (OLD_IRQ)
001B89r 2               
001B89r 2               ; --- What the game calls. These keep X and Y. ---
001B89r 2               
001B89r 2               ; SoundRequest - leave request A for the next tick.
001B89r 2               SoundRequest:
001B89r 2  DA             phx
001B8Ar 2  AE 31 0F       ldx S_ON
001B8Dr 2  F0 10          beq @done
001B8Fr 2  AE 28 0F       ldx S_QH
001B92r 2  9D 20 0F       sta S_Q,x
001B95r 2  E8             inx
001B96r 2  E0 08          cpx #8
001B98r 2  90 02          bcc @stored
001B9Ar 2  A2 00          ldx #0
001B9Cr 2               @stored:
001B9Cr 2  8E 28 0F       stx S_QH
001B9Fr 2               @done:
001B9Fr 2  FA             plx
001BA0r 2  60             rts
001BA1r 2               
001BA1r 2               .macro SOUND name, effect
001BA1r 2               name:
001BA1r 2                 lda #effect
001BA1r 2                 jmp SoundRequest
001BA1r 2               .endmacro
001BA1r 2               
001BA1r 2  A9 01 4C rr  SOUND SndPick, SFX_PRESS
001BA5r 2  rr           
001BA6r 2  A9 02 4C rr  SOUND SndBack, SFX_BACK
001BAAr 2  rr           
001BABr 2  A9 03 4C rr  SOUND SndCommit, SFX_COMMIT
001BAFr 2  rr           
001BB0r 2  A9 04 4C rr  SOUND SndError, SFX_ERROR
001BB4r 2  rr           
001BB5r 2  A9 07 4C rr  SOUND SndHit, SFX_HIT
001BB9r 2  rr           
001BBAr 2  A9 08 4C rr  SOUND SndTorpHit, SFX_TORPHIT
001BBEr 2  rr           
001BBFr 2  A9 0A 4C rr  SOUND SndBoom, SFX_BOOM
001BC3r 2  rr           
001BC4r 2  A9 0C 4C rr  SOUND SndBlast, SFX_BLAST
001BC8r 2  rr           
001BC9r 2  A9 06 4C rr  SOUND SndTorpedo, SFX_TORPEDO
001BCDr 2  rr           
001BCEr 2  A9 0E 4C rr  SOUND SndThrust, SFX_THRUST
001BD2r 2  rr           
001BD3r 2  A9 0F 4C rr  SOUND SndWarp, SFX_JUMP
001BD7r 2  rr           
001BD8r 2  A9 10 4C rr  SOUND SndCloak, SFX_CLOAK
001BDCr 2  rr           
001BDDr 2  A9 11 4C rr  SOUND SndMine, SFX_MINE
001BE1r 2  rr           
001BE2r 2               
001BE2r 2               SndLaserOn:
001BE2r 2  A5 D7          lda SND_LASER
001BE4r 2  D0 07          bne @done
001BE6r 2  E6 D7          inc SND_LASER
001BE8r 2  A9 05          lda #SFX_LASER
001BEAr 2  4C rr rr       jmp SoundRequest
001BEDr 2               @done:
001BEDr 2  60             rts
001BEEr 2               
001BEEr 2               SndLaserOff:
001BEEr 2  A5 D7          lda SND_LASER
001BF0r 2  F0 07          beq @done
001BF2r 2  64 D7          stz SND_LASER
001BF4r 2  A9 F0          lda #REQ_LASER_OFF
001BF6r 2  4C rr rr       jmp SoundRequest
001BF9r 2               @done:
001BF9r 2  60             rts
001BFAr 2               
001BFAr 2               SoundOff:
001BFAr 2  64 D7          stz SND_LASER
001BFCr 2  A9 F1          lda #REQ_ALL_OFF
001BFEr 2  4C rr rr       jmp SoundRequest
001C01r 2               
001C01r 2               ; PlayMusic - tune A from the top, unless it's already playing.
001C01r 2               PlayMusic:
001C01r 2  8D 2C 0F       sta MUS_WANT
001C04r 2  60             rts
001C05r 2               
001C05r 2               ToggleMusic:
001C05r 2  AD 2D 0F       lda MUS_ON
001C08r 2  49 01          eor #1
001C0Ar 2  8D 2D 0F       sta MUS_ON
001C0Dr 2  60             rts
001C0Er 2               
001C0Er 2               ; =============================================================================
001C0Er 2               ;   The driver, in bank 3. Everything here runs in the interrupt, so it keeps to
001C0Er 2               ;   its own memory and calls nothing outside this bank.
001C0Er 2               ; =============================================================================
001C0Er 2               
001C0Er 2               .segment "BANK03"
000000r 2               
000000r 2               .include "sounddata.inc"
000000r 3               ; =============================================================================
000000r 3               ;   sounddata.inc - GENERATED by tools/build-sound.mjs (make assets).
000000r 3               ;   Do not edit by hand: change the script and run it again.
000000r 3               ; =============================================================================
000000r 3               
000000r 3               SFX_PRESS = 1
000000r 3               SFX_BACK = 2
000000r 3               SFX_COMMIT = 3
000000r 3               SFX_ERROR = 4
000000r 3               SFX_LASER = 5
000000r 3               SFX_TORPEDO = 6
000000r 3               SFX_HIT = 7
000000r 3               SFX_TORPHIT = 8
000000r 3               SFX_SUBHIT = 9
000000r 3               SFX_BOOM = 10
000000r 3               SFX_SUBBOOM = 11
000000r 3               SFX_BLAST = 12
000000r 3               SFX_SUBBLAST = 13
000000r 3               SFX_THRUST = 14
000000r 3               SFX_JUMP = 15
000000r 3               SFX_CLOAK = 16
000000r 3               SFX_MINE = 17
000000r 3               SFX_THUMP = 18
000000r 3               SFX_COUNT = 18
000000r 3               TUNE_MENU = 1
000000r 3               TUNE_BATTLE = 2
000000r 3               KICK_NOTE = $FD
000000r 3               
000000r 3               .segment "BANK03"
000000r 3               
000000r 3               ; Indexed by effect number (0 is nothing)
000000r 3               FxPrio:
000000r 3  00 03 02 05    .byte $00,$03,$02,$05,$05,$03,$05,$04,$06,$02,$08,$02,$07,$02,$01,$06
000004r 3  05 03 05 04  
000008r 3  06 02 08 02  
000010r 3  05 05 00       .byte $05,$05,$00
000013r 3               FxVoice:
000013r 3  00 02 02 02    .byte $00,$02,$02,$02,$02,$01,$02,$02,$02,$01,$02,$01,$02,$01,$02,$02
000017r 3  02 01 02 02  
00001Br 3  02 01 02 01  
000023r 3  02 02 02       .byte $02,$02,$02
000026r 3               FxOther:
000026r 3  00 01 01 01    .byte $00,$01,$01,$01,$01,$00,$01,$01,$01,$00,$01,$00,$01,$00,$00,$01
00002Ar 3  01 00 01 01  
00002Er 3  01 00 01 00  
000036r 3  01 01 00       .byte $01,$01,$00
000039r 3               FxPair:
000039r 3  00 00 00 00    .byte $00,$00,$00,$00,$00,$00,$00,$00,$09,$00,$0B,$00,$0D,$00,$00,$00
00003Dr 3  00 00 00 00  
000041r 3  09 00 0B 00  
000049r 3  00 00 00       .byte $00,$00,$00
00004Cr 3               FxLo:
00004Cr 3  00 rr rr rr    .byte 0, <FxPRESS, <FxBACK, <FxCOMMIT, <FxERROR, <FxLASER, <FxTORPEDO, <FxHIT, <FxTORPHIT, <FxSUBHIT, <FxBOOM, <FxSUBBOOM, <FxBLAST, <FxSUBBLAST, <FxTHRUST, <FxJUMP, <FxCLOAK, <FxMINE, <FxTHUMP
000050r 3  rr rr rr rr  
000054r 3  rr rr rr rr  
00005Fr 3               FxHi:
00005Fr 3  00 rr rr rr    .byte 0, >FxPRESS, >FxBACK, >FxCOMMIT, >FxERROR, >FxLASER, >FxTORPEDO, >FxHIT, >FxTORPHIT, >FxSUBHIT, >FxBOOM, >FxSUBBOOM, >FxBLAST, >FxSUBBLAST, >FxTHRUST, >FxJUMP, >FxCLOAK, >FxMINE, >FxTHUMP
000063r 3  rr rr rr rr  
000067r 3  rr rr rr rr  
000072r 3               FxPRESS:
000072r 3  01 11 70 F3    .byte $01,$11,$70,$F3,$FC,$4C,$FC,$4C,$10,$08,$00,$00,$06,$10,$70,$F3
