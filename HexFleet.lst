001CD0r 2  00 00 00 00    .byte $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$09,$00,$00,$00,$09
001CD4r 2  00 00 00 00  
001CD8r 2  00 00 00 09  
001CE0r 2  00 00 00 09    .byte $00,$00,$00,$09,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$99
001CE4r 2  00 00 00 00  
001CE8r 2  00 00 00 00  
001CF0r 2  00 00 00 90    .byte $00,$00,$00,$90,$00,$99,$00,$00,$09,$90,$00,$00,$00,$00,$00,$00
001CF4r 2  00 99 00 00  
001CF8r 2  09 90 00 00  
001D00r 2               
001D00r 1               .include "src/vdp.asm"
001D00r 2               ; =============================================================================
001D00r 2               ;   vdp.asm - the PICOVDP: setup, loading, text, sprites and the canvas
001D00r 2               ; =============================================================================
001D00r 2               ;   Everything that knows about the video hardware lives here, so a port to
001D00r 2               ;   another machine replaces this file.
001D00r 2               ;
001D00r 2               ;   Layer 0 is the board, fixed once loaded. Layer 1 (2 bits per pixel) is both
001D00r 2               ;   the text and the canvas: its patterns 32..127 are the card's font, and 128..255
001D00r 2               ;   and up are a pool of tiles the game draws beams, rings, outlines and big text
001D00r 2               ;   into, handed to cells as they're touched. With 2 bits a pixel, two lasers crossing in one cell
001D00r 2               ;   each keep their own color. Port A only: the Kernal
001D00r 2               ;   leaves it alone in interrupts, so no SEI is needed.
001D00r 2               ; =============================================================================
001D00r 2               
001D00r 2               .segment "CART"
0000C0r 2               
0000C0r 2               ; Register, value pairs for the display setup
0000C0r 2               VideoRegs:
0000C0r 2  01 02          .byte VC_REG_MODE1,   $02         ; display off, 16x16 sprites
0000C2r 2  00 00          .byte VC_REG_MODE0,   $00
0000C4r 2  0D 04          .byte VC_REG_VMODE,   $04         ; Full: 40 x 30, 320 x 240
0000C6r 2  08 00          .byte VC_REG_VBANK,   0
0000C8r 2  09 01          .byte VC_REG_VINC,    1
0000CAr 2  0A 00          .byte VC_REG_IRQEN,   0
0000CCr 2  0F 00          .byte VC_REG_STATSEL_A, 0
0000CEr 2  07 04          .byte VC_REG_COLOR,   $04         ; backdrop: palette row 0, entry 4
0000D0r 2  10 00          .byte VC_REG_L0NAME,  >V_L0NAME >> 2
0000D2r 2  12 07          .byte VC_REG_L0PAT,   >V_L0PAT >> 3
0000D4r 2  13 00          .byte VC_REG_L0SCRX,  0
0000D6r 2  14 00          .byte VC_REG_L0SCRY,  0
0000D8r 2  15 1D          .byte VC_REG_L0CTRL,  VC_LCTRL_2BPP | VC_LCTRL_ATTR_NONE | VC_LCTRL_ENABLE
0000DAr 2  16 00          .byte VC_REG_L0PAL,   0
0000DCr 2  18 02          .byte VC_REG_L1NAME,  >V_L1NAME >> 2
0000DEr 2  19 04          .byte VC_REG_L1ATTR,  >V_L1ATTR >> 2
0000E0r 2  1A 03          .byte VC_REG_L1PAT,   >V_FONT >> 3    ; the font loads here first
0000E2r 2  1B 00          .byte VC_REG_L1SCRX,  0
0000E4r 2  1C 00          .byte VC_REG_L1SCRY,  0
0000E6r 2  1D 10          .byte VC_REG_L1CTRL,  VC_LCTRL_1BPP | VC_LCTRL_ATTR_CELL | VC_LCTRL_ENABLE
0000E8r 2  1E 03          .byte VC_REG_L1PAL,   3               ; sub-palettes from entry 192
0000EAr 2  20 2C          .byte VC_REG_SPRATTR, >V_SPRATTR << 1
0000ECr 2  21 08          .byte VC_REG_SPRPAT,  $08         ; $4000
0000EEr 2  22 27          .byte VC_REG_SPRCOUNT, NUM_SLOTS
0000F0r 2  23 21          .byte VC_REG_SPRCTRL, VC_SPRCTRL_ENABLE | VC_SPRCTRL_4BPP
0000F2r 2  24 20          .byte VC_REG_SPRLIMIT, 32
0000F4r 2  25 00          .byte VC_REG_SPRPAL,  0
0000F6r 2               VIDEO_REGS = * - VideoRegs
0000F6r 2               
0000F6r 2               ; Palette row 0, entries 1..4: grid, dim star, bright star, backdrop (the app's
0000F6r 2               ; near-black)
0000F6r 2               PaletteBoard:
0000F6r 2  02 46 03 45    .byte $02, $46,  $03, $45,  $0A, $BD,  $01, $12
0000FAr 2  0A BD 01 12  
0000FEr 2               ; Layer 1's inks, by number
0000FEr 2               PaletteInks:
0000FEr 2  00 00 01 12    .byte $00, $00,  $01, $12,  $0F, $FF,  $09, $AB
000102r 2  0F FF 09 AB  
000106r 2  03 AF 0F 92    .byte $03, $AF,  $0F, $92,  $03, $E5,  $0B, $6F
00010Ar 2  03 E5 0B 6F  
00010Er 2  00 EE 0F 44    .byte $00, $EE,  $0F, $44,  $0A, $F3,  $0F, $5D
000112r 2  0A F3 0F 5D  
000116r 2  0F D3 05 67    .byte $0F, $D3,  $05, $67,  $00, $00,  $00, $00
00011Ar 2  00 00 00 00  
00011Er 2               
00011Er 2               ; Hull bar cells: the top rows filled to 0..8 pixels, a thin line below
00011Er 2               BarMasks:
00011Er 2  00 80 C0 E0    .byte $00, $80, $C0, $E0, $F0, $F8, $FC, $FE, $FF
000122r 2  F0 F8 FC FE  
000126r 2  FF           
000127r 2               
000127r 2               RowLo:
000127r 2  00 28 50 78  .repeat 30, I
00012Br 2  A0 C8 F0 18  
00012Fr 2  40 68 90 B8  
000145r 2                 .byte <(I * 40)
000145r 2               .endrepeat
000145r 2               RowHi:
000145r 2  00 00 00 00  .repeat 30, I
000149r 2  00 00 00 01  
00014Dr 2  01 01 01 01  
000163r 2                 .byte >(I * 40)
000163r 2               .endrepeat
000163r 2               
000163r 2               ; A 4-bit pattern as 2-bit pixels of value 1
000163r 2               Nibble2:
000163r 2  00 01 04 05    .byte $00, $01, $04, $05, $10, $11, $14, $15
000167r 2  10 11 14 15  
00016Br 2  40 41 44 45    .byte $40, $41, $44, $45, $50, $51, $54, $55
00016Fr 2  50 51 54 55  
000173r 2               ; The canvas: the bits of a pixel, by column in its byte, and each value there
000173r 2               PixClear:
000173r 2  3F CF F3 FC    .byte $3F, $CF, $F3, $FC
000177r 2               PixBits:
000177r 2  00 00 00 00    .byte $00, $00, $00, $00,  $40, $10, $04, $01
00017Br 2  40 10 04 01  
00017Fr 2  80 20 08 02    .byte $80, $20, $08, $02,  $C0, $30, $0C, $03
000183r 2  C0 30 0C 03  
000187r 2               ; Where each of a tile's 16 bytes is kept
000187r 2               CtLo:
000187r 2  00 00 00 00  .repeat 16, I
00018Br 2  00 00 00 00  
00018Fr 2  00 00 00 00  
000197r 2                 .byte <(CT_ROWS + I * 256)
000197r 2               .endrepeat
000197r 2               CtHi:
000197r 2  20 21 22 23  .repeat 16, I
00019Br 2  24 25 26 27  
00019Fr 2  28 29 2A 2B  
0001A7r 2                 .byte >(CT_ROWS + I * 256)
0001A7r 2               .endrepeat
0001A7r 2               
0001A7r 2               ; SetBank - A selects the 8 KB bank at $C000. Only called from here.
0001A7r 2               SetBank:
0001A7r 2  85 3A          sta BANKSHDW
0001A9r 2  8D 00 E0       sta BANK
0001ACr 2  60             rts
0001ADr 2               
0001ADr 2               ; VReg - A = value, X = register. Keeps X.
0001ADr 2               VReg:
0001ADr 2  8D 01 9C       sta VC_REG
0001B0r 2  8A             txa
0001B1r 2  09 80          ora #VC_REG_WRITE
0001B3r 2  8D 01 9C       sta VC_REG
0001B6r 2  60             rts
0001B7r 2               
0001B7r 2               ; VAddr - point port A at A (low), X (high) to write. Keeps X.
0001B7r 2               VAddr:
0001B7r 2  8D 01 9C       sta VC_REG
0001BAr 2  8A             txa
0001BBr 2  09 40          ora #VC_ADDR_WRITE
0001BDr 2  8D 01 9C       sta VC_REG
0001C0r 2  60             rts
0001C1r 2               
0001C1r 2               ; WaitFrame - until the picture next ends.
0001C1r 2               WaitFrame:
0001C1r 2  2C 01 9C       bit VC_STATUS                     ; bit 7 is the end-of-frame flag
0001C4r 2  10 FB          bpl WaitFrame
0001C6r 2  60             rts
0001C7r 2               
0001C7r 2               WaitFrames:
0001C7r 2  AA             tax
0001C8r 2               @loop:
0001C8r 2  DA             phx
0001C9r 2  20 rr rr       jsr WaitFrame
0001CCr 2  FA             plx
0001CDr 2  CA             dex
0001CEr 2  D0 F8          bne @loop
0001D0r 2  60             rts
0001D1r 2               
0001D1r 2               ; CopyVram - T1:T0 bytes from (PTR0) to where the chip points.
0001D1r 2               CopyVram:
0001D1r 2  A6 41          ldx T1
0001D3r 2  F0 0F          beq @tail
0001D5r 2  A0 00          ldy #0
0001D7r 2               @page:
0001D7r 2  B1 48          lda (PTR0),y
0001D9r 2  8D 00 9C       sta VC_DATA
0001DCr 2  C8             iny
0001DDr 2  D0 F8          bne @page
0001DFr 2  E6 49          inc PTR0+1
0001E1r 2  CA             dex
0001E2r 2  D0 F3          bne @page
0001E4r 2               @tail:
0001E4r 2  A0 00          ldy #0
0001E6r 2               @last:
0001E6r 2  C4 40          cpy T0
0001E8r 2  F0 08          beq @done
0001EAr 2  B1 48          lda (PTR0),y
0001ECr 2  8D 00 9C       sta VC_DATA
0001EFr 2  C8             iny
0001F0r 2  80 F4          bra @last
0001F2r 2               @done:
0001F2r 2  60             rts
0001F3r 2               
0001F3r 2               ; FillVram - T1:T0 bytes of A where the chip points.
0001F3r 2               FillVram:
0001F3r 2  A6 41          ldx T1
0001F5r 2  F0 0B          beq @tail
0001F7r 2  A0 00          ldy #0
0001F9r 2               @page:
0001F9r 2  8D 00 9C       sta VC_DATA
0001FCr 2  C8             iny
0001FDr 2  D0 FA          bne @page
0001FFr 2  CA             dex
000200r 2  D0 F7          bne @page
000202r 2               @tail:
000202r 2  A4 40          ldy T0
000204r 2  F0 06          beq @done
000206r 2               @last:
000206r 2  8D 00 9C       sta VC_DATA
000209r 2  88             dey
00020Ar 2  D0 FA          bne @last
00020Cr 2               @done:
00020Cr 2  60             rts
00020Dr 2               
00020Dr 2               ; VideoInit - set the card up and load the board, sprites and font.
00020Dr 2               VideoInit:
00020Dr 2  A0 00          ldy #0
00020Fr 2               @regs:
00020Fr 2  BE rr rr       ldx VideoRegs,y
000212r 2  B9 rr rr       lda VideoRegs+1,y
000215r 2  20 rr rr       jsr VReg
000218r 2  C8             iny
000219r 2  C8             iny
00021Ar 2  C0 36          cpy #VIDEO_REGS
00021Cr 2  D0 F1          bne @regs
00021Er 2               
00021Er 2                 ; The palette lives at $FC00, in the top bank of video memory
00021Er 2  A9 03          lda #3
000220r 2  A2 08          ldx #VC_REG_VBANK
000222r 2  20 rr rr       jsr VReg
000225r 2  A9 02          lda #$02
000227r 2  A2 3C          ldx #$3C
000229r 2  20 rr rr       jsr VAddr
00022Cr 2  A0 00          ldy #0
00022Er 2               @board:
00022Er 2  B9 rr rr       lda PaletteBoard,y
000231r 2  8D 00 9C       sta VC_DATA
000234r 2  C8             iny
000235r 2  C0 08          cpy #8
000237r 2  D0 F5          bne @board
000239r 2  A9 A0          lda #$A0
00023Br 2  A2 3D          ldx #$3D                          ; sub-palette 4 of the top quarter: $FDA0
00023Dr 2  20 rr rr       jsr VAddr
000240r 2  A0 02          ldy #2
000242r 2               @inks:
000242r 2  9C 00 9C       stz VC_DATA                       ; value 0 is never drawn
000245r 2  9C 00 9C       stz VC_DATA
000248r 2  A2 02          ldx #2
00024Ar 2               @twice:
00024Ar 2  B9 rr rr       lda PaletteInks,y                 ; values 1 and 2: the ink
00024Dr 2  8D 00 9C       sta VC_DATA
000250r 2  B9 rr rr       lda PaletteInks+1,y
000253r 2  8D 00 9C       sta VC_DATA
000256r 2  CA             dex
000257r 2  D0 F1          bne @twice
000259r 2  AD rr rr       lda PaletteInks+2                 ; value 3: the dark
00025Cr 2  8D 00 9C       sta VC_DATA
00025Fr 2  AD rr rr       lda PaletteInks+3
000262r 2  8D 00 9C       sta VC_DATA
000265r 2  C8             iny
000266r 2  C8             iny
000267r 2  C0 1A          cpy #26
000269r 2  D0 D7          bne @inks
00026Br 2               
00026Br 2                 ; The sprites, from their bank, to $4000
00026Br 2  A9 01          lda #1
00026Dr 2  A2 08          ldx #VC_REG_VBANK
00026Fr 2  20 rr rr       jsr VReg
000272r 2  A9 02          lda #2
000274r 2  20 rr rr       jsr SetBank
000277r 2  A9 00          lda #0
000279r 2  AA             tax
00027Ar 2  20 rr rr       jsr VAddr
00027Dr 2  A9 rr          lda #<SpriteData
00027Fr 2  85 48          sta PTR0
000281r 2  A9 rr          lda #>SpriteData
000283r 2  85 49          sta PTR0+1
000285r 2  A9 00          lda #<(SPRITE_COUNT * 128)
000287r 2  85 40          sta T0
000289r 2  A9 1D          lda #>(SPRITE_COUNT * 128)
00028Br 2  85 41          sta T1
00028Dr 2  20 rr rr       jsr CopyVram
000290r 2  A9 00          lda #0
000292r 2  A2 08          ldx #VC_REG_VBANK
000294r 2  20 rr rr       jsr VReg
000297r 2               
000297r 2                 ; The board's name table and tiles
000297r 2  A9 01          lda #1
000299r 2  20 rr rr       jsr SetBank
00029Cr 2  A9 00          lda #<V_L0NAME
00029Er 2  A2 00          ldx #>V_L0NAME
0002A0r 2  20 rr rr       jsr VAddr
0002A3r 2  A9 rr          lda #<BoardMap
0002A5r 2  85 48          sta PTR0
0002A7r 2  A9 rr          lda #>BoardMap
0002A9r 2  85 49          sta PTR0+1
0002ABr 2  A9 B0          lda #<1200
0002ADr 2  85 40          sta T0
0002AFr 2  A9 04          lda #>1200
0002B1r 2  85 41          sta T1
0002B3r 2  20 rr rr       jsr CopyVram
0002B6r 2  A9 00          lda #<V_L0PAT
0002B8r 2  A2 38          ldx #>V_L0PAT
0002BAr 2  20 rr rr       jsr VAddr
0002BDr 2  A9 rr          lda #<BoardTiles
0002BFr 2  85 48          sta PTR0
0002C1r 2  A9 rr          lda #>BoardTiles
0002C3r 2  85 49          sta PTR0+1
0002C5r 2  A9 40          lda #<(BOARD_TILES * 16)
0002C7r 2  85 40          sta T0
0002C9r 2  A9 07          lda #>(BOARD_TILES * 16)
0002CBr 2  85 41          sta T1
0002CDr 2  20 rr rr       jsr CopyVram
0002D0r 2  A9 00          lda #0
0002D2r 2  20 rr rr       jsr SetBank
0002D5r 2               
0002D5r 2                 ; The card's own font, loaded where it stays to be read (lands at the frame end)
0002D5r 2  A9 80          lda #$80
0002D7r 2  A2 30          ldx #VC_REG_FONT
0002D9r 2  20 rr rr       jsr VReg
0002DCr 2  A9 03          lda #3
0002DEr 2  20 rr rr       jsr WaitFrames
0002E1r 2  A9 04          lda #>V_L1PAT >> 3
0002E3r 2  A2 1A          ldx #VC_REG_L1PAT
0002E5r 2  20 rr rr       jsr VReg
0002E8r 2  A9 11          lda #VC_LCTRL_2BPP | VC_LCTRL_ATTR_CELL | VC_LCTRL_ENABLE
0002EAr 2  A2 1D          ldx #VC_REG_L1CTRL
0002ECr 2  20 rr rr       jsr VReg
0002EFr 2               
0002EFr 2                 ; Pattern 0 blank, then the hull bar cells over patterns 1..9
0002EFr 2  A9 00          lda #<V_L1PAT
0002F1r 2  A2 20          ldx #>V_L1PAT
0002F3r 2  20 rr rr       jsr VAddr
0002F6r 2  A2 10          ldx #16
0002F8r 2               @blank:
0002F8r 2  9C 00 9C       stz VC_DATA
0002FBr 2  CA             dex
0002FCr 2  D0 FA          bne @blank
0002FEr 2  64 B7          stz RC
000300r 2               @bar:
000300r 2  A9 00          lda #0
000302r 2  20 rr rr       jsr PutRow
000305r 2  A9 00          lda #0
000307r 2  20 rr rr       jsr PutRow
00030Ar 2  A4 B7          ldy RC
00030Cr 2  B9 rr rr       lda BarMasks,y
00030Fr 2  20 rr rr       jsr PutRow
000312r 2  A4 B7          ldy RC
000314r 2  B9 rr rr       lda BarMasks,y
000317r 2  20 rr rr       jsr PutRow
00031Ar 2  A4 B7          ldy RC
00031Cr 2  B9 rr rr       lda BarMasks,y
00031Fr 2  20 rr rr       jsr PutRow
000322r 2  A9 00          lda #0
000324r 2  20 rr rr       jsr PutRow
000327r 2  A4 B7          ldy RC
000329r 2  B9 rr rr       lda BarMasks,y                    ; a dotted line shows the bar's length
00032Cr 2  09 AA          ora #$AA
00032Er 2  20 rr rr       jsr PutRow
000331r 2  A9 00          lda #0
000333r 2  20 rr rr       jsr PutRow
000336r 2  E6 B7          inc RC
000338r 2  A5 B7          lda RC
00033Ar 2  C9 09          cmp #9
00033Cr 2  D0 C2          bne @bar
00033Er 2  A2 10          ldx #16                           ; pattern 10: solid
000340r 2  A9 FF          lda #$FF
000342r 2               @solid:
000342r 2  8D 00 9C       sta VC_DATA
000345r 2  CA             dex
000346r 2  D0 FA          bne @solid
000348r 2               
000348r 2                 ; The text: the font's characters as 2-bit patterns
000348r 2  A9 20          lda #32
00034Ar 2  85 B7          sta RC
00034Cr 2               @glyph:
00034Cr 2  A5 B7          lda RC
00034Er 2  20 rr rr       jsr ReadGlyph
000351r 2  A5 B7          lda RC
000353r 2  0A             asl a
000354r 2  0A             asl a
000355r 2  0A             asl a
000356r 2  0A             asl a
000357r 2  48             pha
000358r 2  A5 B7          lda RC
00035Ar 2  4A             lsr a
00035Br 2  4A             lsr a
00035Cr 2  4A             lsr a
00035Dr 2  4A             lsr a
00035Er 2  18             clc
00035Fr 2  69 20          adc #>V_L1PAT
000361r 2  AA             tax
000362r 2  68             pla
000363r 2  20 rr rr       jsr VAddr
000366r 2  64 B8          stz RR
000368r 2               @row:
000368r 2  A4 B8          ldy RR
00036Ar 2  B9 F8 08       lda GLYPH,y
00036Dr 2  20 rr rr       jsr PutRow
000370r 2  E6 B8          inc RR
000372r 2  A5 B8          lda RR
000374r 2  C9 08          cmp #8
000376r 2  D0 F0          bne @row
000378r 2  E6 B7          inc RC
00037Ar 2  10 D0          bpl @glyph                        ; through 127
00037Cr 2                 ; alpha and omega, for the teams' marks
00037Cr 2  A9 E0          lda #224
00037Er 2  A2 B0          ldx #PAT_ALPHA * 16
000380r 2  20 rr rr       jsr GlyphTile
000383r 2  A9 EA          lda #234
000385r 2  A2 C0          ldx #(PAT_ALPHA + 1) * 16
000387r 2  20 rr rr       jsr GlyphTile
00038Ar 2               
00038Ar 2  20 rr rr       jsr CanvasReset
00038Dr 2  20 rr rr       jsr ClearLayer1
000390r 2  20 rr rr       jsr HideSprites
000393r 2  20 rr rr       jsr UploadSprites
000396r 2  A9 42          lda #$42                          ; display on, 16x16 sprites
000398r 2  A2 01          ldx #VC_REG_MODE1
00039Ar 2  4C rr rr       jmp VReg
00039Dr 2               
00039Dr 2               ; GlyphTile - font character A as a 2-bit tile, at offset X in the patterns.
00039Dr 2               GlyphTile:
00039Dr 2  DA             phx
00039Er 2  20 rr rr       jsr ReadGlyph
0003A1r 2  68             pla
0003A2r 2  A2 20          ldx #>V_L1PAT
0003A4r 2  20 rr rr       jsr VAddr
0003A7r 2  64 B8          stz RR
0003A9r 2               @row:
0003A9r 2  A4 B8          ldy RR
0003ABr 2  B9 F8 08       lda GLYPH,y
0003AEr 2  20 rr rr       jsr PutRow
0003B1r 2  E6 B8          inc RR
0003B3r 2  A5 B8          lda RR
0003B5r 2  C9 08          cmp #8
0003B7r 2  D0 F0          bne @row
0003B9r 2  60             rts
0003BAr 2               
0003BAr 2               ; PutRow - a row of 8 one-bit pixels, A, as 2-bit pixels of value 1.
0003BAr 2               PutRow:
0003BAr 2  48             pha
0003BBr 2  4A             lsr a
0003BCr 2  4A             lsr a
0003BDr 2  4A             lsr a
0003BEr 2  4A             lsr a
0003BFr 2  AA             tax
0003C0r 2  BD rr rr       lda Nibble2,x
0003C3r 2  8D 00 9C       sta VC_DATA
0003C6r 2  68             pla
0003C7r 2  29 0F          and #$0F
0003C9r 2  AA             tax
0003CAr 2  BD rr rr       lda Nibble2,x
0003CDr 2  8D 00 9C       sta VC_DATA
0003D0r 2  60             rts
0003D1r 2               
0003D1r 2               ; CanvasColors - the canvas's sub-palettes take the seats' inks: values 1 and 2 are
0003D1r 2               ; ships 1 and 2 in both, value 3 is ship 3 in one and ship 4 in the other.
0003D1r 2               CanvasColors:
0003D1r 2  A9 03          lda #3
0003D3r 2  A2 08          ldx #VC_REG_VBANK
0003D5r 2  20 rr rr       jsr VReg
0003D8r 2  A9 A2          lda #$A2                          ; sub-palette 4, value 1
0003DAr 2  A2 3D          ldx #$3D
0003DCr 2  20 rr rr       jsr VAddr
0003DFr 2  AD 08 08       lda SHIP_INK
0003E2r 2  20 rr rr       jsr PutInk
0003E5r 2  AD 09 08       lda SHIP_INK+1
0003E8r 2  20 rr rr       jsr PutInk
0003EBr 2  AD 0A 08       lda SHIP_INK+2
0003EEr 2  20 rr rr       jsr PutInk
0003F1r 2  A9 F2          lda #$F2                          ; sub-palette 14, value 1
0003F3r 2  A2 3D          ldx #$3D
0003F5r 2  20 rr rr       jsr VAddr
0003F8r 2  AD 08 08       lda SHIP_INK
0003FBr 2  20 rr rr       jsr PutInk
0003FEr 2  AD 09 08       lda SHIP_INK+1
000401r 2  20 rr rr       jsr PutInk
000404r 2  AD 0B 08       lda SHIP_INK+3
000407r 2  20 rr rr       jsr PutInk
00040Ar 2  A9 00          lda #0
00040Cr 2  A2 08          ldx #VC_REG_VBANK
00040Er 2  4C rr rr       jmp VReg
000411r 2               
000411r 2               PutInk:
000411r 2  0A             asl a
000412r 2  A8             tay
000413r 2  B9 rr rr       lda PaletteInks,y
000416r 2  8D 00 9C       sta VC_DATA
000419r 2  B9 rr rr       lda PaletteInks+1,y
00041Cr 2  8D 00 9C       sta VC_DATA
00041Fr 2  60             rts
000420r 2               
000420r 2               ; SetPen - canvas drawing from here on is in ship X's color. Keeps X.
000420r 2               SetPen:
000420r 2  BD rr rr       lda PenValue,x
000423r 2  85 51          sta PINK
000425r 2  BD rr rr       lda PenSub,x
000428r 2  85 A0          sta PATTR
00042Ar 2  60             rts
00042Br 2               
00042Br 2               PenValue:
00042Br 2  01 02 03 03    .byte 1, 2, 3, 3
00042Fr 2               PenSub:
00042Fr 2  04 04 04 0E    .byte CANVAS_SUB, CANVAS_SUB, CANVAS_SUB, CANVAS_B
000433r 2               
000433r 2               ; ClearLayer1 - no text, no canvas.
000433r 2               ClearLayer1:
000433r 2  20 rr rr       jsr CanvasReset
000436r 2  A9 00          lda #<V_L1NAME
000438r 2  A2 08          ldx #>V_L1NAME
00043Ar 2  20 rr rr       jsr VAddr
00043Dr 2  A9 B0          lda #<1200
00043Fr 2  85 40          sta T0
000441r 2  A9 04          lda #>1200
000443r 2  85 41          sta T1
000445r 2  A9 00          lda #0
000447r 2  20 rr rr       jsr FillVram
00044Ar 2  A9 00          lda #<V_L1ATTR
00044Cr 2  A2 10          ldx #>V_L1ATTR
00044Er 2  20 rr rr       jsr VAddr
000451r 2  A9 B0          lda #<1200
000453r 2  85 40          sta T0
000455r 2  A9 04          lda #>1200
000457r 2  85 41          sta T1
000459r 2  A9 00          lda #0
00045Br 2  4C rr rr       jmp FillVram
00045Er 2               
00045Er 2               ; --- Text ---
00045Er 2               
00045Er 2               ; LineStart / LineChar / LineStr / LineNum build a line in LINEBUF.
00045Er 2               LineStart:
00045Er 2  64 7B          stz LINE_N
000460r 2  9C E0 08       stz LINEBUF
000463r 2  60             rts
000464r 2               
000464r 2               ; LineChar - add character A. Keeps Y.
000464r 2               LineChar:
000464r 2  A6 7B          ldx LINE_N
000466r 2  9D E0 08       sta LINEBUF,x
000469r 2  9E E1 08       stz LINEBUF+1,x
00046Cr 2  E6 7B          inc LINE_N
00046Er 2  60             rts
00046Fr 2               
00046Fr 2               ; LineStr - add the string X (low), Y (high).
00046Fr 2               LineStr:
00046Fr 2  86 79          stx TXT_PTR
000471r 2  84 7A          sty TXT_PTR+1
000473r 2  A0 00          ldy #0
000475r 2               @loop:
000475r 2  B1 79          lda (TXT_PTR),y
000477r 2  F0 06          beq @done
000479r 2  20 rr rr       jsr LineChar
00047Cr 2  C8             iny
00047Dr 2  80 F6          bra @loop
00047Fr 2               @done:
00047Fr 2  60             rts
000480r 2               
000480r 2               ; LineNum - add A as a number with no leading spaces.
000480r 2               LineNum:
000480r 2  20 rr rr       jsr NumToText
000483r 2  A0 00          ldy #0
000485r 2               @skip:
000485r 2  B9 A2 00       lda DIGITS,y
000488r 2  C9 20          cmp #' '
00048Ar 2  D0 03          bne @digits
00048Cr 2  C8             iny
00048Dr 2  80 F6          bra @skip
00048Fr 2               @digits:
00048Fr 2  B9 A2 00       lda DIGITS,y
000492r 2  F0 06          beq @done
000494r 2  20 rr rr       jsr LineChar
000497r 2  C8             iny
000498r 2  80 F5          bra @digits
00049Ar 2               @done:
00049Ar 2  60             rts
00049Br 2               
00049Br 2               ; LineShow - LINEBUF on panel row A in TXT_INK.
00049Br 2               LineShow:
00049Br 2  A2 E0          ldx #<LINEBUF
00049Dr 2  A0 08          ldy #>LINEBUF
00049Fr 2                 ; falls through
00049Fr 2               
00049Fr 2               ; Print - the string X (low), Y (high) on panel row A in TXT_INK, padded to
00049Fr 2               ; the panel's width.
00049Fr 2               Print:
00049Fr 2  86 79          stx TXT_PTR
0004A1r 2  84 7A          sty TXT_PTR+1
0004A3r 2  AA             tax
0004A4r 2  BD rr rr       lda RowLo,x
0004A7r 2  18             clc
0004A8r 2  69 1D          adc #PANEL_COL
0004AAr 2  85 40          sta T0
0004ACr 2  BD rr rr       lda RowHi,x
0004AFr 2  69 00          adc #0
0004B1r 2  85 41          sta T1
0004B3r 2                 ; the characters
0004B3r 2  A5 41          lda T1
0004B5r 2  18             clc
0004B6r 2  69 08          adc #>V_L1NAME
0004B8r 2  AA             tax
0004B9r 2  A5 40          lda T0
0004BBr 2  20 rr rr       jsr VAddr
0004BEr 2  A0 00          ldy #0
0004C0r 2               @char:
0004C0r 2  B1 79          lda (TXT_PTR),y
0004C2r 2  F0 0A          beq @pad
0004C4r 2  8D 00 9C       sta VC_DATA
0004C7r 2  C8             iny
0004C8r 2  C0 0B          cpy #PANEL_W
0004CAr 2  D0 F4          bne @char
0004CCr 2  80 0A          bra @color
0004CEr 2               @pad:
0004CEr 2  A9 20          lda #' '
0004D0r 2  8D 00 9C       sta VC_DATA
0004D3r 2  C8             iny
0004D4r 2  C0 0B          cpy #PANEL_W
0004D6r 2  D0 F6          bne @pad
0004D8r 2               @color:
0004D8r 2  A5 41          lda T1
0004DAr 2  18             clc
0004DBr 2  69 10          adc #>V_L1ATTR
0004DDr 2  AA             tax
0004DEr 2  A5 40          lda T0
0004E0r 2  20 rr rr       jsr VAddr
0004E3r 2  A5 78          lda TXT_INK                       ; its sub-palette
0004E5r 2  18             clc
0004E6r 2  69 03          adc #3
0004E8r 2  A0 0B          ldy #PANEL_W
0004EAr 2               @ink:
0004EAr 2  8D 00 9C       sta VC_DATA
0004EDr 2  88             dey
0004EEr 2  D0 FA          bne @ink
0004F0r 2  60             rts
0004F1r 2               
0004F1r 2               ; PanelClear - blank panel row A.
0004F1r 2               PanelClear:
0004F1r 2  A2 rr          ldx #<TxtNone
0004F3r 2  A0 rr          ldy #>TxtNone
0004F5r 2  4C rr rr       jmp Print
0004F8r 2               TxtNone:
0004F8r 2  00             .byte 0
0004F9r 2               
0004F9r 2               ; --- Sprites ---
0004F9r 2               
0004F9r 2               HideSprites:
0004F9r 2  A2 26          ldx #NUM_SLOTS - 1
0004FBr 2               @loop:
0004FBr 2  A9 F0          lda #HIDE_Y
0004FDr 2  9D 00 0A       sta SPR_Y,x
000500r 2  9E 40 0A       stz SPR_X,x
000503r 2  9E 80 0A       stz SPR_N,x
000506r 2  9E C0 0A       stz SPR_A,x
000509r 2  CA             dex
00050Ar 2  10 EF          bpl @loop
00050Cr 2  60             rts
00050Dr 2               
00050Dr 2               HideSprite:
00050Dr 2  A9 F0          lda #HIDE_Y
00050Fr 2  9D 00 0A       sta SPR_Y,x
000512r 2  60             rts
000513r 2               
000513r 2               ; PlaceSprite - slot X centered on (HX, HY), pattern A, attribute Y.
000513r 2               PlaceSprite:
000513r 2  9D 80 0A       sta SPR_N,x
000516r 2  98             tya
000517r 2  9D C0 0A       sta SPR_A,x
00051Ar 2  A5 7F          lda HX
00051Cr 2  38             sec
00051Dr 2  E9 08          sbc #8
00051Fr 2  9D 40 0A       sta SPR_X,x
000522r 2  A5 80          lda HY
000524r 2  38             sec
000525r 2  E9 08          sbc #8
000527r 2  9D 00 0A       sta SPR_Y,x
00052Ar 2  60             rts
00052Br 2               
00052Br 2               UploadSprites:
00052Br 2  A9 00          lda #<V_SPRATTR
00052Dr 2  A2 16          ldx #>V_SPRATTR
00052Fr 2  20 rr rr       jsr VAddr
000532r 2  A2 00          ldx #0
000534r 2               @slot:
000534r 2  BD 00 0A       lda SPR_Y,x
000537r 2  8D 00 9C       sta VC_DATA
00053Ar 2  BD 40 0A       lda SPR_X,x
00053Dr 2  8D 00 9C       sta VC_DATA
000540r 2  BD 80 0A       lda SPR_N,x
000543r 2  8D 00 9C       sta VC_DATA
000546r 2  BD C0 0A       lda SPR_A,x
000549r 2  8D 00 9C       sta VC_DATA
00054Cr 2  E8             inx
00054Dr 2  E0 27          cpx #NUM_SLOTS
00054Fr 2  D0 E3          bne @slot
000551r 2  60             rts
