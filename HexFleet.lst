0008F6r 2  18             clc
0008F7r 2  69 01          adc #1
0008F9r 2  85 56          sta PROD
0008FBr 2  A5 57          lda PROD+1
0008FDr 2  49 FF          eor #$FF
0008FFr 2  69 00          adc #0
000901r 2  85 57          sta PROD+1
000903r 2  60             rts
000904r 2               
000904r 2               ; Div16 - DIVIDEND (16-bit) / DIVISOR (8-bit, not 0) into QUOT (16-bit) and
000904r 2               ; REM. Clobbers A, X, DIVIDEND.
000904r 2               Div16:
000904r 2  A9 00          lda #0
000906r 2  A2 10          ldx #16
000908r 2               @loop:
000908r 2  06 58          asl DIVIDEND
00090Ar 2  26 59          rol DIVIDEND+1
00090Cr 2  2A             rol a
00090Dr 2  B0 04          bcs @sub                         ; remainder passed 255: it's over DIVISOR
00090Fr 2  C5 5A          cmp DIVISOR
000911r 2  90 04          bcc @skip
000913r 2               @sub:
000913r 2  E5 5A          sbc DIVISOR                      ; carry is set either way
000915r 2  E6 58          inc DIVIDEND                     ; this quotient bit is 1
000917r 2               @skip:
000917r 2  CA             dex
000918r 2  D0 EE          bne @loop
00091Ar 2  85 5D          sta REM
00091Cr 2  A5 58          lda DIVIDEND
00091Er 2  85 5B          sta QUOT
000920r 2  A5 59          lda DIVIDEND+1
000922r 2  85 5C          sta QUOT+1
000924r 2  60             rts
000925r 2               
000925r 2               ; Isqrt - square root of SQRT_IN (16-bit, under 16384), rounded down, in A.
000925r 2               ; Clobbers X.
000925r 2               Isqrt:
000925r 2  64 DF          stz SQ_R
000927r 2  A9 80          lda #$80
000929r 2  85 E0          sta SQ_BIT
00092Br 2               @loop:
00092Br 2  A5 DF          lda SQ_R
00092Dr 2  05 E0          ora SQ_BIT
00092Fr 2  85 E1          sta SQ_T
000931r 2  AA             tax
000932r 2  20 rr rr       jsr Mul8
000935r 2  A5 57          lda PROD+1                       ; keep the bit if SQ_T squared <= SQRT_IN
000937r 2  C5 5F          cmp SQRT_IN+1
000939r 2  90 0A          bcc @take
00093Br 2  D0 0C          bne @skip
00093Dr 2  A5 56          lda PROD
00093Fr 2  C5 5E          cmp SQRT_IN
000941r 2  F0 02          beq @take
000943r 2  B0 04          bcs @skip
000945r 2               @take:
000945r 2  A5 E1          lda SQ_T
000947r 2  85 DF          sta SQ_R
000949r 2               @skip:
000949r 2  46 E0          lsr SQ_BIT
00094Br 2  D0 DE          bne @loop
00094Dr 2  A5 DF          lda SQ_R
00094Fr 2  60             rts
000950r 2               
000950r 2               ; Abs8 - A = |A| for a signed byte.
000950r 2               Abs8:
000950r 2  10 05          bpl @done
000952r 2  49 FF          eor #$FF
000954r 2  18             clc
000955r 2  69 01          adc #1
000957r 2               @done:
000957r 2  60             rts
000958r 2               
000958r 2               ; ScaleDir - shrink the vector SD_DX, SD_DY (signed 16-bit, each under 256
000958r 2               ; in size) until both fit under 64, keeping its direction, into DIRX, DIRY.
000958r 2               ; Z is set if the vector is zero. Clobbers A, X.
000958r 2               ScaleDir:
000958r 2  64 CD          stz SD_NX
00095Ar 2  64 CE          stz SD_NY
00095Cr 2  A5 C8          lda SD_DX+1
00095Er 2  10 0B          bpl @xPos
000960r 2  A5 C7          lda SD_DX
000962r 2  49 FF          eor #$FF
000964r 2  18             clc
000965r 2  69 01          adc #1
000967r 2  E6 CD          inc SD_NX
000969r 2  80 02          bra @xDone
00096Br 2               @xPos:
00096Br 2  A5 C7          lda SD_DX
00096Dr 2               @xDone:
00096Dr 2  85 CB          sta SD_AX
00096Fr 2  A5 CA          lda SD_DY+1
000971r 2  10 0B          bpl @yPos
000973r 2  A5 C9          lda SD_DY
000975r 2  49 FF          eor #$FF
000977r 2  18             clc
000978r 2  69 01          adc #1
00097Ar 2  E6 CE          inc SD_NY
00097Cr 2  80 02          bra @yDone
00097Er 2               @yPos:
00097Er 2  A5 C9          lda SD_DY
000980r 2               @yDone:
000980r 2  85 CC          sta SD_AY
000982r 2               @shrink:
000982r 2  A5 CB          lda SD_AX
000984r 2  05 CC          ora SD_AY
000986r 2  29 C0          and #$C0
000988r 2  F0 06          beq @fits
00098Ar 2  46 CB          lsr SD_AX
00098Cr 2  46 CC          lsr SD_AY
00098Er 2  80 F2          bra @shrink
000990r 2               @fits:
000990r 2  A5 CB          lda SD_AX
000992r 2  A6 CD          ldx SD_NX
000994r 2  F0 05          beq @setX
000996r 2  49 FF          eor #$FF
000998r 2  18             clc
000999r 2  69 01          adc #1
00099Br 2               @setX:
00099Br 2  85 90          sta DIRX
00099Dr 2  A5 CC          lda SD_AY
00099Fr 2  A6 CE          ldx SD_NY
0009A1r 2  F0 05          beq @setY
0009A3r 2  49 FF          eor #$FF
0009A5r 2  18             clc
0009A6r 2  69 01          adc #1
0009A8r 2               @setY:
0009A8r 2  85 91          sta DIRY
0009AAr 2  A5 CB          lda SD_AX
0009ACr 2  05 CC          ora SD_AY
0009AEr 2  60             rts
0009AFr 2               
0009AFr 2               ; DirLength - LEN = length of (DIRX, DIRY). Clobbers A, X.
0009AFr 2               DirLength:
0009AFr 2  A5 90          lda DIRX
0009B1r 2  20 rr rr       jsr Abs8
0009B4r 2  AA             tax
0009B5r 2  20 rr rr       jsr Mul8
0009B8r 2  A5 56          lda PROD
0009BAr 2  85 5E          sta SQRT_IN
0009BCr 2  A5 57          lda PROD+1
0009BEr 2  85 5F          sta SQRT_IN+1
0009C0r 2  A5 91          lda DIRY
0009C2r 2  20 rr rr       jsr Abs8
0009C5r 2  AA             tax
0009C6r 2  20 rr rr       jsr Mul8
0009C9r 2  A5 56          lda PROD
0009CBr 2  18             clc
0009CCr 2  65 5E          adc SQRT_IN
0009CEr 2  85 5E          sta SQRT_IN
0009D0r 2  A5 57          lda PROD+1
0009D2r 2  65 5F          adc SQRT_IN+1
0009D4r 2  85 5F          sta SQRT_IN+1
0009D6r 2  20 rr rr       jsr Isqrt
0009D9r 2  85 92          sta LEN
0009DBr 2  60             rts
0009DCr 2               
0009DCr 2               ; NumToText - A (0..255) as three characters, leading spaces, in DIGITS.
0009DCr 2               NumToText:
0009DCr 2  85 CF          sta NT_V
0009DEr 2  A2 20          ldx #' '
0009E0r 2  86 A2          stx DIGITS
0009E2r 2  86 A3          stx DIGITS+1
0009E4r 2  64 A5          stz DIGITS+3
0009E6r 2  A2 00          ldx #0                           ; hundreds
0009E8r 2               @hundreds:
0009E8r 2  C9 64          cmp #100
0009EAr 2  90 05          bcc @tens
0009ECr 2  E9 64          sbc #100
0009EEr 2  E8             inx
0009EFr 2  80 F7          bra @hundreds
0009F1r 2               @tens:
0009F1r 2  E0 00          cpx #0
0009F3r 2  F0 07          beq @noHundreds
0009F5r 2  48             pha
0009F6r 2  8A             txa
0009F7r 2  09 30          ora #'0'
0009F9r 2  85 A2          sta DIGITS
0009FBr 2  68             pla
0009FCr 2               @noHundreds:
0009FCr 2  A2 00          ldx #0
0009FEr 2               @tensLoop:
0009FEr 2  C9 0A          cmp #10
000A00r 2  90 05          bcc @ones
000A02r 2  E9 0A          sbc #10
000A04r 2  E8             inx
000A05r 2  80 F7          bra @tensLoop
000A07r 2               @ones:
000A07r 2  09 30          ora #'0'
000A09r 2  85 A4          sta DIGITS+2
000A0Br 2  E0 00          cpx #0
000A0Dr 2  D0 06          bne @setTens
000A0Fr 2  A5 A2          lda DIGITS                       ; a zero tens digit shows only after hundreds
000A11r 2  C9 20          cmp #' '
000A13r 2  F0 05          beq @done
000A15r 2               @setTens:
000A15r 2  8A             txa
000A16r 2  09 30          ora #'0'
000A18r 2  85 A3          sta DIGITS+1
000A1Ar 2               @done:
000A1Ar 2  60             rts
000A1Br 2               
000A1Br 1               .include "src/hex.asm"
000A1Br 2               ; =============================================================================
000A1Br 2               ;   hex.asm - the board's hexes: centers, row lengths, distance, headings
000A1Br 2               ; =============================================================================
000A1Br 2               ;   The board is the app's: 15 rows of pointy hexes. A hex is (C, R): row R
000A1Br 2               ;   0..14 from the top, column C from the left. Even rows hold 10 hexes and
000A1Br 2               ;   sit half a hex to the right; odd rows hold 11. Hexes are 20 pixels wide
000A1Br 2               ;   and rows 15 pixels apart.
000A1Br 2               ; =============================================================================
000A1Br 2               
000A1Br 2               .segment "CART"
000A1Br 2               
000A1Br 2               ; floor((R - 7) / 2) for each row: turns (C, R) into the engine's axial q
000A1Br 2               FloorHalf:
000A1Br 2  FC FD FD FE    .byte $FC, $FD, $FD, $FE, $FE, $FF, $FF, 0, 0, 1, 1, 2, 2, 3, 3
000A1Fr 2  FE FF FF 00  
000A23r 2  00 01 01 02  
000A2Ar 2               
000A2Ar 2               ; HexCenter - X = column, Y = row: the center pixel in HX, HY. Keeps X, Y.
000A2Ar 2               HexCenter:
000A2Ar 2  84 E2          sty HC_T
000A2Cr 2  98             tya
000A2Dr 2  0A             asl a
000A2Er 2  0A             asl a
000A2Fr 2  0A             asl a
000A30r 2  0A             asl a                            ; 16R
000A31r 2  38             sec
000A32r 2  E5 E2          sbc HC_T                         ; 15R
000A34r 2  18             clc
000A35r 2  69 0F          adc #BOARD_Y + 10
000A37r 2  85 80          sta HY
000A39r 2  8A             txa
000A3Ar 2  0A             asl a
000A3Br 2  0A             asl a                            ; 4C
000A3Cr 2  85 E2          sta HC_T
000A3Er 2  0A             asl a
000A3Fr 2  0A             asl a                            ; 16C
000A40r 2  18             clc
000A41r 2  65 E2          adc HC_T                         ; 20C
000A43r 2  69 0E          adc #BOARD_X + 10
000A45r 2  85 7F          sta HX
000A47r 2  98             tya
000A48r 2  29 01          and #1
000A4Ar 2  D0 07          bne @done
000A4Cr 2  A5 7F          lda HX                           ; even rows sit half a hex right
000A4Er 2  18             clc
000A4Fr 2  69 0A          adc #10
000A51r 2  85 7F          sta HX
000A53r 2               @done:
000A53r 2  60             rts
000A54r 2               
000A54r 2               ; RowLen - A = row: A = hexes in it.
000A54r 2               RowLen:
000A54r 2  29 01          and #1
000A56r 2  F0 03          beq @even
000A58r 2  A9 0B          lda #11
000A5Ar 2  60             rts
000A5Br 2               @even:
000A5Br 2  A9 0A          lda #10
000A5Dr 2  60             rts
000A5Er 2               
000A5Er 2               ; HexDist - hexes between (HD_C1, HD_R1) and (HD_C2, HD_R2), in A.
000A5Er 2               ; Clobbers X.
000A5Er 2               HexDist:
000A5Er 2  A6 B1          ldx HD_R1
000A60r 2  A5 B0          lda HD_C1
000A62r 2  38             sec
000A63r 2  FD rr rr       sbc FloorHalf,x
000A66r 2  85 B4          sta HD_Q                         ; q1
000A68r 2  A6 B3          ldx HD_R2
000A6Ar 2  A5 B2          lda HD_C2
000A6Cr 2  38             sec
000A6Dr 2  FD rr rr       sbc FloorHalf,x                  ; q2
000A70r 2  85 B6          sta HD_S
000A72r 2  A5 B4          lda HD_Q
000A74r 2  38             sec
000A75r 2  E5 B6          sbc HD_S
000A77r 2  85 B4          sta HD_Q                         ; dq
000A79r 2  A5 B1          lda HD_R1
000A7Br 2  38             sec
000A7Cr 2  E5 B3          sbc HD_R2
000A7Er 2  85 B5          sta HD_DR                        ; dr
000A80r 2  18             clc
000A81r 2  65 B4          adc HD_Q
000A83r 2  20 rr rr       jsr Abs8                         ; |dq + dr|
000A86r 2  85 B6          sta HD_S
000A88r 2  A5 B4          lda HD_Q
000A8Ar 2  20 rr rr       jsr Abs8
000A8Dr 2  18             clc
000A8Er 2  65 B6          adc HD_S
000A90r 2  85 B6          sta HD_S
000A92r 2  A5 B5          lda HD_DR
000A94r 2  20 rr rr       jsr Abs8
000A97r 2  18             clc
000A98r 2  65 B6          adc HD_S
000A9Ar 2  4A             lsr a                            ; half of |dq| + |dr| + |dq + dr|
000A9Br 2  60             rts
000A9Cr 2               
000A9Cr 2               ; HeadingOf - heading 0..11 (0 up, then every 30 degrees clockwise) of the
000A9Cr 2               ; vector HDX, HDY (signed 16-bit pixels), in A; $FF if it's zero.
000A9Cr 2               HeadingOf:
000A9Cr 2  A5 C0          lda HDX
000A9Er 2  85 C7          sta SD_DX
000AA0r 2  A5 C1          lda HDX+1
000AA2r 2  85 C8          sta SD_DX+1
000AA4r 2  A5 C2          lda HDY
000AA6r 2  85 C9          sta SD_DY
000AA8r 2  A5 C3          lda HDY+1
000AAAr 2  85 CA          sta SD_DY+1
000AACr 2  20 rr rr       jsr ScaleDir
000AAFr 2  D0 03          bne @moving
000AB1r 2  A9 FF          lda #$FF
000AB3r 2  60             rts
000AB4r 2               @moving:
000AB4r 2  A5 90          lda DIRX
000AB6r 2  20 rr rr       jsr Abs8
000AB9r 2  85 C4          sta HG_AX
000ABBr 2  A5 91          lda DIRY
000ABDr 2  20 rr rr       jsr Abs8
000AC0r 2  85 C5          sta HG_AY
000AC2r 2                 ; how far from vertical: 0 (within 15 degrees) to 3 (horizontal)
000AC2r 2  A5 C4          lda HG_AX
000AC4r 2  0A             asl a
000AC5r 2  0A             asl a
000AC6r 2  C5 C5          cmp HG_AY
000AC8r 2  90 16          bcc @s0
000ACAr 2  F0 14          beq @s0
000ACCr 2  A5 C4          lda HG_AX
000ACEr 2  C5 C5          cmp HG_AY
000AD0r 2  90 12          bcc @s1
000AD2r 2  F0 10          beq @s1
000AD4r 2  A5 C5          lda HG_AY
000AD6r 2  0A             asl a
000AD7r 2  0A             asl a
000AD8r 2  C5 C4          cmp HG_AX
000ADAr 2  B0 0C          bcs @s2
000ADCr 2  A9 03          lda #3
000ADEr 2  80 0A          bra @sector
000AE0r 2               @s0:
000AE0r 2  A9 00          lda #0
000AE2r 2  80 06          bra @sector
000AE4r 2               @s1:
000AE4r 2  A9 01          lda #1
000AE6r 2  80 02          bra @sector
000AE8r 2               @s2:
000AE8r 2  A9 02          lda #2
000AEAr 2               @sector:
000AEAr 2  85 C6          sta HG_S
000AECr 2                 ; which quarter
000AECr 2  A5 90          lda DIRX
000AEEr 2  30 0D          bmi @left
000AF0r 2  A5 91          lda DIRY
000AF2r 2  30 06          bmi @upRight
000AF4r 2  A9 06          lda #6                           ; down and right: 6 - s
000AF6r 2  38             sec
000AF7r 2  E5 C6          sbc HG_S
000AF9r 2  60             rts
000AFAr 2               @upRight:
000AFAr 2  A5 C6          lda HG_S                         ; up and right: s
000AFCr 2  60             rts
000AFDr 2               @left:
000AFDr 2  A5 91          lda DIRY
000AFFr 2  30 06          bmi @upLeft
000B01r 2  A9 06          lda #6                           ; down and left: 6 + s
000B03r 2  18             clc
000B04r 2  65 C6          adc HG_S
000B06r 2  60             rts
000B07r 2               @upLeft:
000B07r 2  A9 0C          lda #12                          ; up and left: 12 - s, 0 for straight up
000B09r 2  38             sec
000B0Ar 2  E5 C6          sbc HG_S
000B0Cr 2  C9 0C          cmp #12
000B0Er 2  D0 02          bne @done
000B10r 2  A9 00          lda #0
000B12r 2               @done:
000B12r 2  60             rts
000B13r 2               
000B13r 1               .include "src/input.asm"
000B13r 2               ; =============================================================================
000B13r 2               ;   input.asm - joysticks and keyboard as one set of controls
000B13r 2               ; =============================================================================
000B13r 2               ;   Only one person plans at a time, so either joystick and either key
000B13r 2               ;   cluster drive the same cursor:
000B13r 2               ;     move:  stick, W A S D, or the arrow keys
000B13r 2               ;     pick:  fire (A), Space or Enter
000B13r 2               ;     swap:  B, or X on the keyboard (Laser, Torpedo, the special)
000B13r 2               ;   A held stick moves once, then repeats.
000B13r 2               ; =============================================================================
000B13r 2               
000B13r 2               .include "../../6502-Lib/include/input.inc"
000B13r 3               ; =============================================================================
000B13r 3               ;   input.inc - interface contract for shared joystick-first input polling
000B13r 3               ; =============================================================================
000B13r 3               ;
000B13r 3               ; Required caller symbols (defined by the consuming project before this
000B13r 3               ; file is .include-d):
000B13r 3               ;   HW_PRESENT, HW_GPIO, ReadJoystick1, ReadJoystick2,       ; Kernal
000B13r 3               ;   BufferSize, ReadBuffer                                     ; Kernal
000B13r 3               ;   DIR_UP, DIR_DOWN                        ; caller's own numeric values
000B13r 3               ;   DIR_LEFT, DIR_RIGHT                     ; omit both for a 2-directional
000B13r 3               ;                                            ; game (e.g. Pong) - LEFT/RIGHT
000B13r 3               ;                                            ; checks compile out
000B13r 3               ;   JOY_STATE                               ; zero page, for PollJoyCombined
000B13r 3               ;                                            ; and PollJoy1
000B13r 3               ;   JOY_STATE2                              ; zero page, for PollJoy2
000B13r 3               ;   KB_DIR, KB_FIRE                         ; zero page, for
000B13r 3               ;                                            ; DrainKeyboardCombined
000B13r 3               ;   KB_DIR_P1, KB_DIR_P2, KB_FIRE           ; zero page, for
000B13r 3               ;   KB_FIRE_P1, KB_FIRE_P2                  ; DrainKeyboardSplit
000B13r 3               ;                                            ; (KB_FIRE_P1/P2 only needed
000B13r 3               ;                                            ; by a caller that wants
000B13r 3               ;                                            ; independent per-player fire
000B13r 3               ;                                            ; - every game as of this
000B13r 3               ;                                            ; writing uses the combined
000B13r 3               ;                                            ; KB_FIRE instead)
000B13r 3               ;
000B13r 3               ; Exported routines:
000B13r 3               ;   PollJoyCombined       both joystick ports AND-combined (single-player)
000B13r 3               ;   PollJoy1 / PollJoy2   one joystick port, gated on HW_GPIO
000B13r 3               ;   DrainKeyboardCombined single-player keyboard fallback (WASD or arrows)
000B13r 3               ;   DrainKeyboardSplit    two-player keyboard fallback (WASD=P1, arrows=P2)
000B13r 3               ;   NextKey               the next key in the buffer, carry clear if none,
000B13r 3               ;                         without the echo Chrin does
000B13r 3               ;
000B13r 3               ; Fire keys: space (KEY_FIRE) is P1's/the single-player fallback; enter
000B13r 3               ; (KEY_FIRE2) is P2's. DrainKeyboardCombined accepts either interchangeably
000B13r 3               ; into one KB_FIRE flag. DrainKeyboardSplit sets both the combined KB_FIRE
000B13r 3               ; (either key, for today's shared start/pause/confirm actions) and the
000B13r 3               ; per-player KB_FIRE_P1/KB_FIRE_P2 (for a future game with independent
000B13r 3               ; per-player fire, e.g. a two-player shooter).
000B13r 3               ;
000B13r 3               ; Priority rule every caller composes for itself (see docs/INPUT.md):
000B13r 3               ;   Joystick first. If the joystick shows a direction this poll, use it and
000B13r 3               ;   ignore the keyboard entirely this poll. Only consult the keyboard's
000B13r 3               ;   drained result when the joystick shows nothing. The fire/A button is
000B13r 3               ;   OR'd (joystick A or keyboard space, either triggers), independent of
000B13r 3               ;   the direction priority.
000B13r 3               ; =============================================================================
000B13r 3               
000B13r 2               .include "../../6502-Lib/core/input.asm"
000B13r 3               ; =============================================================================
000B13r 3               ;   input.asm - shared joystick-first, keyboard-fallback input primitives
000B13r 3               ; =============================================================================
000B13r 3               ; Caller contract:
000B13r 3               ; - Consuming project defines HW_PRESENT, HW_GPIO, ReadJoystick1,
000B13r 3               ;   ReadJoystick2, BufferSize, ReadBuffer (all Kernal-provided) before
000B13r 3               ;   including this file.
000B13r 3               ; - Consuming project defines its own DIR_UP/DIR_DOWN constants (and
000B13r 3               ;   DIR_LEFT/DIR_RIGHT, only if it's a 4-directional game) at whatever
000B13r 3               ;   numeric values it already uses - this file references them by name
000B13r 3               ;   only, so Snake/LightCycles' 0/1/2/3 and Pong's 1/2 both work unchanged.
000B13r 3               ; - Consuming project defines the zero-page output bytes each routine
000B13r 3               ;   below documents (JOY_STATE, JOY_STATE2, KB_DIR, KB_DIR_P1, KB_DIR_P2,
000B13r 3               ;   KB_FIRE, and - only if calling DrainKeyboardSplit - KB_FIRE_P1,
000B13r 3               ;   KB_FIRE_P2) before including this file, at whatever address is free.
000B13r 3               ;
000B13r 3               ; Exported routines:
000B13r 3               ; - PollJoyCombined      both ports AND-combined (single-player, either port)
000B13r 3               ; - PollJoy1 / PollJoy2  a single port, gated on HW_GPIO
000B13r 3               ; - DrainKeyboardCombined  single-player keyboard fallback (WASD or arrows)
000B13r 3               ; - DrainKeyboardSplit     two-player keyboard fallback (WASD=P1, arrows=P2)
000B13r 3               ;
000B13r 3               ; This file intentionally does NOT resolve a final NEXT_DIR/START_PRESSED -
000B13r 3               ; that composition (joystick-first priority, A-button-or-space, edge
000B13r 3               ; detection) is project-specific glue that stays in each game's own
000B13r 3               ; input.asm, since the exact target variables differ per game (NEXT_DIR vs
000B13r 3               ; NEXT_P1/NEXT_P2, single-player vs split). See docs/INPUT.md for the
000B13r 3               ; priority rule every caller should follow.
000B13r 3               ; =============================================================================
000B13r 3               
000B13r 3               ; --- Joystick bits (active-low on the wire: 0 = pressed) ---
000B13r 3               JOY_A     = %00000001
000B13r 3               JOY_B     = %00000010
000B13r 3               JOY_X     = %00000100
000B13r 3               JOY_Y     = %00001000
000B13r 3               JOY_UP    = %00010000
000B13r 3               JOY_DOWN  = %00100000
000B13r 3               JOY_LEFT  = %01000000
000B13r 3               JOY_RIGHT = %10000000
000B13r 3               
000B13r 3               ; --- Keyboard fallback scancodes ---
000B13r 3               ; Kernal delivers uppercase ASCII for letter keys; arrow keys are control
000B13r 3               ; codes, not printable characters.
000B13r 3               KEY_W           = 'W'
000B13r 3               KEY_A           = 'A'
000B13r 3               KEY_S           = 'S'
000B13r 3               KEY_D           = 'D'
000B13r 3               KEY_UP_ARROW    = $1E
000B13r 3               KEY_DOWN_ARROW  = $1F
000B13r 3               KEY_LEFT_ARROW  = $1C
000B13r 3               KEY_RIGHT_ARROW = $1D
000B13r 3               KEY_FIRE        = ' '     ; space bar: P1's fire fallback (thumb-reachable
000B13r 3                                          ; from WASD's resting position; also the
000B13r 3                                          ; traditional single-player shooter fire key)
000B13r 3               KEY_FIRE2       = $0D     ; enter/return (CHAR_CR): P2's fire fallback,
000B13r 3                                          ; sits right next to the arrow-key cluster on
000B13r 3                                          ; nearly every layout. Deliberately not a
000B13r 3                                          ; modifier key (Ctrl/Shift) -- the input buffer is a plain
000B13r 3                                          ; character buffer, and modifier keys generally
000B13r 3                                          ; don't produce their own readable character,
000B13r 3                                          ; nor could left/right variants be told apart
000B13r 3                                          ; even if they did.
000B13r 3               
000B13r 3               KB_DIR_NONE = $FF          ; sentinel: no direction seen in this drain
000B13r 3               
000B13r 3               .segment "CART"
000B13r 3               
000B13r 3               ; -----------------------------------------------------------------------------
000B13r 3               ; PollJoyCombined - read both joystick ports and AND-combine them
000B13r 3               ; (active-low AND = logical OR of "pressed"), so either port drives a
000B13r 3               ; single-player game regardless of which one it's plugged into.
000B13r 3               ; Out: JOY_STATE = combined active-low byte, or $FF (idle) if no GPIO card.
000B13r 3               ; Clobbers: A
000B13r 3               ; -----------------------------------------------------------------------------
000B13r 3               PollJoyCombined:
000B13r 3  AD 0D 03       lda HW_PRESENT
000B16r 3  29 20          and #HW_GPIO
000B18r 3  D0 05          bne @haveGpio
000B1Ar 3  A9 FF          lda #$FF
000B1Cr 3  85 60          sta JOY_STATE
000B1Er 3  60             rts
000B1Fr 3               @haveGpio:
000B1Fr 3  20 48 A0       jsr ReadJoystick1
000B22r 3  85 60          sta JOY_STATE
000B24r 3  20 4B A0       jsr ReadJoystick2
000B27r 3  25 60          and JOY_STATE
000B29r 3  85 60          sta JOY_STATE
000B2Br 3  60             rts
000B2Cr 3               
000B2Cr 3               ; -----------------------------------------------------------------------------
000B2Cr 3               ; PollJoy1 / PollJoy2 - read a single joystick port, gated on HW_GPIO
000B2Cr 3               ; (ReadJoystick1/2 do not check hardware presence themselves - a floating
000B2Cr 3               ; bus reads as meaningless data with no GPIO card fitted).
000B2Cr 3               ; Out: JOY_STATE / JOY_STATE2, or $FF (idle) if no GPIO card.
000B2Cr 3               ; Clobbers: A
000B2Cr 3               ; -----------------------------------------------------------------------------
000B2Cr 3               PollJoy1:
000B2Cr 3  AD 0D 03       lda HW_PRESENT
000B2Fr 3  29 20          and #HW_GPIO
000B31r 3  D0 05          bne @haveGpio
000B33r 3  A9 FF          lda #$FF
000B35r 3  85 60          sta JOY_STATE
000B37r 3  60             rts
000B38r 3               @haveGpio:
000B38r 3  20 48 A0       jsr ReadJoystick1
000B3Br 3  85 60          sta JOY_STATE
000B3Dr 3  60             rts
000B3Er 3               
000B3Er 3               PollJoy2:
000B3Er 3  AD 0D 03       lda HW_PRESENT
000B41r 3  29 20          and #HW_GPIO
000B43r 3  D0 05          bne @haveGpio
000B45r 3  A9 FF          lda #$FF
000B47r 3  85 61          sta JOY_STATE2
000B49r 3  60             rts
000B4Ar 3               @haveGpio:
000B4Ar 3  20 4B A0       jsr ReadJoystick2
000B4Dr 3  85 61          sta JOY_STATE2
000B4Fr 3  60             rts
000B50r 3               
000B50r 3               ; -----------------------------------------------------------------------------
000B50r 3               ; NextKey - the next key waiting in the Kernal's input buffer, read with
000B50r 3               ; BufferSize/ReadBuffer rather than Chrin: Chrin echoes the key through
000B50r 3               ; Chrout, which on BIOS 2.x brings the Kernal's text screen up over the
000B50r 3               ; game's own picture, and on a TMS9918A writes the character into the screen
000B50r 3               ; at the cursor.
000B50r 3               ; Out: carry set and A = the key, or carry clear if none is waiting.
000B50r 3               ; Clobbers: A
000B50r 3               ; -----------------------------------------------------------------------------
000B50r 3               NextKey:
000B50r 3  20 0C A0       jsr BufferSize
000B53r 3  C9 00          cmp #0
000B55r 3  F0 07          beq @none
000B57r 3  DA             phx
000B58r 3  20 09 A0       jsr ReadBuffer
000B5Br 3  FA             plx
000B5Cr 3  38             sec
000B5Dr 3  60             rts
000B5Er 3               @none:
000B5Er 3  18             clc
000B5Fr 3  60             rts
000B60r 3               
000B60r 3               ; -----------------------------------------------------------------------------
000B60r 3               ; DrainKeyboardCombined - single-player keyboard fallback: WASD or arrow
000B60r 3               ; keys both work, whichever was pressed most recently in this call wins.
000B60r 3               ; Drains every pending key each call (not just one), so a
000B60r 3               ; burst typed between polls doesn't leave stale characters for next time.
000B60r 3               ; LEFT/RIGHT checks compile out entirely for a 2-directional caller that
000B60r 3               ; never defines DIR_LEFT/DIR_RIGHT (e.g. Pong).
000B60r 3               ; Out: KB_DIR = last recognized direction this call, or KB_DIR_NONE.
000B60r 3               ;      KB_FIRE = 1 if space or enter was seen this call, else 0. Both
000B60r 3               ;      fire keys work interchangeably here, matching how WASD and arrows
000B60r 3               ;      both work interchangeably for movement in this single-player case.
000B60r 3               ; Clobbers: A
000B60r 3               ; -----------------------------------------------------------------------------
000B60r 3               DrainKeyboardCombined:
000B60r 3  A9 FF          lda #KB_DIR_NONE
000B62r 3  85 62          sta KB_DIR
000B64r 3  64 63          stz KB_FIRE
000B66r 3               @drain:
000B66r 3  20 rr rr       jsr NextKey
000B69r 3  90 4B          bcc @done                 ; C=0 = no key waiting, buffer empty
000B6Br 3               
000B6Br 3  C9 57          cmp #KEY_W
000B6Dr 3  F0 2B          beq @setUp
000B6Fr 3  C9 1E          cmp #KEY_UP_ARROW
000B71r 3  F0 27          beq @setUp
000B73r 3  C9 53          cmp #KEY_S
000B75r 3  F0 2A          beq @setDown
000B77r 3  C9 1F          cmp #KEY_DOWN_ARROW
000B79r 3  F0 26          beq @setDown
000B7Br 3               .ifdef DIR_LEFT
000B7Br 3  C9 41          cmp #KEY_A
000B7Dr 3  F0 29          beq @setLeft
000B7Fr 3  C9 1C          cmp #KEY_LEFT_ARROW
000B81r 3  F0 25          beq @setLeft
000B83r 3               .endif
000B83r 3               .ifdef DIR_RIGHT
000B83r 3  C9 44          cmp #KEY_D
000B85r 3  F0 28          beq @setRight
000B87r 3  C9 1D          cmp #KEY_RIGHT_ARROW
000B89r 3  F0 24          beq @setRight
000B8Br 3               .endif
000B8Br 3  C9 20          cmp #KEY_FIRE
000B8Dr 3  F0 04          beq @setFire
000B8Fr 3  C9 0D          cmp #KEY_FIRE2
000B91r 3  D0 D3          bne @drain
000B93r 3               @setFire:
000B93r 3  A9 01          lda #1
000B95r 3  85 63          sta KB_FIRE
000B97r 3  4C rr rr       jmp @drain
000B9Ar 3               
000B9Ar 3               @setUp:
000B9Ar 3  A9 00          lda #DIR_UP
000B9Cr 3  85 62          sta KB_DIR
000B9Er 3  4C rr rr       jmp @drain
000BA1r 3               @setDown:
000BA1r 3  A9 01          lda #DIR_DOWN
000BA3r 3  85 62          sta KB_DIR
000BA5r 3  4C rr rr       jmp @drain
000BA8r 3               .ifdef DIR_LEFT
000BA8r 3               @setLeft:
000BA8r 3  A9 02          lda #DIR_LEFT
000BAAr 3  85 62          sta KB_DIR
000BACr 3  4C rr rr       jmp @drain
000BAFr 3               .endif
000BAFr 3               .ifdef DIR_RIGHT
000BAFr 3               @setRight:
000BAFr 3  A9 03          lda #DIR_RIGHT
000BB1r 3  85 62          sta KB_DIR
000BB3r 3  4C rr rr       jmp @drain
000BB6r 3               .endif
000BB6r 3               
000BB6r 3               @done:
000BB6r 3  60             rts
000BB7r 3               
000BB7r 3               ; -----------------------------------------------------------------------------
000BB7r 3               ; DrainKeyboardSplit - two-player keyboard fallback: WASD drives P1 only,
000BB7r 3               ; arrow keys drive P2 only, so one player's keypresses can never move the
000BB7r 3               ; other's paddle/cycle. Drains every pending key ONCE per
000BB7r 3               ; call, checking both keysets in the same pass (so both players' presses
000BB7r 3               ; in the same drain window are captured, not just whichever keyset was
000BB7r 3               ; checked first). LEFT/RIGHT checks compile out for a 2-directional caller
000BB7r 3               ; that never defines DIR_LEFT/DIR_RIGHT (e.g. Pong).
000BB7r 3               ; Out: KB_DIR_P1 = last WASD direction seen this call, or KB_DIR_NONE.
000BB7r 3               ;      KB_DIR_P2 = last arrow-key direction seen this call, or KB_DIR_NONE.
000BB7r 3               ;      KB_FIRE = 1 if EITHER fire key was seen this call, else 0 - kept
000BB7r 3               ;      for callers with only one shared fire/start/pause action (every
000BB7r 3               ;      game as of this writing: "did anyone press it" is all that
000BB7r 3               ;      matters, mirroring how either joystick's A button already
000BB7r 3               ;      triggers the same shared action today).
000BB7r 3               ;      KB_FIRE_P1 = 1 if space (P1's fire key) was seen this call, else 0.
000BB7r 3               ;      KB_FIRE_P2 = 1 if enter (P2's fire key) was seen this call, else 0.
000BB7r 3               ;      A future game with independent per-player fire (e.g. a two-player
000BB7r 3               ;      shooter) reads KB_FIRE_P1/KB_FIRE_P2 instead of the combined flag.
000BB7r 3               ; Clobbers: A
000BB7r 3               ; -----------------------------------------------------------------------------
000BB7r 3               DrainKeyboardSplit:
000BB7r 3  A9 FF          lda #KB_DIR_NONE
000BB9r 3  85 64          sta KB_DIR_P1
000BBBr 3  85 65          sta KB_DIR_P2
000BBDr 3  64 63          stz KB_FIRE
000BBFr 3  64 66          stz KB_FIRE_P1
000BC1r 3  64 67          stz KB_FIRE_P2
000BC3r 3               @drain:
000BC3r 3  20 rr rr       jsr NextKey
000BC6r 3  90 72          bcc @done                 ; C=0 = no key waiting, buffer empty
000BC8r 3               
000BC8r 3  C9 57          cmp #KEY_W
000BCAr 3  F0 36          beq @p1Up
000BCCr 3  C9 53          cmp #KEY_S
000BCEr 3  F0 39          beq @p1Down
000BD0r 3               .ifdef DIR_LEFT
000BD0r 3  C9 41          cmp #KEY_A
000BD2r 3  F0 3C          beq @p1Left
000BD4r 3               .endif
000BD4r 3               .ifdef DIR_RIGHT
000BD4r 3  C9 44          cmp #KEY_D
000BD6r 3  F0 3F          beq @p1Right
000BD8r 3               .endif
000BD8r 3  C9 1E          cmp #KEY_UP_ARROW
000BDAr 3  F0 42          beq @p2Up
000BDCr 3  C9 1F          cmp #KEY_DOWN_ARROW
000BDEr 3  F0 45          beq @p2Down
000BE0r 3               .ifdef DIR_LEFT
000BE0r 3  C9 1C          cmp #KEY_LEFT_ARROW
000BE2r 3  F0 48          beq @p2Left
000BE4r 3               .endif
000BE4r 3               .ifdef DIR_RIGHT
000BE4r 3  C9 1D          cmp #KEY_RIGHT_ARROW
000BE6r 3  F0 4B          beq @p2Right
000BE8r 3               .endif
000BE8r 3  C9 20          cmp #KEY_FIRE
000BEAr 3  F0 0D          beq @p1Fire
000BECr 3  C9 0D          cmp #KEY_FIRE2
000BEEr 3  D0 D3          bne @drain
000BF0r 3  A9 01          lda #1
000BF2r 3  85 63          sta KB_FIRE
000BF4r 3  85 67          sta KB_FIRE_P2
000BF6r 3  4C rr rr       jmp @drain
000BF9r 3               @p1Fire:
000BF9r 3  A9 01          lda #1
000BFBr 3  85 63          sta KB_FIRE
000BFDr 3  85 66          sta KB_FIRE_P1
000BFFr 3  4C rr rr       jmp @drain
000C02r 3               
000C02r 3               @p1Up:
000C02r 3  A9 00          lda #DIR_UP
000C04r 3  85 64          sta KB_DIR_P1
000C06r 3  4C rr rr       jmp @drain
000C09r 3               @p1Down:
000C09r 3  A9 01          lda #DIR_DOWN
000C0Br 3  85 64          sta KB_DIR_P1
000C0Dr 3  4C rr rr       jmp @drain
000C10r 3               .ifdef DIR_LEFT
000C10r 3               @p1Left:
000C10r 3  A9 02          lda #DIR_LEFT
000C12r 3  85 64          sta KB_DIR_P1
000C14r 3  4C rr rr       jmp @drain
000C17r 3               .endif
000C17r 3               .ifdef DIR_RIGHT
000C17r 3               @p1Right:
000C17r 3  A9 03          lda #DIR_RIGHT
000C19r 3  85 64          sta KB_DIR_P1
000C1Br 3  4C rr rr       jmp @drain
000C1Er 3               .endif
000C1Er 3               @p2Up:
000C1Er 3  A9 00          lda #DIR_UP
000C20r 3  85 65          sta KB_DIR_P2
000C22r 3  4C rr rr       jmp @drain
000C25r 3               @p2Down:
000C25r 3  A9 01          lda #DIR_DOWN
000C27r 3  85 65          sta KB_DIR_P2
000C29r 3  4C rr rr       jmp @drain
000C2Cr 3               .ifdef DIR_LEFT
000C2Cr 3               @p2Left:
000C2Cr 3  A9 02          lda #DIR_LEFT
000C2Er 3  85 65          sta KB_DIR_P2
000C30r 3  4C rr rr       jmp @drain
000C33r 3               .endif
000C33r 3               .ifdef DIR_RIGHT
000C33r 3               @p2Right:
000C33r 3  A9 03          lda #DIR_RIGHT
000C35r 3  85 65          sta KB_DIR_P2
000C37r 3  4C rr rr       jmp @drain
000C3Ar 3               .endif
000C3Ar 3               
000C3Ar 3               @done:
000C3Ar 3  60             rts
000C3Br 3               
000C3Br 2               
000C3Br 2               .segment "CART"
000C3Br 2               
000C3Br 2               REPEAT_FIRST = 15                 ; frames before a held stick repeats
000C3Br 2               REPEAT_NEXT  = 5                  ; then every this many
000C3Br 2               
000C3Br 2               ; ReadInput - this frame's EV_DIR, EV_FIRE and EV_SWAP.
000C3Br 2               ReadInput:
000C3Br 2  64 6B          stz EV_FIRE
000C3Dr 2  64 6C          stz EV_SWAP
000C3Fr 2  A9 FF          lda #NO_DIR
000C41r 2  85 6A          sta EV_DIR
000C43r 2  20 rr rr       jsr PollJoy1
000C46r 2  20 rr rr       jsr PollJoy2
000C49r 2  A5 60          lda JOY_STATE
000C4Br 2  25 61          and JOY_STATE2                   ; active low: pressed on either stick
000C4Dr 2  49 FF          eor #$FF
000C4Fr 2  85 40          sta T0                           ; active high
000C51r 2                 ; buttons, on the press
000C51r 2  A5 6D          lda PREV_BTN
000C53r 2  49 FF          eor #$FF
000C55r 2  25 40          and T0
000C57r 2  85 41          sta T1
000C59r 2  29 01          and #JOY_A
000C5Br 2  F0 02          beq @noFire
000C5Dr 2  E6 6B          inc EV_FIRE
000C5Fr 2               @noFire:
000C5Fr 2  A5 41          lda T1
000C61r 2  29 02          and #JOY_B
000C63r 2  F0 02          beq @noSwap
000C65r 2  E6 6C          inc EV_SWAP
000C67r 2               @noSwap:
000C67r 2  A5 40          lda T0
000C69r 2  29 03          and #(JOY_A | JOY_B)
000C6Br 2  85 6D          sta PREV_BTN
000C6Dr 2                 ; the stick's direction
000C6Dr 2  A2 FF          ldx #NO_DIR
000C6Fr 2  A5 40          lda T0
000C71r 2  29 10          and #JOY_UP
000C73r 2  F0 02          beq @notUp
000C75r 2  A2 00          ldx #DIR_UP
000C77r 2               @notUp:
000C77r 2  A5 40          lda T0
000C79r 2  29 20          and #JOY_DOWN
000C7Br 2  F0 02          beq @notDown
000C7Dr 2  A2 01          ldx #DIR_DOWN
000C7Fr 2               @notDown:
000C7Fr 2  A5 40          lda T0
000C81r 2  29 40          and #JOY_LEFT
000C83r 2  F0 02          beq @notLeft
000C85r 2  A2 02          ldx #DIR_LEFT
000C87r 2               @notLeft:
000C87r 2  A5 40          lda T0
000C89r 2  29 80          and #JOY_RIGHT
000C8Br 2  F0 02          beq @notRight
000C8Dr 2  A2 03          ldx #DIR_RIGHT
000C8Fr 2               @notRight:
000C8Fr 2  E4 68          cpx HELD_DIR
000C91r 2  F0 0E          beq @held
000C93r 2  86 68          stx HELD_DIR                     ; a new direction: move now
000C95r 2  E0 FF          cpx #NO_DIR
000C97r 2  F0 16          beq @keys
000C99r 2  86 6A          stx EV_DIR
000C9Br 2  A9 0F          lda #REPEAT_FIRST
000C9Dr 2  85 69          sta REPEAT_T
000C9Fr 2  80 0E          bra @keys
000CA1r 2               @held:
000CA1r 2  E0 FF          cpx #NO_DIR
000CA3r 2  F0 0A          beq @keys
000CA5r 2  C6 69          dec REPEAT_T
000CA7r 2  D0 06          bne @keys
000CA9r 2  86 6A          stx EV_DIR
000CABr 2  A9 05          lda #REPEAT_NEXT
000CADr 2  85 69          sta REPEAT_T
000CAFr 2               @keys:
000CAFr 2  20 0C A0       jsr BufferSize                   ; straight from the buffer: Chrin would echo
000CB2r 2  C9 00          cmp #0                           ; the key onto the Kernal's text screen
000CB4r 2  F0 4D          beq @done
000CB6r 2  20 09 A0       jsr ReadBuffer
000CB9r 2  A2 00          ldx #DIR_UP
000CBBr 2  C9 57          cmp #'W'
000CBDr 2  F0 34          beq @keyDir
000CBFr 2  C9 1E          cmp #KEY_UP_ARROW
000CC1r 2  F0 30          beq @keyDir
000CC3r 2  A2 01          ldx #DIR_DOWN
000CC5r 2  C9 53          cmp #'S'
000CC7r 2  F0 2A          beq @keyDir
000CC9r 2  C9 1F          cmp #KEY_DOWN_ARROW
000CCBr 2  F0 26          beq @keyDir
000CCDr 2  A2 02          ldx #DIR_LEFT
000CCFr 2  C9 41          cmp #'A'
000CD1r 2  F0 20          beq @keyDir
000CD3r 2  C9 1C          cmp #KEY_LEFT_ARROW
000CD5r 2  F0 1C          beq @keyDir
000CD7r 2  A2 03          ldx #DIR_RIGHT
000CD9r 2  C9 44          cmp #'D'
000CDBr 2  F0 16          beq @keyDir
000CDDr 2  C9 1D          cmp #KEY_RIGHT_ARROW
000CDFr 2  F0 12          beq @keyDir
000CE1r 2  C9 20          cmp #' '
000CE3r 2  F0 12          beq @keyFire
000CE5r 2  C9 0D          cmp #$0D
000CE7r 2  F0 0E          beq @keyFire
000CE9r 2  C9 58          cmp #'X'
000CEBr 2  F0 10          beq @keySwap
000CEDr 2  C9 42          cmp #'B'
000CEFr 2  F0 0C          beq @keySwap
000CF1r 2  80 BC          bra @keys
000CF3r 2               @keyDir:
000CF3r 2  86 6A          stx EV_DIR
000CF5r 2  80 B8          bra @keys
000CF7r 2               @keyFire:
000CF7r 2  A9 01          lda #1
000CF9r 2  85 6B          sta EV_FIRE
000CFBr 2  80 B2          bra @keys
000CFDr 2               @keySwap:
000CFDr 2  A9 01          lda #1
000CFFr 2  85 6C          sta EV_SWAP
000D01r 2  80 AC          bra @keys
000D03r 2               @done:
000D03r 2  60             rts
000D04r 2               
000D04r 1               .include "src/game.asm"
000D04r 2               ; =============================================================================
000D04r 2               ;   game.asm - the title screen, planning and the end of a battle
000D04r 2               ; =============================================================================
000D04r 2               ;   A battle goes: each person plans in turn, the machine passed between them
000D04r 2               ;   (a handoff screen hides one plan from the next person), then the turn
000D04r 2               ;   plays out for everyone (turn.asm), until one ship or none is left.
000D04r 2               ; =============================================================================
000D04r 2               
000D04r 2               .segment "BANK00"
000000r 2               
000000r 2               ; --- Factions: Vanguard, Raider, Swarm, Wraith ---
000000r 2               FactionNames:
000000r 2  rr rr rr rr    .word TxtVanguard, TxtRaider, TxtSwarm, TxtWraith
000004r 2  rr rr rr rr  
000008r 2               MaxHull:
000008r 2  7D 69 7D 73    .byte 125, 105, 125, 115
00000Cr 2               ; Ship colors, by faction, then each faction's second color: palette row and ink
00000Cr 2               ColorRow:
00000Cr 2  09 03 06 0B    .byte $9, $3, $6, $B,  $8, $2, $5, $4
000010r 2  08 02 05 04  
000014r 2               ColorInk:
000014r 2  04 05 06 07    .byte INK_AZURE, INK_ORANGE, INK_GREEN, INK_VIOLET
000018r 2  08 09 0A 0C    .byte INK_CYAN, INK_RED, INK_LIME, INK_YELLOW
00001Cr 2               SeatInk = ColorInk
00001Cr 2               
00001Cr 2  56 41 4E 47  TxtVanguard:  .asciiz "VANGUARD"
000020r 2  55 41 52 44  
000024r 2  00           
000025r 2  52 41 49 44  TxtRaider:    .asciiz "RAIDER"
000029r 2  45 52 00     
00002Cr 2  53 57 41 52  TxtSwarm:     .asciiz "SWARM"
000030r 2  4D 00        
000032r 2  57 52 41 49  TxtWraith:    .asciiz "WRAITH"
000036r 2  54 48 00     
000039r 2  48 45 58 46  TxtTitle:     .asciiz "HEXFLEET"
00003Dr 2  4C 45 45 54  
000041r 2  00           
000042r 2  54 55 52 4E  TxtTurn:      .asciiz "TURN "
000046r 2  20 00        
000048r 2  50 4C 41 59  TxtPlayer:    .asciiz "PLAYER "
00004Cr 2  45 52 20 00  
000050r 2  55 50 2F 44  TxtUpDown:    .asciiz "UP/DN: ITEM"
000054r 2  4E 3A 20 49  
000058r 2  54 45 4D 00  
00005Cr 2  4C 54 2F 52  TxtLeftRight: .asciiz "LT/RT: SET"
000060r 2  54 3A 20 53  
000064r 2  45 54 00     
000067r 2  46 49 52 45  TxtStart:     .asciiz "FIRE: START"
00006Br 2  3A 20 53 54  
00006Fr 2  41 52 54 00  
000073r 2  50 52 45 53  TxtPressFire: .asciiz "PRESS FIRE"
000077r 2  53 20 46 49  
00007Br 2  52 45 00     
00007Er 2  50 49 43 4B  TxtPickMove:  .asciiz "PICK A MOVE"
000082r 2  20 41 20 4D  
000086r 2  4F 56 45 00  
00008Ar 2  55 50 20 54  TxtUpTo3:     .asciiz "UP TO 3 HEX"
00008Er 2  4F 20 33 20  
000092r 2  48 45 58 00  
000096r 2  54 4F 4F 20  TxtTooFar:    .asciiz "TOO FAR"
00009Ar 2  46 41 52 00  
00009Er 2  50 49 43 4B  TxtPickAim:   .asciiz "PICK TARGET"
0000A2r 2  20 54 41 52  
0000A6r 2  47 45 54 00  
0000AAr 2  53 48 49 50  TxtShipBack:  .asciiz "SHIP: REDO"
0000AEr 2  3A 20 52 45  
0000B2r 2  44 4F 00     
0000B5r 2  4C 4F 43 4B  TxtLockIn:    .asciiz "LOCK IN?"
0000B9r 2  20 49 4E 3F  
0000BDr 2  00           
0000BEr 2  46 49 52 45  TxtFireYes:   .asciiz "FIRE: YES"
0000C2r 2  3A 20 59 45  
0000C6r 2  53 00        
0000C8r 2  57 45 41 50  TxtWeapon:    .asciiz "WEAPON"
0000CCr 2  4F 4E 00     
0000CFr 2  4C 41 53 45  TxtLaser:     .asciiz "LASER"
0000D3r 2  52 00        
0000D5r 2  54 4F 52 50  TxtTorpedo:   .asciiz "TORPEDO"
0000D9r 2  45 44 4F 00  
0000DDr 2  42 2F 58 3A  TxtSwap:      .asciiz "B/X: SWAP"
0000E1r 2  20 53 57 41  
0000E5r 2  50 00        
0000E7r 2  4F 52 44 45  TxtOrdersIn:  .asciiz "ORDERS IN"
0000EBr 2  52 53 20 49  
0000EFr 2  4E 00        
0000F1r 2  46 49 52 45  TxtFirePlay:  .asciiz "FIRE: PLAY"
0000F5r 2  3A 20 50 4C  
0000F9r 2  41 59 00     
0000FCr 2  20 57 49 4E  TxtWins:      .asciiz " WINS"
000100r 2  53 00        
000102r 2  44 52 41 57  TxtDraw:      .asciiz "DRAW"
000106r 2  00           
000107r 2  47 41 4D 45  TxtGameOver:  .asciiz "GAME OVER"
00010Br 2  20 4F 56 45  
00010Fr 2  52 00        
000111r 2  46 49 52 45  TxtFireMenu:  .asciiz "FIRE: MENU"
000115r 2  3A 20 4D 45  
000119r 2  4E 55 00     
00011Cr 2  43 50 55 00  TxtCpu:       .asciiz "CPU"
000120r 2  4D 55 53 49  TxtMusicOn:   .asciiz "MUSIC ON"
000124r 2  43 20 4F 4E  
000128r 2  00           
000129r 2  4D 55 53 49  TxtMusicOff:  .asciiz "MUSIC OFF"
00012Dr 2  43 20 4F 46  
000131r 2  46 00        
000133r 2  46 52 45 45  TxtAllFight:  .asciiz "FREE 4 ALL"
000137r 2  20 34 20 41  
00013Br 2  4C 4C 00     
00013Er 2  54 45 41 4D  TxtTeams:     .asciiz "TEAMS"
000142r 2  53 00        
000144r 2  41 4C 50 48  TxtAlphaWins: .asciiz "ALPHA WINS"
000148r 2  41 20 57 49  
00014Cr 2  4E 53 00     
00014Fr 2  4F 4D 45 47  TxtOmegaWins: .asciiz "OMEGA WINS"
000153r 2  41 20 57 49  
000157r 2  4E 53 00     
00015Ar 2  59 4F 55 20  TxtYouWin:    .asciiz "YOU WIN"
00015Er 2  57 49 4E 00  
000162r 2  43 50 55 20  TxtCpuWins:   .asciiz "CPU WINS"
000166r 2  57 49 4E 53  
00016Ar 2  00           
00016Br 2               
00016Br 2               ; --- The main loop ---
00016Br 2               
00016Br 2               MainLoop:
00016Br 2  20 rr rr       jsr ReadInput
00016Er 2  20 rr rr       jsr Dispatch
000171r 2  20 rr rr       jsr WaitFrame
000174r 2  80 F5          bra MainLoop
000176r 2               
000176r 2               Dispatch:
000176r 2  A5 6E          lda STATE
000178r 2  0A             asl a
000179r 2  AA             tax
00017Ar 2  7C rr rr       jmp (StateTable,x)
00017Dr 2               
00017Dr 2               StateTable:
00017Dr 2  rr rr rr rr    .word TitleFrame, HandoffFrame, PlanFrame, ReadyFrame, OverFrame, NameFrame
000181r 2  rr rr rr rr  
000185r 2  rr rr rr rr  
000189r 2  rr rr rr rr    .word LinkFrame, LinkWaitFrame
00018Dr 2               
00018Dr 2               ; --- Small helpers ---
00018Dr 2               
00018Dr 2               ; SetColors - each seat takes its faction's color, or its second color, or else the
00018Dr 2               ; first one no other seat has.
00018Dr 2               SetColors:
00018Dr 2  64 40          stz T0                           ; colors taken, as bits
00018Fr 2  A2 00          ldx #0
000191r 2               @seat:
000191r 2  BC 00 08       ldy SHIP_FACTION,x
000194r 2  B9 rr rr       lda ColorBit,y
000197r 2  24 40          bit T0
000199r 2  F0 1A          beq @take
00019Br 2  B9 rr rr       lda ColorBit+4,y
00019Er 2  24 40          bit T0
0001A0r 2  D0 07          bne @search
0001A2r 2  98             tya
0001A3r 2  18             clc
0001A4r 2  69 04          adc #4
0001A6r 2  A8             tay
0001A7r 2  80 0C          bra @take2
0001A9r 2               @search:
0001A9r 2  A0 00          ldy #0
0001ABr 2               @look:
0001ABr 2  B9 rr rr       lda ColorBit,y
0001AEr 2  24 40          bit T0
0001B0r 2  F0 03          beq @take2
0001B2r 2  C8             iny
0001B3r 2  80 F6          bra @look
0001B5r 2               @take:
0001B5r 2               @take2:
0001B5r 2  B9 rr rr       lda ColorBit,y
0001B8r 2  05 40          ora T0
0001BAr 2  85 40          sta T0
0001BCr 2  B9 rr rr       lda ColorRow,y
0001BFr 2  9D 04 08       sta SHIP_ROW,x
0001C2r 2  B9 rr rr       lda ColorInk,y
0001C5r 2  9D 08 08       sta SHIP_INK,x
0001C8r 2  E8             inx
0001C9r 2  E0 04          cpx #NUM_SHIPS
0001CBr 2  D0 C4          bne @seat
0001CDr 2  4C rr rr       jmp CanvasColors
0001D0r 2               
0001D0r 2               ColorBit:
0001D0r 2  01 02 04 08    .byte 1, 2, 4, 8, 16, 32, 64, 128
0001D4r 2  10 20 40 80  
0001D8r 2               
0001D8r 2               ; ShowShip - ship X's sprite centered on (HX, HY). A cloaked ship is gray for
0001D8r 2               ; whoever may see it and hidden from anyone else. Keeps X.
0001D8r 2               ShowShip:
0001D8r 2  BD 88 09       lda CLOAKED,x
0001DBr 2  F0 0C          beq @plain
0001DDr 2  20 rr rr       jsr CanView
0001E0r 2  B0 03          bcs @ghost
0001E2r 2  4C rr rr       jmp HideSprite
0001E5r 2               @ghost:
0001E5r 2  A9 01          lda #ROW_GRAY
0001E7r 2  80 03          bra @row
0001E9r 2               @plain:
0001E9r 2  BD 04 08       lda SHIP_ROW,x
0001ECr 2               @row:
0001ECr 2  09 40          ora #SPR_FRONT
0001EEr 2  48             pha
0001EFr 2  BD 00 08       lda SHIP_FACTION,x               ; 12 drawings a faction, 4 patterns each
0001F2r 2  0A             asl a
0001F3r 2  7D 00 08       adc SHIP_FACTION,x
0001F6r 2  0A             asl a
0001F7r 2  0A             asl a
0001F8r 2  18             clc
0001F9r 2  7D 20 08       adc SHIP_HEAD,x
0001FCr 2  0A             asl a
0001FDr 2  0A             asl a
0001FEr 2  85 D8          sta MTMP
000200r 2  7A             ply
000201r 2  A5 D8          lda MTMP
000203r 2  4C rr rr       jmp PlaceSprite                  ; ship slots are the ships' indexes
000206r 2               
000206r 2               ; ShipCenter - HX, HY of ship X's hex. Keeps X.
000206r 2               ShipCenter:
000206r 2  DA             phx
000207r 2  BC 1C 08       ldy SHIP_R,x
00020Ar 2  BD 18 08       lda SHIP_C,x
00020Dr 2  AA             tax
00020Er 2  20 rr rr       jsr HexCenter
000211r 2  FA             plx
000212r 2  60             rts
000213r 2               
000213r 2               ; ShowShipsOnHexes - every ship on its hex, or hidden if it's gone.
000213r 2               ShowShipsOnHexes:
000213r 2  A2 00          ldx #0
000215r 2               @loop:
000215r 2  BD 0C 08       lda SHIP_ALIVE,x
000218r 2  F0 08          beq @hide
00021Ar 2  20 rr rr       jsr ShipCenter
00021Dr 2  20 rr rr       jsr ShowShip
000220r 2  80 03          bra @next
000222r 2               @hide:
000222r 2  20 rr rr       jsr HideSprite
000225r 2               @next:
000225r 2  E8             inx
000226r 2  E0 04          cpx #NUM_SHIPS
000228r 2  D0 EB          bne @loop
00022Ar 2  60             rts
00022Br 2               
00022Br 2               ; ShowFriends - while someone plans, a hex round each ship on their side.
00022Br 2               ShowFriends:
00022Br 2  A2 00          ldx #0
00022Dr 2               @ship:
00022Dr 2  DA             phx
00022Er 2  A5 6E          lda STATE
000230r 2  C9 02          cmp #ST_PLAN
000232r 2  D0 2A          bne @hide
000234r 2  E4 6F          cpx PLAYER
000236r 2  F0 26          beq @hide
000238r 2  BD 0C 08       lda SHIP_ALIVE,x
00023Br 2  F0 21          beq @hide
00023Dr 2  A4 6F          ldy PLAYER
00023Fr 2  B9 B8 0C       lda SHIP_SIDE,y
000242r 2  DD B8 0C       cmp SHIP_SIDE,x
000245r 2  D0 17          bne @hide
000247r 2  20 rr rr       jsr ShipCenter
00024Ar 2  A4 6F          ldy PLAYER
00024Cr 2  B9 04 08       lda SHIP_ROW,y
00024Fr 2  09 40          ora #SPR_FRONT
000251r 2  A8             tay
000252r 2  8A             txa
000253r 2  18             clc
000254r 2  69 23          adc #SLOT_FRIEND
000256r 2  AA             tax
000257r 2  A9 D8          lda #PAT_DEST
000259r 2  20 rr rr       jsr PlaceSprite
00025Cr 2  80 08          bra @next
00025Er 2               @hide:
00025Er 2  8A             txa
00025Fr 2  18             clc
000260r 2  69 23          adc #SLOT_FRIEND
000262r 2  AA             tax
000263r 2  20 rr rr       jsr HideSprite
000266r 2               @next:
000266r 2  FA             plx
000267r 2  E8             inx
000268r 2  E0 04          cpx #NUM_SHIPS
00026Ar 2  D0 C1          bne @ship
00026Cr 2  60             rts
00026Dr 2               
00026Dr 2               HideFriends:
00026Dr 2  A2 26          ldx #SLOT_FRIEND + NUM_SHIPS - 1
00026Fr 2               @slot:
00026Fr 2  20 rr rr       jsr HideSprite
000272r 2  CA             dex
000273r 2  E0 22          cpx #SLOT_FRIEND - 1
000275r 2  D0 F8          bne @slot
000277r 2  60             rts
000278r 2               
000278r 2               ; ShowBoard - the ships, and what the viewer may see of mines and cloaks.
000278r 2               ShowBoard:
000278r 2  20 rr rr       jsr ShowShipsOnHexes
00027Br 2  20 rr rr       jsr ShowMines
00027Er 2  20 rr rr       jsr ShowFriends
000281r 2  4C rr rr       jmp ShowSeen
000284r 2               
000284r 2               ; ClearMessages - blank the panel's message rows.
000284r 2               ClearMessages:
000284r 2  A9 0B          lda #ROW_MSG1
000286r 2               @loop:
000286r 2  48             pha
000287r 2  20 rr rr       jsr PanelClear
00028Ar 2  68             pla
00028Br 2  1A             inc a
00028Cr 2  C9 16          cmp #ROW_MSG7 + 1
00028Er 2  D0 F6          bne @loop
000290r 2  60             rts
000291r 2               
000291r 2               ; PrintPlayer - panel row A: "PLAYER 1" for ship PLAYER, in its ink.
000291r 2               PrintPlayer:
000291r 2  48             pha
000292r 2  A6 6F          ldx PLAYER
000294r 2  BD 08 08       lda SHIP_INK,x
000297r 2  85 78          sta TXT_INK
000299r 2  20 rr rr       jsr LineStart
00029Cr 2  20 rr rr       jsr SeatIsCpu
00029Fr 2  90 09          bcc @person
0002A1r 2  A2 rr          ldx #<TxtCpu
0002A3r 2  A0 rr          ldy #>TxtCpu
0002A5r 2  20 rr rr       jsr LineStr
0002A8r 2  80 12          bra @show
0002AAr 2               @person:
0002AAr 2  A2 rr          ldx #<TxtPlayer
0002ACr 2  A0 rr          ldy #>TxtPlayer
0002AEr 2  20 rr rr       jsr LineStr
0002B1r 2  A6 6F          ldx PLAYER
0002B3r 2  BD DC 0C       lda SHIP_SEAT,x
0002B6r 2  18             clc
0002B7r 2  69 31          adc #'1'
0002B9r 2  20 rr rr       jsr LineChar
0002BCr 2               @show:
0002BCr 2  68             pla
0002BDr 2  4C rr rr       jmp LineShow
0002C0r 2               
0002C0r 2               ; SeatIsCpu - carry set if seat PLAYER is a CPU's.
0002C0r 2               SeatIsCpu:
0002C0r 2  20 rr rr       jsr IsLink
0002C3r 2  F0 09          beq VsPerson
0002C5r 2  A6 6F          ldx PLAYER
0002C7r 2  BD B4 0C       lda SEAT_KIND,x
0002CAr 2  F0 02          beq VsPerson
0002CCr 2  38             sec
0002CDr 2  60             rts
0002CEr 2               VsPerson:
0002CEr 2  18             clc
0002CFr 2  60             rts
0002D0r 2               
0002D0r 2               ; AddShipName - the name of ship X's faction onto the line.
0002D0r 2               AddShipName:
0002D0r 2  BD 00 08       lda SHIP_FACTION,x
0002D3r 2  0A             asl a
0002D4r 2  AA             tax
0002D5r 2  BD rr rr       lda FactionNames+1,x
0002D8r 2  A8             tay
0002D9r 2  BD rr rr       lda FactionNames,x
0002DCr 2  AA             tax
0002DDr 2  4C rr rr       jmp LineStr
0002E0r 2               
0002E0r 2               DrawTurnLine:
0002E0r 2  A9 02          lda #INK_WHITE
0002E2r 2  85 78          sta TXT_INK
0002E4r 2  20 rr rr       jsr LineStart
0002E7r 2  A2 rr          ldx #<TxtTurn
0002E9r 2  A0 rr          ldy #>TxtTurn
0002EBr 2  20 rr rr       jsr LineStr
0002EEr 2  A5 73          lda TURN
0002F0r 2  20 rr rr       jsr LineNum
0002F3r 2  A9 01          lda #ROW_TURN
0002F5r 2  4C rr rr       jmp LineShow
0002F8r 2               
0002F8r 2               ; ShipRow - A = the panel row of ship X's name. Keeps X.
