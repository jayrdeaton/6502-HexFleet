000B0Br 2               ; PlayTurn - every plan is in: play it, then the next turn or the end.
000B0Br 2               PlayTurn:
000B0Br 2  A9 FF          lda #VIEW_NONE                   ; a lone player still sees their own things
000B0Dr 2  85 76          sta VIEWER
000B0Fr 2  20 rr rr       jsr VsCpu
000B12r 2  90 04          bcc @people
000B14r 2  64 76          stz VIEWER
