000176r 2               
000176r 2               ; --- The main loop ---
000176r 2               
000176r 2               MainLoop:
000176r 2  20 rr rr       jsr ReadInput
000179r 2  20 rr rr       jsr Dispatch
00017Cr 2  20 rr rr       jsr WaitFrame
00017Fr 2  80 F5          bra MainLoop
000181r 2               
000181r 2               Dispatch:
000181r 2  A5 6E          lda STATE
000183r 2  0A             asl a
000184r 2  AA             tax
000185r 2  7C rr rr       jmp (StateTable,x)
000188r 2               
000188r 2               StateTable:
000188r 2  rr rr rr rr    .word TitleFrame, HandoffFrame, PlanFrame, ReadyFrame, OverFrame, NameFrame
00018Cr 2  rr rr rr rr  
000190r 2  rr rr rr rr  
000194r 2  rr rr rr rr    .word LinkFrame, LinkWaitFrame
000198r 2               
000198r 2               ; --- Small helpers ---
000198r 2               
000198r 2               ; SetColors - each ship's sprite row and ink from its faction; a second ship
000198r 2               ; of the same faction takes the faction's other colors.
000198r 2               SetColors:
000198r 2  20 rr rr       jsr PickColors
00019Br 2  4C rr rr       jmp CanvasColors
00019Er 2               
00019Er 2               PickColors:
00019Er 2  AE 00 08       ldx SHIP_FACTION
0001A1r 2  BD rr rr       lda SeatRow,x
0001A4r 2  8D 04 08       sta SHIP_ROW
0001A7r 2  BD rr rr       lda SeatInk,x
0001AAr 2  8D 08 08       sta SHIP_INK
0001ADr 2  AE 01 08       ldx SHIP_FACTION+1
0001B0r 2  EC 00 08       cpx SHIP_FACTION
0001B3r 2  F0 0D          beq @same
0001B5r 2  BD rr rr       lda SeatRow,x
0001B8r 2  8D 05 08       sta SHIP_ROW+1
0001BBr 2  BD rr rr       lda SeatInk,x
0001BEr 2  8D 09 08       sta SHIP_INK+1
0001C1r 2  60             rts
0001C2r 2               @same:
0001C2r 2  BD rr rr       lda AltRow,x
0001C5r 2  8D 05 08       sta SHIP_ROW+1
0001C8r 2  BD rr rr       lda AltInk,x
0001CBr 2  8D 09 08       sta SHIP_INK+1
0001CEr 2  60             rts
0001CFr 2               
0001CFr 2               ; ShowShip - ship X's sprite centered on (HX, HY). A cloaked ship is gray for
0001CFr 2               ; whoever may see it and hidden from anyone else. Keeps X.
0001CFr 2               ShowShip:
0001CFr 2  BD 88 09       lda CLOAKED,x
0001D2r 2  F0 0C          beq @plain
0001D4r 2  20 rr rr       jsr CanView
0001D7r 2  B0 03          bcs @ghost
0001D9r 2  4C rr rr       jmp HideSprite
0001DCr 2               @ghost:
0001DCr 2  A9 01          lda #ROW_GRAY
0001DEr 2  80 03          bra @row
0001E0r 2               @plain:
0001E0r 2  BD 04 08       lda SHIP_ROW,x
0001E3r 2               @row:
0001E3r 2  09 40          ora #SPR_FRONT
0001E5r 2  48             pha
0001E6r 2  BD 00 08       lda SHIP_FACTION,x               ; 12 drawings a faction, 4 patterns each
0001E9r 2  0A             asl a
0001EAr 2  7D 00 08       adc SHIP_FACTION,x
0001EDr 2  0A             asl a
0001EEr 2  0A             asl a
0001EFr 2  18             clc
0001F0r 2  7D 20 08       adc SHIP_HEAD,x
0001F3r 2  0A             asl a
0001F4r 2  0A             asl a
0001F5r 2  85 D8          sta MTMP
0001F7r 2  7A             ply
0001F8r 2  A5 D8          lda MTMP
0001FAr 2  4C rr rr       jmp PlaceSprite                  ; ship slots are the ships' indexes
0001FDr 2               
0001FDr 2               ; ShipCenter - HX, HY of ship X's hex. Keeps X.
0001FDr 2               ShipCenter:
0001FDr 2  DA             phx
0001FEr 2  BC 1C 08       ldy SHIP_R,x
000201r 2  BD 18 08       lda SHIP_C,x
000204r 2  AA             tax
000205r 2  20 rr rr       jsr HexCenter
000208r 2  FA             plx
000209r 2  60             rts
00020Ar 2               
00020Ar 2               ; ShowShipsOnHexes - every ship on its hex, or hidden if it's gone.
00020Ar 2               ShowShipsOnHexes:
00020Ar 2  A2 00          ldx #0
00020Cr 2               @loop:
00020Cr 2  BD 0C 08       lda SHIP_ALIVE,x
00020Fr 2  F0 08          beq @hide
000211r 2  20 rr rr       jsr ShipCenter
000214r 2  20 rr rr       jsr ShowShip
000217r 2  80 03          bra @next
000219r 2               @hide:
000219r 2  20 rr rr       jsr HideSprite
00021Cr 2               @next:
00021Cr 2  E8             inx
00021Dr 2  E0 02          cpx #NUM_SHIPS
00021Fr 2  D0 EB          bne @loop
000221r 2  60             rts
000222r 2               
000222r 2               ; ShowBoard - the ships, and what the viewer may see of mines and cloaks.
000222r 2               ShowBoard:
000222r 2  20 rr rr       jsr ShowShipsOnHexes
000225r 2  20 rr rr       jsr ShowMines
000228r 2  4C rr rr       jmp ShowSeen
00022Br 2               
00022Br 2               ; ClearMessages - blank the panel's message rows.
00022Br 2               ClearMessages:
00022Br 2  A9 0B          lda #ROW_MSG1
00022Dr 2               @loop:
00022Dr 2  48             pha
00022Er 2  20 rr rr       jsr PanelClear
000231r 2  68             pla
000232r 2  1A             inc a
000233r 2  C9 16          cmp #ROW_MSG7 + 1
000235r 2  D0 F6          bne @loop
000237r 2  60             rts
000238r 2               
000238r 2               ; PrintPlayer - panel row A: "PLAYER 1" for ship PLAYER, in its ink.
000238r 2               PrintPlayer:
000238r 2  48             pha
000239r 2  A6 6F          ldx PLAYER
00023Br 2  BD 08 08       lda SHIP_INK,x
00023Er 2  85 78          sta TXT_INK
000240r 2  20 rr rr       jsr LineStart
000243r 2  20 rr rr       jsr SeatIsCpu
000246r 2  90 09          bcc @person
000248r 2  A2 rr          ldx #<TxtCpu
00024Ar 2  A0 rr          ldy #>TxtCpu
00024Cr 2  20 rr rr       jsr LineStr
00024Fr 2  80 0F          bra @show
000251r 2               @person:
000251r 2  A2 rr          ldx #<TxtPlayer
000253r 2  A0 rr          ldy #>TxtPlayer
000255r 2  20 rr rr       jsr LineStr
000258r 2  A5 6F          lda PLAYER
00025Ar 2  18             clc
00025Br 2  69 31          adc #'1'
00025Dr 2  20 rr rr       jsr LineChar
000260r 2               @show:
000260r 2  68             pla
000261r 2  4C rr rr       jmp LineShow
000264r 2               
000264r 2               ; SeatIsCpu - carry set if seat PLAYER is the CPU's.
000264r 2               SeatIsCpu:
000264r 2  A5 6F          lda PLAYER
000266r 2  F0 08          beq VsPerson
000268r 2                 ; falls through
000268r 2               
000268r 2               ; VsCpu - carry set if the opponent is the CPU.
000268r 2               VsCpu:
000268r 2  A5 E6          lda OPP
00026Ar 2  C9 02          cmp #2
00026Cr 2  B0 02          bcs VsPerson
00026Er 2  38             sec
00026Fr 2  60             rts
000270r 2               VsPerson:
000270r 2  18             clc
000271r 2  60             rts
000272r 2               
000272r 2               ; AddShipName - the name of ship X's faction onto the line.
000272r 2               AddShipName:
000272r 2  BD 00 08       lda SHIP_FACTION,x
000275r 2  0A             asl a
000276r 2  AA             tax
000277r 2  BD rr rr       lda FactionNames+1,x
00027Ar 2  A8             tay
00027Br 2  BD rr rr       lda FactionNames,x
00027Er 2  AA             tax
00027Fr 2  4C rr rr       jmp LineStr
000282r 2               
000282r 2               DrawTurnLine:
