00158Cr 2  A5 FC          lda AI_K
00158Er 2  C5 EA          cmp AI_N
001590r 2  D0 DB          bne @end
001592r 2  A5 FD          lda AI_S
001594r 2  CD E1 09       cmp AI_FS
001597r 2  90 11          bcc @next
001599r 2  F0 0F          beq @next
00159Br 2  8D E1 09       sta AI_FS
00159Er 2  AD 64 09       lda AI_OC
0015A1r 2  8D E2 09       sta AI_FC
0015A4r 2  AD 65 09       lda AI_OR
0015A7r 2  8D E3 09       sta AI_FR
0015AAr 2               @next:
