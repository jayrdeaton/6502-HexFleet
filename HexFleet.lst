0019A1r 2  D0 AE          bne @end
0019A3r 2               @done:
0019A3r 2  60             rts
0019A4r 2               
0019A4r 2               ; AiCommit - write the plan.
0019A4r 2               AiCommit:
0019A4r 2  A5 ED          lda AI_BC
0019A6r 2  8D 25 08       sta PLAN_C+ME
0019A9r 2  A5 EE          lda AI_BR
0019ABr 2  8D 29 08       sta PLAN_R+ME
0019AEr 2  A5 F0          lda AI_BAC
0019B0r 2  8D 2D 08       sta AIM_C+ME
0019B3r 2  A5 F1          lda AI_BAR
0019B5r 2  8D 31 08       sta AIM_R+ME
0019B8r 2  A5 EF          lda AI_BW
0019BAr 2  8D 35 08       sta PLAN_WEAPON+ME
0019BDr 2  AD E0 09       lda AI_SPEC
0019C0r 2  8D 85 09       sta PLAN_SPECIAL+ME
0019C3r 2  A9 03          lda #AI_DONE
0019C5r 2  85 E7          sta AI_PHASE
0019C7r 2  60             rts
0019C8r 2               
0019C8r 1               .include "src/special.asm"
0019C8r 2               ; =============================================================================
0019C8r 2               ;   special.asm - each faction's special ability
0019C8r 2               ; =============================================================================
0019C8r 2               ;   The app's rules. A special recharges for some turns once it's used.
0019C8r 2               ;     Vanguard, flak shell: in place of the shot, lobbed at a hex up to 5 away.
0019C8r 2               ;       It bursts as ships stop, 45 to every other ship within a hex.
0019C8r 2               ;     Raider, mine: goes with the shot, dropped where the ship starts. Only its
0019C8r 2               ;       owner sees it. It arms halfway through the turn it's dropped, and goes
0019C8r 2               ;       off for 25 on any other ship that comes within a hex. 3 at most.
0019C8r 2               ;     Swarm, cloak: in place of the shot. Unseen from now until the next turn
0019C8r 2               ;       plays, so the others plan knowing only where it was last seen.
0019C8r 2               ;     Wraith, jump: in place of the move and the shot. Gone until halfway
0019C8r 2               ;       through the turn, it lands up to 6 hexes away with a shockwave: 20 to a
0019C8r 2               ;       ship next to it, 40 to one it lands on, and 20 to itself for that.
0019C8r 2               ; =============================================================================
0019C8r 2               
0019C8r 2               .segment "CART"
000C94r 2               
000C94r 2               RechargeTurns:
000C94r 2  01 03 01 05    .byte 1, 3, 1, 5
000C98r 2               
000C98r 2               SqLo:
000C98r 2  00 01 04 09  .repeat AREA_REACH + 1, I
000C9Cr 2  10 19 24 31  
000CA0r 2  40 51 64 79  
000CB2r 2                 .byte <(I * I)
000CB2r 2               .endrepeat
000CB2r 2               SqHi:
000CB2r 2  00 00 00 00  .repeat AREA_REACH + 1, I
000CB6r 2  00 00 00 00  
000CBAr 2  00 00 00 00  
000CCCr 2                 .byte >(I * I)
000CCCr 2               .endrepeat
000CCCr 2               
000CCCr 2               SpecialNames:
000CCCr 2  rr rr rr rr    .word TxtSpFlak, TxtSpMine, TxtSpCloak, TxtSpJump
000CD0r 2  rr rr rr rr  
000CD4r 2               ChoiceTexts:
000CD4r 2  rr rr rr rr    .word TxtLaser, TxtTorpedo, TxtLaserMine, TxtTorpMine
000CD8r 2  rr rr rr rr  
000CDCr 2  rr rr rr rr    .word TxtFlakShell, TxtCloak, TxtJump
000CE0r 2  rr rr        
000CE2r 2               ChoiceOf:                          ; a special's line in ChoiceTexts (mine aside)
000CE2r 2  04 00 05 06    .byte 4, 0, 5, 6
000CE6r 2               TipName:
000CE6r 2  rr rr rr rr    .word TxtFlakShell, TxtMine, TxtCloak, TxtJump
000CEAr 2  rr rr rr rr  
000CEEr 2               TipA:
000CEEr 2  rr rr rr rr    .word TxtTipFlak1, TxtTipMine1, TxtTipCloak1, TxtTipJump1
000CF2r 2  rr rr rr rr  
000CF6r 2               TipB:
000CF6r 2  rr rr rr rr    .word TxtTipFlak2, TxtTipMine2, TxtTipCloak2, TxtTipJump2
000CFAr 2  rr rr rr rr  
000CFEr 2               
000CFEr 2  46 4C 41 4B  TxtSpFlak:     .asciiz "FLAK"
000D02r 2  00           
000D03r 2  4D 49 4E 45  TxtSpMine:     .asciiz "MINE"
000D07r 2  00           
000D08r 2  43 4C 4F 41  TxtSpCloak:    .asciiz "CLOAK"
000D0Cr 2  4B 00        
000D0Er 2  4A 55 4D 50  TxtSpJump:     .asciiz "JUMP"
000D12r 2  00           
000D13r 2  20 52 45 41  TxtReady:      .asciiz " READY"
000D17r 2  44 59 00     
000D1Ar 2  20 49 4E 20  TxtIn:         .asciiz " IN "
000D1Er 2  00           
000D1Fr 2  46 4C 41 4B  TxtFlakShell:  .asciiz "FLAK SHELL"
000D23r 2  20 53 48 45  
000D27r 2  4C 4C 00     
000D2Ar 2  4D 49 4E 45  TxtMine:       .asciiz "MINE"
000D2Er 2  00           
000D2Fr 2  43 4C 4F 41  TxtCloak:      .asciiz "CLOAK"
000D33r 2  4B 00        
000D35r 2  4A 55 4D 50  TxtJump:       .asciiz "JUMP"
000D39r 2  00           
000D3Ar 2  4C 41 53 45  TxtLaserMine:  .asciiz "LASER+MINE"
000D3Er 2  52 2B 4D 49  
000D42r 2  4E 45 00     
000D45r 2  54 4F 52 50  TxtTorpMine:   .asciiz "TORP+MINE"
000D49r 2  2B 4D 49 4E  
000D4Dr 2  45 00        
000D4Fr 2  4A 55 4D 50  TxtJumpWhere:  .asciiz "JUMP WHERE?"
000D53r 2  20 57 48 45  
000D57r 2  52 45 3F 00  
000D5Br 2  55 50 20 54  TxtUpTo6:      .asciiz "UP TO 6 HEX"
000D5Fr 2  4F 20 36 20  
000D63r 2  48 45 58 00  
000D67r 2  53 48 45 4C  TxtShellWhere: .asciiz "SHELL WHERE"
000D6Br 2  4C 20 57 48  
000D6Fr 2  45 52 45 00  
000D73r 2  55 50 20 54  TxtUpTo5:      .asciiz "UP TO 5 HEX"
000D77r 2  4F 20 35 20  
000D7Br 2  48 45 58 00  
000D7Fr 2  42 55 52 53  TxtTipFlak1:   .asciiz "BURST OF 45"
000D83r 2  54 20 4F 46  
000D87r 2  20 34 35 00  
000D8Br 2  35 20 48 45  TxtTipFlak2:   .asciiz "5 HEX RANGE"
000D8Fr 2  58 20 52 41  
000D93r 2  4E 47 45 00  
000D97r 2  44 52 4F 50  TxtTipMine1:   .asciiz "DROP UNSEEN"
000D9Br 2  20 55 4E 53  
000D9Fr 2  45 45 4E 00  
000DA3r 2  42 4C 41 53  TxtTipMine2:   .asciiz "BLAST OF 25"
000DA7r 2  54 20 4F 46  
000DABr 2  20 32 35 00  
000DAFr 2  55 4E 53 45  TxtTipCloak1:  .asciiz "UNSEEN FOR"
000DB3r 2  45 4E 20 46  
000DB7r 2  4F 52 00     
000DBAr 2  4F 4E 45 20  TxtTipCloak2:  .asciiz "ONE TURN"
000DBEr 2  54 55 52 4E  
000DC2r 2  00           
000DC3r 2  57 41 52 50  TxtTipJump1:   .asciiz "WARP 6 HEX"
000DC7r 2  20 36 20 48  
000DCBr 2  45 58 00     
000DCEr 2  53 48 4F 43  TxtTipJump2:   .asciiz "SHOCK OF 20"
000DD2r 2  4B 20 4F 46  
000DD6r 2  20 32 30 00  
000DDAr 2               
000DDAr 2               ; --- What's picked ---
000DDAr 2               
000DDAr 2               ; PickedSpecial - A = the special ship PLAYER has picked, or $FF. Keeps Y.
000DDAr 2               PickedSpecial:
000DDAr 2  A6 6F          ldx PLAYER
000DDCr 2  BD 84 09       lda PLAN_SPECIAL,x
000DDFr 2  F0 04          beq @none
000DE1r 2  BD 00 08       lda SHIP_FACTION,x
000DE4r 2  60             rts
000DE5r 2               @none:
000DE5r 2  A9 FF          lda #$FF
000DE7r 2  60             rts
000DE8r 2               
000DE8r 2               ; IsJump, IsFlak - Z set if that's what ship PLAYER has picked. Keep Y.
000DE8r 2               IsJump:
000DE8r 2  20 rr rr       jsr PickedSpecial
000DEBr 2  C9 03          cmp #SP_JUMP
000DEDr 2  60             rts
000DEEr 2               
000DEEr 2               IsFlak:
000DEEr 2  20 rr rr       jsr PickedSpecial
000DF1r 2  C9 00          cmp #SP_FLAK
000DF3r 2  60             rts
000DF4r 2               
000DF4r 2               ; NeedsAim - carry set if ship PLAYER's plan needs a hex to aim at.
000DF4r 2               NeedsAim:
000DF4r 2  20 rr rr       jsr PickedSpecial
000DF7r 2  C9 02          cmp #SP_CLOAK
000DF9r 2  F0 06          beq @no
000DFBr 2  C9 03          cmp #SP_JUMP
000DFDr 2  F0 02          beq @no
000DFFr 2  38             sec
000E00r 2  60             rts
000E01r 2               @no:
000E01r 2  18             clc
000E02r 2  60             rts
000E03r 2               
000E03r 2               ; CanView - carry set if ship X's hidden things show right now. Keeps X, Y.
000E03r 2               CanView:
000E03r 2  E4 76          cpx VIEWER
000E05r 2  F0 08          beq @yes
000E07r 2  A5 76          lda VIEWER
000E09r 2  C9 FE          cmp #VIEW_ALL
000E0Br 2  F0 02          beq @yes
000E0Dr 2  18             clc
000E0Er 2  60             rts
000E0Fr 2               @yes:
000E0Fr 2  38             sec
000E10r 2  60             rts
000E11r 2               
000E11r 2               ; --- The panel ---
000E11r 2               
000E11r 2               ; DrawSpecial - ship PLAYER's special: ready, or how long until it is.
000E11r 2               DrawSpecial:
000E11r 2  A6 6F          ldx PLAYER
000E13r 2  BD 08 08       lda SHIP_INK,x
000E16r 2  BC 80 09       ldy SPECIAL_WAIT,x
000E19r 2  F0 02          beq @ink
000E1Br 2  A9 03          lda #INK_GRAY
000E1Dr 2               @ink:
000E1Dr 2  85 78          sta TXT_INK
000E1Fr 2  20 rr rr       jsr LineStart
000E22r 2  A6 6F          ldx PLAYER
000E24r 2  BD 00 08       lda SHIP_FACTION,x
000E27r 2  0A             asl a
000E28r 2  A8             tay
000E29r 2  B9 rr rr       lda SpecialNames+1,y
000E2Cr 2  48             pha
000E2Dr 2  B9 rr rr       lda SpecialNames,y
000E30r 2  AA             tax
000E31r 2  7A             ply
000E32r 2  20 rr rr       jsr LineStr
