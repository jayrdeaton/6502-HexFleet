000ED6r 1               .include "src/turn.asm"
000ED6r 2               ; =============================================================================
000ED6r 2               ;   turn.asm - a turn playing out: the rules and the picture together
000ED6r 2               ; =============================================================================
000ED6r 2               ;   HexFleet's rules, in whole numbers. There are no dice: every ship glides
000ED6r 2               ;   to its hex across the whole turn, and a hit is contact. A laser charges for
000ED6r 2               ;   the first quarter of the turn, then burns whatever its line first touches
000ED6r 2               ;   for 25 hull a quarter, less at long range. A torpedo flies from where its
000ED6r 2               ;   ship started, through the aim and on, and hits the first ship it touches.
000ED6r 2               ; =============================================================================
000ED6r 2               
000ED6r 2               .segment "BANK00"
000ED6r 2               
000ED6r 2               ; A laser's burn each tick by distance in hexes, in 1/256 hull: 25 a quarter
000ED6r 2               ; (16 ticks) up to 2 hexes, then 5% less a hex, never under half.
000ED6r 2               BurnLo:
000ED6r 2  90 90 90 7C    .byte <400, <400, <400, <380, <360, <340, <320, <300, <280, <260, <240, <220, <200
000EDAr 2  68 54 40 2C  
000EDEr 2  18 04 F0 DC  
000EE3r 2               BurnHi:
000EE3r 2  01 01 01 01    .byte >400, >400, >400, >380, >360, >340, >320, >300, >280, >260, >240, >220, >200
000EE7r 2  01 01 01 01  
000EEBr 2  01 01 00 00  
000EF0r 2               
000EF0r 2               SqTab:
000EF0r 2  00 01 04 09    .byte 0, 1, 4, 9, 16, 25, 36, 49, 64, 81, 100
000EF4r 2  10 19 24 31  
000EF8r 2  40 51 64     
000EFBr 2               
000EFBr 2               ; RunTurn - play the turn every ship has planned.
000EFBr 2               RunTurn:
000EFBr 2  20 rr rr       jsr CanvasClear
000EFEr 2  20 rr rr       jsr HideSeen
000F01r 2  20 rr rr       jsr ArmOldMines
000F04r 2  64 E3          stz ANY
000F06r 2  A2 00          ldx #0
000F08r 2               @setup:
000F08r 2  9E 58 08       stz TORP_ON,x
000F0Br 2  9E 7C 08       stz TORP_FLASH,x
000F0Er 2  9E 9C 08       stz FIRING,x
000F11r 2  9E 8C 08       stz EXPL_T,x
000F14r 2  9E 94 09       stz JUMPING,x
000F17r 2  9E 98 09       stz ON_FIELD,x
000F1Ar 2  A9 FF          lda #$FF
000F1Cr 2  9D 88 08       sta BEAM_TGT,x
000F1Fr 2  BD 0C 08       lda SHIP_ALIVE,x
000F22r 2  F0 0B          beq @gone
000F24r 2  FE 98 09       inc ON_FIELD,x
000F27r 2  20 rr rr       jsr StartSpecial
000F2Ar 2  20 rr rr       jsr SetupShip
000F2Dr 2  80 03          bra @next
000F2Fr 2               @gone:
000F2Fr 2  9E 88 09       stz CLOAKED,x
000F32r 2               @next:
000F32r 2  E8             inx
000F33r 2  E4 8E          cpx N_SHIPS
000F35r 2  D0 D1          bne @setup
000F37r 2  A5 E3          lda ANY
000F39r 2  F0 03          beq @quiet
000F3Br 2  20 rr rr       jsr SndTorpedo
000F3Er 2               @quiet:
000F3Er 2  20 rr rr       jsr ThrustSound
000F41r 2  AD 33 0F       lda S_TICKS
000F44r 2  8D CA 0C       sta TICK_MARK
000F47r 2  64 74          stz TICK
000F49r 2  64 9F          stz EXTRA
000F4Br 2  64 9E          stz REDRAW
000F4Dr 2               @tick:
000F4Dr 2  20 rr rr       jsr MoveShips
000F50r 2  20 rr rr       jsr MoveTorpedoes
000F53r 2  20 rr rr       jsr CheckMines
000F56r 2  20 rr rr       jsr LandJumps
000F59r 2  20 rr rr       jsr BurnLasers
000F5Cr 2  20 rr rr       jsr FlakBursts
000F5Fr 2  20 rr rr       jsr CheckWrecks
000F62r 2  20 rr rr       jsr UpdateFx
000F65r 2  20 rr rr       jsr DrawBeams
000F68r 2  20 rr rr       jsr DrawSprites
000F6Br 2  20 rr rr       jsr DrawHulls
000F6Er 2  20 rr rr       jsr TickWait
000F71r 2  E6 74          inc TICK
000F73r 2  A5 74          lda TICK
000F75r 2  C9 40          cmp #TICKS
000F77r 2  90 D4          bcc @tick
000F79r 2  D0 04          bne @late
000F7Br 2  A9 01          lda #1
000F7Dr 2  85 9E          sta REDRAW                       ; the beams go out
000F7Fr 2               @late:
000F7Fr 2  20 rr rr       jsr SndLaserOff
000F82r 2  20 rr rr       jsr StillBusy                    ; torpedoes in flight, wrecks burning
000F85r 2  F0 08          beq @end
000F87r 2  E6 9F          inc EXTRA
000F89r 2  A5 9F          lda EXTRA
000F8Br 2  C9 30          cmp #EXTRA_TICKS
000F8Dr 2  90 BE          bcc @tick
000F8Fr 2               @end:
000F8Fr 2  A2 03          ldx #NUM_FX - 1
000F91r 2               @noFx:
000F91r 2  9E D0 09       stz FX_T,x
000F94r 2  CA             dex
000F95r 2  10 FA          bpl @noFx
000F97r 2  20 rr rr       jsr ShowFx
000F9Ar 2  20 rr rr       jsr CanvasClear
000F9Dr 2  A2 00          ldx #0
000F9Fr 2               @settle:
000F9Fr 2  BD 24 08       lda PLAN_C,x
000FA2r 2  9D 18 08       sta SHIP_C,x
000FA5r 2  BD 28 08       lda PLAN_R,x
000FA8r 2  9D 1C 08       sta SHIP_R,x
000FABr 2  BD rr rr       lda SLOT_TORP_HIDE,x
000FAEr 2  DA             phx
000FAFr 2  AA             tax
000FB0r 2  20 rr rr       jsr HideSprite
000FB3r 2  FA             plx
000FB4r 2  BD rr rr       lda SLOT_EXPL_HIDE,x
000FB7r 2  DA             phx
000FB8r 2  AA             tax
000FB9r 2  20 rr rr       jsr HideSprite
000FBCr 2  FA             plx
000FBDr 2  20 rr rr       jsr DrawHpLine
000FC0r 2  E8             inx
000FC1r 2  E4 8E          cpx N_SHIPS
000FC3r 2  D0 DA          bne @settle
000FC5r 2  20 rr rr       jsr ShowBoard
000FC8r 2  4C rr rr       jmp UploadSprites
000FCBr 2               
000FCBr 2               SLOT_TORP_HIDE:
000FCBr 2  04 05 06 07    .byte SLOT_TORP, SLOT_TORP + 1, SLOT_TORP + 2, SLOT_TORP + 3
000FCFr 2               SLOT_EXPL_HIDE:
000FCFr 2  08 09 0A 0B    .byte SLOT_EXPL, SLOT_EXPL + 1, SLOT_EXPL + 2, SLOT_EXPL + 3
000FD3r 2               
000FD3r 2               ; TickWait - hold each tick of the turn to its time by the sound timer, so a busy
000FD3r 2               ; tick is made up by a shorter wait. Without the timer, count frames.
000FD3r 2               TickWait:
000FD3r 2  AD 31 0F       lda S_ON
000FD6r 2  F0 20          beq @frames
000FD8r 2               @wait:
000FD8r 2  AD 33 0F       lda S_TICKS
000FDBr 2  38             sec
000FDCr 2  ED CA 0C       sbc TICK_MARK
000FDFr 2  C9 02          cmp #FRAMES_A_TICK
000FE1r 2  90 F5          bcc @wait
000FE3r 2  C9 08          cmp #8
000FE5r 2  90 07          bcc @onTime
000FE7r 2  AD 33 0F       lda S_TICKS                      ; far behind: don't try to catch up
000FEAr 2  8D CA 0C       sta TICK_MARK
000FEDr 2  60             rts
000FEEr 2               @onTime:
000FEEr 2  AD CA 0C       lda TICK_MARK
000FF1r 2  18             clc
000FF2r 2  69 02          adc #FRAMES_A_TICK
000FF4r 2  8D CA 0C       sta TICK_MARK
000FF7r 2  60             rts
000FF8r 2               @frames:
000FF8r 2  A9 02          lda #FRAMES_A_TICK
000FFAr 2  4C rr rr       jmp WaitFrames
000FFDr 2               
000FFDr 2               ; StillBusy - Z clear while anything is left to finish.
000FFDr 2               StillBusy:
000FFDr 2  A6 8E          ldx N_SHIPS
000FFFr 2  CA             dex
001000r 2               @loop:
001000r 2  BD 58 08       lda TORP_ON,x
001003r 2  1D 7C 08       ora TORP_FLASH,x
001006r 2  1D 8C 08       ora EXPL_T,x
001009r 2  D0 0F          bne @done
00100Br 2  CA             dex
00100Cr 2  10 F2          bpl @loop
00100Er 2  A2 03          ldx #NUM_FX - 1
001010r 2               @fx:
001010r 2  BD D0 09       lda FX_T,x
001013r 2  D0 05          bne @done
001015r 2  CA             dex
001016r 2  10 F8          bpl @fx
001018r 2  A9 00          lda #0
00101Ar 2               @done:
00101Ar 2  60             rts
00101Br 2               
00101Br 2               ; SetupShip - ship X's course, heading and shot. Keeps X.
00101Br 2               SetupShip:
00101Br 2  86 D5          stx TI
00101Dr 2  20 rr rr       jsr ShipCenter
001020r 2  A5 7F          lda HX
001022r 2  9D 3C 08       sta POS_X_HI,x
001025r 2  9E 38 08       stz POS_X_LO,x
001028r 2  A5 80          lda HY
00102Ar 2  9D 44 08       sta POS_Y_HI,x
00102Dr 2  9E 40 08       stz POS_Y_LO,x
001030r 2                 ; where it's going: velocity is the distance * 4 (64 ticks, 8.8 pixels)
001030r 2  BC 28 08       ldy PLAN_R,x
001033r 2  BD 24 08       lda PLAN_C,x
001036r 2  AA             tax
001037r 2  20 rr rr       jsr HexCenter
00103Ar 2  A6 D5          ldx TI
00103Cr 2  A5 7F          lda HX
00103Er 2  38             sec
00103Fr 2  FD 3C 08       sbc POS_X_HI,x
001042r 2  85 C0          sta HDX
001044r 2  A9 00          lda #0
001046r 2  E9 00          sbc #0
001048r 2  85 C1          sta HDX+1
00104Ar 2  A5 80          lda HY
00104Cr 2  38             sec
00104Dr 2  FD 44 08       sbc POS_Y_HI,x
001050r 2  85 C2          sta HDY
001052r 2  A9 00          lda #0
001054r 2  E9 00          sbc #0
001056r 2  85 C3          sta HDY+1
001058r 2  A5 C0          lda HDX
00105Ar 2  85 40          sta T0
00105Cr 2  A5 C1          lda HDX+1
00105Er 2  85 41          sta T1
001060r 2  06 40          asl T0
001062r 2  26 41          rol T1
001064r 2  06 40          asl T0
001066r 2  26 41          rol T1
001068r 2  A5 40          lda T0
00106Ar 2  9D 48 08       sta VEL_X_LO,x
00106Dr 2  A5 41          lda T1
00106Fr 2  9D 4C 08       sta VEL_X_HI,x
001072r 2  A5 C2          lda HDY
001074r 2  85 40          sta T0
001076r 2  A5 C3          lda HDY+1
001078r 2  85 41          sta T1
00107Ar 2  06 40          asl T0
00107Cr 2  26 41          rol T1
00107Er 2  06 40          asl T0
001080r 2  26 41          rol T1
001082r 2  A5 40          lda T0
001084r 2  9D 50 08       sta VEL_Y_LO,x
001087r 2  A5 41          lda T1
001089r 2  9D 54 08       sta VEL_Y_HI,x
00108Cr 2  20 rr rr       jsr HeadingOf
00108Fr 2  A6 D5          ldx TI
001091r 2  C9 FF          cmp #$FF
001093r 2  F0 03          beq @noTurn
001095r 2  9D 20 08       sta SHIP_HEAD,x
001098r 2               @noTurn:
001098r 2  BD 84 09       lda PLAN_SPECIAL,x
00109Br 2  F0 0A          beq @aim
00109Dr 2  BD 00 08       lda SHIP_FACTION,x
0010A0r 2  C9 03          cmp #SP_JUMP
0010A2r 2  D0 03          bne @aim
0010A4r 2  20 rr rr       jsr StartJump
0010A7r 2               @aim:
0010A7r 2  BC 30 08       ldy AIM_R,x
0010AAr 2  BD 2C 08       lda AIM_C,x
0010ADr 2  AA             tax
0010AEr 2  20 rr rr       jsr HexCenter
0010B1r 2  A6 D5          ldx TI
0010B3r 2  A5 7F          lda HX
0010B5r 2  9D 94 08       sta AIM_X,x
0010B8r 2  A5 80          lda HY
0010BAr 2  9D 98 08       sta AIM_Y,x
0010BDr 2  BD 84 09       lda PLAN_SPECIAL,x
0010C0r 2  F0 0F          beq @shot
0010C2r 2  BD 00 08       lda SHIP_FACTION,x
0010C5r 2  D0 03          bne @notFlak
0010C7r 2  4C rr rr       jmp LaunchShell
0010CAr 2               @notFlak:
0010CAr 2  C9 01          cmp #SP_MINE
0010CCr 2  D0 13          bne @noShot                      ; a cloak or a jump takes the shot's place
0010CEr 2  20 rr rr       jsr LayMine
0010D1r 2               @shot:
0010D1r 2  BD 34 08       lda PLAN_WEAPON,x
0010D4r 2  D0 0C          bne LaunchTorpedo
0010D6r 2  A9 01          lda #1
0010D8r 2  9D 9C 08       sta FIRING,x
0010DBr 2  9E 80 08       stz BEAM_DX,x
0010DEr 2  9E 84 08       stz BEAM_DY,x
0010E1r 2               @noShot:
0010E1r 2  60             rts
0010E2r 2               
0010E2r 2               ; LaunchTorpedo - from where ship X starts, through its aim, 3.75 pixels a tick.
0010E2r 2               LaunchTorpedo:
0010E2r 2  20 rr rr       jsr AimVector
0010E5r 2  20 rr rr       jsr ScaleDir
