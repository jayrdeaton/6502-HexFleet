0009B4r 2  D0 96          bne @side
0009B6r 2  60             rts
0009B7r 2               
0009B7r 2               ; The six sides of a hex: right, left, upper right, upper left, lower right, lower
0009B7r 2               ; left. The neighbor across each, then the pixels of the side from the hex's center,
0009B7r 2               ; the same pixels as the grid's lines.
0009B7r 2               SideColEven:
0009B7r 2  01 FF 01 00    .byte 1, $FF, 1, 0, 1, 0
0009BBr 2  01 00        
0009BDr 2               SideColOdd:
0009BDr 2  01 FF 00 FF    .byte 1, $FF, 0, $FF, 0, $FF
0009C1r 2  00 FF        
0009C3r 2               SideRow:
0009C3r 2  00 00 FF FF    .byte 0, 0, $FF, $FF, 1, 1
0009C7r 2  01 01        
0009C9r 2               SideX:
0009C9r 2  0A 0A 0A 0A  .repeat 11, I
0009CDr 2  0A 0A 0A 0A  
0009D1r 2  0A 0A 0A     
0009D4r 2                 .byte 10
0009D4r 2               .endrepeat
0009D4r 2  F6 F6 F6 F6  .repeat 11, I
0009D8r 2  F6 F6 F6 F6  
0009DCr 2  F6 F6 F6     
0009DFr 2                 .byte <(-10)
0009DFr 2               .endrepeat
0009DFr 2  00 01 02 03  .repeat 11, I
0009E3r 2  04 05 06 07  
0009E7r 2  08 09 0A     
0009EAr 2                 .byte I
0009EAr 2               .endrepeat
0009EAr 2  F6 F7 F8 F9  .repeat 11, I
0009EEr 2  FA FB FC FD  
0009F2r 2  FE FF 00     
0009F5r 2                 .byte <(I - 10)
0009F5r 2               .endrepeat
0009F5r 2  00 01 02 03  .repeat 11, I
0009F9r 2  04 05 06 07  
0009FDr 2  08 09 0A     
000A00r 2                 .byte I
000A00r 2               .endrepeat
000A00r 2  F6 F7 F8 F9  .repeat 11, I
000A04r 2  FA FB FC FD  
000A08r 2  FE FF 00     
000A0Br 2                 .byte <(I - 10)
000A0Br 2               .endrepeat
000A0Br 2               SideY:
000A0Br 2  FB FC FD FE  .repeat 11, I
000A0Fr 2  FF 00 01 02  
000A13r 2  03 04 05     
000A16r 2                 .byte <(I - 5)
000A16r 2               .endrepeat
000A16r 2  FB FC FD FE  .repeat 11, I
000A1Ar 2  FF 00 01 02  
000A1Er 2  03 04 05     
000A21r 2                 .byte <(I - 5)
000A21r 2               .endrepeat
000A21r 2  F6 F6 F7 F7  .repeat 11, I
000A25r 2  F8 F8 F9 F9  
000A29r 2  FA FA FB     
000A2Cr 2                 .byte <(I / 2 - 10)
000A2Cr 2               .endrepeat
000A2Cr 2  FB FA FA F9  .repeat 11, I
000A30r 2  F9 F8 F8 F7  
000A34r 2  F7 F6 F6     
000A37r 2                 .byte <(5 - (I + 1) / 2 - 10)
000A37r 2               .endrepeat
000A37r 2  0A 09 09 08  .repeat 11, I
000A3Br 2  08 07 07 06  
000A3Fr 2  06 05 05     
000A42r 2                 .byte <(10 - (I + 1) / 2)
000A42r 2               .endrepeat
000A42r 2  05 05 06 06  .repeat 11, I
000A46r 2  07 07 08 08  
000A4Ar 2  09 09 0A     
000A4Dr 2                 .byte <(5 + I / 2)
000A4Dr 2               .endrepeat
