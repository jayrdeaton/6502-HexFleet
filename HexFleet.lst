00043Br 2               ; LineShow - LINEBUF on panel row A in TXT_INK.
00043Br 2               LineShow:
00043Br 2  A2 E0          ldx #<LINEBUF
00043Dr 2  A0 08          ldy #>LINEBUF
00043Fr 2                 ; falls through
00043Fr 2               
00043Fr 2               ; Print - the string X (low), Y (high) on panel row A in TXT_INK, padded to
00043Fr 2               ; the panel's width.
00043Fr 2               Print:
00043Fr 2  86 79          stx TXT_PTR
000441r 2  84 7A          sty TXT_PTR+1
000443r 2  AA             tax
000444r 2  BD rr rr       lda RowLo,x
000447r 2  18             clc
000448r 2  69 1D          adc #PANEL_COL
00044Ar 2  85 40          sta T0
00044Cr 2  BD rr rr       lda RowHi,x
00044Fr 2  69 00          adc #0
000451r 2  85 41          sta T1
000453r 2                 ; the characters
000453r 2  A5 41          lda T1
000455r 2  18             clc
000456r 2  69 08          adc #>V_L1NAME
000458r 2  AA             tax
000459r 2  A5 40          lda T0
00045Br 2  20 rr rr       jsr VAddr
00045Er 2  A0 00          ldy #0
000460r 2               @char:
000460r 2  B1 79          lda (TXT_PTR),y
000462r 2  F0 0A          beq @pad
000464r 2  8D 00 9C       sta VC_DATA
000467r 2  C8             iny
000468r 2  C0 0B          cpy #PANEL_W
00046Ar 2  D0 F4          bne @char
00046Cr 2  80 0A          bra @color
00046Er 2               @pad:
00046Er 2  A9 20          lda #' '
000470r 2  8D 00 9C       sta VC_DATA
000473r 2  C8             iny
000474r 2  C0 0B          cpy #PANEL_W
000476r 2  D0 F6          bne @pad
000478r 2               @color:
000478r 2  A5 41          lda T1
00047Ar 2  18             clc
00047Br 2  69 10          adc #>V_L1ATTR
00047Dr 2  AA             tax
00047Er 2  A5 40          lda T0
000480r 2  20 rr rr       jsr VAddr
000483r 2  A5 78          lda TXT_INK                       ; its sub-palette
000485r 2  18             clc
000486r 2  69 03          adc #3
000488r 2  A0 0B          ldy #PANEL_W
00048Ar 2               @ink:
00048Ar 2  8D 00 9C       sta VC_DATA
00048Dr 2  88             dey
00048Er 2  D0 FA          bne @ink
000490r 2  60             rts
000491r 2               
000491r 2               ; PanelClear - blank panel row A.
000491r 2               PanelClear:
000491r 2  A2 rr          ldx #<TxtNone
000493r 2  A0 rr          ldy #>TxtNone
000495r 2  4C rr rr       jmp Print
000498r 2               TxtNone:
000498r 2  00             .byte 0
000499r 2               
000499r 2               ; --- Sprites ---
000499r 2               
000499r 2               HideSprites:
000499r 2  A2 1A          ldx #NUM_SLOTS - 1
00049Br 2               @loop:
00049Br 2  A9 F0          lda #HIDE_Y
00049Dr 2  9D 00 0A       sta SPR_Y,x
0004A0r 2  9E 20 0A       stz SPR_X,x
0004A3r 2  9E 40 0A       stz SPR_N,x
0004A6r 2  9E 60 0A       stz SPR_A,x
0004A9r 2  CA             dex
0004AAr 2  10 EF          bpl @loop
0004ACr 2  60             rts
0004ADr 2               
0004ADr 2               HideSprite:
0004ADr 2  A9 F0          lda #HIDE_Y
0004AFr 2  9D 00 0A       sta SPR_Y,x
0004B2r 2  60             rts
0004B3r 2               
0004B3r 2               ; PlaceSprite - slot X centered on (HX, HY), pattern A, attribute Y.
0004B3r 2               PlaceSprite:
0004B3r 2  9D 40 0A       sta SPR_N,x
0004B6r 2  98             tya
0004B7r 2  9D 60 0A       sta SPR_A,x
0004BAr 2  A5 7F          lda HX
0004BCr 2  38             sec
0004BDr 2  E9 08          sbc #8
0004BFr 2  9D 20 0A       sta SPR_X,x
0004C2r 2  A5 80          lda HY
0004C4r 2  38             sec
0004C5r 2  E9 08          sbc #8
0004C7r 2  9D 00 0A       sta SPR_Y,x
0004CAr 2  60             rts
0004CBr 2               
0004CBr 2               UploadSprites:
0004CBr 2  A9 00          lda #<V_SPRATTR
0004CDr 2  A2 16          ldx #>V_SPRATTR
0004CFr 2  20 rr rr       jsr VAddr
0004D2r 2  A2 00          ldx #0
0004D4r 2               @slot:
0004D4r 2  BD 00 0A       lda SPR_Y,x
0004D7r 2  8D 00 9C       sta VC_DATA
0004DAr 2  BD 20 0A       lda SPR_X,x
0004DDr 2  8D 00 9C       sta VC_DATA
0004E0r 2  BD 40 0A       lda SPR_N,x
0004E3r 2  8D 00 9C       sta VC_DATA
0004E6r 2  BD 60 0A       lda SPR_A,x
0004E9r 2  8D 00 9C       sta VC_DATA
0004ECr 2  E8             inx
0004EDr 2  E0 1B          cpx #NUM_SLOTS
0004EFr 2  D0 E3          bne @slot
0004F1r 2  60             rts
0004F2r 2               
0004F2r 2               ; --- The canvas ---
0004F2r 2               
0004F2r 2               ; SetTile - all of tile X's pixel bytes to A. Keeps X.
0004F2r 2               SetTile:
0004F2r 2  9D 00 20 9D  .repeat 16, I
0004F6r 2  00 21 9D 00  
0004FAr 2  22 9D 00 23  
000522r 2                 sta CT_ROWS + I * 256,x
000522r 2               .endrepeat
000522r 2  60             rts
000523r 2               
000523r 2               ; CanvasReset - forget every tile (layer 1 is about to be cleared).
000523r 2               CanvasReset:
000523r 2  A2 FE          ldx #POOL_TILES - 1
000525r 2               @tile:
000525r 2  9E 00 1C       stz TILE_STATE,x
000528r 2  A9 00          lda #0
00052Ar 2  20 rr rr       jsr SetTile
00052Dr 2  CA             dex
00052Er 2  E0 FF          cpx #$FF
000530r 2  D0 F3          bne @tile
000532r 2  64 52          stz ALLOC
000534r 2  9C F0 0F       stz POOL_HI
000537r 2  A9 00          lda #<CELLMAP
000539r 2  85 48          sta PTR0
00053Br 2  A9 10          lda #>CELLMAP
00053Dr 2  85 49          sta PTR0+1
00053Fr 2  A2 05          ldx #5                            ; 1200 bytes fit in 5 pages
000541r 2  A0 00          ldy #0
000543r 2  98             tya
000544r 2               @page:
000544r 2  91 48          sta (PTR0),y
000546r 2  C8             iny
000547r 2  D0 FB          bne @page
000549r 2  E6 49          inc PTR0+1
00054Br 2  CA             dex
00054Cr 2  D0 F6          bne @page
00054Er 2  60             rts
00054Fr 2               
00054Fr 2               ; CanvasBegin - start a new drawing. What's on screen stays until
00054Fr 2               ; CanvasFlush, which replaces it in one go, so nothing blinks.
00054Fr 2               CanvasBegin:
00054Fr 2  64 52          stz ALLOC
000551r 2  64 A1          stz PFILL
000553r 2  A9 04          lda #CANVAS_SUB
000555r 2  85 A0          sta PATTR
000557r 2  AE F0 0F       ldx POOL_HI
00055Ar 2               @tile:
00055Ar 2  BD 00 1C       lda TILE_STATE,x
00055Dr 2  F0 0A          beq @next
00055Fr 2  A9 01          lda #1
000561r 2  9D 00 1C       sta TILE_STATE,x
000564r 2  A9 00          lda #0
000566r 2  20 rr rr       jsr SetTile
000569r 2               @next:
000569r 2  CA             dex
00056Ar 2  E0 FF          cpx #$FF
00056Cr 2  D0 EC          bne @tile
00056Er 2  60             rts
00056Fr 2               
00056Fr 2               ; CanvasPlot - pixel (PX, PY) in value PINK. A full pool drops it.
00056Fr 2               CanvasPlot:
00056Fr 2  A5 4F          lda PY
000571r 2  4A             lsr a
000572r 2  4A             lsr a
000573r 2  4A             lsr a
000574r 2  AA             tax
000575r 2  A5 4E          lda PX
000577r 2  4A             lsr a
000578r 2  4A             lsr a
000579r 2  4A             lsr a
00057Ar 2  18             clc
00057Br 2  7D rr rr       adc RowLo,x
00057Er 2  85 4C          sta CMAP
000580r 2  BD rr rr       lda RowHi,x
000583r 2  69 10          adc #>CELLMAP
000585r 2  85 4D          sta CMAP+1
000587r 2  B2 4C          lda (CMAP)
000589r 2  D0 30          bne @have
00058Br 2                 ; a new cell: find a free tile
00058Br 2  A6 52          ldx ALLOC
00058Dr 2               @find:
00058Dr 2  E0 FF          cpx #POOL_TILES
00058Fr 2  B0 08          bcs @full
000591r 2  BD 00 1C       lda TILE_STATE,x
000594r 2  F0 06          beq @got
000596r 2  E8             inx
000597r 2  80 F4          bra @find
000599r 2               @full:
000599r 2  86 52          stx ALLOC
00059Br 2  60             rts
00059Cr 2               @got:
00059Cr 2  86 52          stx ALLOC
00059Er 2  EC F0 0F       cpx POOL_HI
0005A1r 2  90 03          bcc @below
0005A3r 2  8E F0 0F       stx POOL_HI
0005A6r 2               @below:
0005A6r 2  8A             txa
0005A7r 2  1A             inc a
0005A8r 2  92 4C          sta (CMAP)
0005AAr 2  A5 4C          lda CMAP
0005ACr 2  9D 00 1D       sta TILE_LO,x
0005AFr 2  A5 4D          lda CMAP+1
0005B1r 2  9D 00 1E       sta TILE_HI,x
0005B4r 2  A9 03          lda #3
0005B6r 2  9D 00 1C       sta TILE_STATE,x
0005B9r 2  80 0E          bra @fresh
0005BBr 2               @have:
0005BBr 2  3A             dec a
0005BCr 2  AA             tax
0005BDr 2  BD 00 1C       lda TILE_STATE,x
0005C0r 2  C9 01          cmp #1
0005C2r 2  D0 0E          bne @plot
0005C4r 2  A9 02          lda #2
0005C6r 2  9D 00 1C       sta TILE_STATE,x
0005C9r 2               @fresh:
0005C9r 2  A5 A1          lda PFILL
0005CBr 2  F0 05          beq @plot
0005CDr 2  A9 FF          lda #$FF
0005CFr 2  20 rr rr       jsr SetTile
0005D2r 2               @plot:
0005D2r 2  A5 A0          lda PATTR
0005D4r 2  9D 00 1F       sta TILE_ATTR,x
0005D7r 2  DA             phx
0005D8r 2                 ; which of the tile's 16 bytes: two a row, four pixels each
0005D8r 2  A5 4F          lda PY
0005DAr 2  29 07          and #7
0005DCr 2  0A             asl a
0005DDr 2  85 50          sta PMASK
0005DFr 2  A5 4E          lda PX
0005E1r 2  29 04          and #4
0005E3r 2  4A             lsr a
0005E4r 2  4A             lsr a
0005E5r 2  05 50          ora PMASK
0005E7r 2  A8             tay
0005E8r 2  B9 rr rr       lda CtLo,y
0005EBr 2  85 4A          sta PTR1
0005EDr 2  B9 rr rr       lda CtHi,y
0005F0r 2  85 4B          sta PTR1+1
0005F2r 2  A5 4E          lda PX
0005F4r 2  29 03          and #3
0005F6r 2  A8             tay
0005F7r 2  B9 rr rr       lda PixClear,y
0005FAr 2  85 50          sta PMASK
0005FCr 2  84 40          sty T0
0005FEr 2  A5 51          lda PINK
000600r 2  0A             asl a
000601r 2  0A             asl a
000602r 2  05 40          ora T0
000604r 2  AA             tax
000605r 2  7A             ply
000606r 2  B1 4A          lda (PTR1),y
000608r 2  25 50          and PMASK
00060Ar 2  1D rr rr       ora PixBits,x
00060Dr 2  91 4A          sta (PTR1),y
00060Fr 2  60             rts
000610r 2               
000610r 2               ; CanvasFlush - show the drawing: new tiles in, old ones out.
000610r 2               CanvasFlush:
000610r 2  9C F1 0F       stz HI_SET
000613r 2  AE F0 0F       ldx POOL_HI
000616r 2  9C F0 0F       stz POOL_HI
000619r 2               @tile:
000619r 2  BD 00 1C       lda TILE_STATE,x
00061Cr 2  D0 03          bne @used
00061Er 2  4C rr rr       jmp @next
000621r 2               @used:
000621r 2  C9 01          cmp #1
000623r 2  D0 2E          bne @drawn
000625r 2                 ; stale: its cell goes blank and the tile is free again
000625r 2  BD 00 1D       lda TILE_LO,x
000628r 2  85 4C          sta CMAP
00062Ar 2  BD 00 1E       lda TILE_HI,x
00062Dr 2  85 4D          sta CMAP+1
00062Fr 2  A9 00          lda #0
000631r 2  92 4C          sta (CMAP)
000633r 2  9E 00 1C       stz TILE_STATE,x
000636r 2  DA             phx
000637r 2  A6 4D          ldx CMAP+1                        ; its color byte too: it holds the high tile bit
000639r 2  A5 4C          lda CMAP
00063Br 2  20 rr rr       jsr VAddr
00063Er 2  9C 00 9C       stz VC_DATA
000641r 2  A5 4D          lda CMAP+1
000643r 2  38             sec
000644r 2  E9 08          sbc #>CELLMAP - >V_L1NAME
000646r 2  AA             tax
000647r 2  A5 4C          lda CMAP
000649r 2  20 rr rr       jsr VAddr
00064Cr 2  9C 00 9C       stz VC_DATA
00064Fr 2  FA             plx
000650r 2  4C rr rr       jmp @next
000653r 2               @drawn:
000653r 2  AD F1 0F       lda HI_SET                        ; counting down, the first one kept is the top
000656r 2  D0 06          bne @topKnown
000658r 2  EE F1 0F       inc HI_SET
00065Br 2  8E F0 0F       stx POOL_HI
00065Er 2               @topKnown:
00065Er 2                 ; its pixels: pool tile x is at V_POOL + x * 16
00065Er 2  8A             txa
00065Fr 2  0A             asl a
000660r 2  0A             asl a
000661r 2  0A             asl a
000662r 2  0A             asl a
000663r 2  85 40          sta T0
000665r 2  8A             txa
000666r 2  4A             lsr a
000667r 2  4A             lsr a
000668r 2  4A             lsr a
000669r 2  4A             lsr a
00066Ar 2  18             clc
00066Br 2  69 28          adc #>V_POOL
00066Dr 2  DA             phx
00066Er 2  AA             tax
00066Fr 2  A5 40          lda T0
000671r 2  20 rr rr       jsr VAddr
000674r 2  FA             plx
000675r 2  BD 00 20 8D  .repeat 16, I
000679r 2  00 9C BD 00  
00067Dr 2  21 8D 00 9C  
0006D5r 2                 lda CT_ROWS + I * 256,x
0006D5r 2                 sta VC_DATA
0006D5r 2               .endrepeat
0006D5r 2                 ; its color (CELLMAP sits at the same address as the attribute table)
0006D5r 2  BD 00 1E       lda TILE_HI,x
0006D8r 2  DA             phx
0006D9r 2  BC 00 1D       ldy TILE_LO,x
0006DCr 2  AA             tax
0006DDr 2  98             tya
0006DEr 2  20 rr rr       jsr VAddr
0006E1r 2  FA             plx
0006E2r 2  BD 00 1F       lda TILE_ATTR,x
0006E5r 2  E0 80          cpx #128                          ; patterns past 255 use the attribute's top bit
0006E7r 2  90 02          bcc @low
0006E9r 2  09 80          ora #$80
0006EBr 2               @low:
0006EBr 2  8D 00 9C       sta VC_DATA
0006EEr 2  BD 00 1C       lda TILE_STATE,x
0006F1r 2  C9 03          cmp #3
0006F3r 2  D0 1C          bne @next
0006F5r 2  A9 02          lda #2
0006F7r 2  9D 00 1C       sta TILE_STATE,x
0006FAr 2                 ; a new cell also needs its name
0006FAr 2  BD 00 1E       lda TILE_HI,x
0006FDr 2  38             sec
0006FEr 2  E9 08          sbc #>CELLMAP - >V_L1NAME
000700r 2  DA             phx
000701r 2  BC 00 1D       ldy TILE_LO,x
000704r 2  AA             tax
000705r 2  98             tya
000706r 2  20 rr rr       jsr VAddr
000709r 2  FA             plx
00070Ar 2  8A             txa
00070Br 2  18             clc
00070Cr 2  69 80          adc #128
00070Er 2  8D 00 9C       sta VC_DATA
000711r 2               @next:
000711r 2  CA             dex
000712r 2  E0 FF          cpx #$FF
000714r 2  F0 03          beq @done
000716r 2  4C rr rr       jmp @tile
000719r 2               @done:
000719r 2  60             rts
00071Ar 2               
00071Ar 2               CanvasClear:
00071Ar 2  20 rr rr       jsr CanvasBegin
00071Dr 2  4C rr rr       jmp CanvasFlush
000720r 2               
000720r 2               ; ReadGlyph - character A's 8 rows from the font into GLYPH.
000720r 2               ReadGlyph:
000720r 2  85 40          sta T0
000722r 2  64 41          stz T1
000724r 2  06 40          asl T0
000726r 2  26 41          rol T1
000728r 2  06 40          asl T0
00072Ar 2  26 41          rol T1
00072Cr 2  06 40          asl T0
00072Er 2  26 41          rol T1
000730r 2  A5 40          lda T0
000732r 2  8D 01 9C       sta VC_REG                        ; a read address: no write bit
000735r 2  A5 41          lda T1
000737r 2  18             clc
000738r 2  69 18          adc #>V_FONT
00073Ar 2  8D 01 9C       sta VC_REG
00073Dr 2  A2 00          ldx #0
00073Fr 2               @row:
00073Fr 2  AD 00 9C       lda VC_DATA
000742r 2  9D F8 08       sta GLYPH,x
000745r 2  E8             inx
000746r 2  E0 08          cpx #8
000748r 2  D0 F5          bne @row
00074Ar 2  60             rts
00074Br 2               
00074Br 2               ; BandClear - a solid band across the board for big text.
00074Br 2               BandClear:
00074Br 2  A2 0C          ldx #BAND_ROW
00074Dr 2               @row:
00074Dr 2  DA             phx
00074Er 2  BD rr rr       lda RowHi,x
000751r 2  18             clc
000752r 2  69 08          adc #>V_L1NAME
000754r 2  48             pha
000755r 2  BD rr rr       lda RowLo,x
000758r 2  FA             plx
000759r 2  48             pha
00075Ar 2  20 rr rr       jsr VAddr
00075Dr 2  68             pla
00075Er 2  85 40          sta T0
000760r 2  A9 0A          lda #PAT_SOLID
000762r 2  A0 1D          ldy #BOARD_CELLS
000764r 2               @name:
000764r 2  8D 00 9C       sta VC_DATA
000767r 2  88             dey
000768r 2  D0 FA          bne @name
00076Ar 2  8A             txa
00076Br 2  18             clc
00076Cr 2  69 08          adc #>V_L1ATTR - >V_L1NAME
00076Er 2  AA             tax
00076Fr 2  A5 40          lda T0
000771r 2  20 rr rr       jsr VAddr
000774r 2  A9 04          lda #CANVAS_SUB
000776r 2  A0 1D          ldy #BOARD_CELLS
000778r 2               @attr:
000778r 2  8D 00 9C       sta VC_DATA
00077Br 2  88             dey
00077Cr 2  D0 FA          bne @attr
00077Er 2  FA             plx
00077Fr 2  E8             inx
000780r 2  E0 11          cpx #BAND_ROW + BAND_ROWS
000782r 2  D0 C9          bne @row
000784r 2  60             rts
000785r 2               
000785r 2               ; BigText - the string X (low), Y (high), A times normal size, centered on the
000785r 2               ; band in TXT_INK.
000785r 2               BigText:
000785r 2  85 7E          sta BIG_S
000787r 2  86 79          stx TXT_PTR
000789r 2  84 7A          sty TXT_PTR+1
00078Br 2  20 rr rr       jsr BandClear
00078Er 2  A0 00          ldy #0
000790r 2               @len:
000790r 2  B1 79          lda (TXT_PTR),y
000792r 2  F0 03          beq @counted
000794r 2  C8             iny
000795r 2  80 F9          bra @len
000797r 2               @counted:
000797r 2                 ; width = length * 8 * scale; x = BOARD_X + (220 - width) / 2
000797r 2  98             tya
000798r 2  0A             asl a
000799r 2  0A             asl a
00079Ar 2  0A             asl a
00079Br 2  A6 7E          ldx BIG_S
00079Dr 2  20 rr rr       jsr Mul8
0007A0r 2  A9 DC          lda #220
0007A2r 2  38             sec
0007A3r 2  E5 56          sbc PROD
0007A5r 2  4A             lsr a
0007A6r 2  18             clc
0007A7r 2  69 04          adc #BOARD_X
0007A9r 2  85 7C          sta BIG_X
0007ABr 2                 ; y centered in the band
0007ABr 2  A5 7E          lda BIG_S
0007ADr 2  0A             asl a
0007AEr 2  0A             asl a
0007AFr 2  0A             asl a
0007B0r 2  85 40          sta T0
0007B2r 2  A9 28          lda #BAND_ROWS * 8
0007B4r 2  38             sec
0007B5r 2  E5 40          sbc T0
0007B7r 2  4A             lsr a
0007B8r 2  18             clc
0007B9r 2  69 60          adc #BAND_ROW * 8
0007BBr 2  85 7D          sta BIG_Y
0007BDr 2  20 rr rr       jsr CanvasBegin
0007C0r 2  A9 01          lda #1                            ; the letters in the ink, on the dark band
0007C2r 2  85 51          sta PINK
0007C4r 2  85 A1          sta PFILL
0007C6r 2  A5 78          lda TXT_INK
0007C8r 2  18             clc
0007C9r 2  69 03          adc #3
0007CBr 2  85 A0          sta PATTR
0007CDr 2  64 B6          stz HD_S                          ; which character
0007CFr 2               @char:
0007CFr 2  A4 B6          ldy HD_S
0007D1r 2  B1 79          lda (TXT_PTR),y
0007D3r 2  F0 33          beq @show
0007D5r 2  20 rr rr       jsr ReadGlyph
0007D8r 2  64 B4          stz HD_Q                          ; glyph row
0007DAr 2               @gRow:
0007DAr 2  A6 B4          ldx HD_Q
0007DCr 2  BD F8 08       lda GLYPH,x
0007DFr 2  85 B5          sta HD_DR
0007E1r 2  64 B7          stz RC                            ; glyph column
0007E3r 2               @gCol:
0007E3r 2  06 B5          asl HD_DR
0007E5r 2  90 03          bcc @gNext
0007E7r 2  20 rr rr       jsr BigPixel
0007EAr 2               @gNext:
0007EAr 2  E6 B7          inc RC
0007ECr 2  A5 B7          lda RC
0007EEr 2  C9 08          cmp #8
0007F0r 2  D0 F1          bne @gCol
0007F2r 2  E6 B4          inc HD_Q
0007F4r 2  A5 B4          lda HD_Q
0007F6r 2  C9 08          cmp #8
0007F8r 2  D0 E0          bne @gRow
0007FAr 2  A5 7E          lda BIG_S
0007FCr 2  0A             asl a
0007FDr 2  0A             asl a
0007FEr 2  0A             asl a
0007FFr 2  18             clc
000800r 2  65 7C          adc BIG_X
000802r 2  85 7C          sta BIG_X
000804r 2  E6 B6          inc HD_S
000806r 2  80 C7          bra @char
000808r 2               @show:
000808r 2  4C rr rr       jmp CanvasFlush
00080Br 2               
00080Br 2               ; BigPixel - glyph pixel (RC, HD_Q) as a BIG_S x BIG_S block.
00080Br 2               BigPixel:
00080Br 2  A5 B7          lda RC
00080Dr 2  A6 7E          ldx BIG_S
00080Fr 2  20 rr rr       jsr Mul8
000812r 2  A5 56          lda PROD
000814r 2  18             clc
000815r 2  65 7C          adc BIG_X
000817r 2  85 B0          sta HD_C1
000819r 2  A5 B4          lda HD_Q
00081Br 2  A6 7E          ldx BIG_S
00081Dr 2  20 rr rr       jsr Mul8
000820r 2  A5 56          lda PROD
000822r 2  18             clc
000823r 2  65 7D          adc BIG_Y
000825r 2  85 4F          sta PY
000827r 2  A5 7E          lda BIG_S
000829r 2  85 B1          sta HD_R1
00082Br 2               @y:
00082Br 2  A5 B0          lda HD_C1
00082Dr 2  85 4E          sta PX
00082Fr 2  A5 7E          lda BIG_S
000831r 2  85 B3          sta HD_R2
000833r 2               @x:
000833r 2  20 rr rr       jsr CanvasPlot
000836r 2  E6 4E          inc PX
000838r 2  C6 B3          dec HD_R2
00083Ar 2  D0 F7          bne @x
00083Cr 2  E6 4F          inc PY
00083Er 2  C6 B1          dec HD_R1
000840r 2  D0 E9          bne @y
000842r 2  60             rts
000843r 2               
000843r 1               .include "src/math.asm"
000843r 2               ; =============================================================================
000843r 2               ;   math.asm - multiply, divide, square root, absolute value
000843r 2               ; =============================================================================
000843r 2               
000843r 2               .segment "CART"
000843r 2               
000843r 2               ; Mul8 - A * X, unsigned, into PROD (16-bit). Clobbers A, X.
000843r 2               Mul8:
000843r 2  85 DB          sta MUL1
000845r 2  86 DC          stx MUL2
000847r 2  A9 00          lda #0
000849r 2  A2 08          ldx #8
00084Br 2  46 DC          lsr MUL2
00084Dr 2               @loop:
00084Dr 2  90 03          bcc @noAdd
00084Fr 2  18             clc
000850r 2  65 DB          adc MUL1
000852r 2               @noAdd:
000852r 2  6A             ror a
000853r 2  66 56          ror PROD
000855r 2  46 DC          lsr MUL2
000857r 2  CA             dex
000858r 2  D0 F3          bne @loop
00085Ar 2  85 57          sta PROD+1
00085Cr 2  60             rts
00085Dr 2               
00085Dr 2               ; SMul - MA (signed byte) * MB (signed 16-bit, |MB| < 256) into PROD,
00085Dr 2               ; signed. Clobbers A, X.
00085Dr 2               SMul:
00085Dr 2  64 DD          stz MSIGN
00085Fr 2  A5 55          lda MB+1
000861r 2  10 0D          bpl @bPos
000863r 2  A5 54          lda MB                           ; |MB| = -MB, which fits in a byte
000865r 2  49 FF          eor #$FF
000867r 2  18             clc
000868r 2  69 01          adc #1
00086Ar 2  85 DE          sta MAGB
00086Cr 2  E6 DD          inc MSIGN
00086Er 2  80 04          bra @a
000870r 2               @bPos:
000870r 2  A5 54          lda MB
000872r 2  85 DE          sta MAGB
000874r 2               @a:
000874r 2  A5 53          lda MA
000876r 2  10 0D          bpl @aPos
000878r 2  49 FF          eor #$FF
00087Ar 2  18             clc
00087Br 2  69 01          adc #1
00087Dr 2  48             pha
00087Er 2  A5 DD          lda MSIGN
000880r 2  49 01          eor #1
000882r 2  85 DD          sta MSIGN
000884r 2  68             pla
000885r 2               @aPos:
000885r 2  A6 DE          ldx MAGB
000887r 2  20 rr rr       jsr Mul8
00088Ar 2  A5 DD          lda MSIGN
00088Cr 2  F0 03          beq @done
00088Er 2  4C rr rr       jmp NegProd
000891r 2               @done:
000891r 2  60             rts
000892r 2               
000892r 2               ; NegProd - PROD = -PROD.
000892r 2               NegProd:
000892r 2  A5 56          lda PROD
000894r 2  49 FF          eor #$FF
000896r 2  18             clc
000897r 2  69 01          adc #1
000899r 2  85 56          sta PROD
00089Br 2  A5 57          lda PROD+1
00089Dr 2  49 FF          eor #$FF
00089Fr 2  69 00          adc #0
0008A1r 2  85 57          sta PROD+1
0008A3r 2  60             rts
0008A4r 2               
0008A4r 2               ; Div16 - DIVIDEND (16-bit) / DIVISOR (8-bit, not 0) into QUOT (16-bit) and
0008A4r 2               ; REM. Clobbers A, X, DIVIDEND.
0008A4r 2               Div16:
0008A4r 2  A9 00          lda #0
0008A6r 2  A2 10          ldx #16
0008A8r 2               @loop:
0008A8r 2  06 58          asl DIVIDEND
0008AAr 2  26 59          rol DIVIDEND+1
0008ACr 2  2A             rol a
0008ADr 2  B0 04          bcs @sub                         ; remainder passed 255: it's over DIVISOR
0008AFr 2  C5 5A          cmp DIVISOR
0008B1r 2  90 04          bcc @skip
0008B3r 2               @sub:
0008B3r 2  E5 5A          sbc DIVISOR                      ; carry is set either way
0008B5r 2  E6 58          inc DIVIDEND                     ; this quotient bit is 1
0008B7r 2               @skip:
0008B7r 2  CA             dex
0008B8r 2  D0 EE          bne @loop
0008BAr 2  85 5D          sta REM
0008BCr 2  A5 58          lda DIVIDEND
0008BEr 2  85 5B          sta QUOT
0008C0r 2  A5 59          lda DIVIDEND+1
0008C2r 2  85 5C          sta QUOT+1
0008C4r 2  60             rts
0008C5r 2               
0008C5r 2               ; Isqrt - square root of SQRT_IN (16-bit, under 16384), rounded down, in A.
0008C5r 2               ; Clobbers X.
0008C5r 2               Isqrt:
0008C5r 2  64 DF          stz SQ_R
0008C7r 2  A9 80          lda #$80
0008C9r 2  85 E0          sta SQ_BIT
0008CBr 2               @loop:
0008CBr 2  A5 DF          lda SQ_R
0008CDr 2  05 E0          ora SQ_BIT
0008CFr 2  85 E1          sta SQ_T
0008D1r 2  AA             tax
0008D2r 2  20 rr rr       jsr Mul8
0008D5r 2  A5 57          lda PROD+1                       ; keep the bit if SQ_T squared <= SQRT_IN
0008D7r 2  C5 5F          cmp SQRT_IN+1
0008D9r 2  90 0A          bcc @take
0008DBr 2  D0 0C          bne @skip
0008DDr 2  A5 56          lda PROD
0008DFr 2  C5 5E          cmp SQRT_IN
0008E1r 2  F0 02          beq @take
0008E3r 2  B0 04          bcs @skip
0008E5r 2               @take:
0008E5r 2  A5 E1          lda SQ_T
0008E7r 2  85 DF          sta SQ_R
0008E9r 2               @skip:
0008E9r 2  46 E0          lsr SQ_BIT
0008EBr 2  D0 DE          bne @loop
0008EDr 2  A5 DF          lda SQ_R
0008EFr 2  60             rts
0008F0r 2               
0008F0r 2               ; Abs8 - A = |A| for a signed byte.
0008F0r 2               Abs8:
0008F0r 2  10 05          bpl @done
0008F2r 2  49 FF          eor #$FF
0008F4r 2  18             clc
0008F5r 2  69 01          adc #1
0008F7r 2               @done:
0008F7r 2  60             rts
0008F8r 2               
0008F8r 2               ; ScaleDir - shrink the vector SD_DX, SD_DY (signed 16-bit, each under 256
0008F8r 2               ; in size) until both fit under 64, keeping its direction, into DIRX, DIRY.
0008F8r 2               ; Z is set if the vector is zero. Clobbers A, X.
0008F8r 2               ScaleDir:
0008F8r 2  64 CD          stz SD_NX
0008FAr 2  64 CE          stz SD_NY
0008FCr 2  A5 C8          lda SD_DX+1
0008FEr 2  10 0B          bpl @xPos
000900r 2  A5 C7          lda SD_DX
000902r 2  49 FF          eor #$FF
000904r 2  18             clc
000905r 2  69 01          adc #1
000907r 2  E6 CD          inc SD_NX
000909r 2  80 02          bra @xDone
00090Br 2               @xPos:
00090Br 2  A5 C7          lda SD_DX
00090Dr 2               @xDone:
00090Dr 2  85 CB          sta SD_AX
00090Fr 2  A5 CA          lda SD_DY+1
000911r 2  10 0B          bpl @yPos
000913r 2  A5 C9          lda SD_DY
000915r 2  49 FF          eor #$FF
000917r 2  18             clc
000918r 2  69 01          adc #1
00091Ar 2  E6 CE          inc SD_NY
00091Cr 2  80 02          bra @yDone
00091Er 2               @yPos:
00091Er 2  A5 C9          lda SD_DY
000920r 2               @yDone:
000920r 2  85 CC          sta SD_AY
000922r 2               @shrink:
000922r 2  A5 CB          lda SD_AX
000924r 2  05 CC          ora SD_AY
000926r 2  29 C0          and #$C0
000928r 2  F0 06          beq @fits
00092Ar 2  46 CB          lsr SD_AX
00092Cr 2  46 CC          lsr SD_AY
00092Er 2  80 F2          bra @shrink
000930r 2               @fits:
000930r 2  A5 CB          lda SD_AX
000932r 2  A6 CD          ldx SD_NX
000934r 2  F0 05          beq @setX
000936r 2  49 FF          eor #$FF
000938r 2  18             clc
000939r 2  69 01          adc #1
00093Br 2               @setX:
00093Br 2  85 90          sta DIRX
00093Dr 2  A5 CC          lda SD_AY
00093Fr 2  A6 CE          ldx SD_NY
000941r 2  F0 05          beq @setY
000943r 2  49 FF          eor #$FF
000945r 2  18             clc
000946r 2  69 01          adc #1
000948r 2               @setY:
000948r 2  85 91          sta DIRY
00094Ar 2  A5 CB          lda SD_AX
00094Cr 2  05 CC          ora SD_AY
00094Er 2  60             rts
00094Fr 2               
00094Fr 2               ; DirLength - LEN = length of (DIRX, DIRY). Clobbers A, X.
00094Fr 2               DirLength:
00094Fr 2  A5 90          lda DIRX
000951r 2  20 rr rr       jsr Abs8
000954r 2  AA             tax
000955r 2  20 rr rr       jsr Mul8
000958r 2  A5 56          lda PROD
00095Ar 2  85 5E          sta SQRT_IN
00095Cr 2  A5 57          lda PROD+1
00095Er 2  85 5F          sta SQRT_IN+1
000960r 2  A5 91          lda DIRY
000962r 2  20 rr rr       jsr Abs8
000965r 2  AA             tax
000966r 2  20 rr rr       jsr Mul8
000969r 2  A5 56          lda PROD
00096Br 2  18             clc
00096Cr 2  65 5E          adc SQRT_IN
00096Er 2  85 5E          sta SQRT_IN
000970r 2  A5 57          lda PROD+1
000972r 2  65 5F          adc SQRT_IN+1
000974r 2  85 5F          sta SQRT_IN+1
000976r 2  20 rr rr       jsr Isqrt
000979r 2  85 92          sta LEN
00097Br 2  60             rts
00097Cr 2               
00097Cr 2               ; NumToText - A (0..255) as three characters, leading spaces, in DIGITS.
00097Cr 2               NumToText:
00097Cr 2  85 CF          sta NT_V
00097Er 2  A2 20          ldx #' '
000980r 2  86 A2          stx DIGITS
000982r 2  86 A3          stx DIGITS+1
000984r 2  64 A5          stz DIGITS+3
000986r 2  A2 00          ldx #0                           ; hundreds
000988r 2               @hundreds:
000988r 2  C9 64          cmp #100
00098Ar 2  90 05          bcc @tens
00098Cr 2  E9 64          sbc #100
00098Er 2  E8             inx
00098Fr 2  80 F7          bra @hundreds
000991r 2               @tens:
000991r 2  E0 00          cpx #0
000993r 2  F0 07          beq @noHundreds
000995r 2  48             pha
000996r 2  8A             txa
000997r 2  09 30          ora #'0'
000999r 2  85 A2          sta DIGITS
00099Br 2  68             pla
00099Cr 2               @noHundreds:
00099Cr 2  A2 00          ldx #0
00099Er 2               @tensLoop:
00099Er 2  C9 0A          cmp #10
0009A0r 2  90 05          bcc @ones
0009A2r 2  E9 0A          sbc #10
0009A4r 2  E8             inx
0009A5r 2  80 F7          bra @tensLoop
0009A7r 2               @ones:
0009A7r 2  09 30          ora #'0'
0009A9r 2  85 A4          sta DIGITS+2
0009ABr 2  E0 00          cpx #0
0009ADr 2  D0 06          bne @setTens
0009AFr 2  A5 A2          lda DIGITS                       ; a zero tens digit shows only after hundreds
0009B1r 2  C9 20          cmp #' '
0009B3r 2  F0 05          beq @done
0009B5r 2               @setTens:
0009B5r 2  8A             txa
0009B6r 2  09 30          ora #'0'
0009B8r 2  85 A3          sta DIGITS+1
0009BAr 2               @done:
0009BAr 2  60             rts
0009BBr 2               
0009BBr 1               .include "src/hex.asm"
0009BBr 2               ; =============================================================================
0009BBr 2               ;   hex.asm - the board's hexes: centers, row lengths, distance, headings
0009BBr 2               ; =============================================================================
0009BBr 2               ;   The board is the app's: 15 rows of pointy hexes. A hex is (C, R): row R
0009BBr 2               ;   0..14 from the top, column C from the left. Even rows hold 10 hexes and
0009BBr 2               ;   sit half a hex to the right; odd rows hold 11. Hexes are 20 pixels wide
0009BBr 2               ;   and rows 15 pixels apart.
0009BBr 2               ; =============================================================================
0009BBr 2               
0009BBr 2               .segment "CART"
0009BBr 2               
0009BBr 2               ; floor((R - 7) / 2) for each row: turns (C, R) into the engine's axial q
0009BBr 2               FloorHalf:
0009BBr 2  FC FD FD FE    .byte $FC, $FD, $FD, $FE, $FE, $FF, $FF, 0, 0, 1, 1, 2, 2, 3, 3
0009BFr 2  FE FF FF 00  
0009C3r 2  00 01 01 02  
0009CAr 2               
0009CAr 2               ; HexCenter - X = column, Y = row: the center pixel in HX, HY. Keeps X, Y.
0009CAr 2               HexCenter:
0009CAr 2  84 E2          sty HC_T
0009CCr 2  98             tya
0009CDr 2  0A             asl a
0009CEr 2  0A             asl a
0009CFr 2  0A             asl a
0009D0r 2  0A             asl a                            ; 16R
0009D1r 2  38             sec
0009D2r 2  E5 E2          sbc HC_T                         ; 15R
0009D4r 2  18             clc
0009D5r 2  69 0F          adc #BOARD_Y + 10
0009D7r 2  85 80          sta HY
0009D9r 2  8A             txa
0009DAr 2  0A             asl a
0009DBr 2  0A             asl a                            ; 4C
0009DCr 2  85 E2          sta HC_T
0009DEr 2  0A             asl a
0009DFr 2  0A             asl a                            ; 16C
0009E0r 2  18             clc
0009E1r 2  65 E2          adc HC_T                         ; 20C
0009E3r 2  69 0E          adc #BOARD_X + 10
0009E5r 2  85 7F          sta HX
0009E7r 2  98             tya
0009E8r 2  29 01          and #1
0009EAr 2  D0 07          bne @done
0009ECr 2  A5 7F          lda HX                           ; even rows sit half a hex right
0009EEr 2  18             clc
0009EFr 2  69 0A          adc #10
0009F1r 2  85 7F          sta HX
0009F3r 2               @done:
0009F3r 2  60             rts
0009F4r 2               
0009F4r 2               ; RowLen - A = row: A = hexes in it.
0009F4r 2               RowLen:
0009F4r 2  29 01          and #1
0009F6r 2  F0 03          beq @even
0009F8r 2  A9 0B          lda #11
0009FAr 2  60             rts
0009FBr 2               @even:
0009FBr 2  A9 0A          lda #10
0009FDr 2  60             rts
0009FEr 2               
0009FEr 2               ; HexDist - hexes between (HD_C1, HD_R1) and (HD_C2, HD_R2), in A.
0009FEr 2               ; Clobbers X.
0009FEr 2               HexDist:
0009FEr 2  A6 B1          ldx HD_R1
000A00r 2  A5 B0          lda HD_C1
000A02r 2  38             sec
000A03r 2  FD rr rr       sbc FloorHalf,x
000A06r 2  85 B4          sta HD_Q                         ; q1
000A08r 2  A6 B3          ldx HD_R2
000A0Ar 2  A5 B2          lda HD_C2
000A0Cr 2  38             sec
000A0Dr 2  FD rr rr       sbc FloorHalf,x                  ; q2
000A10r 2  85 B6          sta HD_S
000A12r 2  A5 B4          lda HD_Q
000A14r 2  38             sec
000A15r 2  E5 B6          sbc HD_S
000A17r 2  85 B4          sta HD_Q                         ; dq
000A19r 2  A5 B1          lda HD_R1
000A1Br 2  38             sec
000A1Cr 2  E5 B3          sbc HD_R2
000A1Er 2  85 B5          sta HD_DR                        ; dr
000A20r 2  18             clc
000A21r 2  65 B4          adc HD_Q
000A23r 2  20 rr rr       jsr Abs8                         ; |dq + dr|
000A26r 2  85 B6          sta HD_S
000A28r 2  A5 B4          lda HD_Q
000A2Ar 2  20 rr rr       jsr Abs8
000A2Dr 2  18             clc
000A2Er 2  65 B6          adc HD_S
000A30r 2  85 B6          sta HD_S
000A32r 2  A5 B5          lda HD_DR
000A34r 2  20 rr rr       jsr Abs8
000A37r 2  18             clc
000A38r 2  65 B6          adc HD_S
000A3Ar 2  4A             lsr a                            ; half of |dq| + |dr| + |dq + dr|
000A3Br 2  60             rts
000A3Cr 2               
000A3Cr 2               ; HeadingOf - heading 0..11 (0 up, then every 30 degrees clockwise) of the
000A3Cr 2               ; vector HDX, HDY (signed 16-bit pixels), in A; $FF if it's zero.
000A3Cr 2               HeadingOf:
000A3Cr 2  A5 C0          lda HDX
000A3Er 2  85 C7          sta SD_DX
000A40r 2  A5 C1          lda HDX+1
000A42r 2  85 C8          sta SD_DX+1
000A44r 2  A5 C2          lda HDY
000A46r 2  85 C9          sta SD_DY
000A48r 2  A5 C3          lda HDY+1
000A4Ar 2  85 CA          sta SD_DY+1
000A4Cr 2  20 rr rr       jsr ScaleDir
000A4Fr 2  D0 03          bne @moving
000A51r 2  A9 FF          lda #$FF
000A53r 2  60             rts
000A54r 2               @moving:
000A54r 2  A5 90          lda DIRX
000A56r 2  20 rr rr       jsr Abs8
000A59r 2  85 C4          sta HG_AX
000A5Br 2  A5 91          lda DIRY
000A5Dr 2  20 rr rr       jsr Abs8
000A60r 2  85 C5          sta HG_AY
000A62r 2                 ; how far from vertical: 0 (within 15 degrees) to 3 (horizontal)
000A62r 2  A5 C4          lda HG_AX
000A64r 2  0A             asl a
000A65r 2  0A             asl a
000A66r 2  C5 C5          cmp HG_AY
000A68r 2  90 16          bcc @s0
000A6Ar 2  F0 14          beq @s0
000A6Cr 2  A5 C4          lda HG_AX
000A6Er 2  C5 C5          cmp HG_AY
000A70r 2  90 12          bcc @s1
000A72r 2  F0 10          beq @s1
000A74r 2  A5 C5          lda HG_AY
000A76r 2  0A             asl a
000A77r 2  0A             asl a
000A78r 2  C5 C4          cmp HG_AX
000A7Ar 2  B0 0C          bcs @s2
000A7Cr 2  A9 03          lda #3
000A7Er 2  80 0A          bra @sector
000A80r 2               @s0:
000A80r 2  A9 00          lda #0
000A82r 2  80 06          bra @sector
000A84r 2               @s1:
000A84r 2  A9 01          lda #1
000A86r 2  80 02          bra @sector
000A88r 2               @s2:
000A88r 2  A9 02          lda #2
000A8Ar 2               @sector:
000A8Ar 2  85 C6          sta HG_S
000A8Cr 2                 ; which quarter
000A8Cr 2  A5 90          lda DIRX
000A8Er 2  30 0D          bmi @left
000A90r 2  A5 91          lda DIRY
000A92r 2  30 06          bmi @upRight
000A94r 2  A9 06          lda #6                           ; down and right: 6 - s
000A96r 2  38             sec
000A97r 2  E5 C6          sbc HG_S
000A99r 2  60             rts
000A9Ar 2               @upRight:
000A9Ar 2  A5 C6          lda HG_S                         ; up and right: s
000A9Cr 2  60             rts
000A9Dr 2               @left:
000A9Dr 2  A5 91          lda DIRY
000A9Fr 2  30 06          bmi @upLeft
000AA1r 2  A9 06          lda #6                           ; down and left: 6 + s
000AA3r 2  18             clc
000AA4r 2  65 C6          adc HG_S
000AA6r 2  60             rts
000AA7r 2               @upLeft:
000AA7r 2  A9 0C          lda #12                          ; up and left: 12 - s, 0 for straight up
000AA9r 2  38             sec
000AAAr 2  E5 C6          sbc HG_S
000AACr 2  C9 0C          cmp #12
000AAEr 2  D0 02          bne @done
000AB0r 2  A9 00          lda #0
000AB2r 2               @done:
000AB2r 2  60             rts
000AB3r 2               
000AB3r 1               .include "src/input.asm"
000AB3r 2               ; =============================================================================
000AB3r 2               ;   input.asm - joysticks and keyboard as one set of controls
000AB3r 2               ; =============================================================================
000AB3r 2               ;   Only one person plans at a time, so either joystick and either key
000AB3r 2               ;   cluster drive the same cursor:
000AB3r 2               ;     move:  stick, W A S D, or the arrow keys
000AB3r 2               ;     pick:  fire (A), Space or Enter
000AB3r 2               ;     swap:  B, or X on the keyboard (Laser, Torpedo, the special)
000AB3r 2               ;   A held stick moves once, then repeats.
000AB3r 2               ; =============================================================================
000AB3r 2               
000AB3r 2               .include "../../6502-Lib/include/input.inc"
000AB3r 3               ; =============================================================================
000AB3r 3               ;   input.inc - interface contract for shared joystick-first input polling
000AB3r 3               ; =============================================================================
000AB3r 3               ;
000AB3r 3               ; Required caller symbols (defined by the consuming project before this
000AB3r 3               ; file is .include-d):
000AB3r 3               ;   HW_PRESENT, HW_GPIO, ReadJoystick1, ReadJoystick2, Chrin  ; Kernal
000AB3r 3               ;   DIR_UP, DIR_DOWN                        ; caller's own numeric values
000AB3r 3               ;   DIR_LEFT, DIR_RIGHT                     ; omit both for a 2-directional
000AB3r 3               ;                                            ; game (e.g. Pong) - LEFT/RIGHT
000AB3r 3               ;                                            ; checks compile out
000AB3r 3               ;   JOY_STATE                               ; zero page, for PollJoyCombined
000AB3r 3               ;                                            ; and PollJoy1
000AB3r 3               ;   JOY_STATE2                              ; zero page, for PollJoy2
000AB3r 3               ;   KB_DIR, KB_FIRE                         ; zero page, for
000AB3r 3               ;                                            ; DrainKeyboardCombined
000AB3r 3               ;   KB_DIR_P1, KB_DIR_P2, KB_FIRE           ; zero page, for
000AB3r 3               ;   KB_FIRE_P1, KB_FIRE_P2                  ; DrainKeyboardSplit
000AB3r 3               ;                                            ; (KB_FIRE_P1/P2 only needed
000AB3r 3               ;                                            ; by a caller that wants
000AB3r 3               ;                                            ; independent per-player fire
000AB3r 3               ;                                            ; - every game as of this
000AB3r 3               ;                                            ; writing uses the combined
000AB3r 3               ;                                            ; KB_FIRE instead)
000AB3r 3               ;
000AB3r 3               ; Exported routines:
000AB3r 3               ;   PollJoyCombined       both joystick ports AND-combined (single-player)
000AB3r 3               ;   PollJoy1 / PollJoy2   one joystick port, gated on HW_GPIO
000AB3r 3               ;   DrainKeyboardCombined single-player keyboard fallback (WASD or arrows)
000AB3r 3               ;   DrainKeyboardSplit    two-player keyboard fallback (WASD=P1, arrows=P2)
000AB3r 3               ;
000AB3r 3               ; Fire keys: space (KEY_FIRE) is P1's/the single-player fallback; enter
000AB3r 3               ; (KEY_FIRE2) is P2's. DrainKeyboardCombined accepts either interchangeably
000AB3r 3               ; into one KB_FIRE flag. DrainKeyboardSplit sets both the combined KB_FIRE
000AB3r 3               ; (either key, for today's shared start/pause/confirm actions) and the
000AB3r 3               ; per-player KB_FIRE_P1/KB_FIRE_P2 (for a future game with independent
000AB3r 3               ; per-player fire, e.g. a two-player shooter).
000AB3r 3               ;
000AB3r 3               ; Priority rule every caller composes for itself (see docs/INPUT.md):
000AB3r 3               ;   Joystick first. If the joystick shows a direction this poll, use it and
000AB3r 3               ;   ignore the keyboard entirely this poll. Only consult the keyboard's
000AB3r 3               ;   drained result when the joystick shows nothing. The fire/A button is
000AB3r 3               ;   OR'd (joystick A or keyboard space, either triggers), independent of
000AB3r 3               ;   the direction priority.
000AB3r 3               ; =============================================================================
000AB3r 3               
000AB3r 2               .include "../../6502-Lib/core/input.asm"
000AB3r 3               ; =============================================================================
000AB3r 3               ;   input.asm - shared joystick-first, keyboard-fallback input primitives
000AB3r 3               ; =============================================================================
000AB3r 3               ; Caller contract:
000AB3r 3               ; - Consuming project defines HW_PRESENT, HW_GPIO, ReadJoystick1,
000AB3r 3               ;   ReadJoystick2, Chrin (all Kernal-provided) before including this file.
000AB3r 3               ; - Consuming project defines its own DIR_UP/DIR_DOWN constants (and
000AB3r 3               ;   DIR_LEFT/DIR_RIGHT, only if it's a 4-directional game) at whatever
000AB3r 3               ;   numeric values it already uses - this file references them by name
000AB3r 3               ;   only, so Snake/LightCycles' 0/1/2/3 and Pong's 1/2 both work unchanged.
000AB3r 3               ; - Consuming project defines the zero-page output bytes each routine
000AB3r 3               ;   below documents (JOY_STATE, JOY_STATE2, KB_DIR, KB_DIR_P1, KB_DIR_P2,
000AB3r 3               ;   KB_FIRE, and - only if calling DrainKeyboardSplit - KB_FIRE_P1,
000AB3r 3               ;   KB_FIRE_P2) before including this file, at whatever address is free.
000AB3r 3               ;
000AB3r 3               ; Exported routines:
000AB3r 3               ; - PollJoyCombined      both ports AND-combined (single-player, either port)
000AB3r 3               ; - PollJoy1 / PollJoy2  a single port, gated on HW_GPIO
000AB3r 3               ; - DrainKeyboardCombined  single-player keyboard fallback (WASD or arrows)
000AB3r 3               ; - DrainKeyboardSplit     two-player keyboard fallback (WASD=P1, arrows=P2)
000AB3r 3               ;
000AB3r 3               ; This file intentionally does NOT resolve a final NEXT_DIR/START_PRESSED -
000AB3r 3               ; that composition (joystick-first priority, A-button-or-space, edge
000AB3r 3               ; detection) is project-specific glue that stays in each game's own
000AB3r 3               ; input.asm, since the exact target variables differ per game (NEXT_DIR vs
000AB3r 3               ; NEXT_P1/NEXT_P2, single-player vs split). See docs/INPUT.md for the
000AB3r 3               ; priority rule every caller should follow.
000AB3r 3               ; =============================================================================
000AB3r 3               
000AB3r 3               ; --- Joystick bits (active-low on the wire: 0 = pressed) ---
000AB3r 3               JOY_A     = %00000001
000AB3r 3               JOY_B     = %00000010
000AB3r 3               JOY_X     = %00000100
000AB3r 3               JOY_Y     = %00001000
000AB3r 3               JOY_UP    = %00010000
000AB3r 3               JOY_DOWN  = %00100000
000AB3r 3               JOY_LEFT  = %01000000
000AB3r 3               JOY_RIGHT = %10000000
000AB3r 3               
000AB3r 3               ; --- Keyboard fallback scancodes ---
000AB3r 3               ; Kernal delivers uppercase ASCII for letter keys; arrow keys are control
000AB3r 3               ; codes, not printable characters.
000AB3r 3               KEY_W           = 'W'
000AB3r 3               KEY_A           = 'A'
000AB3r 3               KEY_S           = 'S'
000AB3r 3               KEY_D           = 'D'
000AB3r 3               KEY_UP_ARROW    = $1E
000AB3r 3               KEY_DOWN_ARROW  = $1F
000AB3r 3               KEY_LEFT_ARROW  = $1C
000AB3r 3               KEY_RIGHT_ARROW = $1D
000AB3r 3               KEY_FIRE        = ' '     ; space bar: P1's fire fallback (thumb-reachable
000AB3r 3                                          ; from WASD's resting position; also the
000AB3r 3                                          ; traditional single-player shooter fire key)
000AB3r 3               KEY_FIRE2       = $0D     ; enter/return (CHAR_CR): P2's fire fallback,
000AB3r 3                                          ; sits right next to the arrow-key cluster on
000AB3r 3                                          ; nearly every layout. Deliberately not a
000AB3r 3                                          ; modifier key (Ctrl/Shift) -- Chrin is a plain
000AB3r 3                                          ; character buffer, and modifier keys generally
000AB3r 3                                          ; don't produce their own readable character,
000AB3r 3                                          ; nor could left/right variants be told apart
000AB3r 3                                          ; even if they did.
000AB3r 3               
000AB3r 3               KB_DIR_NONE = $FF          ; sentinel: no direction seen in this drain
000AB3r 3               
000AB3r 3               .segment "CART"
000AB3r 3               
000AB3r 3               ; -----------------------------------------------------------------------------
000AB3r 3               ; PollJoyCombined - read both joystick ports and AND-combine them
000AB3r 3               ; (active-low AND = logical OR of "pressed"), so either port drives a
000AB3r 3               ; single-player game regardless of which one it's plugged into.
000AB3r 3               ; Out: JOY_STATE = combined active-low byte, or $FF (idle) if no GPIO card.
000AB3r 3               ; Clobbers: A
000AB3r 3               ; -----------------------------------------------------------------------------
000AB3r 3               PollJoyCombined:
000AB3r 3  AD 0D 03       lda HW_PRESENT
000AB6r 3  29 20          and #HW_GPIO
000AB8r 3  D0 05          bne @haveGpio
000ABAr 3  A9 FF          lda #$FF
000ABCr 3  85 60          sta JOY_STATE
000ABEr 3  60             rts
000ABFr 3               @haveGpio:
000ABFr 3  20 48 A0       jsr ReadJoystick1
000AC2r 3  85 60          sta JOY_STATE
000AC4r 3  20 4B A0       jsr ReadJoystick2
000AC7r 3  25 60          and JOY_STATE
000AC9r 3  85 60          sta JOY_STATE
000ACBr 3  60             rts
000ACCr 3               
000ACCr 3               ; -----------------------------------------------------------------------------
000ACCr 3               ; PollJoy1 / PollJoy2 - read a single joystick port, gated on HW_GPIO
000ACCr 3               ; (ReadJoystick1/2 do not check hardware presence themselves - a floating
000ACCr 3               ; bus reads as meaningless data with no GPIO card fitted).
000ACCr 3               ; Out: JOY_STATE / JOY_STATE2, or $FF (idle) if no GPIO card.
000ACCr 3               ; Clobbers: A
000ACCr 3               ; -----------------------------------------------------------------------------
000ACCr 3               PollJoy1:
000ACCr 3  AD 0D 03       lda HW_PRESENT
000ACFr 3  29 20          and #HW_GPIO
000AD1r 3  D0 05          bne @haveGpio
000AD3r 3  A9 FF          lda #$FF
000AD5r 3  85 60          sta JOY_STATE
000AD7r 3  60             rts
000AD8r 3               @haveGpio:
000AD8r 3  20 48 A0       jsr ReadJoystick1
000ADBr 3  85 60          sta JOY_STATE
000ADDr 3  60             rts
000ADEr 3               
000ADEr 3               PollJoy2:
000ADEr 3  AD 0D 03       lda HW_PRESENT
000AE1r 3  29 20          and #HW_GPIO
000AE3r 3  D0 05          bne @haveGpio
000AE5r 3  A9 FF          lda #$FF
000AE7r 3  85 61          sta JOY_STATE2
000AE9r 3  60             rts
000AEAr 3               @haveGpio:
000AEAr 3  20 4B A0       jsr ReadJoystick2
000AEDr 3  85 61          sta JOY_STATE2
000AEFr 3  60             rts
000AF0r 3               
000AF0r 3               ; -----------------------------------------------------------------------------
000AF0r 3               ; DrainKeyboardCombined - single-player keyboard fallback: WASD or arrow
000AF0r 3               ; keys both work, whichever was pressed most recently in this call wins.
000AF0r 3               ; Drains every pending Chrin character each call (not just one), so a
000AF0r 3               ; burst typed between polls doesn't leave stale characters for next time.
000AF0r 3               ; LEFT/RIGHT checks compile out entirely for a 2-directional caller that
000AF0r 3               ; never defines DIR_LEFT/DIR_RIGHT (e.g. Pong).
000AF0r 3               ; Out: KB_DIR = last recognized direction this call, or KB_DIR_NONE.
000AF0r 3               ;      KB_FIRE = 1 if space or enter was seen this call, else 0. Both
000AF0r 3               ;      fire keys work interchangeably here, matching how WASD and arrows
000AF0r 3               ;      both work interchangeably for movement in this single-player case.
000AF0r 3               ; Clobbers: A
000AF0r 3               ; -----------------------------------------------------------------------------
000AF0r 3               DrainKeyboardCombined:
000AF0r 3  A9 FF          lda #KB_DIR_NONE
000AF2r 3  85 62          sta KB_DIR
000AF4r 3  64 63          stz KB_FIRE
000AF6r 3               @drain:
000AF6r 3  20 03 A0       jsr Chrin
000AF9r 3  90 4B          bcc @done                 ; C=0 = no character waiting, buffer empty
000AFBr 3                                            ; (Chrin signals this via carry, NOT via A=0 --
000AFBr 3                                            ; A holds a character even when C=0 is possible,
000AFBr 3                                            ; so checking A for zero here would loop forever)
000AFBr 3               
000AFBr 3  C9 57          cmp #KEY_W
000AFDr 3  F0 2B          beq @setUp
000AFFr 3  C9 1E          cmp #KEY_UP_ARROW
000B01r 3  F0 27          beq @setUp
000B03r 3  C9 53          cmp #KEY_S
000B05r 3  F0 2A          beq @setDown
000B07r 3  C9 1F          cmp #KEY_DOWN_ARROW
000B09r 3  F0 26          beq @setDown
000B0Br 3               .ifdef DIR_LEFT
000B0Br 3  C9 41          cmp #KEY_A
000B0Dr 3  F0 29          beq @setLeft
000B0Fr 3  C9 1C          cmp #KEY_LEFT_ARROW
000B11r 3  F0 25          beq @setLeft
000B13r 3               .endif
000B13r 3               .ifdef DIR_RIGHT
000B13r 3  C9 44          cmp #KEY_D
000B15r 3  F0 28          beq @setRight
000B17r 3  C9 1D          cmp #KEY_RIGHT_ARROW
000B19r 3  F0 24          beq @setRight
000B1Br 3               .endif
000B1Br 3  C9 20          cmp #KEY_FIRE
000B1Dr 3  F0 04          beq @setFire
000B1Fr 3  C9 0D          cmp #KEY_FIRE2
000B21r 3  D0 D3          bne @drain
000B23r 3               @setFire:
000B23r 3  A9 01          lda #1
000B25r 3  85 63          sta KB_FIRE
000B27r 3  4C rr rr       jmp @drain
000B2Ar 3               
000B2Ar 3               @setUp:
000B2Ar 3  A9 00          lda #DIR_UP
000B2Cr 3  85 62          sta KB_DIR
000B2Er 3  4C rr rr       jmp @drain
000B31r 3               @setDown:
000B31r 3  A9 01          lda #DIR_DOWN
000B33r 3  85 62          sta KB_DIR
000B35r 3  4C rr rr       jmp @drain
000B38r 3               .ifdef DIR_LEFT
000B38r 3               @setLeft:
000B38r 3  A9 02          lda #DIR_LEFT
000B3Ar 3  85 62          sta KB_DIR
000B3Cr 3  4C rr rr       jmp @drain
000B3Fr 3               .endif
000B3Fr 3               .ifdef DIR_RIGHT
000B3Fr 3               @setRight:
000B3Fr 3  A9 03          lda #DIR_RIGHT
000B41r 3  85 62          sta KB_DIR
000B43r 3  4C rr rr       jmp @drain
000B46r 3               .endif
000B46r 3               
000B46r 3               @done:
000B46r 3  60             rts
000B47r 3               
000B47r 3               ; -----------------------------------------------------------------------------
000B47r 3               ; DrainKeyboardSplit - two-player keyboard fallback: WASD drives P1 only,
000B47r 3               ; arrow keys drive P2 only, so one player's keypresses can never move the
000B47r 3               ; other's paddle/cycle. Drains every pending Chrin character ONCE per
000B47r 3               ; call, checking both keysets in the same pass (so both players' presses
000B47r 3               ; in the same drain window are captured, not just whichever keyset was
000B47r 3               ; checked first). LEFT/RIGHT checks compile out for a 2-directional caller
000B47r 3               ; that never defines DIR_LEFT/DIR_RIGHT (e.g. Pong).
000B47r 3               ; Out: KB_DIR_P1 = last WASD direction seen this call, or KB_DIR_NONE.
000B47r 3               ;      KB_DIR_P2 = last arrow-key direction seen this call, or KB_DIR_NONE.
000B47r 3               ;      KB_FIRE = 1 if EITHER fire key was seen this call, else 0 - kept
000B47r 3               ;      for callers with only one shared fire/start/pause action (every
000B47r 3               ;      game as of this writing: "did anyone press it" is all that
000B47r 3               ;      matters, mirroring how either joystick's A button already
000B47r 3               ;      triggers the same shared action today).
000B47r 3               ;      KB_FIRE_P1 = 1 if space (P1's fire key) was seen this call, else 0.
000B47r 3               ;      KB_FIRE_P2 = 1 if enter (P2's fire key) was seen this call, else 0.
000B47r 3               ;      A future game with independent per-player fire (e.g. a two-player
000B47r 3               ;      shooter) reads KB_FIRE_P1/KB_FIRE_P2 instead of the combined flag.
000B47r 3               ; Clobbers: A
000B47r 3               ; -----------------------------------------------------------------------------
000B47r 3               DrainKeyboardSplit:
000B47r 3  A9 FF          lda #KB_DIR_NONE
000B49r 3  85 64          sta KB_DIR_P1
000B4Br 3  85 65          sta KB_DIR_P2
000B4Dr 3  64 63          stz KB_FIRE
000B4Fr 3  64 66          stz KB_FIRE_P1
000B51r 3  64 67          stz KB_FIRE_P2
000B53r 3               @drain:
000B53r 3  20 03 A0       jsr Chrin
000B56r 3  90 72          bcc @done                 ; C=0 = no character waiting, buffer empty
000B58r 3                                            ; (Chrin signals this via carry, NOT via A=0)
000B58r 3               
000B58r 3  C9 57          cmp #KEY_W
000B5Ar 3  F0 36          beq @p1Up
000B5Cr 3  C9 53          cmp #KEY_S
000B5Er 3  F0 39          beq @p1Down
000B60r 3               .ifdef DIR_LEFT
000B60r 3  C9 41          cmp #KEY_A
000B62r 3  F0 3C          beq @p1Left
000B64r 3               .endif
000B64r 3               .ifdef DIR_RIGHT
000B64r 3  C9 44          cmp #KEY_D
000B66r 3  F0 3F          beq @p1Right
000B68r 3               .endif
000B68r 3  C9 1E          cmp #KEY_UP_ARROW
000B6Ar 3  F0 42          beq @p2Up
000B6Cr 3  C9 1F          cmp #KEY_DOWN_ARROW
000B6Er 3  F0 45          beq @p2Down
000B70r 3               .ifdef DIR_LEFT
000B70r 3  C9 1C          cmp #KEY_LEFT_ARROW
000B72r 3  F0 48          beq @p2Left
000B74r 3               .endif
000B74r 3               .ifdef DIR_RIGHT
000B74r 3  C9 1D          cmp #KEY_RIGHT_ARROW
000B76r 3  F0 4B          beq @p2Right
000B78r 3               .endif
000B78r 3  C9 20          cmp #KEY_FIRE
000B7Ar 3  F0 0D          beq @p1Fire
000B7Cr 3  C9 0D          cmp #KEY_FIRE2
000B7Er 3  D0 D3          bne @drain
000B80r 3  A9 01          lda #1
000B82r 3  85 63          sta KB_FIRE
000B84r 3  85 67          sta KB_FIRE_P2
000B86r 3  4C rr rr       jmp @drain
000B89r 3               @p1Fire:
000B89r 3  A9 01          lda #1
000B8Br 3  85 63          sta KB_FIRE
000B8Dr 3  85 66          sta KB_FIRE_P1
000B8Fr 3  4C rr rr       jmp @drain
000B92r 3               
000B92r 3               @p1Up:
000B92r 3  A9 00          lda #DIR_UP
000B94r 3  85 64          sta KB_DIR_P1
000B96r 3  4C rr rr       jmp @drain
000B99r 3               @p1Down:
000B99r 3  A9 01          lda #DIR_DOWN
000B9Br 3  85 64          sta KB_DIR_P1
000B9Dr 3  4C rr rr       jmp @drain
000BA0r 3               .ifdef DIR_LEFT
000BA0r 3               @p1Left:
000BA0r 3  A9 02          lda #DIR_LEFT
000BA2r 3  85 64          sta KB_DIR_P1
000BA4r 3  4C rr rr       jmp @drain
000BA7r 3               .endif
000BA7r 3               .ifdef DIR_RIGHT
000BA7r 3               @p1Right:
000BA7r 3  A9 03          lda #DIR_RIGHT
000BA9r 3  85 64          sta KB_DIR_P1
000BABr 3  4C rr rr       jmp @drain
000BAEr 3               .endif
000BAEr 3               @p2Up:
000BAEr 3  A9 00          lda #DIR_UP
000BB0r 3  85 65          sta KB_DIR_P2
000BB2r 3  4C rr rr       jmp @drain
000BB5r 3               @p2Down:
000BB5r 3  A9 01          lda #DIR_DOWN
000BB7r 3  85 65          sta KB_DIR_P2
000BB9r 3  4C rr rr       jmp @drain
000BBCr 3               .ifdef DIR_LEFT
000BBCr 3               @p2Left:
000BBCr 3  A9 02          lda #DIR_LEFT
000BBEr 3  85 65          sta KB_DIR_P2
000BC0r 3  4C rr rr       jmp @drain
000BC3r 3               .endif
000BC3r 3               .ifdef DIR_RIGHT
000BC3r 3               @p2Right:
000BC3r 3  A9 03          lda #DIR_RIGHT
000BC5r 3  85 65          sta KB_DIR_P2
000BC7r 3  4C rr rr       jmp @drain
000BCAr 3               .endif
000BCAr 3               
000BCAr 3               @done:
000BCAr 3  60             rts
000BCBr 3               
000BCBr 2               
000BCBr 2               .segment "CART"
000BCBr 2               
000BCBr 2               REPEAT_FIRST = 15                 ; frames before a held stick repeats
000BCBr 2               REPEAT_NEXT  = 5                  ; then every this many
000BCBr 2               
000BCBr 2               ; ReadInput - this frame's EV_DIR, EV_FIRE and EV_SWAP.
000BCBr 2               ReadInput:
000BCBr 2  64 6B          stz EV_FIRE
000BCDr 2  64 6C          stz EV_SWAP
000BCFr 2  A9 FF          lda #NO_DIR
000BD1r 2  85 6A          sta EV_DIR
000BD3r 2  20 rr rr       jsr PollJoy1
000BD6r 2  20 rr rr       jsr PollJoy2
000BD9r 2  A5 60          lda JOY_STATE
000BDBr 2  25 61          and JOY_STATE2                   ; active low: pressed on either stick
000BDDr 2  49 FF          eor #$FF
000BDFr 2  85 40          sta T0                           ; active high
000BE1r 2                 ; buttons, on the press
000BE1r 2  A5 6D          lda PREV_BTN
000BE3r 2  49 FF          eor #$FF
000BE5r 2  25 40          and T0
000BE7r 2  85 41          sta T1
000BE9r 2  29 01          and #JOY_A
000BEBr 2  F0 02          beq @noFire
000BEDr 2  E6 6B          inc EV_FIRE
000BEFr 2               @noFire:
000BEFr 2  A5 41          lda T1
000BF1r 2  29 02          and #JOY_B
000BF3r 2  F0 02          beq @noSwap
000BF5r 2  E6 6C          inc EV_SWAP
000BF7r 2               @noSwap:
000BF7r 2  A5 40          lda T0
000BF9r 2  29 03          and #(JOY_A | JOY_B)
000BFBr 2  85 6D          sta PREV_BTN
000BFDr 2                 ; the stick's direction
000BFDr 2  A2 FF          ldx #NO_DIR
000BFFr 2  A5 40          lda T0
000C01r 2  29 10          and #JOY_UP
000C03r 2  F0 02          beq @notUp
000C05r 2  A2 00          ldx #DIR_UP
000C07r 2               @notUp:
000C07r 2  A5 40          lda T0
000C09r 2  29 20          and #JOY_DOWN
000C0Br 2  F0 02          beq @notDown
000C0Dr 2  A2 01          ldx #DIR_DOWN
000C0Fr 2               @notDown:
000C0Fr 2  A5 40          lda T0
000C11r 2  29 40          and #JOY_LEFT
000C13r 2  F0 02          beq @notLeft
000C15r 2  A2 02          ldx #DIR_LEFT
000C17r 2               @notLeft:
000C17r 2  A5 40          lda T0
000C19r 2  29 80          and #JOY_RIGHT
000C1Br 2  F0 02          beq @notRight
000C1Dr 2  A2 03          ldx #DIR_RIGHT
000C1Fr 2               @notRight:
000C1Fr 2  E4 68          cpx HELD_DIR
000C21r 2  F0 0E          beq @held
000C23r 2  86 68          stx HELD_DIR                     ; a new direction: move now
000C25r 2  E0 FF          cpx #NO_DIR
000C27r 2  F0 16          beq @keys
000C29r 2  86 6A          stx EV_DIR
000C2Br 2  A9 0F          lda #REPEAT_FIRST
000C2Dr 2  85 69          sta REPEAT_T
000C2Fr 2  80 0E          bra @keys
000C31r 2               @held:
000C31r 2  E0 FF          cpx #NO_DIR
000C33r 2  F0 0A          beq @keys
000C35r 2  C6 69          dec REPEAT_T
000C37r 2  D0 06          bne @keys
000C39r 2  86 6A          stx EV_DIR
000C3Br 2  A9 05          lda #REPEAT_NEXT
000C3Dr 2  85 69          sta REPEAT_T
000C3Fr 2               @keys:
000C3Fr 2  20 0C A0       jsr BufferSize                   ; straight from the buffer: Chrin would echo
000C42r 2  C9 00          cmp #0                           ; the key onto the Kernal's text screen
000C44r 2  F0 4D          beq @done
000C46r 2  20 09 A0       jsr ReadBuffer
000C49r 2  A2 00          ldx #DIR_UP
000C4Br 2  C9 57          cmp #'W'
000C4Dr 2  F0 34          beq @keyDir
000C4Fr 2  C9 1E          cmp #KEY_UP_ARROW
000C51r 2  F0 30          beq @keyDir
000C53r 2  A2 01          ldx #DIR_DOWN
000C55r 2  C9 53          cmp #'S'
000C57r 2  F0 2A          beq @keyDir
000C59r 2  C9 1F          cmp #KEY_DOWN_ARROW
000C5Br 2  F0 26          beq @keyDir
000C5Dr 2  A2 02          ldx #DIR_LEFT
000C5Fr 2  C9 41          cmp #'A'
000C61r 2  F0 20          beq @keyDir
000C63r 2  C9 1C          cmp #KEY_LEFT_ARROW
000C65r 2  F0 1C          beq @keyDir
000C67r 2  A2 03          ldx #DIR_RIGHT
000C69r 2  C9 44          cmp #'D'
000C6Br 2  F0 16          beq @keyDir
000C6Dr 2  C9 1D          cmp #KEY_RIGHT_ARROW
000C6Fr 2  F0 12          beq @keyDir
000C71r 2  C9 20          cmp #' '
000C73r 2  F0 12          beq @keyFire
000C75r 2  C9 0D          cmp #$0D
000C77r 2  F0 0E          beq @keyFire
000C79r 2  C9 58          cmp #'X'
000C7Br 2  F0 10          beq @keySwap
000C7Dr 2  C9 42          cmp #'B'
000C7Fr 2  F0 0C          beq @keySwap
000C81r 2  80 BC          bra @keys
000C83r 2               @keyDir:
000C83r 2  86 6A          stx EV_DIR
000C85r 2  80 B8          bra @keys
000C87r 2               @keyFire:
000C87r 2  A9 01          lda #1
000C89r 2  85 6B          sta EV_FIRE
000C8Br 2  80 B2          bra @keys
000C8Dr 2               @keySwap:
000C8Dr 2  A9 01          lda #1
000C8Fr 2  85 6C          sta EV_SWAP
000C91r 2  80 AC          bra @keys
000C93r 2               @done:
000C93r 2  60             rts
000C94r 2               
000C94r 1               .include "src/game.asm"
000C94r 2               ; =============================================================================
000C94r 2               ;   game.asm - the title screen, planning and the end of a battle
000C94r 2               ; =============================================================================
000C94r 2               ;   A battle goes: each person plans in turn, the machine passed between them
000C94r 2               ;   (a handoff screen hides one plan from the next person), then the turn
000C94r 2               ;   plays out for everyone (turn.asm), until one ship or none is left.
000C94r 2               ; =============================================================================
000C94r 2               
000C94r 2               .segment "BANK00"
000000r 2               
