000346r 2  65 D2          adc HPL_W
000348r 2  85 D2          sta HPL_W
00034Ar 2  88             dey
00034Br 2  D0 E6          bne @cell
00034Dr 2  A9 20          lda #' '
00034Fr 2  20 rr rr       jsr LineChar
000352r 2  A6 D0          ldx HPL_SHIP
000354r 2  BD 14 08       lda SHIP_HP_HI,x
