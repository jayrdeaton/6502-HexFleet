00097Fr 2  90 2D          bcc @nextSide
000981r 2               @draw:
000981r 2  A5 AB          lda MN_I
000983r 2  0A             asl a
000984r 2  85 AD          sta MN_COUNT
000986r 2  0A             asl a
000987r 2  0A             asl a
000988r 2  18             clc
000989r 2  65 AD          adc MN_COUNT
00098Br 2  65 AB          adc MN_I                         ; 11 points a side
00098Dr 2  85 AE          sta MN_FREE
00098Fr 2  A9 0B          lda #11
000991r 2  85 AD          sta MN_COUNT
000993r 2               @point:
000993r 2  A4 AE          ldy MN_FREE
000995r 2  A5 7F          lda HX
000997r 2  18             clc
000998r 2  79 rr rr       adc SideX,y
00099Br 2  85 4E          sta PX
