00094Cr 2  DA             phx
00094Dr 2  84 D1          sty S_A
00094Fr 2  BD rr rr       lda VoiceBase,x
000952r 2  AA             tax
000953r 2  A4 D9          ldy S_B
000955r 2  B9 rr rr       lda NoteLo,y
000958r 2  9D 00 0F       sta S_REG,x
00095Br 2  B9 rr rr       lda NoteHi,y
00095Er 2  9D 01 0F       sta S_REG+1,x
000961r 2  A4 D1          ldy S_A
000963r 2  B9 rr rr       lda Instruments,y
000966r 2  9D 04 0F       sta S_REG+4,x
000969r 2  B9 rr rr       lda Instruments+1,y
00096Cr 2  9D 05 0F       sta S_REG+5,x
00096Fr 2  B9 rr rr       lda Instruments+2,y
000972r 2  9D 06 0F       sta S_REG+6,x
000975r 2  B9 rr rr       lda Instruments+3,y
