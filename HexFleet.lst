000B8Er 2  FE 34 08       inc PLAN_WEAPON,x                ; laser to torpedo
000B91r 2  80 26          bra @chosen
000B93r 2               @afterTorpedo:
000B93r 2  9E 34 08       stz PLAN_WEAPON,x                ; torpedo to the special, or back to laser
000B96r 2  BD 80 09       lda SPECIAL_WAIT,x
