0001BBr 2  09 40          ora #VC_ADDR_WRITE
0001BDr 2  8D 01 9C       sta VC_REG
0001C0r 2  60             rts
0001C1r 2               
0001C1r 2               ; WaitFrame - until the picture next ends.
0001C1r 2               WaitFrame:
0001C1r 2  2C 01 9C       bit VC_STATUS                     ; bit 7 is the end-of-frame flag
0001C4r 2  10 FB          bpl WaitFrame
0001C6r 2  60             rts
0001C7r 2               
0001C7r 2               WaitFrames:
0001C7r 2  AA             tax
0001C8r 2               @loop:
