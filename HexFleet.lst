000E90r 2  20 rr rr       jsr ShowBoard
000E93r 2  20 rr rr       jsr HideFriends
000E96r 2  20 rr rr       jsr UploadSprites
000E99r 2  20 rr rr       jsr SoundOff
000E9Cr 2  A5 77          lda WINNER
000E9Er 2  C9 FF          cmp #$FF
000EA0r 2  F0 0E          beq @draw
