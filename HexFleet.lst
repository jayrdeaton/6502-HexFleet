0006A3r 2               
0006A3r 2               ; DrawRange - an outline round every hex within RANGE of the ship, along the
0006A3r 2               ; board's own lines.
0006A3r 2               DrawRange:
0006A3r 2  A5 6F          lda PLAYER
0006A5r 2  1A             inc a
0006A6r 2  85 51          sta PINK
0006A8r 2  20 rr rr       jsr CanvasBegin
0006ABr 2  20 rr rr       jsr ShipToHex
0006AEr 2  64 B8          stz RR
0006B0r 2               @row:
0006B0r 2  A5 B8          lda RR
0006B2r 2  20 rr rr       jsr RowLen
0006B5r 2  85 42          sta T2
0006B7r 2  64 B7          stz RC
0006B9r 2               @hex:
0006B9r 2  A5 B7          lda RC
0006BBr 2  85 B2          sta HD_C2
0006BDr 2  A5 B8          lda RR
0006BFr 2  85 B3          sta HD_R2
0006C1r 2  20 rr rr       jsr HexDist
0006C4r 2  C5 8D          cmp RANGE
0006C6r 2  F0 13          beq @edge                        ; at the limit of the reach
0006C8r 2  B0 14          bcs @next
0006CAr 2  A5 B8          lda RR                           ; inside it: only the board's rim has an edge
0006CCr 2  F0 0D          beq @edge
0006CEr 2  C9 0E          cmp #ROWS - 1
0006D0r 2  F0 09          beq @edge
0006D2r 2  A5 B7          lda RC
0006D4r 2  F0 05          beq @edge
0006D6r 2  1A             inc a
0006D7r 2  C5 42          cmp T2
0006D9r 2  D0 03          bne @next
0006DBr 2               @edge:
0006DBr 2  20 rr rr       jsr OutlineHex
0006DEr 2               @next:
0006DEr 2  E6 B7          inc RC
0006E0r 2  A5 B7          lda RC
0006E2r 2  C5 42          cmp T2
0006E4r 2  D0 D3          bne @hex
0006E6r 2  E6 B8          inc RR
0006E8r 2  A5 B8          lda RR
0006EAr 2  C9 0F          cmp #ROWS
0006ECr 2  D0 C2          bne @row
0006EEr 2  4C rr rr       jmp CanvasFlush
0006F1r 2               
0006F1r 2               ; OutlineHex - hex (RC, RR): draw each side that has no reachable hex beyond it.
0006F1r 2               OutlineHex:
0006F1r 2  A6 B7          ldx RC
0006F3r 2  A4 B8          ldy RR
0006F5r 2  20 rr rr       jsr HexCenter
0006F8r 2  64 AB          stz MN_I
0006FAr 2               @side:
0006FAr 2  A6 AB          ldx MN_I
0006FCr 2  A5 B8          lda RR
0006FEr 2  29 01          and #1
000700r 2  D0 05          bne @odd
000702r 2  BD rr rr       lda SideColEven,x
000705r 2  80 03          bra @column
000707r 2               @odd:
000707r 2  BD rr rr       lda SideColOdd,x
00070Ar 2               @column:
00070Ar 2  18             clc
00070Br 2  65 B7          adc RC
00070Dr 2  85 B2          sta HD_C2
00070Fr 2  A5 B8          lda RR
000711r 2  18             clc
000712r 2  7D rr rr       adc SideRow,x
000715r 2  85 B3          sta HD_R2
000717r 2  C9 0F          cmp #ROWS
000719r 2  B0 14          bcs @draw                        ; off the board
00071Br 2  20 rr rr       jsr RowLen
00071Er 2  85 AD          sta MN_COUNT
000720r 2  A5 B2          lda HD_C2
000722r 2  C5 AD          cmp MN_COUNT
000724r 2  B0 09          bcs @draw
000726r 2  20 rr rr       jsr HexDist
000729r 2  C5 8D          cmp RANGE
00072Br 2  F0 2F          beq @nextSide
00072Dr 2  90 2D          bcc @nextSide
00072Fr 2               @draw:
00072Fr 2  A5 AB          lda MN_I
000731r 2  0A             asl a
000732r 2  85 AD          sta MN_COUNT
000734r 2  0A             asl a
000735r 2  0A             asl a
000736r 2  18             clc
000737r 2  65 AD          adc MN_COUNT
000739r 2  65 AB          adc MN_I                         ; 11 points a side
00073Br 2  85 AE          sta MN_FREE
00073Dr 2  A9 0B          lda #11
00073Fr 2  85 AD          sta MN_COUNT
000741r 2               @point:
000741r 2  A4 AE          ldy MN_FREE
000743r 2  A5 7F          lda HX
000745r 2  18             clc
000746r 2  79 rr rr       adc SideX,y
000749r 2  85 4E          sta PX
00074Br 2  A5 80          lda HY
00074Dr 2  18             clc
00074Er 2  79 rr rr       adc SideY,y
000751r 2  85 4F          sta PY
000753r 2  20 rr rr       jsr CanvasPlot
000756r 2  E6 AE          inc MN_FREE
000758r 2  C6 AD          dec MN_COUNT
00075Ar 2  D0 E5          bne @point
00075Cr 2               @nextSide:
00075Cr 2  E6 AB          inc MN_I
00075Er 2  A5 AB          lda MN_I
000760r 2  C9 06          cmp #6
000762r 2  D0 96          bne @side
000764r 2  60             rts
000765r 2               
000765r 2               ; The six sides of a hex: right, left, upper right, upper left, lower right, lower
000765r 2               ; left. The neighbor across each, then the pixels of the side from the hex's center,
000765r 2               ; the same pixels as the grid's lines.
000765r 2               SideColEven:
000765r 2  01 FF 01 00    .byte 1, $FF, 1, 0, 1, 0
000769r 2  01 00        
00076Br 2               SideColOdd:
00076Br 2  01 FF 00 FF    .byte 1, $FF, 0, $FF, 0, $FF
00076Fr 2  00 FF        
000771r 2               SideRow:
000771r 2  00 00 FF FF    .byte 0, 0, $FF, $FF, 1, 1
000775r 2  01 01        
000777r 2               SideX:
000777r 2  0A 0A 0A 0A  .repeat 11, I
00077Br 2  0A 0A 0A 0A  
00077Fr 2  0A 0A 0A     
000782r 2                 .byte 10
000782r 2               .endrepeat
000782r 2  F6 F6 F6 F6  .repeat 11, I
000786r 2  F6 F6 F6 F6  
00078Ar 2  F6 F6 F6     
00078Dr 2                 .byte <(-10)
00078Dr 2               .endrepeat
00078Dr 2  00 01 02 03  .repeat 11, I
000791r 2  04 05 06 07  
000795r 2  08 09 0A     
000798r 2                 .byte I
000798r 2               .endrepeat
000798r 2  F6 F7 F8 F9  .repeat 11, I
00079Cr 2  FA FB FC FD  
0007A0r 2  FE FF 00     
0007A3r 2                 .byte <(I - 10)
0007A3r 2               .endrepeat
0007A3r 2  00 01 02 03  .repeat 11, I
0007A7r 2  04 05 06 07  
0007ABr 2  08 09 0A     
0007AEr 2                 .byte I
0007AEr 2               .endrepeat
0007AEr 2  F6 F7 F8 F9  .repeat 11, I
0007B2r 2  FA FB FC FD  
0007B6r 2  FE FF 00     
0007B9r 2                 .byte <(I - 10)
0007B9r 2               .endrepeat
0007B9r 2               SideY:
0007B9r 2  FB FC FD FE  .repeat 11, I
0007BDr 2  FF 00 01 02  
0007C1r 2  03 04 05     
0007C4r 2                 .byte <(I - 5)
0007C4r 2               .endrepeat
0007C4r 2  FB FC FD FE  .repeat 11, I
0007C8r 2  FF 00 01 02  
0007CCr 2  03 04 05     
0007CFr 2                 .byte <(I - 5)
0007CFr 2               .endrepeat
0007CFr 2  F6 F6 F7 F7  .repeat 11, I
0007D3r 2  F8 F8 F9 F9  
0007D7r 2  FA FA FB     
0007DAr 2                 .byte <(I / 2 - 10)
0007DAr 2               .endrepeat
0007DAr 2  FB FA FA F9  .repeat 11, I
0007DEr 2  F9 F8 F8 F7  
0007E2r 2  F7 F6 F6     
0007E5r 2                 .byte <(5 - (I + 1) / 2 - 10)
0007E5r 2               .endrepeat
0007E5r 2  0A 09 09 08  .repeat 11, I
0007E9r 2  08 07 07 06  
0007EDr 2  06 05 05     
0007F0r 2                 .byte <(10 - (I + 1) / 2)
0007F0r 2               .endrepeat
0007F0r 2  05 05 06 06  .repeat 11, I
0007F4r 2  07 07 08 08  
0007F8r 2  09 09 0A     
0007FBr 2                 .byte <(5 + I / 2)
0007FBr 2               .endrepeat
