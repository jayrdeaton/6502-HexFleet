000DEBr 2  85 41          sta T1
000DEDr 2  20 rr rr       jsr IsLink
000DF0r 2  D0 09          bne @local
000DF2r 2  A5 41          lda T1
000DF4r 2  CD 05 0E       cmp MY_SEAT
000DF7r 2  F0 49          beq @you
000DF9r 2  80 4E          bra @lose
000DFBr 2               @local:
000DFBr 2  AD C8 0C       lda HUMANS
000DFEr 2  F0 50          beq @cpus
000E00r 2                 ; are the people all on one side?
000E00r 2  64 42          stz T2
000E02r 2  A6 8E          ldx N_SHIPS
000E04r 2               @seat:
000E04r 2  CA             dex
000E05r 2  30 2C          bmi @oneSide
000E07r 2  BD B4 0C       lda SEAT_KIND,x
000E0Ar 2  D0 F8          bne @seat
000E0Cr 2  BD B8 0C       lda SHIP_SIDE,x
000E0Fr 2  09 80          ora #$80
000E11r 2  85 40          sta T0
000E13r 2  A5 42          lda T2
000E15r 2  F0 06          beq @first
000E17r 2  C5 40          cmp T0
000E19r 2  D0 08          bne @split
000E1Br 2  80 E7          bra @seat
000E1Dr 2               @first:
