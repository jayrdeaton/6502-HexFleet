0001DDr 2  D0 F8          bne @page
0001DFr 2  E6 49          inc PTR0+1
0001E1r 2  CA             dex
0001E2r 2  D0 F3          bne @page
0001E4r 2               @tail:
0001E4r 2  A0 00          ldy #0
0001E6r 2               @last:
0001E6r 2  C4 40          cpy T0
0001E8r 2  F0 08          beq @done
0001EAr 2  B1 48          lda (PTR0),y
0001ECr 2  8D 00 9C       sta VC_DATA
0001EFr 2  C8             iny
0001F0r 2  80 F4          bra @last
0001F2r 2               @done:
0001F2r 2  60             rts
0001F3r 2               
0001F3r 2               ; FillVram - T1:T0 bytes of A where the chip points.
0001F3r 2               FillVram:
0001F3r 2  A6 41          ldx T1
0001F5r 2  F0 0B          beq @tail
0001F7r 2  A0 00          ldy #0
0001F9r 2               @page:
0001F9r 2  8D 00 9C       sta VC_DATA
0001FCr 2  C8             iny
0001FDr 2  D0 FA          bne @page
0001FFr 2  CA             dex
000200r 2  D0 F7          bne @page
000202r 2               @tail:
