00088Er 2               
00088Er 2               ; TrackTick - track X, one frame on.
00088Er 2               TrackTick:
00088Er 2  AD 2B 0F       lda MUS_ID
000891r 2  F0 40          beq @done
000893r 2  BD 41 0F       lda M_LEFT,x
000896r 2  D0 03          bne @run
000898r 2  20 rr rr       jsr NextEvent
00089Br 2               @run:
00089Br 2  DE 41 0F       dec M_LEFT,x
00089Er 2  BD 4D 0F       lda SF_ID,x
0008A1r 2  D0 30          bne @done                        ; an effect has this voice
0008A3r 2  BC rr rr       ldy VoiceBase,x
0008A6r 2  BD 44 0F       lda M_GATE,x
0008A9r 2  F0 0D          beq @drift
0008ABr 2  DD 41 0F       cmp M_LEFT,x
0008AEr 2  D0 08          bne @drift
0008B0r 2  B9 04 0F       lda S_REG+4,y                    ; time for this note to let go
0008B3r 2  29 FE          and #$FE
0008B5r 2  99 04 0F       sta S_REG+4,y
0008B8r 2               @drift:
0008B8r 2  BD 47 0F       lda M_RATE,x
0008BBr 2  F0 16          beq @done
0008BDr 2  18             clc
0008BEr 2  79 02 0F       adc S_REG+2,y
0008C1r 2  99 02 0F       sta S_REG+2,y
0008C4r 2  90 0D          bcc @done
0008C6r 2  B9 03 0F       lda S_REG+3,y
0008C9r 2  1A             inc a
0008CAr 2  29 0F          and #$0F
0008CCr 2  D0 02          bne @width
0008CEr 2  A9 02          lda #2                           ; never so narrow that it vanishes
0008D0r 2               @width:
0008D0r 2  99 03 0F       sta S_REG+3,y
0008D3r 2               @done:
0008D3r 2  60             rts
0008D4r 2               
0008D4r 2               NextEvent:
0008D4r 2  BD 35 0F       lda M_PL,x
0008D7r 2  85 D3          sta S_P
0008D9r 2  BD 38 0F       lda M_PH,x
0008DCr 2  85 D4          sta S_P+1
0008DEr 2  B2 D3          lda (S_P)
0008E0r 2  D0 0C          bne @event
0008E2r 2  BD 3B 0F       lda M_SL,x                       ; the end: round again
0008E5r 2  85 D3          sta S_P
0008E7r 2  BD 3E 0F       lda M_SH,x
0008EAr 2  85 D4          sta S_P+1
0008ECr 2  B2 D3          lda (S_P)
0008EEr 2               @event:
0008EEr 2  9D 41 0F       sta M_LEFT,x
0008F1r 2  A0 01          ldy #1
0008F3r 2  B1 D3          lda (S_P),y
0008F5r 2  85 D9          sta S_B
0008F7r 2  C8             iny
0008F8r 2  B1 D3          lda (S_P),y
0008FAr 2  85 DA          sta S_C
0008FCr 2  A5 D3          lda S_P
0008FEr 2  18             clc
0008FFr 2  69 03          adc #3
000901r 2  9D 35 0F       sta M_PL,x
000904r 2  A5 D4          lda S_P+1
000906r 2  69 00          adc #0
000908r 2  9D 38 0F       sta M_PH,x
00090Br 2  A5 D9          lda S_B
00090Dr 2  F0 09          beq @rest
00090Fr 2  C9 FD          cmp #KICK_NOTE
000911r 2  D0 0C          bne StartNote
000913r 2  A9 12          lda #SFX_THUMP
000915r 2  4C rr rr       jmp EffectStart
