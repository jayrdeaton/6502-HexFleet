000292r 2  20 rr rr       jsr LineNum
000295r 2  A9 01          lda #ROW_TURN
000297r 2  4C rr rr       jmp LineShow
00029Ar 2               
00029Ar 2               ; ShipRow - A = the panel row of ship X's name. Keeps X.
00029Ar 2               ShipRow:
