0009B0r 2  F0 14          beq @open
0009B2r 2  4A             lsr a
0009B3r 2  4A             lsr a
0009B4r 2  4A             lsr a
0009B5r 2  D0 02          bne @fall
0009B7r 2  A9 01          lda #1
0009B9r 2               @fall:
0009B9r 2  85 DA          sta S_C
0009BBr 2  AD 30 0F       lda F_ENV
0009BEr 2  48             pha
0009BFr 2  38             sec
0009C0r 2  E5 DA          sbc S_C
0009C2r 2  8D 30 0F       sta F_ENV
0009C5r 2  68             pla
