00093Fr 2  80 26          bra @chosen
000941r 2               @afterTorpedo:
000941r 2  9E 34 08       stz PLAN_WEAPON,x                ; torpedo to the special, or back to laser
000944r 2  BD 80 09       lda SPECIAL_WAIT,x
