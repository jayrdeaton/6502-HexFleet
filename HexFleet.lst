000511r 2  8D 67 09       sta AI_B
000514r 2  20 rr rr       jsr Interp
000517r 2  A4 FE          ldy AI_CNT
000519r 2  99 FC 09       sta AI_MY,y
00051Cr 2  E6 FE          inc AI_CNT
00051Er 2  A5 FE          lda AI_CNT
000520r 2  C9 03          cmp #3
000522r 2  D0 CA          bne @moment
000524r 2               @done:
000524r 2  60             rts
000525r 2               
000525r 2               ; MateOnLine - would the line from (AI_A, AI_B) touch the teammate at moment A?
000525r 2               MateOnLine:
000525r 2  A8             tay
000526r 2  AD EE 09       lda AI_MATE
000529r 2  30 28          bmi @done
00052Br 2  B9 F9 09       lda AI_MX,y
00052Er 2  38             sec
00052Fr 2  ED 66 09       sbc AI_A
000532r 2  85 96          sta VX
000534r 2  A9 00          lda #0
000536r 2  E9 00          sbc #0
000538r 2  85 97          sta VX+1
00053Ar 2  B9 FC 09       lda AI_MY,y
00053Dr 2  38             sec
00053Er 2  ED 67 09       sbc AI_B
000541r 2  85 98          sta VY
000543r 2  A9 00          lda #0
000545r 2  E9 00          sbc #0
000547r 2  85 99          sta VY+1
000549r 2  20 rr rr       jsr LineTest
00054Cr 2  90 05          bcc @done
00054Er 2  A9 01          lda #1
000550r 2  8D F6 09       sta AI_BAD
000553r 2               @done:
000553r 2  60             rts
000554r 2               
000554r 2               ; AiSetup - the move is chosen: work out where the ship will be.
000554r 2               AiSetup:
000554r 2  A6 ED          ldx AI_BC
000556r 2  A4 EE          ldy AI_BR
000558r 2  20 rr rr       jsr HexCenter
00055Br 2  A5 7F          lda HX
00055Dr 2  8D 69 09       sta AI_DX
000560r 2  A5 80          lda HY
000562r 2  8D 6A 09       sta AI_DY
000565r 2  A0 00          ldy #0
000567r 2               @moment:
000567r 2  5A             phy
000568r 2  B9 rr rr       lda SampleK,y
00056Br 2  8D 68 09       sta AI_F
00056Er 2  A5 F4          lda AI_SX
000570r 2  8D 66 09       sta AI_A
000573r 2  AD 69 09       lda AI_DX
000576r 2  8D 67 09       sta AI_B
000579r 2  20 rr rr       jsr Interp
00057Cr 2  7A             ply
00057Dr 2  99 58 09       sta AI_PX,y
000580r 2  5A             phy
000581r 2  A5 F5          lda AI_SY
000583r 2  8D 66 09       sta AI_A
000586r 2  AD 6A 09       lda AI_DY
000589r 2  8D 67 09       sta AI_B
00058Cr 2  20 rr rr       jsr Interp
00058Fr 2  7A             ply
000590r 2  99 5B 09       sta AI_PY,y
000593r 2  C8             iny
000594r 2  C0 03          cpy #3
000596r 2  D0 CF          bne @moment
000598r 2  20 rr rr       jsr MateMoments
00059Br 2                 ; aim at where the enemy is unless something scores better
00059Br 2  AD 7D 09       lda AI_KC
00059Er 2  85 F0          sta AI_BAC
0005A0r 2  AD 7E 09       lda AI_KR
0005A3r 2  85 F1          sta AI_BAR
0005A5r 2  64 EF          stz AI_BW
0005A7r 2  A2 01          ldx #1
0005A9r 2               @clear:
0005A9r 2  9E 74 09       stz AI_BS_LO,x
0005ACr 2  9E 76 09       stz AI_BS_HI,x
0005AFr 2  AD 7D 09       lda AI_KC
0005B2r 2  9D 78 09       sta AI_BA_C,x
0005B5r 2  AD 7E 09       lda AI_KR
0005B8r 2  9D 7A 09       sta AI_BA_R,x
0005BBr 2  CA             dex
0005BCr 2  10 EB          bpl @clear
0005BEr 2  A5 ED          lda AI_BC
0005C0r 2  85 B0          sta HD_C1
0005C2r 2  A5 EE          lda AI_BR
0005C4r 2  85 B1          sta HD_R1
0005C6r 2  AD 7D 09       lda AI_KC
0005C9r 2  85 B2          sta HD_C2
0005CBr 2  AD 7E 09       lda AI_KR
0005CEr 2  85 B3          sta HD_R2
0005D0r 2  20 rr rr       jsr HexDist
0005D3r 2  85 FF          sta AI_TMP
0005D5r 2  C9 0D          cmp #13
0005D7r 2  90 02          bcc @near
0005D9r 2  A9 0C          lda #12
0005DBr 2               @near:
0005DBr 2  AA             tax
0005DCr 2  BD rr rr       lda BurnByRange,x
0005DFr 2  8D 6E 09       sta AI_BURN
0005E2r 2  AD EF 09       lda AI_EASY
0005E5r 2  F0 10          beq @normal
0005E7r 2                 ; easy: lasers up close, otherwise either weapon
0005E7r 2  A5 FF          lda AI_TMP
0005E9r 2  C9 05          cmp #5
0005EBr 2  90 07          bcc @commit
0005EDr 2  20 rr rr       jsr Rnd
0005F0r 2  29 01          and #1
0005F2r 2  85 EF          sta AI_BW
0005F4r 2               @commit:
0005F4r 2  4C rr rr       jmp AiSpecial
0005F7r 2               @normal:
0005F7r 2  64 FB          stz AI_I
0005F9r 2  9C 73 09       stz AI_SUB
0005FCr 2  A9 02          lda #AI_AIMS
0005FEr 2  85 E7          sta AI_PHASE
000600r 2  60             rts
000601r 2               
000601r 2               ; AiAim - one slice of trying the weapons at one of the enemy's possible ends:
000601r 2               ; the laser at each of the three moments, then the torpedo.
000601r 2               AiAim:
000601r 2  A4 FB          ldy AI_I
000603r 2  B9 18 09       lda AI_EPX,y
000606r 2  8D 6B 09       sta AI_AX
000609r 2  B9 20 09       lda AI_EPY,y
00060Cr 2  8D 6C 09       sta AI_AY
00060Fr 2  AD 73 09       lda AI_SUB
000612r 2  C9 03          cmp #3
000614r 2  F0 1E          beq @torpedo
000616r 2  85 FD          sta AI_S
000618r 2  D0 07          bne @moment
00061Ar 2  64 F2          stz AI_SC
00061Cr 2  64 F3          stz AI_SC+1
00061Er 2  9C F6 09       stz AI_BAD
000621r 2               @moment:
000621r 2  20 rr rr       jsr LaserMoment
000624r 2  EE 73 09       inc AI_SUB
000627r 2  AD 73 09       lda AI_SUB
00062Ar 2  C9 03          cmp #3
00062Cr 2  D0 1F          bne @done
00062Er 2  9C 6D 09       stz AI_W
000631r 2  4C rr rr       jmp KeepShot
000634r 2               @torpedo:
000634r 2  20 rr rr       jsr ScoreTorpedo
000637r 2  A9 01          lda #W_TORPEDO
000639r 2  8D 6D 09       sta AI_W
00063Cr 2  20 rr rr       jsr KeepShot
00063Fr 2  9C 73 09       stz AI_SUB
000642r 2  E6 FB          inc AI_I
000644r 2  A5 FB          lda AI_I
000646r 2  C5 EA          cmp AI_N
000648r 2  D0 03          bne @done
00064Ar 2  4C rr rr       jmp AiChoose
00064Dr 2               @done:
00064Dr 2  60             rts
00064Er 2               
00064Er 2               ; KeepShot - AI_SC, plus a little noise, against weapon AI_W's best so far. A shot
00064Er 2               ; that would hit the teammate doesn't count.
00064Er 2               KeepShot:
00064Er 2  AD F6 09       lda AI_BAD
000651r 2  F0 01          beq @fair
000653r 2  60             rts
000654r 2               @fair:
000654r 2  20 rr rr       jsr Rnd
000657r 2  29 0F          and #15
000659r 2  18             clc
00065Ar 2  65 F2          adc AI_SC
00065Cr 2  85 F2          sta AI_SC
00065Er 2  90 02          bcc @noCarry
000660r 2  E6 F3          inc AI_SC+1
000662r 2               @noCarry:
000662r 2  AE 6D 09       ldx AI_W
000665r 2  A5 F2          lda AI_SC
000667r 2  DD 74 09       cmp AI_BS_LO,x
00066Ar 2  A5 F3          lda AI_SC+1
00066Cr 2  FD 76 09       sbc AI_BS_HI,x
00066Fr 2  90 18          bcc @done
000671r 2  A5 F2          lda AI_SC
000673r 2  9D 74 09       sta AI_BS_LO,x
000676r 2  A5 F3          lda AI_SC+1
000678r 2  9D 76 09       sta AI_BS_HI,x
00067Br 2  A4 FB          ldy AI_I
00067Dr 2  B9 00 09       lda AI_EC,y
000680r 2  9D 78 09       sta AI_BA_C,x
000683r 2  B9 08 09       lda AI_ER,y
000686r 2  9D 7A 09       sta AI_BA_R,x
000689r 2               @done:
000689r 2  60             rts
00068Ar 2               
00068Ar 2               ; AiChoose - laser or torpedo. A laser usually promises more, but only if the
00068Ar 2               ; enemy holds still, so a torpedo that's at least half as good gets its turn
00068Ar 2               ; now and then, more often against an enemy that's been moving.
00068Ar 2               AiChoose:
00068Ar 2  A2 00          ldx #W_LASER
00068Cr 2  AD 75 09       lda AI_BS_LO+W_TORPEDO
00068Fr 2  CD 74 09       cmp AI_BS_LO+W_LASER
000692r 2  AD 77 09       lda AI_BS_HI+W_TORPEDO
000695r 2  ED 76 09       sbc AI_BS_HI+W_LASER
000698r 2  B0 28          bcs @torpedo                     ; better outright
00069Ar 2  AD 76 09       lda AI_BS_HI+W_LASER             ; half the laser's score
00069Dr 2  4A             lsr a
00069Er 2  85 FF          sta AI_TMP
0006A0r 2  AD 74 09       lda AI_BS_LO+W_LASER
0006A3r 2  6A             ror a
0006A4r 2  CD 75 09       cmp AI_BS_LO+W_TORPEDO
0006A7r 2  A5 FF          lda AI_TMP
0006A9r 2  ED 77 09       sbc AI_BS_HI+W_TORPEDO
0006ACr 2  B0 1A          bcs @pick                        ; not close enough
0006AEr 2  20 rr rr       jsr Rnd
0006B1r 2  29 07          and #7
0006B3r 2  AC 7C 09       ldy AI_STAYED
0006B6r 2  D0 06          bne @still
0006B8r 2  C9 03          cmp #3                           ; 3 in 8 against a moving enemy
0006BAr 2  B0 0A          bcs @laser
0006BCr 2  80 04          bra @torpedo
0006BEr 2               @still:
0006BEr 2  C9 01          cmp #1                           ; 1 in 8 against one holding still
0006C0r 2  B0 04          bcs @laser
0006C2r 2               @torpedo:
0006C2r 2  A2 01          ldx #W_TORPEDO
0006C4r 2  80 02          bra @pick
0006C6r 2               @laser:
0006C6r 2  A2 00          ldx #W_LASER
0006C8r 2               @pick:
0006C8r 2  86 EF          stx AI_BW
0006CAr 2  BD 78 09       lda AI_BA_C,x
0006CDr 2  85 F0          sta AI_BAC
0006CFr 2  BD 7A 09       lda AI_BA_R,x
0006D2r 2  85 F1          sta AI_BAR
0006D4r 2  4C rr rr       jmp AiSpecial
0006D7r 2               
0006D7r 2               ; AddScore - weight of end AI_K times A onto AI_SC.
0006D7r 2               AddScore:
0006D7r 2  A4 FC          ldy AI_K
0006D9r 2  BE 10 09       ldx AI_EW,y
0006DCr 2  20 rr rr       jsr Mul8
0006DFr 2  A5 56          lda PROD
0006E1r 2  18             clc
0006E2r 2  65 F2          adc AI_SC
0006E4r 2  85 F2          sta AI_SC
0006E6r 2  A5 57          lda PROD+1
0006E8r 2  65 F3          adc AI_SC+1
0006EAr 2  85 F3          sta AI_SC+1
0006ECr 2  60             rts
0006EDr 2               
0006EDr 2               ; SetV - VX, VY = the enemy at end AI_K, moment AI_S, less (AI_A, AI_B).
0006EDr 2               SetV:
0006EDr 2  A5 FC          lda AI_K
0006EFr 2  0A             asl a
0006F0r 2  18             clc
0006F1r 2  65 FC          adc AI_K
0006F3r 2  65 FD          adc AI_S
0006F5r 2  A8             tay
0006F6r 2  B9 28 09       lda AI_TX,y
0006F9r 2  38             sec
0006FAr 2  ED 66 09       sbc AI_A
