0014F0r 2  C5 FD          cmp AI_S
0014F2r 2  90 13          bcc @shorter
0014F4r 2  F0 11          beq @shorter
0014F6r 2  85 FD          sta AI_S
0014F8r 2  AD 64 09       lda AI_OC
0014FBr 2  85 ED          sta AI_BC
0014FDr 2  AD 65 09       lda AI_OR
001500r 2  85 EE          sta AI_BR
001502r 2  A9 01          lda #1
001504r 2  8D E0 09       sta AI_SPEC
001507r 2               @shorter:
001507r 2  C6 FC          dec AI_K
001509r 2  C6 FC          dec AI_K
00150Br 2  D0 AF          bne @hop
00150Dr 2  E6 FB          inc AI_I
00150Fr 2  A5 FB          lda AI_I
001511r 2  C9 06          cmp #6
001513r 2  D0 A3          bne @dir
001515r 2               @commit:
001515r 2  4C rr rr       jmp AiCommit
001518r 2               
001518r 2               ; TimesK - A (1, 0 or -1) times AI_K.
001518r 2               TimesK:
001518r 2  C9 00          cmp #0
00151Ar 2  F0 0A          beq @done
00151Cr 2  30 03          bmi @minus
00151Er 2  A5 FC          lda AI_K
001520r 2  60             rts
001521r 2               @minus:
001521r 2  A9 00          lda #0
001523r 2  38             sec
001524r 2  E5 FC          sbc AI_K
001526r 2               @done:
001526r 2  60             rts
001527r 2               
001527r 2               ; AiFlak - one slice: how much of where the enemy may end would a burst on this
001527r 2               ; hex catch? The enemy's hex first, then the six round it.
001527r 2               AiFlak:
001527r 2  AD 7D 09       lda AI_KC
00152Ar 2  8D 64 09       sta AI_OC
00152Dr 2  8D 60 09       sta AI_HC
001530r 2  AD 7E 09       lda AI_KR
001533r 2  8D 65 09       sta AI_OR
001536r 2  8D 61 09       sta AI_HR
001539r 2  A6 FB          ldx AI_I
00153Br 2  F0 11          beq @have
00153Dr 2  BD rr rr       lda DirQ-1,x
001540r 2  8D 62 09       sta AI_HQ
001543r 2  BD rr rr       lda DirR-1,x
001546r 2  8D 63 09       sta AI_HS
001549r 2  20 rr rr       jsr HexStep
00154Cr 2  90 5C          bcc @next
00154Er 2               @have:
00154Er 2  AD 19 08       lda SHIP_C+ME
001551r 2  85 B0          sta HD_C1
001553r 2  AD 1D 08       lda SHIP_R+ME
001556r 2  85 B1          sta HD_R1
001558r 2  AD 64 09       lda AI_OC
00155Br 2  85 B2          sta HD_C2
00155Dr 2  AD 65 09       lda AI_OR
001560r 2  85 B3          sta HD_R2
001562r 2  20 rr rr       jsr HexDist
001565r 2  C9 06          cmp #FLAK_RANGE + 1
001567r 2  B0 41          bcs @next
001569r 2  64 FD          stz AI_S
00156Br 2  64 FC          stz AI_K
