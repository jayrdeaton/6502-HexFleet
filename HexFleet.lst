0008FFr 2  AD 7F 09       lda AI_D
000902r 2  C9 07          cmp #JUMP_RANGE + 1
000904r 2  B0 3B          bcs @away
000906r 2  AD F2 09       lda AI_MHP
000909r 2  C9 15          cmp #RAM_RECOIL + 1
00090Br 2  90 34          bcc @away
00090Dr 2  AD F5 09       lda AI_FHP
000910r 2  C9 29          cmp #RAM_DAMAGE + 1
000912r 2  90 0C          bcc @dive
000914r 2  AD 7C 09       lda AI_STAYED
000917r 2  F0 28          beq @away
000919r 2  20 rr rr       jsr Rnd
00091Cr 2  29 01          and #1
00091Er 2  D0 21          bne @away
000920r 2               @dive:
000920r 2  AD 7D 09       lda AI_KC                        ; not onto the teammate
000923r 2  8D 64 09       sta AI_OC
000926r 2  AD 7E 09       lda AI_KR
000929r 2  8D 65 09       sta AI_OR
00092Cr 2  20 rr rr       jsr NearMate
00092Fr 2  B0 10          bcs @away
000931r 2  AD 7D 09       lda AI_KC
000934r 2  85 ED          sta AI_BC
000936r 2  AD 7E 09       lda AI_KR
000939r 2  85 EE          sta AI_BR
00093Br 2  EE E0 09       inc AI_SPEC
00093Er 2  4C rr rr       jmp AiCommit
000941r 2               @away:
000941r 2  AD F2 09       lda AI_MHP
000944r 2  C9 1F          cmp #AI_HURT
000946r 2  B0 6B          bcs @commit
000948r 2  AD 7F 09       lda AI_D
00094Br 2  C9 05          cmp #5
00094Dr 2  B0 64          bcs @commit
00094Fr 2  AD 7F 09       lda AI_D
000952r 2  85 FD          sta AI_S
000954r 2  64 FB          stz AI_I
000956r 2               @dir:
000956r 2  A9 06          lda #JUMP_RANGE
000958r 2  85 FC          sta AI_K
00095Ar 2               @hop:
00095Ar 2  AD F0 09       lda AI_MC
00095Dr 2  8D 60 09       sta AI_HC
000960r 2  AD F1 09       lda AI_MR
000963r 2  8D 61 09       sta AI_HR
000966r 2  A6 FB          ldx AI_I
000968r 2  BD rr rr       lda DirQ,x
00096Br 2  20 rr rr       jsr TimesK
00096Er 2  8D 62 09       sta AI_HQ
000971r 2  A6 FB          ldx AI_I
000973r 2  BD rr rr       lda DirR,x
000976r 2  20 rr rr       jsr TimesK
000979r 2  8D 63 09       sta AI_HS
00097Cr 2  20 rr rr       jsr HexStep
00097Fr 2  90 24          bcc @shorter
000981r 2  AD 64 09       lda AI_OC
000984r 2  85 B0          sta HD_C1
000986r 2  AD 65 09       lda AI_OR
000989r 2  85 B1          sta HD_R1
00098Br 2  20 rr rr       jsr HexDist                      ; HD_C2, HD_R2 still hold the enemy
00098Er 2  C5 FD          cmp AI_S
000990r 2  90 13          bcc @shorter
000992r 2  F0 11          beq @shorter
000994r 2  85 FD          sta AI_S
000996r 2  AD 64 09       lda AI_OC
000999r 2  85 ED          sta AI_BC
00099Br 2  AD 65 09       lda AI_OR
00099Er 2  85 EE          sta AI_BR
0009A0r 2  A9 01          lda #1
0009A2r 2  8D E0 09       sta AI_SPEC
0009A5r 2               @shorter:
0009A5r 2  C6 FC          dec AI_K
0009A7r 2  C6 FC          dec AI_K
0009A9r 2  D0 AF          bne @hop
0009ABr 2  E6 FB          inc AI_I
0009ADr 2  A5 FB          lda AI_I
0009AFr 2  C9 06          cmp #6
0009B1r 2  D0 A3          bne @dir
0009B3r 2               @commit:
0009B3r 2  4C rr rr       jmp AiCommit
0009B6r 2               
0009B6r 2               ; TimesK - A (1, 0 or -1) times AI_K.
0009B6r 2               TimesK:
0009B6r 2  C9 00          cmp #0
0009B8r 2  F0 0A          beq @done
0009BAr 2  30 03          bmi @minus
0009BCr 2  A5 FC          lda AI_K
0009BEr 2  60             rts
0009BFr 2               @minus:
0009BFr 2  A9 00          lda #0
0009C1r 2  38             sec
0009C2r 2  E5 FC          sbc AI_K
0009C4r 2               @done:
0009C4r 2  60             rts
0009C5r 2               
0009C5r 2               ; AiFlak - one slice: how much of where the enemy may end would a burst on this
0009C5r 2               ; hex catch? The enemy's hex first, then the six round it.
0009C5r 2               AiFlak:
0009C5r 2  AD 7D 09       lda AI_KC
0009C8r 2  8D 64 09       sta AI_OC
0009CBr 2  8D 60 09       sta AI_HC
0009CEr 2  AD 7E 09       lda AI_KR
0009D1r 2  8D 65 09       sta AI_OR
0009D4r 2  8D 61 09       sta AI_HR
0009D7r 2  A6 FB          ldx AI_I
0009D9r 2  F0 11          beq @have
0009DBr 2  BD rr rr       lda DirQ-1,x
0009DEr 2  8D 62 09       sta AI_HQ
0009E1r 2  BD rr rr       lda DirR-1,x
0009E4r 2  8D 63 09       sta AI_HS
0009E7r 2  20 rr rr       jsr HexStep
0009EAr 2  90 61          bcc @next
0009ECr 2               @have:
0009ECr 2  20 rr rr       jsr NearMate                     ; a shell here would catch the teammate
0009EFr 2  B0 5C          bcs @next
0009F1r 2  AD F0 09       lda AI_MC
0009F4r 2  85 B0          sta HD_C1
0009F6r 2  AD F1 09       lda AI_MR
0009F9r 2  85 B1          sta HD_R1
0009FBr 2  AD 64 09       lda AI_OC
0009FEr 2  85 B2          sta HD_C2
000A00r 2  AD 65 09       lda AI_OR
000A03r 2  85 B3          sta HD_R2
000A05r 2  20 rr rr       jsr HexDist
000A08r 2  C9 06          cmp #FLAK_RANGE + 1
000A0Ar 2  B0 41          bcs @next
000A0Cr 2  64 FD          stz AI_S
000A0Er 2  64 FC          stz AI_K
000A10r 2               @end:
000A10r 2  A4 FC          ldy AI_K
000A12r 2  B9 00 09       lda AI_EC,y
000A15r 2  85 B0          sta HD_C1
000A17r 2  B9 08 09       lda AI_ER,y
000A1Ar 2  85 B1          sta HD_R1
000A1Cr 2  20 rr rr       jsr HexDist
000A1Fr 2  C9 02          cmp #2
000A21r 2  B0 0A          bcs @far
000A23r 2  A4 FC          ldy AI_K
000A25r 2  B9 10 09       lda AI_EW,y
000A28r 2  18             clc
000A29r 2  65 FD          adc AI_S
000A2Br 2  85 FD          sta AI_S
000A2Dr 2               @far:
000A2Dr 2  E6 FC          inc AI_K
000A2Fr 2  A5 FC          lda AI_K
000A31r 2  C5 EA          cmp AI_N
000A33r 2  D0 DB          bne @end
000A35r 2  A5 FD          lda AI_S
000A37r 2  CD E1 09       cmp AI_FS
000A3Ar 2  90 11          bcc @next
000A3Cr 2  F0 0F          beq @next
000A3Er 2  8D E1 09       sta AI_FS
000A41r 2  AD 64 09       lda AI_OC
000A44r 2  8D E2 09       sta AI_FC
000A47r 2  AD 65 09       lda AI_OR
000A4Ar 2  8D E3 09       sta AI_FR
000A4Dr 2               @next:
000A4Dr 2  E6 FB          inc AI_I
000A4Fr 2  A5 FB          lda AI_I
000A51r 2  C9 07          cmp #7
000A53r 2  F0 01          beq @decide
000A55r 2  60             rts
000A56r 2               @decide:
000A56r 2  AD E1 09       lda AI_FS
000A59r 2  F0 34          beq @commit
000A5Br 2  A2 2D          ldx #FLAK_DAMAGE
000A5Dr 2  20 rr rr       jsr Mul8
000A60r 2  06 56          asl PROD
000A62r 2  26 57          rol PROD+1
000A64r 2  A6 EF          ldx AI_BW
000A66r 2  A5 56          lda PROD
000A68r 2  DD 74 09       cmp AI_BS_LO,x
000A6Br 2  A5 57          lda PROD+1
000A6Dr 2  FD 76 09       sbc AI_BS_HI,x
000A70r 2  90 09          bcc @rare
000A72r 2  20 rr rr       jsr Rnd                          ; worth at least half the shot: 1 in 2
000A75r 2  29 01          and #1
000A77r 2  D0 16          bne @commit
000A79r 2  80 07          bra @use
000A7Br 2               @rare:
000A7Br 2  20 rr rr       jsr Rnd                          ; otherwise 1 in 4, to keep the enemy moving
000A7Er 2  29 03          and #3
000A80r 2  D0 0D          bne @commit
000A82r 2               @use:
000A82r 2  AD E2 09       lda AI_FC
000A85r 2  85 F0          sta AI_BAC
000A87r 2  AD E3 09       lda AI_FR
000A8Ar 2  85 F1          sta AI_BAR
000A8Cr 2  EE E0 09       inc AI_SPEC
000A8Fr 2               @commit:
