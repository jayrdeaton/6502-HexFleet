0003E8r 2               IT_MODE       = 0
0003E8r 2               IT_MUSIC      = 9
0003E8r 2               
0003E8r 2               ModeNames:
0003E8r 2  rr rr rr rr    .word TxtAllFight, TxtTeams, TxtLink
0003ECr 2  rr rr        
