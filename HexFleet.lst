000629r 2  9D 00 98       sta SID_V1_FREQ_LO,x
00062Cr 2  CA             dex
00062Dr 2  10 F7          bpl @copy
00062Fr 2  60             rts
000630r 2               
000630r 2               TakeRequests:
000630r 2  AE 29 0F       ldx S_QT
000633r 2  EC 28 0F       cpx S_QH
000636r 2  F0 34          beq @done
000638r 2  BD 20 0F       lda S_Q,x
00063Br 2  E8             inx
00063Cr 2  E0 08          cpx #8
00063Er 2  90 02          bcc @stored
000640r 2  A2 00          ldx #0
000642r 2               @stored:
000642r 2  8E 29 0F       stx S_QT
000645r 2  C9 F0          cmp #REQ_LASER_OFF
000647r 2  F0 09          beq @laserOff
000649r 2  C9 F1          cmp #REQ_ALL_OFF
00064Br 2  F0 13          beq @allOff
00064Dr 2  20 rr rr       jsr EffectStart
000650r 2  80 DE          bra TakeRequests
000652r 2               @laserOff:
000652r 2  A2 01          ldx #1
000654r 2  BD 4D 0F       lda SF_ID,x
000657r 2  C9 05          cmp #SFX_LASER
000659r 2  D0 D5          bne TakeRequests
00065Br 2  20 rr rr       jsr EffectEnd
00065Er 2  80 D0          bra TakeRequests
000660r 2               @allOff:
000660r 2  A2 01          ldx #1
000662r 2  20 rr rr       jsr EffectEnd
000665r 2  A2 02          ldx #2
000667r 2  20 rr rr       jsr EffectEnd
00066Ar 2  80 C4          bra TakeRequests
00066Cr 2               @done:
00066Cr 2  60             rts
00066Dr 2               
00066Dr 2               ; --- Effects ---
00066Dr 2               
00066Dr 2               ; CanTake - carry set if an effect of priority S_A may have voice X.
00066Dr 2               CanTake:
00066Dr 2  BD 4D 0F       lda SF_ID,x
000670r 2  F0 06          beq @yes
000672r 2  A5 D1          lda S_A
000674r 2  DD 50 0F       cmp SF_P,x                       ; carry set if it matters as much or more
000677r 2  60             rts
000678r 2               @yes:
000678r 2  38             sec
000679r 2  60             rts
00067Ar 2               
00067Ar 2               ; EffectStart - effect A on the voice it prefers, or its other choice. Keeps X.
00067Ar 2               EffectStart:
00067Ar 2  DA             phx
00067Br 2  A8             tay
00067Cr 2  B9 rr rr       lda FxPrio,y
00067Fr 2  85 D1          sta S_A
000681r 2  BE rr rr       ldx FxVoice,y
000684r 2  20 rr rr       jsr CanTake
000687r 2  B0 0E          bcs @take
000689r 2  B9 rr rr       lda FxOther,y
00068Cr 2  F0 29          beq @done
00068Er 2  8A             txa
00068Fr 2  49 03          eor #3                           ; 1 and 2 swap
000691r 2  AA             tax
000692r 2  20 rr rr       jsr CanTake
000695r 2  90 20          bcc @done
000697r 2               @take:
000697r 2  98             tya
000698r 2  9D 4D 0F       sta SF_ID,x
00069Br 2  A5 D1          lda S_A
00069Dr 2  9D 50 0F       sta SF_P,x
0006A0r 2  B9 rr rr       lda FxLo,y
0006A3r 2  9D 53 0F       sta SF_PL,x
0006A6r 2  B9 rr rr       lda FxHi,y
0006A9r 2  9D 56 0F       sta SF_PH,x
0006ACr 2  9E 59 0F       stz SF_LEFT,x
0006AFr 2  B9 rr rr       lda FxPair,y
0006B2r 2  F0 03          beq @done
0006B4r 2  20 rr rr       jsr EffectStart
0006B7r 2               @done:
0006B7r 2  FA             plx
0006B8r 2  60             rts
0006B9r 2               
0006B9r 2               ; EffectEnd - voice X lets go and goes back to the music.
0006B9r 2               EffectEnd:
0006B9r 2  BD 4D 0F       lda SF_ID,x
0006BCr 2  F0 11          beq @done
0006BEr 2  9E 4D 0F       stz SF_ID,x
0006C1r 2  9E 6D 0F       stz SF_FIL,x
0006C4r 2  BC rr rr       ldy VoiceBase,x
0006C7r 2  B9 04 0F       lda S_REG+4,y
0006CAr 2  29 FE          and #$FE
0006CCr 2  99 04 0F       sta S_REG+4,y
0006CFr 2               @done:
0006CFr 2  60             rts
0006D0r 2               
0006D0r 2               ; EffectTick - voice X's effect, one frame on.
0006D0r 2               EffectTick:
0006D0r 2  BD 4D 0F       lda SF_ID,x
0006D3r 2  F0 3B          beq @done
0006D5r 2  BD 59 0F       lda SF_LEFT,x
0006D8r 2  D0 08          bne @run
0006DAr 2  20 rr rr       jsr NextStep
0006DDr 2  BD 4D 0F       lda SF_ID,x
0006E0r 2  F0 2E          beq @done
0006E2r 2               @run:
0006E2r 2  DE 59 0F       dec SF_LEFT,x
0006E5r 2  BC rr rr       ldy VoiceBase,x
0006E8r 2  BD 68 0F       lda SF_FLG,x
0006EBr 2  29 20          and #$20
0006EDr 2  F0 08          beq @noChop
0006EFr 2  B9 04 0F       lda S_REG+4,y                    ; chopped: the gate flips every frame
0006F2r 2  49 01          eor #1
0006F4r 2  99 04 0F       sta S_REG+4,y
0006F7r 2               @noChop:
0006F7r 2  BD 68 0F       lda SF_FLG,x
0006FAr 2  29 0F          and #$0F
0006FCr 2  F0 03          beq @write
0006FEr 2  20 rr rr       jsr SlidePitch
000701r 2               @write:
000701r 2  BC rr rr       ldy VoiceBase,x
000704r 2  BD 5C 0F       lda SF_FL,x
000707r 2  99 00 0F       sta S_REG,y
00070Ar 2  BD 5F 0F       lda SF_FH,x
00070Dr 2  99 01 0F       sta S_REG+1,y
000710r 2               @done:
000710r 2  60             rts
000711r 2               
000711r 2               ; NextStep - load voice X's next step, or end the effect.
000711r 2               NextStep:
000711r 2  BD 53 0F       lda SF_PL,x
000714r 2  85 D3          sta S_P
000716r 2  BD 56 0F       lda SF_PH,x
000719r 2  85 D4          sta S_P+1
00071Br 2  B2 D3          lda (S_P)
00071Dr 2  D0 03          bne @step
00071Fr 2  4C rr rr       jmp EffectEnd
000722r 2               @step:
000722r 2  C9 FF          cmp #$FF
000724r 2  D0 1B          bne @load
000726r 2                 ; go back some steps
000726r 2  A0 01          ldy #1
000728r 2  B1 D3          lda (S_P),y
00072Ar 2  0A             asl a
00072Br 2  0A             asl a
00072Cr 2  85 D9          sta S_B
00072Er 2  0A             asl a
00072Fr 2  18             clc
000730r 2  65 D9          adc S_B                          ; 12 bytes a step
000732r 2  85 D9          sta S_B
000734r 2  A5 D3          lda S_P
000736r 2  38             sec
000737r 2  E5 D9          sbc S_B
000739r 2  85 D3          sta S_P
00073Br 2  B0 02          bcs @back
00073Dr 2  C6 D4          dec S_P+1
00073Fr 2               @back:
00073Fr 2  B2 D3          lda (S_P)
000741r 2               @load:
000741r 2  9D 59 0F       sta SF_LEFT,x
000744r 2  DA             phx
000745r 2  BD rr rr       lda VoiceBase,x
000748r 2  AA             tax
000749r 2  A0 01          ldy #1
00074Br 2  B1 D3          lda (S_P),y
00074Dr 2  9D 04 0F       sta S_REG+4,x
000750r 2  C8             iny
000751r 2  B1 D3          lda (S_P),y
000753r 2  9D 05 0F       sta S_REG+5,x
000756r 2  C8             iny
000757r 2  B1 D3          lda (S_P),y
000759r 2  9D 06 0F       sta S_REG+6,x
00075Cr 2  A0 09          ldy #9
00075Er 2  B1 D3          lda (S_P),y
000760r 2  9D 03 0F       sta S_REG+3,x
000763r 2  9E 02 0F       stz S_REG+2,x
000766r 2  FA             plx
000767r 2  A0 08          ldy #8
000769r 2  B1 D3          lda (S_P),y
00076Br 2  9D 68 0F       sta SF_FLG,x
00076Er 2  30 19          bmi @kept                        ; carries on from the last pitch
000770r 2  A0 04          ldy #4
000772r 2  B1 D3          lda (S_P),y
000774r 2  9D 5C 0F       sta SF_FL,x
000777r 2  C8             iny
000778r 2  B1 D3          lda (S_P),y
00077Ar 2  9D 5F 0F       sta SF_FH,x
00077Dr 2  C8             iny
00077Er 2  B1 D3          lda (S_P),y
000780r 2  9D 62 0F       sta SF_TL,x
000783r 2  C8             iny
000784r 2  B1 D3          lda (S_P),y
000786r 2  9D 65 0F       sta SF_TH,x
000789r 2               @kept:
000789r 2  A0 0A          ldy #10
00078Br 2  B1 D3          lda (S_P),y
00078Dr 2  F0 0B          beq @noFilter
00078Fr 2  8D 6B 0F       sta S_FXC
000792r 2  C8             iny
000793r 2  B1 D3          lda (S_P),y
000795r 2  8D 6C 0F       sta S_FXK
000798r 2  A9 01          lda #1
00079Ar 2               @noFilter:
00079Ar 2  9D 6D 0F       sta SF_FIL,x
00079Dr 2  BD 68 0F       lda SF_FLG,x
0007A0r 2  29 10          and #$10
0007A2r 2  F0 05          beq @noRetrigger
0007A4r 2  A9 01          lda #1
0007A6r 2  9D 1C 0F       sta S_PEND,x
0007A9r 2               @noRetrigger:
0007A9r 2  A5 D3          lda S_P
0007ABr 2  18             clc
0007ACr 2  69 0C          adc #12
0007AEr 2  9D 53 0F       sta SF_PL,x
0007B1r 2  A5 D4          lda S_P+1
0007B3r 2  69 00          adc #0
0007B5r 2  9D 56 0F       sta SF_PH,x
0007B8r 2  60             rts
0007B9r 2               
0007B9r 2               ; SlidePitch - voice X's pitch toward its target.
0007B9r 2               SlidePitch:
0007B9r 2  BD 68 0F       lda SF_FLG,x
0007BCr 2  29 40          and #$40
0007BEr 2  D0 39          bne @grow
0007C0r 2                 ; a share of the distance left
0007C0r 2  BD 62 0F       lda SF_TL,x
0007C3r 2  38             sec
0007C4r 2  FD 5C 0F       sbc SF_FL,x
0007C7r 2  85 D9          sta S_B
0007C9r 2  BD 65 0F       lda SF_TH,x
0007CCr 2  FD 5F 0F       sbc SF_FH,x
0007CFr 2  85 DA          sta S_C
0007D1r 2  20 rr rr       jsr ShiftStep
0007D4r 2  A5 D9          lda S_B
0007D6r 2  05 DA          ora S_C
0007D8r 2  F0 12          beq @arrive
0007DAr 2  BD 5C 0F       lda SF_FL,x
0007DDr 2  18             clc
0007DEr 2  65 D9          adc S_B
0007E0r 2  9D 5C 0F       sta SF_FL,x
0007E3r 2  BD 5F 0F       lda SF_FH,x
0007E6r 2  65 DA          adc S_C
0007E8r 2  9D 5F 0F       sta SF_FH,x
0007EBr 2  60             rts
0007ECr 2               @arrive:
0007ECr 2  BD 62 0F       lda SF_TL,x
0007EFr 2  9D 5C 0F       sta SF_FL,x
0007F2r 2  BD 65 0F       lda SF_TH,x
0007F5r 2  9D 5F 0F       sta SF_FH,x
0007F8r 2  60             rts
0007F9r 2               @grow:
0007F9r 2  BD 5C 0F       lda SF_FL,x
0007FCr 2  85 D9          sta S_B
0007FEr 2  BD 5F 0F       lda SF_FH,x
000801r 2  85 DA          sta S_C
000803r 2  20 rr rr       jsr ShiftStep
000806r 2  BD 5C 0F       lda SF_FL,x
000809r 2  18             clc
00080Ar 2  65 D9          adc S_B
00080Cr 2  9D 5C 0F       sta SF_FL,x
00080Fr 2  BD 5F 0F       lda SF_FH,x
000812r 2  65 DA          adc S_C
000814r 2  9D 5F 0F       sta SF_FH,x
000817r 2  B0 D3          bcs @arrive
000819r 2  DD 65 0F       cmp SF_TH,x
00081Cr 2  B0 CE          bcs @arrive
00081Er 2  60             rts
00081Fr 2               
00081Fr 2               ; ShiftStep - S_C:S_B, signed, shifted right by voice X's slide amount.
00081Fr 2               ShiftStep:
00081Fr 2  BD 68 0F       lda SF_FLG,x
000822r 2  29 0F          and #$0F
000824r 2  A8             tay
000825r 2               @shift:
000825r 2  A5 DA          lda S_C
000827r 2  C9 80          cmp #$80
000829r 2  66 DA          ror S_C
00082Br 2  66 D9          ror S_B
00082Dr 2  88             dey
00082Er 2  D0 F5          bne @shift
000830r 2  60             rts
000831r 2               
000831r 2               ; --- Music ---
000831r 2               
000831r 2               ; ChooseTune - start the tune asked for, or stop if music is off.
000831r 2               ChooseTune:
000831r 2  AD 2D 0F       lda MUS_ON
000834r 2  F0 03          beq @wanted
000836r 2  AD 2C 0F       lda MUS_WANT
000839r 2               @wanted:
000839r 2  CD 2B 0F       cmp MUS_ID
00083Cr 2  F0 4F          beq @done
00083Er 2  8D 2B 0F       sta MUS_ID
000841r 2  9C 2E 0F       stz M_LFO
000844r 2  9C 2F 0F       stz M_LFO+1
000847r 2  A2 02          ldx #2
000849r 2               @track:
000849r 2  9E 41 0F       stz M_LEFT,x
00084Cr 2  9E 44 0F       stz M_GATE,x
00084Fr 2  9E 4A 0F       stz M_FILT,x
000852r 2  9E 47 0F       stz M_RATE,x
000855r 2  BD 4D 0F       lda SF_ID,x
000858r 2  D0 0B          bne @busy
00085Ar 2  BC rr rr       ldy VoiceBase,x
00085Dr 2  B9 04 0F       lda S_REG+4,y
000860r 2  29 FE          and #$FE
000862r 2  99 04 0F       sta S_REG+4,y
000865r 2               @busy:
000865r 2  AD 2B 0F       lda MUS_ID
000868r 2  F0 20          beq @next
00086Ar 2  0A             asl a
00086Br 2  6D 2B 0F       adc MUS_ID                       ; 3 tracks a tune
00086Er 2  38             sec
00086Fr 2  E9 03          sbc #3
000871r 2  86 D1          stx S_A
000873r 2  18             clc
000874r 2  65 D1          adc S_A
000876r 2  A8             tay
000877r 2  C8             iny
000878r 2  B9 rr rr       lda TuneTrackLo,y
00087Br 2  9D 35 0F       sta M_PL,x
00087Er 2  9D 3B 0F       sta M_SL,x
000881r 2  B9 rr rr       lda TuneTrackHi,y
000884r 2  9D 38 0F       sta M_PH,x
000887r 2  9D 3E 0F       sta M_SH,x
00088Ar 2               @next:
00088Ar 2  CA             dex
00088Br 2  10 BC          bpl @track
00088Dr 2               @done:
00088Dr 2  60             rts
00088Er 2               
00088Er 2               ; TrackTick - track X, one frame on.
00088Er 2               TrackTick:
00088Er 2  AD 2B 0F       lda MUS_ID
000891r 2  F0 40          beq @done
000893r 2  BD 41 0F       lda M_LEFT,x
000896r 2  D0 03          bne @run
000898r 2  20 rr rr       jsr NextEvent
00089Br 2               @run:
00089Br 2  DE 41 0F       dec M_LEFT,x
00089Er 2  BD 4D 0F       lda SF_ID,x
0008A1r 2  D0 30          bne @done                        ; an effect has this voice
0008A3r 2  BC rr rr       ldy VoiceBase,x
0008A6r 2  BD 44 0F       lda M_GATE,x
0008A9r 2  F0 0D          beq @drift
0008ABr 2  DD 41 0F       cmp M_LEFT,x
0008AEr 2  D0 08          bne @drift
0008B0r 2  B9 04 0F       lda S_REG+4,y                    ; time for this note to let go
0008B3r 2  29 FE          and #$FE
0008B5r 2  99 04 0F       sta S_REG+4,y
0008B8r 2               @drift:
0008B8r 2  BD 47 0F       lda M_RATE,x
0008BBr 2  F0 16          beq @done
0008BDr 2  18             clc
0008BEr 2  79 02 0F       adc S_REG+2,y
0008C1r 2  99 02 0F       sta S_REG+2,y
0008C4r 2  90 0D          bcc @done
0008C6r 2  B9 03 0F       lda S_REG+3,y
0008C9r 2  1A             inc a
0008CAr 2  29 0F          and #$0F
0008CCr 2  D0 02          bne @width
0008CEr 2  A9 02          lda #2                           ; never so narrow that it vanishes
0008D0r 2               @width:
0008D0r 2  99 03 0F       sta S_REG+3,y
0008D3r 2               @done:
0008D3r 2  60             rts
0008D4r 2               
0008D4r 2               NextEvent:
0008D4r 2  BD 35 0F       lda M_PL,x
0008D7r 2  85 D3          sta S_P
0008D9r 2  BD 38 0F       lda M_PH,x
0008DCr 2  85 D4          sta S_P+1
0008DEr 2  B2 D3          lda (S_P)
0008E0r 2  D0 0C          bne @event
0008E2r 2  BD 3B 0F       lda M_SL,x                       ; the end: round again
0008E5r 2  85 D3          sta S_P
0008E7r 2  BD 3E 0F       lda M_SH,x
0008EAr 2  85 D4          sta S_P+1
0008ECr 2  B2 D3          lda (S_P)
0008EEr 2               @event:
0008EEr 2  9D 41 0F       sta M_LEFT,x
0008F1r 2  A0 01          ldy #1
0008F3r 2  B1 D3          lda (S_P),y
0008F5r 2  85 D9          sta S_B
0008F7r 2  C8             iny
0008F8r 2  B1 D3          lda (S_P),y
0008FAr 2  85 DA          sta S_C
0008FCr 2  A5 D3          lda S_P
0008FEr 2  18             clc
0008FFr 2  69 03          adc #3
000901r 2  9D 35 0F       sta M_PL,x
000904r 2  A5 D4          lda S_P+1
000906r 2  69 00          adc #0
000908r 2  9D 38 0F       sta M_PH,x
00090Br 2  A5 D9          lda S_B
00090Dr 2  F0 09          beq @rest
00090Fr 2  C9 FD          cmp #KICK_NOTE
000911r 2  D0 0C          bne StartNote
000913r 2  A9 12          lda #SFX_THUMP
000915r 2  4C rr rr       jmp EffectStart
000918r 2               @rest:
000918r 2  9E 44 0F       stz M_GATE,x
00091Br 2  9E 47 0F       stz M_RATE,x
00091Er 2  60             rts
00091Fr 2               
00091Fr 2               ; StartNote - note S_B with instrument S_C on track X.
00091Fr 2               StartNote:
00091Fr 2  A5 DA          lda S_C
000921r 2  0A             asl a
000922r 2  0A             asl a
000923r 2  0A             asl a
000924r 2  A8             tay
000925r 2  B9 rr rr       lda Instruments+4,y
000928r 2  9D 47 0F       sta M_RATE,x
00092Br 2  BD 41 0F       lda M_LEFT,x                     ; it lets go after being held this long
00092Er 2  38             sec
00092Fr 2  F9 rr rr       sbc Instruments+5,y
000932r 2  B0 02          bcs @gate
000934r 2  A9 00          lda #0
000936r 2               @gate:
000936r 2  9D 44 0F       sta M_GATE,x
000939r 2  B9 rr rr       lda Instruments+6,y
00093Cr 2  9D 4A 0F       sta M_FILT,x
