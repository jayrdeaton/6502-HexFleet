000878r 2               ; --- Planning ---
000878r 2               ;
000878r 2               ; B swaps through what the ship can do this turn: Laser, Torpedo, then its
000878r 2               ; special if it's ready. A Raider's mine goes with the shot, so it adds Laser and
000878r 2               ; Torpedo with a mine. A flak shell is aimed like a shot but only so far; a cloak
000878r 2               ; needs no aim; a jump replaces the move and needs no aim.
000878r 2               
000878r 2               EnterPlan:
000878r 2  A9 02          lda #ST_PLAN
00087Ar 2  85 6E          sta STATE
00087Cr 2  A9 00          lda #PH_MOVE
00087Er 2  85 70          sta PHASE
000880r 2  64 8C          stz HAS_AIM
000882r 2  A6 6F          ldx PLAYER
000884r 2  86 76          stx VIEWER
000886r 2  9E 84 09       stz PLAN_SPECIAL,x
000889r 2  BD 18 08       lda SHIP_C,x
00088Cr 2  85 71          sta CUR_C
00088Er 2  BD 1C 08       lda SHIP_R,x
000891r 2  85 72          sta CUR_R
000893r 2  20 rr rr       jsr ClearMessages
000896r 2  20 rr rr       jsr IsLink
000899r 2  D0 12          bne @seat
00089Br 2  A6 6F          ldx PLAYER
00089Dr 2  BD 08 08       lda SHIP_INK,x
0008A0r 2  85 78          sta TXT_INK
0008A2r 2  A9 0B          lda #ROW_MSG1
