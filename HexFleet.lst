000302r 2  BD 14 08       lda SHIP_HP_HI,x
000305r 2  9D 90 08       sta HP_SHOWN,x
000308r 2  BD 08 08       lda SHIP_INK,x
00030Br 2  85 78          sta TXT_INK
00030Dr 2  BD 14 08       lda SHIP_HP_HI,x
000310r 2  A2 38          ldx #56
000312r 2  20 rr rr       jsr Mul8
000315r 2  A5 56          lda PROD
000317r 2  85 58          sta DIVIDEND
