00079Fr 2  AD 00 9C       lda VC_DATA
0007A2r 2  9D F8 08       sta GLYPH,x
0007A5r 2  E8             inx
0007A6r 2  E0 08          cpx #8
0007A8r 2  D0 F5          bne @row
0007AAr 2  60             rts
0007ABr 2               
0007ABr 2               ; BandClear - a solid band across the board for big text.
0007ABr 2               BandClear:
0007ABr 2  A2 0C          ldx #BAND_ROW
0007ADr 2               @row:
0007ADr 2  DA             phx
0007AEr 2  BD rr rr       lda RowHi,x
0007B1r 2  18             clc
0007B2r 2  69 08          adc #>V_L1NAME
0007B4r 2  48             pha
0007B5r 2  BD rr rr       lda RowLo,x
0007B8r 2  FA             plx
0007B9r 2  48             pha
0007BAr 2  20 rr rr       jsr VAddr
0007BDr 2  68             pla
0007BEr 2  85 40          sta T0
0007C0r 2  A9 0A          lda #PAT_SOLID
0007C2r 2  A0 1D          ldy #BOARD_CELLS
0007C4r 2               @name:
0007C4r 2  8D 00 9C       sta VC_DATA
0007C7r 2  88             dey
0007C8r 2  D0 FA          bne @name
0007CAr 2  8A             txa
0007CBr 2  18             clc
0007CCr 2  69 08          adc #>V_L1ATTR - >V_L1NAME
0007CEr 2  AA             tax
