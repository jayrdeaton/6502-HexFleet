000858r 2  D0 0B          bne @busy
00085Ar 2  BC rr rr       ldy VoiceBase,x
00085Dr 2  B9 04 0F       lda S_REG+4,y
000860r 2  29 FE          and #$FE
000862r 2  99 04 0F       sta S_REG+4,y
000865r 2               @busy:
000865r 2  AD 2B 0F       lda MUS_ID
000868r 2  F0 20          beq @next
00086Ar 2  0A             asl a
00086Br 2  6D 2B 0F       adc MUS_ID                       ; 3 tracks a tune
00086Er 2  38             sec
