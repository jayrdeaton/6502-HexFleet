000E2Br 2  B9 B4 0C       lda SEAT_KIND,y
000E2Er 2  D0 0B          bne @cpuWon
000E30r 2  4C rr rr       jmp @named
000E33r 2               @oneSide:
000E33r 2  A5 42          lda T2
000E35r 2  29 7F          and #$7F
000E37r 2  C5 41          cmp T1
000E39r 2  F0 07          beq @you
000E3Br 2               @cpuWon:
000E3Br 2  A2 rr          ldx #<TxtCpuWins
000E3Dr 2  A0 rr          ldy #>TxtCpuWins
000E3Fr 2  A9 03          lda #3
000E41r 2  60             rts
000E42r 2               @you:
000E42r 2  A2 rr          ldx #<TxtYouWin
000E44r 2  A0 rr          ldy #>TxtYouWin
000E46r 2  A9 03          lda #3
