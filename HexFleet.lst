001610r 2               
001610r 1               .include "src/ai.asm"
001610r 2               ; =============================================================================
001610r 2               ;   ai.asm - the CPU opponent
001610r 2               ; =============================================================================
001610r 2               ;   Each CPU seat plans in turn, from the board as the turn began, and never sees
001610r 2               ;   a person's plan. It thinks a slice at a time during the people's planning
001610r 2               ;   (AiWork, once a frame), so there's little to wait for. It watches its nearest
001610r 2               ;   enemy, and a teammate is something not to shoot or fly into.
001610r 2               ;
001610r 2               ;   Normal: it picks a hex that keeps a good distance and slides sideways off
001610r 2               ;   the line a shot would come down, guesses where the enemy may end up (staying
001610r 2               ;   put, or two hexes off in any of six directions), and tries a laser and a
001610r 2               ;   torpedo at each of those places, keeping the shot that should do the most.
001610r 2               ;   Easy: it closes in and shoots at where the enemy is now.
001610r 2               ;   Its specials are in special.asm. A cloaked enemy is known only by where it
001610r 2               ;   was last seen, and it knows nothing of the enemy's mines.
001610r 2               ; =============================================================================
001610r 2               
001610r 2               .segment "BANK04"
000000r 2               
000000r 2               AI_MOVES      = 0                  ; AI_PHASE: scoring moves,
000000r 2               AI_SETUP      = 1                  ; getting ready to aim,
000000r 2               AI_AIMS       = 2                  ; scoring shots,
000000r 2               AI_DONE       = 3                  ; the plan is in
000000r 2               AI_FLAK       = 4                  ; or still weighing a flak shell
000000r 2               AI_NEXT       = 5                  ; on to the next CPU seat
000000r 2               AI_IDLE       = AI_DONE
000000r 2               AI_BANK       = 4
000000r 2               
000000r 2               MOVES_A_SLICE = 4
000000r 2               
000000r 2               DirQ:
000000r 2  01 00 FF FF    .byte 1, 0, $FF, $FF, 0, 1
000004r 2  00 01        
000006r 2               DirR:
000006r 2  00 01 01 00    .byte 0, 1, 1, 0, $FF, $FF
00000Ar 2  FF FF        
00000Cr 2               ; Three moments in the turn, as eighths: 3/8, 5/8 and 7/8 of the way
00000Cr 2               SampleK:
00000Cr 2  03 05 07       .byte 3, 5, 7
00000Fr 2               ; A laser's burn a quarter-turn by distance in hexes
00000Fr 2               BurnByRange:
00000Fr 2  19 19 19 18    .byte 25, 25, 25, 24, 23, 21, 20, 19, 18, 16, 15, 14, 13
000013r 2  17 15 14 13  
000017r 2  12 10 0F 0E  
00001Cr 2               
00001Cr 2               .segment "CART"
000D9Dr 2               
000D9Dr 2               ; Rnd - a pseudo-random byte in A. Clobbers X.
000D9Dr 2               Rnd:
000D9Dr 2  A2 05          ldx #5
000D9Fr 2               @step:
000D9Fr 2  06 E4          asl RND
000DA1r 2  26 E5          rol RND+1
000DA3r 2  90 06          bcc @next
000DA5r 2  A5 E4          lda RND
000DA7r 2  49 2D          eor #$2D
000DA9r 2  85 E4          sta RND
000DABr 2               @next:
000DABr 2  CA             dex
000DACr 2  D0 F1          bne @step
000DAEr 2  A5 E4          lda RND
000DB0r 2  60             rts
000DB1r 2               
000DB1r 2               .segment "BANK04"
00001Cr 2               
00001Cr 2               ; HexStep - (AI_HC, AI_HR) moved by axial (AI_HQ, AI_HS) into (AI_OC, AI_OR).
00001Cr 2               ; Carry set if that's on the board.
00001Cr 2               HexStep:
00001Cr 2  AE 61 09       ldx AI_HR
00001Fr 2  AD 60 09       lda AI_HC
000022r 2  38             sec
000023r 2  FD rr rr       sbc FloorHalf,x
000026r 2  18             clc
000027r 2  6D 62 09       adc AI_HQ
00002Ar 2  85 FF          sta AI_TMP
00002Cr 2  AD 61 09       lda AI_HR
00002Fr 2  18             clc
000030r 2  6D 63 09       adc AI_HS
000033r 2  C9 0F          cmp #ROWS
000035r 2  B0 1C          bcs @off
000037r 2  8D 65 09       sta AI_OR
00003Ar 2  AA             tax
00003Br 2  A5 FF          lda AI_TMP
00003Dr 2  18             clc
00003Er 2  7D rr rr       adc FloorHalf,x
000041r 2  8D 64 09       sta AI_OC
000044r 2  8A             txa
000045r 2  20 rr rr       jsr RowLen
000048r 2  85 FF          sta AI_TMP
00004Ar 2  AD 64 09       lda AI_OC
00004Dr 2  C5 FF          cmp AI_TMP
00004Fr 2  B0 02          bcs @off
000051r 2  38             sec
000052r 2  60             rts
000053r 2               @off:
000053r 2  18             clc
000054r 2  60             rts
000055r 2               
000055r 2               ; Interp - AI_A + (AI_B - AI_A) * AI_F / 8, in A.
000055r 2               Interp:
000055r 2  AD 67 09       lda AI_B
000058r 2  38             sec
000059r 2  ED 66 09       sbc AI_A
00005Cr 2  85 54          sta MB
00005Er 2  A9 00          lda #0
000060r 2  E9 00          sbc #0
000062r 2  85 55          sta MB+1
000064r 2  AD 68 09       lda AI_F
000067r 2  85 53          sta MA
000069r 2  20 rr rr       jsr SMul
00006Cr 2  A2 03          ldx #3
00006Er 2               @shift:
00006Er 2  A5 57          lda PROD+1
000070r 2  C9 80          cmp #$80
000072r 2  66 57          ror PROD+1
000074r 2  66 56          ror PROD
000076r 2  CA             dex
000077r 2  D0 F5          bne @shift
000079r 2  A5 56          lda PROD
00007Br 2  18             clc
00007Cr 2  6D 66 09       adc AI_A
00007Fr 2  60             rts
000080r 2               
000080r 2               ; AddEnd - (AI_OC, AI_OR) is somewhere the enemy may finish, weight A.
000080r 2               AddEnd:
000080r 2  A4 EA          ldy AI_N
000082r 2  99 10 09       sta AI_EW,y
000085r 2  AD 64 09       lda AI_OC
000088r 2  99 00 09       sta AI_EC,y
00008Br 2  AD 65 09       lda AI_OR
00008Er 2  99 08 09       sta AI_ER,y
000091r 2  AE 64 09       ldx AI_OC
000094r 2  5A             phy
000095r 2  AC 65 09       ldy AI_OR
000098r 2  20 rr rr       jsr HexCenter
00009Br 2  7A             ply
00009Cr 2  A5 7F          lda HX
00009Er 2  99 18 09       sta AI_EPX,y
0000A1r 2  A5 80          lda HY
0000A3r 2  99 20 09       sta AI_EPY,y
0000A6r 2  E6 EA          inc AI_N
0000A8r 2  60             rts
0000A9r 2               
0000A9r 2               ; AiBegin4 - a new turn: the first CPU seat is up next.
0000A9r 2               AiBegin4:
0000A9r 2  A2 03          ldx #NUM_SHIPS - 1
0000ABr 2               @ship:
0000ABr 2  9E CC 0C       stz PLANNED,x
0000AEr 2  CA             dex
0000AFr 2  10 FA          bpl @ship
0000B1r 2  A9 FF          lda #$FF
0000B3r 2  8D EC 09       sta AI_ME
0000B6r 2  A9 05          lda #AI_NEXT
0000B8r 2  85 E7          sta AI_PHASE
0000BAr 2  60             rts
0000BBr 2               
0000BBr 2               ; AiNextSeat - start the next CPU seat with an enemy to fight, or finish.
0000BBr 2               AiNextSeat:
0000BBr 2  EE EC 09       inc AI_ME
0000BEr 2  AE EC 09       ldx AI_ME
0000C1r 2  E4 8E          cpx N_SHIPS
0000C3r 2  B0 12          bcs @done
0000C5r 2  BD 0C 08       lda SHIP_ALIVE,x
0000C8r 2  F0 F1          beq AiNextSeat
0000CAr 2  BD B4 0C       lda SEAT_KIND,x
0000CDr 2  F0 EC          beq AiNextSeat
0000CFr 2  20 rr rr       jsr AiLoadSeat
0000D2r 2  90 E7          bcc AiNextSeat
0000D4r 2  4C rr rr       jmp AiStart
0000D7r 2               @done:
0000D7r 2  A9 03          lda #AI_DONE
0000D9r 2  85 E7          sta AI_PHASE
0000DBr 2  60             rts
0000DCr 2               
0000DCr 2               ; AiLoadSeat - seat X's own details, its nearest enemy and its teammate. Carry clear
0000DCr 2               ; if it has no enemy left.
0000DCr 2               AiLoadSeat:
0000DCr 2  BD 18 08       lda SHIP_C,x
0000DFr 2  8D F0 09       sta AI_MC
0000E2r 2  85 B0          sta HD_C1
0000E4r 2  BD 1C 08       lda SHIP_R,x
0000E7r 2  8D F1 09       sta AI_MR
0000EAr 2  85 B1          sta HD_R1
0000ECr 2  BD 14 08       lda SHIP_HP_HI,x
0000EFr 2  8D F2 09       sta AI_MHP
0000F2r 2  BD 00 08       lda SHIP_FACTION,x
0000F5r 2  8D F3 09       sta AI_MFAC
0000F8r 2  BD 80 09       lda SPECIAL_WAIT,x
0000FBr 2  8D F4 09       sta AI_MWAIT
0000FEr 2  9C EF 09       stz AI_EASY
000101r 2  BD B4 0C       lda SEAT_KIND,x
000104r 2  C9 02          cmp #KIND_EASY
000106r 2  D0 03          bne @kind
000108r 2  EE EF 09       inc AI_EASY
00010Br 2               @kind:
00010Br 2  A9 FF          lda #$FF
00010Dr 2  8D ED 09       sta AI_FOE
000110r 2  8D EE 09       sta AI_MATE
000113r 2  8D E5 09       sta AI_TMP2
000116r 2  64 FE          stz AI_CNT
000118r 2               @seat:
000118r 2  A4 FE          ldy AI_CNT
00011Ar 2  C4 8E          cpy N_SHIPS
00011Cr 2  B0 65          bcs @picked
00011Er 2  CC EC 09       cpy AI_ME
000121r 2  F0 5C          beq @next
000123r 2  B9 0C 08       lda SHIP_ALIVE,y
000126r 2  F0 57          beq @next
000128r 2  AE EC 09       ldx AI_ME
