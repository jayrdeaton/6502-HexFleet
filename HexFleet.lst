00138Br 1               .include "src/ai.asm"
00138Br 2               ; =============================================================================
00138Br 2               ;   ai.asm - the CPU opponent
00138Br 2               ; =============================================================================
00138Br 2               ;   Ship 1 plans from the board as the turn began and never sees the person's
00138Br 2               ;   plan. It thinks a slice at a time during the person's planning (AiWork, once
00138Br 2               ;   a frame), so there's nothing to wait for.
00138Br 2               ;
00138Br 2               ;   Normal: it picks a hex that keeps a good distance and slides sideways off
00138Br 2               ;   the line a shot would come down, guesses where the enemy may end up (staying
00138Br 2               ;   put, or two hexes off in any of six directions), and tries a laser and a
00138Br 2               ;   torpedo at each of those places, keeping the shot that should do the most.
00138Br 2               ;   Easy: it closes in and shoots at where the enemy is now.
00138Br 2               ;   Its specials are in special.asm. A cloaked enemy is known only by where it
00138Br 2               ;   was last seen, and it knows nothing of the enemy's mines.
00138Br 2               ; =============================================================================
00138Br 2               
00138Br 2               .segment "BANK00"
00138Br 2               
00138Br 2               ME            = 1                  ; the CPU's ship
00138Br 2               FOE           = 0
00138Br 2               
00138Br 2               AI_MOVES      = 0                  ; AI_PHASE: scoring moves,
00138Br 2               AI_SETUP      = 1                  ; getting ready to aim,
00138Br 2               AI_AIMS       = 2                  ; scoring shots,
00138Br 2               AI_DONE       = 3                  ; the plan is in
00138Br 2               AI_FLAK       = 4                  ; or still weighing a flak shell
00138Br 2               
00138Br 2               MOVES_A_SLICE = 4
00138Br 2               
00138Br 2               DirQ:
00138Br 2  01 00 FF FF    .byte 1, 0, $FF, $FF, 0, 1
00138Fr 2  00 01        
001391r 2               DirR:
001391r 2  00 01 01 00    .byte 0, 1, 1, 0, $FF, $FF
001395r 2  FF FF        
001397r 2               ; Three moments in the turn, as eighths: 3/8, 5/8 and 7/8 of the way
001397r 2               SampleK:
001397r 2  03 05 07       .byte 3, 5, 7
00139Ar 2               ; A laser's burn a quarter-turn by distance in hexes
00139Ar 2               BurnByRange:
00139Ar 2  19 19 19 18    .byte 25, 25, 25, 24, 23, 21, 20, 19, 18, 16, 15, 14, 13
00139Er 2  17 15 14 13  
0013A2r 2  12 10 0F 0E  
0013A7r 2               
0013A7r 2               ; Rnd - a pseudo-random byte in A. Clobbers X.
0013A7r 2               Rnd:
