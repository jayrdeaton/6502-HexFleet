000D72r 2  B0 20          bcs @done
000D74r 2  BD B4 0C       lda SEAT_KIND,x
000D77r 2  D0 18          bne @next
000D79r 2  A5 76          lda VIEWER
000D7Br 2  C9 FF          cmp #VIEW_NONE
000D7Dr 2  D0 04          bne @other
000D7Fr 2  86 76          stx VIEWER
000D81r 2  80 0E          bra @next
000D83r 2               @other:
000D83r 2  A8             tay
000D84r 2  B9 B8 0C       lda SHIP_SIDE,y
000D87r 2  DD B8 0C       cmp SHIP_SIDE,x
000D8Ar 2  F0 05          beq @next
000D8Cr 2  A9 FF          lda #VIEW_NONE                   ; people on different sides see nothing hidden
000D8Er 2  85 76          sta VIEWER
000D90r 2  60             rts
000D91r 2               @next:
000D91r 2  E8             inx
000D92r 2  80 DC          bra @seat
000D94r 2               @done:
000D94r 2  60             rts
000D95r 2               
000D95r 2               ; PlayTurn - every plan is in: play it, then the next turn or the end.
000D95r 2               PlayTurn:
