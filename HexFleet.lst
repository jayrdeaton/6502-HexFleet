00029Br 2  0A             asl a
00029Cr 2  86 D8          stx MTMP
00029Er 2  18             clc
00029Fr 2  65 D8          adc MTMP
0002A1r 2  69 03          adc #ROW_NAME0
0002A3r 2  60             rts
0002A4r 2               
0002A4r 2               ; DrawNameLine - "P1 VANGUARD" in the ship's ink. Keeps X.
0002A4r 2               DrawNameLine:
0002A4r 2  86 D0          stx HPL_SHIP
0002A6r 2  BD 08 08       lda SHIP_INK,x
0002A9r 2  85 78          sta TXT_INK
0002ABr 2  20 rr rr       jsr LineStart
0002AEr 2  20 rr rr       jsr IsLink
0002B1r 2  D0 19          bne @local
0002B3r 2  A5 D0          lda HPL_SHIP                     ; "ME RAIDER" and "VS RAIDER"
0002B5r 2  CD 05 0E       cmp MY_SEAT
0002B8r 2  D0 09          bne @them
0002BAr 2  A9 4D          lda #'M'
0002BCr 2  20 rr rr       jsr LineChar
0002BFr 2  A9 45          lda #'E'
0002C1r 2  80 25          bra @tag
0002C3r 2               @them:
0002C3r 2  A9 56          lda #'V'
0002C5r 2  20 rr rr       jsr LineChar
0002C8r 2  A9 53          lda #'S'
0002CAr 2  80 1C          bra @tag
0002CCr 2               @local:
