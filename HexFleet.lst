000E6Fr 2  A6 77          ldx WINNER
000E71r 2  BD DC 0C       lda SHIP_SEAT,x
000E74r 2  18             clc
000E75r 2  69 31          adc #'1'
000E77r 2  20 rr rr       jsr LineChar
000E7Ar 2  A2 rr          ldx #<TxtWins
000E7Cr 2  A0 rr          ldy #>TxtWins
