0003FEr 2               
0003FEr 2               ; LineStart / LineChar / LineStr / LineNum build a line in LINEBUF.
0003FEr 2               LineStart:
0003FEr 2  64 7B          stz LINE_N
000400r 2  9C E0 08       stz LINEBUF
