000A92r 2               
000A92r 1               .include "src/scores.asm"
000A92r 2               ; =============================================================================
000A92r 2               ;   scores.asm - the high score table, saved on the Flash Cart
000A92r 2               ; =============================================================================
000A92r 2               ;   One person beating the CPUs scores 100, plus their hull left as a percentage,
000A92r 2               ;   plus 5 for every turn under 20, plus 100 for each enemy past the first. With no
000A92r 2               ;   Easy CPU in the battle that's worth 5 times as much. The best five are kept.
000A92r 2               ;
000A92r 2               ;   The table lives in the cart's save sector, the top 4 KB of bank $0E, as a
000A92r 2               ;   log of 64-byte records. Each save goes in the next free record, so a power
000A92r 2               ;   cut while saving only loses that save, and the sector is erased once every
000A92r 2               ;   64 saves rather than every time. Loading takes the last record that checks
000A92r 2               ;   out. A record: "HF", a version, 5 entries of 8 bytes, a checksum.
000A92r 2               ;
000A92r 2               ;   While the flash chip is erasing or programming, every read of it returns
000A92r 2               ;   status, the fixed bank included. So the writing routine is copied to RAM and
000A92r 2               ;   runs there with interrupts off, and it may only use relative branches.
000A92r 2               ; =============================================================================
000A92r 2               
000A92r 2               .segment "CART"
001527r 2               
001527r 2               SAVE_BANK     = $0E
001527r 2               SAVE_ADDR     = $D000
001527r 2               UNLOCK1_BANK  = $02
001527r 2               UNLOCK1       = $D555              ; flash $5555
001527r 2               UNLOCK2_BANK  = $01
001527r 2               UNLOCK2       = $CAAA              ; flash $2AAA
001527r 2               SLOT_COUNT    = 64
001527r 2               SAVE_VERSION  = 1
001527r 2               NUM_SCORES    = 5
001527r 2               ENTRY_SIZE    = 8
001527r 2               ENTRIES       = SAVE_BUF + 3
001527r 2               SUM_AT        = 3 + NUM_SCORES * ENTRY_SIZE
001527r 2               SAVE_SIZE     = SUM_AT + 1
001527r 2               
001527r 2               ; An entry's bytes
001527r 2               E_LO          = 0
001527r 2               E_HI          = 1
001527r 2               E_NAME        = 2
001527r 2               E_FACTION     = 5
001527r 2               E_OPP         = 6
001527r 2               E_TURNS       = 7
001527r 2               
001527r 2  48 49 47 48  TxtHighScores: .asciiz "HIGH SCORES"
00152Br 2  20 53 43 4F  
00152Fr 2  52 45 53 00  
001533r 2  4E 45 57 20  TxtNewRecord:  .asciiz "NEW RECORD"
001537r 2  52 45 43 4F  
00153Br 2  52 44 00     
00153Er 2  53 43 4F 52  TxtScore:      .asciiz "SCORE "
001542r 2  45 20 00     
001545r 2  52 41 4E 4B  TxtRank:       .asciiz "RANK "
001549r 2  20 00        
00154Br 2  55 50 2F 44  TxtUpDownLtr:  .asciiz "UP/DN: LTR"
00154Fr 2  4E 3A 20 4C  
001553r 2  54 52 00     
001556r 2  46 49 52 45  TxtFireNext:   .asciiz "FIRE: NEXT"
00155Ar 2  3A 20 4E 45  
00155Er 2  58 54 00     
001561r 2  53 41 56 45  TxtSaved:      .asciiz "SAVED"
001565r 2  44 00        
001567r 2  4E 4F 54 20  TxtNotSaved:   .asciiz "NOT SAVED"
00156Br 2  53 41 56 45  
00156Fr 2  44 00        
001571r 2  2D 2D 2D 00  TxtNoScore:    .asciiz "---"
001575r 2               
001575r 2               PowLo:
001575r 2  E8 64 0A 01    .byte <1000, <100, <10, <1
001579r 2               PowHi:
001579r 2  03 00 00 00    .byte >1000, >100, >10, >1
00157Dr 2               
00157Dr 2               ; --- Loading ---
00157Dr 2               
00157Dr 2               ; SlotAddr - SV_PTR = where record A lives in the window.
00157Dr 2               SlotAddr:
00157Dr 2  48             pha
00157Er 2  29 03          and #3
001580r 2  0A             asl a
001581r 2  0A             asl a
001582r 2  0A             asl a
001583r 2  0A             asl a
001584r 2  0A             asl a
001585r 2  0A             asl a
001586r 2  85 43          sta SV_PTR
001588r 2  68             pla
001589r 2  4A             lsr a
00158Ar 2  4A             lsr a
00158Br 2  18             clc
00158Cr 2  69 D0          adc #>SAVE_ADDR
00158Er 2  85 44          sta SV_PTR+1
001590r 2  60             rts
001591r 2               
001591r 2               ; RecordSum - A = the checksum of the record at SV_PTR.
001591r 2               RecordSum:
001591r 2  A0 00          ldy #0
001593r 2  A9 5A          lda #$5A
001595r 2  18             clc
001596r 2               @byte:
001596r 2  71 43          adc (SV_PTR),y
001598r 2  C8             iny
001599r 2  C0 2B          cpy #SUM_AT
00159Br 2  D0 F9          bne @byte
00159Dr 2  60             rts
00159Er 2               
00159Er 2               ; RecordValid - carry set if the record at SV_PTR checks out.
00159Er 2               RecordValid:
00159Er 2  B2 43          lda (SV_PTR)
0015A0r 2  C9 48          cmp #'H'
0015A2r 2  D0 1A          bne @no
0015A4r 2  A0 01          ldy #1
0015A6r 2  B1 43          lda (SV_PTR),y
0015A8r 2  C9 46          cmp #'F'
0015AAr 2  D0 12          bne @no
0015ACr 2  C8             iny
0015ADr 2  B1 43          lda (SV_PTR),y
0015AFr 2  C9 01          cmp #SAVE_VERSION
0015B1r 2  D0 0B          bne @no
0015B3r 2  20 rr rr       jsr RecordSum
0015B6r 2  A0 2B          ldy #SUM_AT
0015B8r 2  D1 43          cmp (SV_PTR),y
0015BAr 2  D0 02          bne @no
0015BCr 2  38             sec
0015BDr 2  60             rts
0015BEr 2               @no:
0015BEr 2  18             clc
0015BFr 2  60             rts
0015C0r 2               
0015C0r 2               ; LoadScores - the newest good record into SAVE_BUF, or an empty table; SV_SLOT
0015C0r 2               ; is left on the first free record (SLOT_COUNT if there's none).
0015C0r 2               LoadScores:
0015C0r 2  A2 2B          ldx #SAVE_SIZE - 1
0015C2r 2               @clear:
0015C2r 2  9E 00 0C       stz SAVE_BUF,x
0015C5r 2  CA             dex
0015C6r 2  10 FA          bpl @clear
0015C8r 2  A9 41          lda #'A'
0015CAr 2  8D 40 0C       sta NAME_BUF
0015CDr 2  8D 41 0C       sta NAME_BUF+1
0015D0r 2  8D 42 0C       sta NAME_BUF+2
0015D3r 2  A9 0E          lda #SAVE_BANK
0015D5r 2  20 rr rr       jsr SetBank
0015D8r 2  64 46          stz SV_SLOT
0015DAr 2               @slot:
0015DAr 2  A5 46          lda SV_SLOT
0015DCr 2  20 rr rr       jsr SlotAddr
0015DFr 2  B2 43          lda (SV_PTR)
0015E1r 2  C9 FF          cmp #$FF
0015E3r 2  F0 17          beq @done                        ; never written: the log ends here
0015E5r 2  20 rr rr       jsr RecordValid
0015E8r 2  90 0A          bcc @next
0015EAr 2  A0 2B          ldy #SUM_AT
0015ECr 2               @copy:
0015ECr 2  B1 43          lda (SV_PTR),y
0015EEr 2  99 00 0C       sta SAVE_BUF,y
0015F1r 2  88             dey
0015F2r 2  10 F8          bpl @copy
0015F4r 2               @next:
0015F4r 2  E6 46          inc SV_SLOT
0015F6r 2  A5 46          lda SV_SLOT
0015F8r 2  C9 40          cmp #SLOT_COUNT
0015FAr 2  D0 DE          bne @slot
0015FCr 2               @done:
0015FCr 2  A9 00          lda #0
0015FEr 2  4C rr rr       jmp SetBank
001601r 2               
001601r 2               ; --- Saving ---
001601r 2               
001601r 2               ; SaveScores - SAVE_BUF into the next record. Carry set if it reads back right.
001601r 2               SaveScores:
001601r 2  A9 48          lda #'H'
001603r 2  8D 00 0C       sta SAVE_BUF
001606r 2  A9 46          lda #'F'
001608r 2  8D 01 0C       sta SAVE_BUF+1
00160Br 2  A9 01          lda #SAVE_VERSION
00160Dr 2  8D 02 0C       sta SAVE_BUF+2
001610r 2  A9 00          lda #<SAVE_BUF
001612r 2  85 43          sta SV_PTR
001614r 2  A9 0C          lda #>SAVE_BUF
001616r 2  85 44          sta SV_PTR+1
001618r 2  20 rr rr       jsr RecordSum
00161Br 2  8D 2B 0C       sta SAVE_BUF + SUM_AT
00161Er 2  64 45          stz SV_ERASE
001620r 2  A5 46          lda SV_SLOT
001622r 2  C9 40          cmp #SLOT_COUNT
001624r 2  90 04          bcc @room
001626r 2  E6 45          inc SV_ERASE                     ; the log is full: start it again
001628r 2  64 46          stz SV_SLOT
00162Ar 2               @room:
00162Ar 2  A5 46          lda SV_SLOT
00162Cr 2  20 rr rr       jsr SlotAddr
00162Fr 2  A2 93          ldx #RamWriteEnd - RamWrite - 1
001631r 2               @copy:
001631r 2  BD rr rr       lda RamWrite,x
001634r 2  9D 00 0B       sta SAVE_CODE,x
001637r 2  CA             dex
001638r 2  E0 FF          cpx #$FF
00163Ar 2  D0 F5          bne @copy
00163Cr 2  20 00 0B       jsr SAVE_CODE
00163Fr 2  E6 46          inc SV_SLOT
001641r 2  A9 0E          lda #SAVE_BANK
001643r 2  20 rr rr       jsr SetBank
001646r 2  A0 2B          ldy #SUM_AT
001648r 2               @verify:
001648r 2  B1 43          lda (SV_PTR),y
00164Ar 2  D9 00 0C       cmp SAVE_BUF,y
00164Dr 2  D0 0A          bne @bad
00164Fr 2  88             dey
001650r 2  10 F6          bpl @verify
001652r 2  A9 00          lda #0
001654r 2  20 rr rr       jsr SetBank
001657r 2  38             sec
001658r 2  60             rts
001659r 2               @bad:
001659r 2  A9 00          lda #0
00165Br 2  20 rr rr       jsr SetBank
00165Er 2  18             clc
00165Fr 2  60             rts
001660r 2               
001660r 2               ; RamWrite - runs at SAVE_CODE. Erases the sector if SV_ERASE, then programs
001660r 2               ; SAVE_BUF at (SV_PTR). Every wait gives up in time, so a cart that won't take
001660r 2               ; the write can't hang the game; SaveScores' read-back catches it.
001660r 2               RamWrite:
001660r 2  78             sei
001661r 2  A5 45          lda SV_ERASE
