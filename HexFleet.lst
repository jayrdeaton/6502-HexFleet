00090Dr 2  85 B2          sta HD_C2
00090Fr 2  A5 B8          lda RR
000911r 2  85 B3          sta HD_R2
000913r 2  20 rr rr       jsr HexDist
000916r 2  C5 8D          cmp RANGE
000918r 2  F0 13          beq @edge                        ; at the limit of the reach
00091Ar 2  B0 14          bcs @next
00091Cr 2  A5 B8          lda RR                           ; inside it: only the board's rim has an edge
00091Er 2  F0 0D          beq @edge
000920r 2  C9 0E          cmp #ROWS - 1
000922r 2  F0 09          beq @edge
000924r 2  A5 B7          lda RC
000926r 2  F0 05          beq @edge
000928r 2  1A             inc a
000929r 2  C5 42          cmp T2
00092Br 2  D0 03          bne @next
00092Dr 2               @edge:
00092Dr 2  20 rr rr       jsr OutlineHex
000930r 2               @next:
000930r 2  E6 B7          inc RC
000932r 2  A5 B7          lda RC
000934r 2  C5 42          cmp T2
000936r 2  D0 D3          bne @hex
000938r 2  E6 B8          inc RR
00093Ar 2  A5 B8          lda RR
00093Cr 2  C9 0F          cmp #ROWS
00093Er 2  D0 C2          bne @row
000940r 2  4C rr rr       jmp CanvasFlush
000943r 2               
000943r 2               ; OutlineHex - hex (RC, RR): draw each side that has no reachable hex beyond it.
000943r 2               OutlineHex:
