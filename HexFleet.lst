000409r 2  9E E1 08       stz LINEBUF+1,x
00040Cr 2  E6 7B          inc LINE_N
00040Er 2  60             rts
00040Fr 2               
00040Fr 2               ; LineStr - add the string X (low), Y (high).
00040Fr 2               LineStr:
00040Fr 2  86 79          stx TXT_PTR
000411r 2  84 7A          sty TXT_PTR+1
000413r 2  A0 00          ldy #0
000415r 2               @loop:
000415r 2  B1 79          lda (TXT_PTR),y
000417r 2  F0 06          beq @done
000419r 2  20 rr rr       jsr LineChar
00041Cr 2  C8             iny
00041Dr 2  80 F6          bra @loop
00041Fr 2               @done:
00041Fr 2  60             rts
000420r 2               
000420r 2               ; LineNum - add A as a number with no leading spaces.
000420r 2               LineNum:
000420r 2  20 rr rr       jsr NumToText
000423r 2  A0 00          ldy #0
000425r 2               @skip:
000425r 2  B9 A2 00       lda DIGITS,y
000428r 2  C9 20          cmp #' '
00042Ar 2  D0 03          bne @digits
00042Cr 2  C8             iny
00042Dr 2  80 F6          bra @skip
00042Fr 2               @digits:
00042Fr 2  B9 A2 00       lda DIGITS,y
000432r 2  F0 06          beq @done
000434r 2  20 rr rr       jsr LineChar
