00097Br 2  9E 02 0F       stz S_REG+2,x
00097Er 2  FA             plx
00097Fr 2  A9 01          lda #1
000981r 2  9D 1C 0F       sta S_PEND,x
000984r 2               @done:
000984r 2  60             rts
000985r 2               
000985r 2               ; FilterTick - the filter breathes, opens on each bass note and settles back.
000985r 2               FilterTick:
000985r 2  AD 2B 0F       lda MUS_ID
000988r 2  0A             asl a
000989r 2  6D 2B 0F       adc MUS_ID
00098Cr 2  A8             tay                              ; 3 bytes a tune
00098Dr 2  AD 2E 0F       lda M_LFO
000990r 2  18             clc
000991r 2  79 rr rr       adc TuneFilter+1,y
000994r 2  8D 2E 0F       sta M_LFO
000997r 2  90 03          bcc @phase
000999r 2  EE 2F 0F       inc M_LFO+1
00099Cr 2               @phase:
00099Cr 2  AD 2F 0F       lda M_LFO+1
00099Fr 2  0A             asl a
0009A0r 2  90 02          bcc @rising
0009A2r 2  49 FF          eor #$FF
0009A4r 2               @rising:
0009A4r 2  4A             lsr a
0009A5r 2  4A             lsr a
0009A6r 2  4A             lsr a
0009A7r 2  18             clc
0009A8r 2  79 rr rr       adc TuneFilter,y
0009ABr 2  85 D9          sta S_B
0009ADr 2  AD 30 0F       lda F_ENV
0009B0r 2  F0 14          beq @open
0009B2r 2  4A             lsr a
0009B3r 2  4A             lsr a
0009B4r 2  4A             lsr a
0009B5r 2  D0 02          bne @fall
0009B7r 2  A9 01          lda #1
0009B9r 2               @fall:
0009B9r 2  85 DA          sta S_C
0009BBr 2  AD 30 0F       lda F_ENV
0009BEr 2  48             pha
0009BFr 2  38             sec
0009C0r 2  E5 DA          sbc S_C
0009C2r 2  8D 30 0F       sta F_ENV
0009C5r 2  68             pla
0009C6r 2               @open:
0009C6r 2  18             clc
0009C7r 2  65 D9          adc S_B
0009C9r 2  8D 16 0F       sta S_REG+$16
0009CCr 2  9C 15 0F       stz S_REG+$15
0009CFr 2                 ; which voices go through it
0009CFr 2  64 DA          stz S_C
0009D1r 2  64 D9          stz S_B
0009D3r 2  A2 02          ldx #2
0009D5r 2               @voice:
0009D5r 2  BD 4D 0F       lda SF_ID,x
0009D8r 2  F0 09          beq @music
0009DAr 2  BD 6D 0F       lda SF_FIL,x
0009DDr 2  F0 10          beq @direct
0009DFr 2  E6 D9          inc S_B                          ; an effect is using the filter
0009E1r 2  80 05          bra @route
0009E3r 2               @music:
0009E3r 2  BD 4A 0F       lda M_FILT,x
0009E6r 2  F0 07          beq @direct
0009E8r 2               @route:
0009E8r 2  BD rr rr       lda VoiceBit,x
0009EBr 2  05 DA          ora S_C
0009EDr 2  85 DA          sta S_C
0009EFr 2               @direct:
0009EFr 2  CA             dex
0009F0r 2  10 E3          bpl @voice
0009F2r 2  A5 D9          lda S_B
0009F4r 2  F0 1F          beq @setRouting
0009F6r 2                 ; an effect's own cutoff, closing as it goes, wins
0009F6r 2  AD 6B 0F       lda S_FXC
0009F9r 2  8D 16 0F       sta S_REG+$16
0009FCr 2  AE 6C 0F       ldx S_FXK
0009FFr 2  F0 14          beq @setRouting
000A01r 2               @close:
000A01r 2  4A             lsr a
000A02r 2  CA             dex
000A03r 2  D0 FC          bne @close
000A05r 2  1A             inc a
000A06r 2  49 FF          eor #$FF
000A08r 2  38             sec
000A09r 2  6D 6B 0F       adc S_FXC
000A0Cr 2  C9 14          cmp #20
000A0Er 2  B0 02          bcs @closed
000A10r 2  A9 14          lda #20
000A12r 2               @closed:
000A12r 2  8D 6B 0F       sta S_FXC
000A15r 2               @setRouting:
000A15r 2  B9 rr rr       lda TuneFilter+2,y
000A18r 2  0A             asl a
000A19r 2  0A             asl a
000A1Ar 2  0A             asl a
000A1Br 2  0A             asl a
000A1Cr 2  05 DA          ora S_C
000A1Er 2  8D 17 0F       sta S_REG+$17
000A21r 2  AD 32 0F       lda S_MASTER
000A24r 2  09 10          ora #SID_FILT_LP
000A26r 2  8D 18 0F       sta S_REG+$18
000A29r 2  60             rts
000A2Ar 2               
000A2Ar 2               VoiceBit:
000A2Ar 2  01 02 04       .byte 1, 2, 4
000A2Dr 2               
000A2Dr 1               
000A2Dr 1               .segment "FIXED"
000000r 1               
000000r 1               CartReset:
000000r 1  A2 FF          ldx #$FF
000002r 1  9A             txs
000003r 1  64 3A          stz BANKSHDW                     ; reset selected bank 0
000005r 1  20 78 A0       jsr KernalInit
000008r 1  20 7B A0       jsr KernalVersion
00000Br 1  C9 02          cmp #2
00000Dr 1  90 07          bcc @wrongMachine
00000Fr 1  AD 0D 03       lda HW_PRESENT
000012r 1  29 80          and #HW_VID
000014r 1  D0 11          bne @ready
000016r 1               @wrongMachine:
000016r 1  A2 00          ldx #0
000018r 1               @message:
000018r 1  BD rr rr       lda NeedsMsg,x
00001Br 1  F0 08          beq @halt
00001Dr 1  DA             phx
00001Er 1  20 00 A0       jsr Chrout
000021r 1  FA             plx
000022r 1  E8             inx
000023r 1  80 F3          bra @message
000025r 1               @halt:
000025r 1  80 FE          bra @halt
000027r 1               
000027r 1               @ready:
000027r 1  A9 00          lda #0
000029r 1  20 0F A0       jsr SetIOMode                    ; the keyboard, for Chrin
00002Cr 1  58             cli
00002Dr 1  A9 FF          lda #NO_DIR
00002Fr 1  85 68          sta HELD_DIR
000031r 1  64 6D          stz PREV_BTN
000033r 1  20 rr rr       jsr InitSeats                    ; a duel against a Normal CPU to start
000036r 1  A9 A7          lda #$A7
000038r 1  85 E4          sta RND
00003Ar 1  85 E5          sta RND+1
00003Cr 1  20 rr rr       jsr SerialQuiet
00003Fr 1  20 rr rr       jsr SoundInit
000042r 1  20 rr rr       jsr VideoInit
000045r 1  20 rr rr       jsr LoadScores
000048r 1  20 rr rr       jsr EnterTitle
00004Br 1  4C rr rr       jmp MainLoop
