00067Fr 2               ; PhaseCanvas - how far the ship can reach with what's being picked now.
00067Fr 2               PhaseCanvas:
00067Fr 2  A5 70          lda PHASE
000681r 2  D0 10          bne @notMove
000683r 2  20 rr rr       jsr IsJump
000686r 2  F0 04          beq @jump
000688r 2  A9 03          lda #MOVE_RANGE
00068Ar 2  80 02          bra @draw
00068Cr 2               @jump:
00068Cr 2  A9 06          lda #JUMP_RANGE
00068Er 2               @draw:
00068Er 2  85 8D          sta RANGE
000690r 2  4C rr rr       jmp DrawRange
000693r 2               @notMove:
000693r 2  C9 01          cmp #PH_AIM
000695r 2  D0 09          bne @clear
000697r 2  20 rr rr       jsr IsFlak
00069Ar 2  D0 04          bne @clear
00069Cr 2  A9 05          lda #FLAK_RANGE
