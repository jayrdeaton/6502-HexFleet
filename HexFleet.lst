000BFAr 2               
000BFAr 1               .include "src/turn.asm"
000BFAr 2               ; =============================================================================
000BFAr 2               ;   turn.asm - a turn playing out: the rules and the picture together
000BFAr 2               ; =============================================================================
000BFAr 2               ;   HexFleet's rules, in whole numbers. There are no dice: every ship glides
000BFAr 2               ;   to its hex across the whole turn, and a hit is contact. A laser charges for
000BFAr 2               ;   the first quarter of the turn, then burns whatever its line first touches
000BFAr 2               ;   for 25 hull a quarter, less at long range. A torpedo flies from where its
000BFAr 2               ;   ship started, through the aim and on, and hits the first ship it touches.
000BFAr 2               ; =============================================================================
000BFAr 2               
000BFAr 2               .segment "BANK00"
000BFAr 2               
000BFAr 2               ; A laser's burn each tick by distance in hexes, in 1/256 hull: 25 a quarter
000BFAr 2               ; (16 ticks) up to 2 hexes, then 5% less a hex, never under half.
000BFAr 2               BurnLo:
000BFAr 2  90 90 90 7C    .byte <400, <400, <400, <380, <360, <340, <320, <300, <280, <260, <240, <220, <200
000BFEr 2  68 54 40 2C  
000C02r 2  18 04 F0 DC  
000C07r 2               BurnHi:
000C07r 2  01 01 01 01    .byte >400, >400, >400, >380, >360, >340, >320, >300, >280, >260, >240, >220, >200
000C0Br 2  01 01 01 01  
000C0Fr 2  01 01 00 00  
000C14r 2               
000C14r 2               SqTab:
000C14r 2  00 01 04 09    .byte 0, 1, 4, 9, 16, 25, 36, 49, 64, 81, 100
000C18r 2  10 19 24 31  
000C1Cr 2  40 51 64     
000C1Fr 2               
000C1Fr 2               ; RunTurn - play the turn every ship has planned.
000C1Fr 2               RunTurn:
000C1Fr 2  20 rr rr       jsr CanvasClear
000C22r 2  20 rr rr       jsr HideSeen
000C25r 2  20 rr rr       jsr ArmOldMines
000C28r 2  64 E3          stz ANY
000C2Ar 2  A2 00          ldx #0
000C2Cr 2               @setup:
000C2Cr 2  9E 58 08       stz TORP_ON,x
000C2Fr 2  9E 7C 08       stz TORP_FLASH,x
000C32r 2  9E 9C 08       stz FIRING,x
000C35r 2  9E 8C 08       stz EXPL_T,x
000C38r 2  9E 94 09       stz JUMPING,x
000C3Br 2  9E 98 09       stz ON_FIELD,x
000C3Er 2  A9 FF          lda #$FF
000C40r 2  9D 88 08       sta BEAM_TGT,x
000C43r 2  BD 0C 08       lda SHIP_ALIVE,x
000C46r 2  F0 0B          beq @gone
000C48r 2  FE 98 09       inc ON_FIELD,x
000C4Br 2  20 rr rr       jsr StartSpecial
000C4Er 2  20 rr rr       jsr SetupShip
000C51r 2  80 03          bra @next
000C53r 2               @gone:
000C53r 2  9E 88 09       stz CLOAKED,x
000C56r 2               @next:
000C56r 2  E8             inx
000C57r 2  E0 02          cpx #NUM_SHIPS
000C59r 2  D0 D1          bne @setup
000C5Br 2  A5 E3          lda ANY
000C5Dr 2  F0 03          beq @quiet
000C5Fr 2  20 rr rr       jsr SndTorpedo
000C62r 2               @quiet:
000C62r 2  20 rr rr       jsr ThrustSound
000C65r 2  64 74          stz TICK
000C67r 2  64 9F          stz EXTRA
000C69r 2  64 9E          stz REDRAW
000C6Br 2               @tick:
000C6Br 2  20 rr rr       jsr MoveShips
000C6Er 2  20 rr rr       jsr MoveTorpedoes
000C71r 2  20 rr rr       jsr CheckMines
000C74r 2  20 rr rr       jsr LandJumps
000C77r 2  20 rr rr       jsr BurnLasers
000C7Ar 2  20 rr rr       jsr FlakBursts
000C7Dr 2  20 rr rr       jsr CheckWrecks
000C80r 2  20 rr rr       jsr UpdateFx
000C83r 2  20 rr rr       jsr DrawBeams
000C86r 2  20 rr rr       jsr DrawSprites
000C89r 2  20 rr rr       jsr DrawHulls
000C8Cr 2  A9 02          lda #FRAMES_A_TICK
000C8Er 2  20 rr rr       jsr WaitFrames
000C91r 2  E6 74          inc TICK
000C93r 2  A5 74          lda TICK
000C95r 2  C9 40          cmp #TICKS
000C97r 2  90 D2          bcc @tick
000C99r 2  D0 04          bne @late
000C9Br 2  A9 01          lda #1
000C9Dr 2  85 9E          sta REDRAW                       ; the beams go out
000C9Fr 2               @late:
000C9Fr 2  20 rr rr       jsr SndLaserOff
000CA2r 2  20 rr rr       jsr StillBusy                    ; torpedoes in flight, wrecks burning
000CA5r 2  F0 08          beq @end
000CA7r 2  E6 9F          inc EXTRA
000CA9r 2  A5 9F          lda EXTRA
000CABr 2  C9 30          cmp #EXTRA_TICKS
000CADr 2  90 BC          bcc @tick
000CAFr 2               @end:
000CAFr 2  A2 03          ldx #NUM_FX - 1
