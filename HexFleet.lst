0015EFr 2               
0015EFr 1               .include "src/scores.asm"
0015EFr 2               ; =============================================================================
0015EFr 2               ;   scores.asm - the high score table, saved on the Flash Cart
0015EFr 2               ; =============================================================================
0015EFr 2               ;   Winning against the CPU scores 100, plus your hull left as a percentage,
0015EFr 2               ;   plus 5 for every turn under 20. Against the Normal CPU that's worth 5 times
0015EFr 2               ;   as much, so an Easy win never outranks a Normal one. The best five are kept.
0015EFr 2               ;
0015EFr 2               ;   The table lives in the cart's save sector, the top 4 KB of bank $0E, as a
0015EFr 2               ;   log of 64-byte records. Each save goes in the next free record, so a power
0015EFr 2               ;   cut while saving only loses that save, and the sector is erased once every
0015EFr 2               ;   64 saves rather than every time. Loading takes the last record that checks
0015EFr 2               ;   out. A record: "HF", a version, 5 entries of 8 bytes, a checksum.
0015EFr 2               ;
0015EFr 2               ;   While the flash chip is erasing or programming, every read of it returns
0015EFr 2               ;   status, the fixed bank included. So the writing routine is copied to RAM and
0015EFr 2               ;   runs there with interrupts off, and it may only use relative branches.
0015EFr 2               ; =============================================================================
0015EFr 2               
0015EFr 2               .segment "CART"
0015EFr 2               
0015EFr 2               SAVE_BANK     = $0E
0015EFr 2               SAVE_ADDR     = $D000
0015EFr 2               UNLOCK1_BANK  = $02
0015EFr 2               UNLOCK1       = $D555              ; flash $5555
0015EFr 2               UNLOCK2_BANK  = $01
0015EFr 2               UNLOCK2       = $CAAA              ; flash $2AAA
0015EFr 2               SLOT_COUNT    = 64
0015EFr 2               SAVE_VERSION  = 1
0015EFr 2               NUM_SCORES    = 5
0015EFr 2               ENTRY_SIZE    = 8
0015EFr 2               ENTRIES       = SAVE_BUF + 3
0015EFr 2               SUM_AT        = 3 + NUM_SCORES * ENTRY_SIZE
0015EFr 2               SAVE_SIZE     = SUM_AT + 1
0015EFr 2               
0015EFr 2               ; An entry's bytes
0015EFr 2               E_LO          = 0
0015EFr 2               E_HI          = 1
0015EFr 2               E_NAME        = 2
0015EFr 2               E_FACTION     = 5
0015EFr 2               E_OPP         = 6
0015EFr 2               E_TURNS       = 7
0015EFr 2               
0015EFr 2  48 49 47 48  TxtHighScores: .asciiz "HIGH SCORES"
0015F3r 2  20 53 43 4F  
0015F7r 2  52 45 53 00  
0015FBr 2  4E 45 57 20  TxtNewRecord:  .asciiz "NEW RECORD"
0015FFr 2  52 45 43 4F  
001603r 2  52 44 00     
001606r 2  53 43 4F 52  TxtScore:      .asciiz "SCORE "
00160Ar 2  45 20 00     
00160Dr 2  52 41 4E 4B  TxtRank:       .asciiz "RANK "
001611r 2  20 00        
001613r 2  55 50 2F 44  TxtUpDownLtr:  .asciiz "UP/DN: LTR"
001617r 2  4E 3A 20 4C  
00161Br 2  54 52 00     
00161Er 2  46 49 52 45  TxtFireNext:   .asciiz "FIRE: NEXT"
001622r 2  3A 20 4E 45  
001626r 2  58 54 00     
001629r 2  53 41 56 45  TxtSaved:      .asciiz "SAVED"
00162Dr 2  44 00        
00162Fr 2  4E 4F 54 20  TxtNotSaved:   .asciiz "NOT SAVED"
001633r 2  53 41 56 45  
001637r 2  44 00        
001639r 2  2D 2D 2D 00  TxtNoScore:    .asciiz "---"
00163Dr 2               
00163Dr 2               PowLo:
00163Dr 2  E8 64 0A 01    .byte <1000, <100, <10, <1
001641r 2               PowHi:
001641r 2  03 00 00 00    .byte >1000, >100, >10, >1
001645r 2               
001645r 2               ; --- Loading ---
001645r 2               
001645r 2               ; SlotAddr - SV_PTR = where record A lives in the window.
001645r 2               SlotAddr:
001645r 2  48             pha
001646r 2  29 03          and #3
001648r 2  0A             asl a
001649r 2  0A             asl a
00164Ar 2  0A             asl a
00164Br 2  0A             asl a
00164Cr 2  0A             asl a
00164Dr 2  0A             asl a
00164Er 2  85 43          sta SV_PTR
001650r 2  68             pla
001651r 2  4A             lsr a
001652r 2  4A             lsr a
001653r 2  18             clc
001654r 2  69 D0          adc #>SAVE_ADDR
001656r 2  85 44          sta SV_PTR+1
001658r 2  60             rts
001659r 2               
001659r 2               ; RecordSum - A = the checksum of the record at SV_PTR.
001659r 2               RecordSum:
001659r 2  A0 00          ldy #0
00165Br 2  A9 5A          lda #$5A
00165Dr 2  18             clc
00165Er 2               @byte:
00165Er 2  71 43          adc (SV_PTR),y
001660r 2  C8             iny
001661r 2  C0 2B          cpy #SUM_AT
001663r 2  D0 F9          bne @byte
001665r 2  60             rts
001666r 2               
001666r 2               ; RecordValid - carry set if the record at SV_PTR checks out.
001666r 2               RecordValid:
001666r 2  B2 43          lda (SV_PTR)
001668r 2  C9 48          cmp #'H'
00166Ar 2  D0 1A          bne @no
00166Cr 2  A0 01          ldy #1
00166Er 2  B1 43          lda (SV_PTR),y
001670r 2  C9 46          cmp #'F'
001672r 2  D0 12          bne @no
001674r 2  C8             iny
001675r 2  B1 43          lda (SV_PTR),y
001677r 2  C9 01          cmp #SAVE_VERSION
001679r 2  D0 0B          bne @no
00167Br 2  20 rr rr       jsr RecordSum
00167Er 2  A0 2B          ldy #SUM_AT
001680r 2  D1 43          cmp (SV_PTR),y
001682r 2  D0 02          bne @no
001684r 2  38             sec
001685r 2  60             rts
001686r 2               @no:
001686r 2  18             clc
001687r 2  60             rts
001688r 2               
001688r 2               ; LoadScores - the newest good record into SAVE_BUF, or an empty table; SV_SLOT
001688r 2               ; is left on the first free record (SLOT_COUNT if there's none).
001688r 2               LoadScores:
001688r 2  A2 2B          ldx #SAVE_SIZE - 1
00168Ar 2               @clear:
00168Ar 2  9E 00 0C       stz SAVE_BUF,x
00168Dr 2  CA             dex
00168Er 2  10 FA          bpl @clear
001690r 2  A9 41          lda #'A'
001692r 2  8D 40 0C       sta NAME_BUF
001695r 2  8D 41 0C       sta NAME_BUF+1
001698r 2  8D 42 0C       sta NAME_BUF+2
00169Br 2  A9 0E          lda #SAVE_BANK
00169Dr 2  20 rr rr       jsr SetBank
0016A0r 2  64 46          stz SV_SLOT
0016A2r 2               @slot:
0016A2r 2  A5 46          lda SV_SLOT
0016A4r 2  20 rr rr       jsr SlotAddr
0016A7r 2  B2 43          lda (SV_PTR)
0016A9r 2  C9 FF          cmp #$FF
0016ABr 2  F0 17          beq @done                        ; never written: the log ends here
0016ADr 2  20 rr rr       jsr RecordValid
0016B0r 2  90 0A          bcc @next
0016B2r 2  A0 2B          ldy #SUM_AT
0016B4r 2               @copy:
0016B4r 2  B1 43          lda (SV_PTR),y
0016B6r 2  99 00 0C       sta SAVE_BUF,y
0016B9r 2  88             dey
0016BAr 2  10 F8          bpl @copy
0016BCr 2               @next:
0016BCr 2  E6 46          inc SV_SLOT
0016BEr 2  A5 46          lda SV_SLOT
0016C0r 2  C9 40          cmp #SLOT_COUNT
0016C2r 2  D0 DE          bne @slot
0016C4r 2               @done:
0016C4r 2  A9 00          lda #0
0016C6r 2  4C rr rr       jmp SetBank
0016C9r 2               
0016C9r 2               ; --- Saving ---
0016C9r 2               
0016C9r 2               ; SaveScores - SAVE_BUF into the next record. Carry set if it reads back right.
0016C9r 2               SaveScores:
0016C9r 2  A9 48          lda #'H'
0016CBr 2  8D 00 0C       sta SAVE_BUF
0016CEr 2  A9 46          lda #'F'
0016D0r 2  8D 01 0C       sta SAVE_BUF+1
0016D3r 2  A9 01          lda #SAVE_VERSION
0016D5r 2  8D 02 0C       sta SAVE_BUF+2
0016D8r 2  A9 00          lda #<SAVE_BUF
0016DAr 2  85 43          sta SV_PTR
0016DCr 2  A9 0C          lda #>SAVE_BUF
0016DEr 2  85 44          sta SV_PTR+1
0016E0r 2  20 rr rr       jsr RecordSum
