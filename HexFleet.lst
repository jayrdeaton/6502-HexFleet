001D00r 2               
001D00r 1               .include "src/vdp.asm"
001D00r 2               ; =============================================================================
001D00r 2               ;   vdp.asm - the PICOVDP: setup, loading, text, sprites and the canvas
001D00r 2               ; =============================================================================
001D00r 2               ;   Everything that knows about the video hardware lives here, so a port to
001D00r 2               ;   another machine replaces this file.
001D00r 2               ;
001D00r 2               ;   Layer 0 is the board, fixed once loaded. Layer 1 (2 bits per pixel) is both
001D00r 2               ;   the text and the canvas: its patterns 32..127 are the card's font, and 128..255
001D00r 2               ;   and up are a pool of tiles the game draws beams, rings, outlines and big text
001D00r 2               ;   into, handed to cells as they're touched. With 2 bits a pixel, two lasers crossing in one cell
001D00r 2               ;   each keep their own color. Port A only: the Kernal
001D00r 2               ;   leaves it alone in interrupts, so no SEI is needed.
001D00r 2               ; =============================================================================
001D00r 2               
001D00r 2               .segment "CART"
0000C0r 2               
0000C0r 2               ; Register, value pairs for the display setup
0000C0r 2               VideoRegs:
0000C0r 2  01 02          .byte VC_REG_MODE1,   $02         ; display off, 16x16 sprites
0000C2r 2  00 00          .byte VC_REG_MODE0,   $00
0000C4r 2  0D 04          .byte VC_REG_VMODE,   $04         ; Full: 40 x 30, 320 x 240
0000C6r 2  08 00          .byte VC_REG_VBANK,   0
0000C8r 2  09 01          .byte VC_REG_VINC,    1
0000CAr 2  0A 00          .byte VC_REG_IRQEN,   0
0000CCr 2  0F 00          .byte VC_REG_STATSEL_A, 0
0000CEr 2  07 04          .byte VC_REG_COLOR,   $04         ; backdrop: palette row 0, entry 4
0000D0r 2  10 00          .byte VC_REG_L0NAME,  >V_L0NAME >> 2
0000D2r 2  12 07          .byte VC_REG_L0PAT,   >V_L0PAT >> 3
0000D4r 2  13 00          .byte VC_REG_L0SCRX,  0
0000D6r 2  14 00          .byte VC_REG_L0SCRY,  0
0000D8r 2  15 1D          .byte VC_REG_L0CTRL,  VC_LCTRL_2BPP | VC_LCTRL_ATTR_NONE | VC_LCTRL_ENABLE
0000DAr 2  16 00          .byte VC_REG_L0PAL,   0
0000DCr 2  18 02          .byte VC_REG_L1NAME,  >V_L1NAME >> 2
0000DEr 2  19 04          .byte VC_REG_L1ATTR,  >V_L1ATTR >> 2
0000E0r 2  1A 03          .byte VC_REG_L1PAT,   >V_FONT >> 3    ; the font loads here first
0000E2r 2  1B 00          .byte VC_REG_L1SCRX,  0
0000E4r 2  1C 00          .byte VC_REG_L1SCRY,  0
0000E6r 2  1D 10          .byte VC_REG_L1CTRL,  VC_LCTRL_1BPP | VC_LCTRL_ATTR_CELL | VC_LCTRL_ENABLE
0000E8r 2  1E 03          .byte VC_REG_L1PAL,   3               ; sub-palettes from entry 192
0000EAr 2  20 2C          .byte VC_REG_SPRATTR, >V_SPRATTR << 1
0000ECr 2  21 08          .byte VC_REG_SPRPAT,  $08         ; $4000
0000EEr 2  22 1B          .byte VC_REG_SPRCOUNT, NUM_SLOTS
0000F0r 2  23 21          .byte VC_REG_SPRCTRL, VC_SPRCTRL_ENABLE | VC_SPRCTRL_4BPP
0000F2r 2  24 20          .byte VC_REG_SPRLIMIT, 32
0000F4r 2  25 00          .byte VC_REG_SPRPAL,  0
0000F6r 2               VIDEO_REGS = * - VideoRegs
0000F6r 2               
0000F6r 2               ; Palette row 0, entries 1..4: grid, dim star, bright star, backdrop (the app's
0000F6r 2               ; near-black)
0000F6r 2               PaletteBoard:
0000F6r 2  02 46 03 45    .byte $02, $46,  $03, $45,  $0A, $BD,  $01, $12
0000FAr 2  0A BD 01 12  
0000FEr 2               ; Layer 1's inks, by number
0000FEr 2               PaletteInks:
0000FEr 2  00 00 01 12    .byte $00, $00,  $01, $12,  $0F, $FF,  $09, $AB
000102r 2  0F FF 09 AB  
000106r 2  03 AF 0F 92    .byte $03, $AF,  $0F, $92,  $03, $E5,  $0B, $6F
00010Ar 2  03 E5 0B 6F  
00010Er 2  00 EE 0F 44    .byte $00, $EE,  $0F, $44,  $0A, $F3,  $0F, $5D
000112r 2  0A F3 0F 5D  
000116r 2  0F D3 05 67    .byte $0F, $D3,  $05, $67,  $00, $00,  $00, $00
00011Ar 2  00 00 00 00  
00011Er 2               
00011Er 2               ; Hull bar cells: the top rows filled to 0..8 pixels, a thin line below
00011Er 2               BarMasks:
00011Er 2  00 80 C0 E0    .byte $00, $80, $C0, $E0, $F0, $F8, $FC, $FE, $FF
000122r 2  F0 F8 FC FE  
000126r 2  FF           
000127r 2               
000127r 2               RowLo:
000127r 2  00 28 50 78  .repeat 30, I
00012Br 2  A0 C8 F0 18  
00012Fr 2  40 68 90 B8  
000145r 2                 .byte <(I * 40)
000145r 2               .endrepeat
000145r 2               RowHi:
000145r 2  00 00 00 00  .repeat 30, I
000149r 2  00 00 00 01  
00014Dr 2  01 01 01 01  
000163r 2                 .byte >(I * 40)
000163r 2               .endrepeat
000163r 2               
000163r 2               ; A 4-bit pattern as 2-bit pixels of value 1
000163r 2               Nibble2:
000163r 2  00 01 04 05    .byte $00, $01, $04, $05, $10, $11, $14, $15
000167r 2  10 11 14 15  
00016Br 2  40 41 44 45    .byte $40, $41, $44, $45, $50, $51, $54, $55
00016Fr 2  50 51 54 55  
000173r 2               ; The canvas: the bits of a pixel, by column in its byte, and each value there
000173r 2               PixClear:
000173r 2  3F CF F3 FC    .byte $3F, $CF, $F3, $FC
000177r 2               PixBits:
000177r 2  00 00 00 00    .byte $00, $00, $00, $00,  $40, $10, $04, $01
00017Br 2  40 10 04 01  
00017Fr 2  80 20 08 02    .byte $80, $20, $08, $02,  $C0, $30, $0C, $03
000183r 2  C0 30 0C 03  
000187r 2               ; Where each of a tile's 16 bytes is kept
000187r 2               CtLo:
000187r 2  00 00 00 00  .repeat 16, I
00018Br 2  00 00 00 00  
00018Fr 2  00 00 00 00  
000197r 2                 .byte <(CT_ROWS + I * 256)
000197r 2               .endrepeat
000197r 2               CtHi:
000197r 2  20 21 22 23  .repeat 16, I
00019Br 2  24 25 26 27  
00019Fr 2  28 29 2A 2B  
0001A7r 2                 .byte >(CT_ROWS + I * 256)
0001A7r 2               .endrepeat
0001A7r 2               
0001A7r 2               ; SetBank - A selects the 8 KB bank at $C000. Only called from here.
0001A7r 2               SetBank:
0001A7r 2  85 3A          sta BANKSHDW
0001A9r 2  8D 00 E0       sta BANK
0001ACr 2  60             rts
0001ADr 2               
0001ADr 2               ; VReg - A = value, X = register. Keeps X.
0001ADr 2               VReg:
0001ADr 2  8D 01 9C       sta VC_REG
0001B0r 2  8A             txa
0001B1r 2  09 80          ora #VC_REG_WRITE
0001B3r 2  8D 01 9C       sta VC_REG
0001B6r 2  60             rts
0001B7r 2               
0001B7r 2               ; VAddr - point port A at A (low), X (high) to write. Keeps X.
0001B7r 2               VAddr:
0001B7r 2  8D 01 9C       sta VC_REG
