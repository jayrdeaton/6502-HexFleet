000715r 2  A4 FD          ldy AI_S
000717r 2  B9 58 09       lda AI_PX,y
00071Ar 2  8D 66 09       sta AI_A
00071Dr 2  B9 5B 09       lda AI_PY,y
000720r 2  8D 67 09       sta AI_B
000723r 2  AD 6B 09       lda AI_AX
000726r 2  38             sec
000727r 2  ED 66 09       sbc AI_A
00072Ar 2  85 C7          sta SD_DX
00072Cr 2  A9 00          lda #0
00072Er 2  E9 00          sbc #0
000730r 2  85 C8          sta SD_DX+1
000732r 2  AD 6C 09       lda AI_AY
000735r 2  38             sec
000736r 2  ED 67 09       sbc AI_B
000739r 2  85 C9          sta SD_DY
00073Br 2  A9 00          lda #0
00073Dr 2  E9 00          sbc #0
00073Fr 2  85 CA          sta SD_DY+1
000741r 2  20 rr rr       jsr ScaleDir
000744r 2  F0 24          beq @done
000746r 2  20 rr rr       jsr DirLength
000749r 2  A5 92          lda LEN
00074Br 2  F0 1D          beq @done
00074Dr 2  A5 FD          lda AI_S
00074Fr 2  20 rr rr       jsr MateOnLine
000752r 2  64 FC          stz AI_K
000754r 2               @end:
000754r 2  20 rr rr       jsr SetV
000757r 2  20 rr rr       jsr LineTest
00075Ar 2  90 06          bcc @miss
00075Cr 2  AD 6E 09       lda AI_BURN
00075Fr 2  20 rr rr       jsr AddScore
000762r 2               @miss:
000762r 2  E6 FC          inc AI_K
000764r 2  A5 FC          lda AI_K
000766r 2  C5 EA          cmp AI_N
000768r 2  D0 EA          bne @end
00076Ar 2               @done:
00076Ar 2  60             rts
00076Br 2               
00076Br 2               ; ScoreTorpedo - what a torpedo from the ship's start through the aim should
00076Br 2               ; do: it counts if the enemy would be on its line by the time it gets there.
00076Br 2               ScoreTorpedo:
00076Br 2  64 F2          stz AI_SC
00076Dr 2  64 F3          stz AI_SC+1
00076Fr 2  9C F6 09       stz AI_BAD
000772r 2  A5 F4          lda AI_SX
000774r 2  8D 66 09       sta AI_A
000777r 2  A5 F5          lda AI_SY
000779r 2  8D 67 09       sta AI_B
00077Cr 2  AD 6B 09       lda AI_AX
00077Fr 2  38             sec
000780r 2  ED 66 09       sbc AI_A
000783r 2  85 C7          sta SD_DX
000785r 2  A9 00          lda #0
000787r 2  E9 00          sbc #0
000789r 2  85 C8          sta SD_DX+1
00078Br 2  AD 6C 09       lda AI_AY
00078Er 2  38             sec
00078Fr 2  ED 67 09       sbc AI_B
000792r 2  85 C9          sta SD_DY
000794r 2  A9 00          lda #0
000796r 2  E9 00          sbc #0
000798r 2  85 CA          sta SD_DY+1
00079Ar 2  20 rr rr       jsr ScaleDir
00079Dr 2  F0 6A          beq @done
00079Fr 2  20 rr rr       jsr DirLength
0007A2r 2  A5 92          lda LEN
0007A4r 2  F0 63          beq @done
0007A6r 2  A9 00          lda #0
0007A8r 2  20 rr rr       jsr MateOnLine
0007ABr 2  A9 01          lda #1
0007ADr 2  20 rr rr       jsr MateOnLine
0007B0r 2  A9 02          lda #2
0007B2r 2  20 rr rr       jsr MateOnLine
0007B5r 2  64 FC          stz AI_K
0007B7r 2               @end:
0007B7r 2  A9 01          lda #1                           ; first, roughly how far along it is
0007B9r 2  85 FD          sta AI_S
0007BBr 2  20 rr rr       jsr SetV
0007BEr 2  20 rr rr       jsr LineTest
0007C1r 2  A5 9B          lda DOT+1
0007C3r 2  30 3C          bmi @next
0007C5r 2  A5 9A          lda DOT
0007C7r 2  85 58          sta DIVIDEND
0007C9r 2  A5 9B          lda DOT+1
0007CBr 2  85 59          sta DIVIDEND+1
0007CDr 2  A5 92          lda LEN
0007CFr 2  85 5A          sta DIVISOR
0007D1r 2  20 rr rr       jsr Div16
0007D4r 2                 ; the torpedo covers 60 pixels a quarter-turn: pick the moment it arrives
0007D4r 2  64 FD          stz AI_S
0007D6r 2  A5 5C          lda QUOT+1
0007D8r 2  D0 0C          bne @late
0007DAr 2  A5 5B          lda QUOT
0007DCr 2  C9 78          cmp #120
0007DEr 2  90 0A          bcc @test
0007E0r 2  E6 FD          inc AI_S
0007E2r 2  C9 B4          cmp #180
0007E4r 2  90 04          bcc @test
0007E6r 2               @late:
0007E6r 2  A9 02          lda #2
0007E8r 2  85 FD          sta AI_S
0007EAr 2               @test:
0007EAr 2  20 rr rr       jsr SetV
0007EDr 2  20 rr rr       jsr LineTest
0007F0r 2  90 0F          bcc @next
0007F2r 2  AC F3 09       ldy AI_MFAC              ; counted half again: it lands all at once
0007F5r 2  B9 rr rr       lda TorpedoDamage,y
0007F8r 2  85 FF          sta AI_TMP
0007FAr 2  4A             lsr a
0007FBr 2  18             clc
0007FCr 2  65 FF          adc AI_TMP
0007FEr 2  20 rr rr       jsr AddScore
000801r 2               @next:
000801r 2  E6 FC          inc AI_K
000803r 2  A5 FC          lda AI_K
000805r 2  C5 EA          cmp AI_N
000807r 2  D0 AE          bne @end
000809r 2               @done:
000809r 2  60             rts
00080Ar 2               
00080Ar 2               ; AiCommit - write this seat's plan, and on to the next.
00080Ar 2               AiCommit:
00080Ar 2  AE EC 09       ldx AI_ME
00080Dr 2  A5 ED          lda AI_BC
00080Fr 2  9D 24 08       sta PLAN_C,x
000812r 2  A5 EE          lda AI_BR
000814r 2  9D 28 08       sta PLAN_R,x
000817r 2  A5 F0          lda AI_BAC
000819r 2  9D 2C 08       sta AIM_C,x
00081Cr 2  A5 F1          lda AI_BAR
00081Er 2  9D 30 08       sta AIM_R,x
000821r 2  A5 EF          lda AI_BW
000823r 2  9D 34 08       sta PLAN_WEAPON,x
000826r 2  AD E0 09       lda AI_SPEC
000829r 2  9D 84 09       sta PLAN_SPECIAL,x
00082Cr 2  A9 01          lda #1
00082Er 2  9D CC 0C       sta PLANNED,x
000831r 2  A9 05          lda #AI_NEXT
000833r 2  85 E7          sta AI_PHASE
000835r 2  60             rts
000836r 2               
000836r 1               .include "src/special.asm"
000836r 2               ; =============================================================================
000836r 2               ;   special.asm - each faction's special ability
000836r 2               ; =============================================================================
000836r 2               ;   The app's rules. A special recharges for some turns once it's used.
000836r 2               ;     Vanguard, flak shell: in place of the shot, lobbed at a hex up to 5 away.
000836r 2               ;       It bursts as ships stop, 45 to every other ship within a hex.
000836r 2               ;     Raider, mine: goes with the shot, dropped where the ship starts. Only its
000836r 2               ;       owner sees it. It arms halfway through the turn it's dropped, and goes
000836r 2               ;       off for 25 on any other ship that comes within a hex. 3 at most.
000836r 2               ;     Swarm, cloak: in place of the shot. Unseen from now until the next turn
000836r 2               ;       plays, so the others plan knowing only where it was last seen.
000836r 2               ;     Wraith, jump: in place of the move and the shot. Gone until halfway
000836r 2               ;       through the turn, it lands up to 6 hexes away with a shockwave: 20 to a
000836r 2               ;       ship next to it, 40 to one it lands on, and 20 to itself for that.
000836r 2               ; =============================================================================
000836r 2               
000836r 2               .segment "CART"
000DB1r 2               
000DB1r 2               RechargeTurns:
000DB1r 2  01 03 01 05    .byte 1, 3, 1, 5
000DB5r 2               TorpedoDamage:
000DB5r 2  1E 23 23 23    .byte 30, 35, 35, 35
000DB9r 2               
000DB9r 2               ; The CPU's code is in its own bank; these reach it from anywhere.
000DB9r 2               .macro IN_AI_BANK target
000DB9r 2                 lda #AI_BANK
000DB9r 2                 jsr SetBank
000DB9r 2                 jsr target
000DB9r 2                 lda #0
000DB9r 2                 jmp SetBank
000DB9r 2               .endmacro
000DB9r 2               
000DB9r 2               AiBegin:
000DB9r 2  A9 04 20 rr    IN_AI_BANK AiBegin4
000DBDr 2  rr 20 rr rr  
000DC1r 2  A9 00 4C rr  
000DC6r 2               AiWork:
000DC6r 2  A9 04 20 rr    IN_AI_BANK AiWork4
000DCAr 2  rr 20 rr rr  
000DCEr 2  A9 00 4C rr  
000DD3r 2               AiFinish:
000DD3r 2  A9 04 20 rr    IN_AI_BANK AiFinish4
000DD7r 2  rr 20 rr rr  
000DDBr 2  A9 00 4C rr  
000DE0r 2               
000DE0r 2               SqLo:
000DE0r 2  00 01 04 09  .repeat AREA_REACH + 1, I
000DE4r 2  10 19 24 31  
000DE8r 2  40 51 64 79  
000DFAr 2                 .byte <(I * I)
000DFAr 2               .endrepeat
000DFAr 2               SqHi:
000DFAr 2  00 00 00 00  .repeat AREA_REACH + 1, I
000DFEr 2  00 00 00 00  
000E02r 2  00 00 00 00  
000E14r 2                 .byte >(I * I)
000E14r 2               .endrepeat
000E14r 2               
000E14r 2               SpecialNames:
000E14r 2  rr rr rr rr    .word TxtSpFlak, TxtSpMine, TxtSpCloak, TxtSpJump
000E18r 2  rr rr rr rr  
000E1Cr 2               ChoiceTexts:
000E1Cr 2  rr rr rr rr    .word TxtLaser, TxtTorpedo, TxtLaserMine, TxtTorpMine
000E20r 2  rr rr rr rr  
000E24r 2  rr rr rr rr    .word TxtFlakShell, TxtCloak, TxtJump
000E28r 2  rr rr        
000E2Ar 2               ChoiceOf:                          ; a special's line in ChoiceTexts (mine aside)
000E2Ar 2  04 00 05 06    .byte 4, 0, 5, 6
000E2Er 2               TipName:
000E2Er 2  rr rr rr rr    .word TxtFlakShell, TxtMine, TxtCloak, TxtJump
000E32r 2  rr rr rr rr  
000E36r 2               TipA:
000E36r 2  rr rr rr rr    .word TxtTipFlak1, TxtTipMine1, TxtTipCloak1, TxtTipJump1
