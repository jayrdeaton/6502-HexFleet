0009CFr 2                 ; which voices go through it
0009CFr 2  64 DA          stz S_C
0009D1r 2  64 D9          stz S_B
0009D3r 2  A2 02          ldx #2
0009D5r 2               @voice:
0009D5r 2  BD 4D 0F       lda SF_ID,x
0009D8r 2  F0 09          beq @music
0009DAr 2  BD 6D 0F       lda SF_FIL,x
