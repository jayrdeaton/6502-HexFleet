000964r 2  7D rr rr       adc SideRow,x
000967r 2  85 B3          sta HD_R2
000969r 2  C9 0F          cmp #ROWS
00096Br 2  B0 14          bcs @draw                        ; off the board
00096Dr 2  20 rr rr       jsr RowLen
000970r 2  85 AD          sta MN_COUNT
000972r 2  A5 B2          lda HD_C2
000974r 2  C5 AD          cmp MN_COUNT
000976r 2  B0 09          bcs @draw
