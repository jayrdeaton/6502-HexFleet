0015ACr 2  A5 FB          lda AI_I
0015AEr 2  C9 07          cmp #7
0015B0r 2  F0 01          beq @decide
0015B2r 2  60             rts
0015B3r 2               @decide:
0015B3r 2  AD E1 09       lda AI_FS
0015B6r 2  F0 34          beq @commit
0015B8r 2  A2 2D          ldx #FLAK_DAMAGE
0015BAr 2  20 rr rr       jsr Mul8
0015BDr 2  06 56          asl PROD
0015BFr 2  26 57          rol PROD+1
0015C1r 2  A6 EF          ldx AI_BW
0015C3r 2  A5 56          lda PROD
0015C5r 2  DD 74 09       cmp AI_BS_LO,x
0015C8r 2  A5 57          lda PROD+1
0015CAr 2  FD 76 09       sbc AI_BS_HI,x
0015CDr 2  90 09          bcc @rare
0015CFr 2  20 rr rr       jsr Rnd                          ; worth at least half the shot: 1 in 2
0015D2r 2  29 01          and #1
0015D4r 2  D0 16          bne @commit
0015D6r 2  80 07          bra @use
0015D8r 2               @rare:
0015D8r 2  20 rr rr       jsr Rnd                          ; otherwise 1 in 4, to keep the enemy moving
0015DBr 2  29 03          and #3
0015DDr 2  D0 0D          bne @commit
