000000r 1               ; =============================================================================
000000r 1               ;   HexFleet.asm - cartridge entry point
000000r 1               ; =============================================================================
000000r 1               ;   HexFleet for the AC6502 ACE with a 6502-PICOVDP on BIOS 2.x, as a 128 KB
000000r 1               ;   Flash Cart. The fixed 8 KB holds start-up and everything that touches the
000000r 1               ;   hardware (vdp, input, sound, plus the maths); bank 0 holds the game and
000000r 1               ;   stays selected; banks 1 and 2 hold the art, copied to video memory once.
000000r 1               ; =============================================================================
000000r 1               
000000r 1               .setcpu "65C02"
000000r 1               
000000r 1               .include "6502-VDP.inc"
000000r 2               ; =============================================================================
000000r 2               ;   6502-VDP.inc — the AC6502 ACE with a 6502-PICOVDP
000000r 2               ; =============================================================================
000000r 2               ;
000000r 2               ;   CPU:       WDC 65C02S
000000r 2               ;   Video:     6502-PICOVDP (SPEC draft 0.5)
000000r 2               ;   BIOS:      v2.1.0
000000r 2               ;   Assembler: ca65 (cc65 toolchain) — uses := for absolute symbols
000000r 2               ;
000000r 2               ;   Include this file in programs for an ACE whose video card is a
000000r 2               ;   6502-PICOVDP, running BIOS 2.x, to access Kernal routines, IO hardware
000000r 2               ;   registers, system variables, and useful constants.  It names the
000000r 2               ;   PICOVDP's second port pair, its registers, status registers and bit
000000r 2               ;   fields as VC_* equates.
000000r 2               ;
000000r 2               ;   An ACE with a TMS9918A uses 6502.inc instead.  A program built with this
000000r 2               ;   file assembles and links for either machine but only runs on this one.
000000r 2               ;   To build one source both ways, select the include with ca65's VDP symbol
000000r 2               ;   (make VDP=1 passes --asm-define VDP):
000000r 2               ;
000000r 2               ;     .ifdef VDP
000000r 2               ;     .include "../6502-VDP.inc"
000000r 2               ;     .else
000000r 2               ;     .include "../6502.inc"
000000r 2               ;     .endif
000000r 2               ;
000000r 2               ;   Do not include both: every shared name would be defined twice.
000000r 2               ;
000000r 2               ;   NAMES
000000r 2               ;   -----
000000r 2               ;   A name for something the 6502-PICOVDP SPEC defines (a register, a bit
000000r 2               ;   field, a capability bit, a font ID, a status value) is VC_*, as in
000000r 2               ;   VC_REG_FONT and VC_CAP_FONT.  A name for something the BIOS defines (a
000000r 2               ;   Kernal entry, a RAM variable, an HW_* flag) is BIOS.inc's own, as in
000000r 2               ;   VdpLoadFont and VDP_CAPS.  BIOS.inc's VDP_* names for SPEC values are
000000r 2               ;   internal to the BIOS and are not repeated here, so VDP_* in this file is
000000r 2               ;   only ever a Kernal RAM variable.  tools/check-include.py enforces that.
000000r 2               ;
000000r 2               ;   MEMORY MAP
000000r 2               ;   ----------
000000r 2               ;   $0000-$0003   Zero Page: System pointers (see below)
000000r 2               ;   $0004-$0023   Zero Page: Reserved by BASIC interpreter
000000r 2               ;   $0024-$0039   Zero Page: System scratch (CF, serial, delay, XModem)
000000r 2               ;   $003A-$00FF   Zero Page: Free for a program that has taken the machine over
000000r 2               ;                 (not underneath a running BASIC, which uses it as it interprets)
000000r 2               ;   $0100-$01FF   CPU Stack
000000r 2               ;   $0200-$02FF   Input Buffer (ring buffer, managed by Kernal)
000000r 2               ;   $0300-$03FF   Kernal Variables (vectors, cursor, HW flags, video, etc.)
000000r 2               ;   $0400-$04FF   BAS_LINBUF: BASIC's raw input line (NOT user memory, despite
000000r 2               ;                 BIOS.inc naming $0400 USER_VARS -- a legacy name kept only
000000r 2               ;                 because Wozmon builds its input buffer there)
000000r 2               ;   $0500-$05FF   BAS_TOKBUF: BASIC's tokenizing scratch
000000r 2               ;   $0600-$07FF   FS sector buffer (clobbered by any FS/St routine call)
000000r 2               ;   $0800-$7FFF   Program RAM (30 KB — load address for user code)
000000r 2               ;   $8000-$83FF   IO 1: Banked RAM Low  (256 × ~1 KB banks)
000000r 2               ;   $8400-$87FF   IO 2: Banked RAM High (256 × ~1 KB banks)
000000r 2               ;   $8800-$881F   IO 3: RTC (DS1511Y)
000000r 2               ;   $8C00-$8C07   IO 4: Storage (CompactFlash, 8-bit IDE)
000000r 2               ;   $9000-$9003   IO 5: Serial (R6551AP ACIA)
000000r 2               ;   $9400-$940F   IO 6: GPIO (65C22 VIA — keyboard & joysticks)
000000r 2               ;   $9800-$981C   IO 7: Sound (SID / ARMSID)
000000r 2               ;   $9C00-$9C03   IO 8: Video (6502-PICOVDP, two port pairs)
000000r 2               ;   $A000-$A0FF   Kernal Jump Table (stable entry points)
000000r 2               ;   $A100-$BFFF   Kernal Implementation
000000r 2               ;   $C000-$FEFF   BASIC Interpreter
000000r 2               ;   $FF00-$FFF9   Wozmon (mini monitor; SYS 65280 from BASIC)
000000r 2               ;   $FFFA-$FFFF   CPU Vectors (NMI, RESET, IRQ)
000000r 2               ;
000000r 2               ;   There is no machine-code Monitor and no character set in ROM on 2.x.
000000r 2               ;   The text font is the card's own (font $00), loaded by InitVideo.
000000r 2               ;
000000r 2               ;   BOOT SEQUENCE
000000r 2               ;   -------------
000000r 2               ;   On RESET the BIOS probes all eight IO slots, initializes detected
000000r 2               ;   hardware, and auto-selects video or serial console.  If neither is
000000r 2               ;   found, IO_MODE is left unchanged (no halt — cartridges with their
000000r 2               ;   own display hardware can still boot).  A startup beep plays (if SID
000000r 2               ;   is present) for audible feedback, then BOOT_VECTOR ($035B) is
000000r 2               ;   checked — if non-zero, execution jumps there (cartridge takeover).
000000r 2               ;   Otherwise a console check halts if no video/serial is found, and the
000000r 2               ;   machine goes straight to BASIC, which prints its header:
000000r 2               ;     AC6502 BIOS v2.1
000000r 2               ;     BASIC v2.0 NNNNN BYTES FREE
000000r 2               ;   On video the header is the console's first use, which brings the Text
000000r 2               ;   console up (see VIDEO CONSOLE).
000000r 2               ;
000000r 2               ;   VIDEO CONSOLE
000000r 2               ;   -------------
000000r 2               ;   The probe sets HW_VID only for a 6502-PICOVDP (STAT4 = VC_ID) whose STAT6
000000r 2               ;   has VC_CAP_FONT set; it records STAT5 in VDP_FW and STAT6 in VDP_CAPS.
000000r 2               ;   STAT5 gates nothing.  KernalInit leaves the card as its own reset does:
000000r 2               ;   the legacy submode (VMODE $0), unscrolled.  The first Chrout,
000000r 2               ;   VideoClear, VideoSetCursor, VideoGetCursor or VideoSetColor brings up the
000000r 2               ;   40×24 Text console (InitVideo, then a clear).  So a cartridge written for
000000r 2               ;   1.x runs unchanged: one that programs M1/M2/M3 and its tables finds the
000000r 2               ;   card as a TMS9918 was left, and one that prints gets the Text console.
000000r 2               ;   A program never needs to check STAT4 or switch modes to print.
000000r 2               ;
000000r 2               ;   Every character is written with an attribute byte, fg<<4 | bg, from the
000000r 2               ;   pen VID_PEN.  The console scrolls in hardware (L0SCRY = VID_TOP × 8).
000000r 2               ;   The Kernal drives the card through port A only, and every entry assumes
000000r 2               ;   and leaves VBANK = 0 and VINC = +1.
000000r 2               ;
000000r 2               ;   PORT B FOR INTERRUPT HANDLERS
000000r 2               ;   -----------------------------
000000r 2               ;   The Kernal never touches port B ($9C02/$9C03), so an interrupt handler
000000r 2               ;   that uses it cannot land between the two writes of a foreground command,
000000r 2               ;   and needs no sei/cli around foreground VDP work.  A handler acknowledges
000000r 2               ;   through STAT1 (VC_REG_STATSEL_B = VC_STAT1), which clears the interrupt
000000r 2               ;   latches and leaves STAT0's flags for foreground code.  A handler that
000000r 2               ;   writes VBANK or VINC puts them back: both ports share them.  InitVideo
000000r 2               ;   writes IRQEN = 0, so re-enable the interrupt after anything that calls
000000r 2               ;   it (the console's first use, BASIC's SCREEN 0 or return to text).
000000r 2               ;
000000r 2               ;   GRACEFUL DEGRADATION
000000r 2               ;   --------------------
000000r 2               ;   Every Kernal routine that drives a card checks HW_PRESENT first, so
000000r 2               ;   a call on a machine without that card is safe rather than a crash.
000000r 2               ;   Routines with nothing to report back return silently (video console and
000000r 2               ;   SID); routines that move data report failure in the carry (CompactFlash,
000000r 2               ;   the NVRAM save slots, and the PICOVDP entries VdpInfo-VdpStatus, which
000000r 2               ;   write nothing with no card; WaitVBlank waits 2 cs instead).  An empty
000000r 2               ;   slot, a TMS9918A, and a PICOVDP without the built-in font all count as
000000r 2               ;   no card.  The raw NVRAM pair RtcReadNVRAM / RtcWriteNVRAM is the
000000r 2               ;   exception: it does not check, so test HW_RTC before calling it.
000000r 2               ;   The per-routine notes below say which behaviour each one has.
000000r 2               ;
000000r 2               ;   CARTRIDGE SUPPORT
000000r 2               ;   -----------------
000000r 2               ;   Cartridges overlay $C000-$FFFF (BASIC, Wozmon, vectors).  The Kernal
000000r 2               ;   ($A000-$BFFF, all of it on 2.x) remains accessible.  Use KernalInit
000000r 2               ;   ($A078) to initialize all hardware and return via RTS — interrupts are
000000r 2               ;   left disabled so the cart can set up its own handlers first.  BRK_PTR
000000r 2               ;   points at the Kernal's BRK report, which warm-starts BASIC at $C000; a
000000r 2               ;   cartridge must point it at its own handler.  See usage patterns in the
000000r 2               ;   BIOS README.
000000r 2               ;
000000r 2               ;   IO_MODE
000000r 2               ;   -------
000000r 2               ;   Bit 0 of IO_MODE selects the console output device:
000000r 2               ;     0 = Video (6502-PICOVDP)    1 = Serial (R6551AP)
000000r 2               ;   Chrout ($A000) dispatches automatically based on IO_MODE.
000000r 2               ;   Use SetIOMode / GetIOMode to change or query the active console.
000000r 2               ;
000000r 2               ;   CALLING CONVENTION
000000r 2               ;   ------------------
000000r 2               ;   Kernal routines are called via JSR to the jump table addresses below.
000000r 2               ;   Parameters are passed in A, X, Y, and/or zero-page pointers as
000000r 2               ;   documented per routine.  Carry flag is used for success/error returns
000000r 2               ;   (C=0 success, C=1 error) where noted.
000000r 2               ;
000000r 2               ;   HW_PRESENT BITMASK
000000r 2               ;   -------------------
000000r 2               ;   After boot, HW_PRESENT ($030D) contains a bitmask of detected hardware.
000000r 2               ;   Test individual bits before calling hardware-specific routines.
000000r 2               ;   Example:
000000r 2               ;     lda HW_PRESENT
000000r 2               ;     and #HW_VID          ; Is a PICOVDP with the built-in font present?
000000r 2               ;     beq @NoVideo         ; Skip if not
000000r 2               ;
000000r 2               ; =============================================================================
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 1: ZERO PAGE POINTERS
000000r 2               ; =============================================================================
000000r 2               ; These zero page locations are used by the Kernal.  External programs may
000000r 2               ; use STR_PTR and CF_BUF_PTR/CF_LBA as parameters to Kernal calls.
000000r 2               ; Locations $3A-$FF are free for user programs.
000000r 2               
000000r 2               STR_PTR             := $02               ; 2 bytes — String pointer (used by FsLoadFile, FsSaveFile, FsDeleteFile, etc.)
000000r 2               CF_BUF_PTR          := $24               ; 2 bytes — CF sector data buffer pointer
000000r 2               CF_LBA              := $26               ; 4 bytes — CF 28-bit LBA address (little-endian)
000000r 2               XFER_PTR            := $2A               ; 2 bytes — XModem transfer data pointer (source for XModemSave, dest for XModemLoad)
000000r 2               NV_PTR              := STR_PTR           ; 2 bytes — Caller's buffer during an NvRead / NvWrite copy (clobbered by both)
000000r 2               
000000r 2               ; Safe zero page range for user programs:
000000r 2               ; $3A-$FF (198 bytes free)
000000r 2               ;   $2C-$2D belong to SysDelay and $36-$39 to XModemLoad/XModemSave; neither
000000r 2               ;   survives a call into those routines.  $2E-$35 are unassigned on 2.x (1.x's
000000r 2               ;   Monitor used them)
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 2: SYSTEM VARIABLES ($0300-$03FF)
000000r 2               ; =============================================================================
000000r 2               
000000r 2               IRQ_PTR             := $0300             ; 2 bytes — IRQ handler vector (writable; default: internal Irq handler)
000000r 2               BRK_PTR             := $0302             ; 2 bytes — BRK handler vector (writable; default: the BRK report, then BASIC)
000000r 2               NMI_PTR             := $0304             ; 2 bytes — NMI handler vector (writable; default: RTI)
000000r 2               
000000r 2               IO_MODE             := $0306             ; 1 byte  — Console output mode (bit 0: 0=video, 1=serial)
000000r 2               VID_CURSOR_X        := $0307             ; 1 byte  — Video cursor column (0-39)
000000r 2               VID_CURSOR_Y        := $0308             ; 1 byte  — Video cursor row (0-23)
000000r 2               
000000r 2               HW_PRESENT          := $030D             ; 1 byte  — Hardware present bitmask (set during boot probe)
000000r 2               CF_DISK             := $030F             ; 1 byte  — Current CF disk bank (0–255); base LBA = CF_DISK × FS_DISK_SECTORS; reset to 0 on boot
000000r 2               
000000r 2               ; HW_PRESENT bit definitions (bit order matches IO slot numbers):
000000r 2               HW_RAM_L            = %00000001          ; Bit 0: RAM card low  (IO 1, $8000-$83FF)
000000r 2               HW_RAM_H            = %00000010          ; Bit 1: RAM card high (IO 2, $8400-$87FF)
000000r 2               HW_RTC              = %00000100          ; Bit 2: RTC card      (IO 3, DS1511Y)
000000r 2               HW_CF               = %00001000          ; Bit 3: Storage card   (IO 4, CompactFlash)
000000r 2               HW_SC               = %00010000          ; Bit 4: Serial card    (IO 5, R6551AP)
000000r 2               HW_GPIO             = %00100000          ; Bit 5: GPIO card      (IO 6, 65C22 VIA — keyboard/joysticks)
000000r 2               HW_SID              = %01000000          ; Bit 6: Sound card     (IO 7, SID/ARMSID)
000000r 2               HW_VID              = %10000000          ; Bit 7: Video card     (IO 8, a 6502-PICOVDP with the built-in font)
000000r 2               
000000r 2               ; BRK register save area.  The BRK handler fills it and prints a report:
000000r 2               ;     BREAK $nn AT $xxxx
000000r 2               ;     A=xx X=xx Y=xx P=xx S=xx
000000r 2               ; ($xxxx the BRK opcode, $nn the byte after it, S the stack pointer before the
000000r 2               ; BRK), then warm-starts BASIC with the program kept.  CONT cannot continue.
000000r 2               ; BASIC's SYS addr[,a[,x[,y]]] also leaves the routine's returned A, X, Y and P
000000r 2               ; in BRK_A, BRK_X, BRK_Y and BRK_P.
000000r 2               BRK_P               := $0310             ; Saved processor status (P)
000000r 2               BRK_PCL             := $0311             ; Saved PC low byte (points to BRK instruction + 2)
000000r 2               BRK_PCH             := $0312             ; Saved PC high byte
000000r 2               BRK_A               := $0313             ; Saved accumulator
000000r 2               BRK_X               := $0314             ; Saved X register
000000r 2               BRK_Y               := $0315             ; Saved Y register
000000r 2               BRK_SP              := $0316             ; Saved stack pointer
000000r 2               
000000r 2               XFER_REMAIN         := $0317             ; 2 bytes — XModem byte count (output from XModemLoad; input to XModemSave)
000000r 2               XFER_IO_SAVE        := $0319             ; 1 byte  — Saved IO_MODE during XModem transfer (internal use)
000000r 2               
000000r 2               ; RTC scratch (used by RtcWriteDate to pass century):
000000r 2               RTC_BUF_CENT        := $030B             ; Century value for RtcReadDate / RtcWriteDate
000000r 2               
000000r 2               ; Cartridge / boot redirect vector:
000000r 2               BOOT_VECTOR         := $035B             ; 2 bytes — Boot redirect address (0=normal boot)
000000r 2                                                        ;   Set after KernalInit to redirect Reset flow
000000r 2                                                        ;   KernalInit zeroes this; write after init returns
000000r 2               FS_IO_ADDR          := $037F             ; 2 bytes — Load/save target address for FsLoadFileAddr / FsSaveFileAddr
000000r 2               FS_FILE_SIZE        := $034A             ; 2 bytes — File size in bytes (set by caller for FsSaveFileAddr; populated by FsLoadFileAddr)
000000r 2               
000000r 2               ; Program image handoff (v1.3):
000000r 2               PRG_IMAGE_END       := $038E             ; 2 bytes — End address of a program image placed at
000000r 2                                                        ;   PROGRAM_START by a loader running outside BASIC
000000r 2                                                        ;   (e.g. a cartridge's own loader); 0 = none.
000000r 2                                                        ;   KernalInit zeroes it; BASIC consumes and re-zeroes it
000000r 2                                                        ;   on entry, so a stale value is never acted on twice.
000000r 2                                                        ;   A loader that drops a .prg at $0800 and then hands
000000r 2                                                        ;   off to BASIC should write the end address here so
000000r 2                                                        ;   the attached machine code survives LOAD/SAVE.
000000r 2               
000000r 2               ; NVRAM save slots (v1.6):
000000r 2               NV_ID               := $0390             ; 1 byte  — Owner ID input for NvWrite ($01-$FF; $00 is refused — that is NvErase)
000000r 2               
000000r 2               ; Boot CF probe diagnostics (v2.1): left by the probe for a PEEK after boot.
000000r 2               CF_PROBE_POLLS      := $0376             ; 2 bytes — Polls (100 cycles each, 0.1 ms at 1 MHz) that found the
000000r 2                                                        ;   CF card not ready.  30,000 = it never came ready; 0 with HW_CF
000000r 2                                                        ;   clear = the slot was empty (recognised in two reads)
000000r 2               CF_PROBE_STAT       := $0378             ; 1 byte  — The first status byte the probe read: $80 from a busy
000000r 2                                                        ;   card, $8C from an empty slot (open bus)
000000r 2               
000000r 2               ; Video variables (v2.0):
000000r 2               VID_PEN             := $0391             ; 1 byte  — Attribute byte for new output, fg<<4 | bg
000000r 2                                                        ;   KernalInit sets $1F (black on white); NEW, RUN,
000000r 2                                                        ;   CLR and errors keep it.  Set it with VideoSetColor
000000r 2               VID_TOP             := $0392             ; 1 byte  — Name-table row shown at the top (0-23);
000000r 2                                                        ;   L0SCRY = VID_TOP × 8.  A cell's name byte is at
000000r 2                                                        ;   ((row + VID_TOP) mod 24) × 40 + column
000000r 2               VID_MODE            := $0393             ; 1 byte  — $00 = console not set up since KernalInit
000000r 2                                                        ;   (card in the legacy submode); $01 = Text console
000000r 2                                                        ;   intact; otherwise low nibble = the VMODE the Kernal
000000r 2                                                        ;   last set, b7 = disturbed (sprites, scroll, layers)
000000r 2               VDP_FW              := $0394             ; 1 byte  — STAT5 (firmware version, BCD) at boot; $00 if no PICOVDP
000000r 2               VDP_CAPS            := $0395             ; 1 byte  — STAT6 (capability bits, VC_CAP_*) at boot; $00 if no PICOVDP
000000r 2               VDP_L0CTRL_SHADOW   := $0396             ; 1 byte  — What was last written to the write-only L0CTRL
000000r 2               VDP_L1CTRL_SHADOW   := $0397             ; 1 byte  — What was last written to the write-only L1CTRL
000000r 2                                                        ;   Both are kept by VdpWriteReg, VdpSetScroll, VdpLayer
000000r 2                                                        ;   and InitVideo; a direct register write bypasses them
000000r 2               VDP_P0              := $0398             ; 1 byte  — Parameter block for VdpSprite and VdpSetScroll
000000r 2               VDP_P1              := $0399             ; 1 byte
000000r 2               VDP_P2              := $039A             ; 1 byte
000000r 2               VDP_P3              := $039B             ; 1 byte
000000r 2               VID_BORDER          := $039C             ; 1 byte  — The border the console shows: register 7's
000000r 2                                                        ;   low nibble.  KernalInit sets $0F (the pen's
000000r 2                                                        ;   background).  VideoSetColor and VideoSetPen set it
000000r 2                                                        ;   to the pen's background; COLOR fg,bg,border sets it
000000r 2                                                        ;   on its own.  Register 7 is write-only, so this is
000000r 2                                                        ;   what InitVideo puts back (v2.0.2)
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 3: KEY MEMORY LOCATIONS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               INPUT_BUFFER        := $0200             ; $0200-$02FF — 256-byte ring buffer (keyboard/serial input)
000000r 2               PROGRAM_START       := $0800             ; User programs and BASIC programs load here
000000r 2               ;                                        ; Program space extends to $7FFF (30 KB)
000000r 2               MEMORY_TOP          := $8000             ; First address past usable RAM (IO space starts here)
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 4: KERNAL JUMP TABLE ($A000-$A0FF)
000000r 2               ; =============================================================================
000000r 2               ; All entry points are stable 3-byte JMP instructions.  Call via JSR.
000000r 2               ; 72 entries ($A000-$A0D5); the reserved slots after them ($A0D8-$A0FE) return
000000r 2               ; immediately (RTS).
000000r 2               
000000r 2               ; --- Character I/O ---
000000r 2               Chrout              := $A000             ; Output character (dispatched by IO_MODE)
000000r 2                                                        ;   In: A = character
000000r 2                                                        ;   Preserves: A, X, Y
000000r 2                                                        ;   Handles CR ($0D), LF ($0A), BS ($08), BEL ($07) in video mode
000000r 2               
000000r 2               Chrin               := $A003             ; Input character from buffer (non-blocking poll)
000000r 2                                                        ;   Out: A = character, C=1 if char available, C=0 if not
000000r 2                                                        ;   Caller must loop until C=1 for blocking behavior
000000r 2                                                        ;   Echoes character via Chrout
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               WriteBuffer         := $A006             ; Write byte to input ring buffer
000000r 2                                                        ;   In: A = byte to write
000000r 2                                                        ;   Modifies: X
000000r 2               
000000r 2               ReadBuffer          := $A009             ; Read byte from input ring buffer
000000r 2                                                        ;   Out: A = byte read
000000r 2                                                        ;   Modifies: X, A
000000r 2               
000000r 2               BufferSize          := $A00C             ; Get number of unread bytes in input buffer
000000r 2                                                        ;   Out: A = count
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               ; --- IO Mode ---
000000r 2               SetIOMode           := $A00F             ; Set IO_MODE
000000r 2                                                        ;   In: A = mode (bit 0: 0=video, 1=serial)
000000r 2               
000000r 2               GetIOMode           := $A012             ; Get IO_MODE
000000r 2                                                        ;   Out: A = current IO_MODE
000000r 2               
000000r 2               ; --- Video console (6502-PICOVDP) ---
000000r 2               ;   The console entries marked "brings the console up" call InitVideo and
000000r 2               ;   clear the screen first if nothing has since KernalInit (VID_MODE = $00).
000000r 2               InitVideo           := $A015             ; Put the PICOVDP in the Kernal's Text-mode console
000000r 2                                                        ;   With the display off, writes the Text layout: VMODE
000000r 2                                                        ;   Text (40×24 of 6×8), name table $0000, attributes
000000r 2                                                        ;   $0400, pattern table $0800, PALBASE $3F ($FC00),
000000r 2                                                        ;   VBANK 0, VINC +1, IRQEN 0, STATSEL_A 0, scroll 0,
000000r 2                                                        ;   layer 1 and sprites off.  Then has the card load its
000000r 2                                                        ;   built-in font into $0800 (VdpLoadFont, font $00) and
000000r 2                                                        ;   waits for it: returns after the next vertical blank,
000000r 2                                                        ;   up to a frame later.  Restores palette row 0, sets
000000r 2                                                        ;   the border to VID_BORDER, turns the display on and
000000r 2                                                        ;   sets VID_MODE = $01
000000r 2                                                        ;   The display is off while all of that happens, and a
000000r 2                                                        ;   blanked card shows the border over the whole screen,
000000r 2                                                        ;   so a caller with a border of its own sets VID_BORDER
000000r 2                                                        ;   before the console comes up (v2.0.2)
000000r 2                                                        ;   Does not clear the screen: the name and attribute
000000r 2                                                        ;   tables are shown as they are, unscrolled
000000r 2                                                        ;   A program that switched modes, moved tables or
000000r 2                                                        ;   overwrote the glyphs gets the console back with this
000000r 2                                                        ;   one call.  It writes IRQEN = 0, so a program using a
000000r 2                                                        ;   VDP interrupt enables it again afterwards
000000r 2                                                        ;   Skips silently if no video card is fitted
000000r 2                                                        ;   Modifies: Flags, A, X, Y
000000r 2               
000000r 2               VideoClear          := $A018             ; Clear screen to spaces in the pen, cursor home, unscrolled
000000r 2                                                        ;   Fills the 960 names at $0000 with $20 and the 960
000000r 2                                                        ;   attributes at $0400 with VID_PEN; VID_TOP = 0
000000r 2                                                        ;   Brings the console up
000000r 2                                                        ;   Skips silently if no video card is fitted
000000r 2                                                        ;   Modifies: Flags, A, X, Y
000000r 2               
000000r 2               VideoPutChar        := $A01B             ; Write character at cursor position (no cursor advance)
000000r 2                                                        ;   In: A = character; its attribute byte is VID_PEN
000000r 2                                                        ;   No card check and no console bring-up
000000r 2                                                        ;   Modifies: Flags
000000r 2               
000000r 2               VideoSetCursor      := $A01E             ; Set cursor position
000000r 2                                                        ;   In: X = column (0-39), Y = row (0-23), on the screen
000000r 2                                                        ;   as shown (VID_TOP is folded in)
000000r 2                                                        ;   Brings the console up
000000r 2                                                        ;   Skips silently if no video card is fitted
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               VideoGetCursor      := $A021             ; Get cursor position
000000r 2                                                        ;   Out: X = column (0-39), Y = row (0-23), screen coordinates
000000r 2                                                        ;   Brings the console up
000000r 2                                                        ;   Modifies: Flags
000000r 2               
000000r 2               VideoScroll         := $A024             ; Scroll screen up one line, in hardware
000000r 2                                                        ;   Moves the origin down a row (VID_TOP, L0SCRY) and
000000r 2                                                        ;   blanks the new bottom row in the pen; nothing is
000000r 2                                                        ;   copied.  The cursor keeps its screen position
000000r 2                                                        ;   Skips silently if no video card is fitted
000000r 2                                                        ;   Modifies: Flags, A, X, Y
000000r 2               
000000r 2               VideoSetColor       := $A027             ; Set the pen for later output, and the border
000000r 2                                                        ;   In: A = fg<<4 | bg (palette row 0, see Colour Constants)
000000r 2                                                        ;   VID_PEN = A, VID_BORDER = A & $0F, and register 7
000000r 2                                                        ;   (VC_REG_COLOR) = A: its low nibble is the border, so
000000r 2                                                        ;   the border follows the background.  Characters
000000r 2                                                        ;   already on screen keep their colours; VideoClear
000000r 2                                                        ;   fills with the pen
000000r 2                                                        ;   Brings the console up
000000r 2                                                        ;   Skips silently if no video card is fitted
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               VideoChroutRaw      := $A02A             ; Output char to video with no control-code handling
000000r 2                                                        ;   In: A = character code (0-255), glyph n of the font
000000r 2                                                        ;   Preserves: A, X, Y
000000r 2                                                        ;   Always renders glyph, never interprets CR/LF/BS/BEL
000000r 2                                                        ;   Brings the console up
000000r 2               
000000r 2               ; --- Sound (SID / ARMSID) ---
000000r 2               InitSID             := $A02D             ; Initialize SID (clear all registers, volume=15)
000000r 2                                                        ;   Modifies: A, X
000000r 2               
000000r 2               Beep                := $A030             ; Play short beep tone (~475 Hz)
000000r 2                                                        ;   Skips silently if no SID detected
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               SidPlayNote         := $A033             ; Play note on a SID voice
000000r 2                                                        ;   In: A = voice (0-2), X = freq low, Y = freq high
000000r 2                                                        ;   Uses triangle waveform, ADSR: A=0 D=9 S=F R=8
000000r 2                                                        ;   Full sustain holds the note flat until gated off
000000r 2                                                        ;   Skips silently if no SID is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               SidSilence          := $A036             ; Silence all 3 SID voices (gate off only)
000000r 2                                                        ;   Frequencies are left intact — the envelope release
000000r 2                                                        ;   rings the tone out.  Zeroing freq would freeze the
000000r 2                                                        ;   waveform and decay a DC offset (audible thump)
000000r 2                                                        ;   Skips silently if no SID is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               SidSetVolume        := $A039             ; Set SID master volume
000000r 2                                                        ;   In: A = volume (0-15); only the low nibble is used
000000r 2                                                        ;   Skips silently if no SID is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               ; --- Filesystem (disk-banked, 16-file directory per disk) ---
000000r 2               ;   The CF card is divided into 256 disk banks of 1 MB each (FS_DISK_SECTORS
000000r 2               ;   sectors × 512 bytes).  CF_DISK ($030F) selects the active bank (reset to
000000r 2               ;   0 on boot).  Use FsSetDisk / FsGetDisk to change it at runtime.  Each
000000r 2               ;   bank has its own directory at the first sector, holding up to 16 entries
000000r 2               ;   (8.3 filenames, space-padded, case-insensitive).  All FS routines and
000000r 2               ;   StReadSector / StWriteSector operate on the selected bank automatically.
000000r 2               ;   Pass null-terminated "NAME.EXT" string via STR_PTR ($02-$03).
000000r 2               ;   Use FsLoadFileAddr / FsSaveFileAddr for load-to-address transfers.
000000r 2               ;   The extension is inert — nothing in the BIOS branches on it, so .PRG, .BAS
000000r 2               ;   and .FOO behave identically.  What a file means is decided by the routine
000000r 2               ;   that loads it, never by its name.
000000r 2               ;   All FS routines use $0600-$07FF as a 512-byte sector buffer.
000000r 2               
000000r 2               FsLoadFile          := $A03C             ; Load file from CF
000000r 2                                                        ;   In: STR_PTR = pointer to null-terminated filename
000000r 2                                                        ;   Out: C=0 success, C=1 not found or error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsSaveFile          := $A03F             ; Save file to CF
000000r 2                                                        ;   In: STR_PTR = pointer to null-terminated filename
000000r 2                                                        ;   Out: C=0 success, C=1 error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsDeleteFile        := $A042             ; Delete file from CF
000000r 2                                                        ;   In: STR_PTR = pointer to null-terminated filename
000000r 2                                                        ;   Out: C=0 success, C=1 not found or error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               ; --- Keyboard / GPIO ---
000000r 2               InitKB              := $A045             ; Initialize VIA for keyboard input
000000r 2                                                        ;   Configures Port A/B as inputs, enables CB1/CA1 IRQs
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               ; --- Joysticks ---
000000r 2               ;   Both ports are ACTIVE LOW — each line is pulled up through 1K and grounded
000000r 2               ;   by its switch — and both routines return the port read raw.  So a held
000000r 2               ;   button is a 0 bit and an untouched stick reads $FF:
000000r 2               ;
000000r 2               ;     Bit:  7   6   5   4   3   2   1   0
000000r 2               ;           R   L   D   U   Y   X   B   A
000000r 2               ;
000000r 2               ;   Test a direction with:  lda ... / and #%00010000 / beq @UpHeld
000000r 2               ;
000000r 2               ;   Neither routine checks HW_PRESENT — with no GPIO card fitted they read a
000000r 2               ;   floating bus and the value is meaningless.  Test HW_GPIO first if the card
000000r 2               ;   may be absent.  (BASIC's JOY() does this and reports $FF.)
000000r 2               ;
000000r 2               ;   Both routines release both encoders (KBDisable), read the port, then
000000r 2               ;   re-enable them (KBEnable).  The interrupt state is left alone.
000000r 2               
000000r 2               ReadJoystick1       := $A048             ; Read joystick 1 (VIA Port B)
000000r 2                                                        ;   Out: A = bitmask (active low, see above)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               ReadJoystick2       := $A04B             ; Read joystick 2 (VIA Port A)
000000r 2                                                        ;   Out: A = bitmask (active low, see above)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               ; --- Serial (R6551AP) ---
000000r 2               InitSC              := $A04E             ; Initialize serial card (8-N-1, 19200 baud)
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               SerialChrout        := $A051             ; Direct serial output (bypasses IO_MODE)
000000r 2                                                        ;   In: A = character
000000r 2                                                        ;   Blocks until TX register is empty
000000r 2               
000000r 2               ; --- Serial Transfer ---
000000r 2               XModemLoad          := $A054             ; Receive data via XModem into memory
000000r 2                                                        ;   Protocol: standard XModem (128-byte blocks, checksum)
000000r 2                                                        ;   In: XFER_PTR = destination address
000000r 2                                                        ;   Out: C=0 success, XFER_PTR advanced past last byte written
000000r 2                                                        ;        XFER_REMAIN = total bytes received
000000r 2                                                        ;        C=1 transfer failed (timeout or CAN received)
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               XModemSave          := $A057             ; Send data via XModem from memory
000000r 2                                                        ;   Protocol: standard XModem (128-byte blocks, checksum)
000000r 2                                                        ;   In: XFER_PTR = source address, XFER_REMAIN = byte count
000000r 2                                                        ;   Out: C=0 success, C=1 transfer failed (timeout or CAN received)
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               ; --- RTC (DS1511Y) ---
000000r 2               RtcReadTime         := $A05A             ; Read current time
000000r 2                                                        ;   Out: A = hours, X = minutes, Y = seconds (all binary)
000000r 2               
000000r 2               RtcReadDate         := $A05D             ; Read current date
000000r 2                                                        ;   Out: A = day, X = month, Y = year (all binary)
000000r 2                                                        ;   RTC_BUF_CENT ($030B) = century
000000r 2               
000000r 2               RtcWriteTime        := $A060             ; Set RTC time
000000r 2                                                        ;   In: A = hours, X = minutes, Y = seconds (all binary)
000000r 2                                                        ;   Modifies: A, X
000000r 2               
000000r 2               RtcWriteDate        := $A063             ; Set RTC date
000000r 2                                                        ;   In: A = day, X = month, Y = year (all binary)
000000r 2                                                        ;   RTC_BUF_CENT ($030B) must hold century
000000r 2                                                        ;   Modifies: A, X
000000r 2               
000000r 2               RtcReadNVRAM        := $A066             ; Read byte from DS1511Y NVRAM (256 bytes)
000000r 2                                                        ;   In: X = address ($00-$FF)
000000r 2                                                        ;   Out: A = data byte
000000r 2               
000000r 2               RtcWriteNVRAM       := $A069             ; Write byte to DS1511Y NVRAM
000000r 2                                                        ;   In: X = address ($00-$FF), A = data byte
000000r 2               
000000r 2               ; --- CompactFlash Storage ---
000000r 2               StReadSector        := $A06C             ; Read one 512-byte sector
000000r 2                                                        ;   In: CF_LBA ($26-$29) = LBA, CF_BUF_PTR ($24-$25) = dest
000000r 2                                                        ;   Out: C=0 success, C=1 error; CF_BUF_PTR advanced by 512
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               StWriteSector       := $A06F             ; Write one 512-byte sector
000000r 2                                                        ;   In: CF_LBA ($26-$29) = LBA, CF_BUF_PTR ($24-$25) = source
000000r 2                                                        ;   Out: C=0 success, C=1 error; CF_BUF_PTR advanced by 512
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               StWaitReady         := $A072             ; Wait for CF to become ready (BSY=0, RDY=1)
000000r 2                                                        ;   Out: C=0 ready, C=1 timeout/error
000000r 2                                                        ;   Returns C=1 at once if the boot probe found no CF
000000r 2                                                        ;   card, rather than spinning out the full timeout.
000000r 2                                                        ;   Every FS and sector routine passes through here, so
000000r 2                                                        ;   an empty slot fails fast throughout the stack
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               ; --- Timing ---
000000r 2               SysDelay            := $A075             ; Delay for specified centiseconds (10 ms units)
000000r 2                                                        ;   In: A = low byte, X = high byte (16-bit count)
000000r 2                                                        ;   Uses VIA T1 if available, else software loop
000000r 2                                                        ;   Modifies: A, X, Y (X/Y clobbered only in software-fallback path)
000000r 2               
000000r 2               ; --- System / Cartridge Support ---
000000r 2               KernalInit          := $A078             ; Initialize all hardware (vectors, probe & init all I/O)
000000r 2                                                        ;   Caller MUST reset the stack pointer before JSR:
000000r 2                                                        ;     ldx #$ff / txs / jsr KernalInit
000000r 2                                                        ;   Zeroes BOOT_VECTOR, PRG_IMAGE_END and CF_DISK;
000000r 2                                                        ;   sets HW_PRESENT, IO_MODE, IRQ/BRK/NMI ptrs,
000000r 2                                                        ;   VID_PEN = $1F, VDP_FW, VDP_CAPS and VID_MODE = $00
000000r 2                                                        ;   Leaves a PICOVDP in the legacy submode (VMODE $0),
000000r 2                                                        ;   unscrolled, as its own reset does: the Text console
000000r 2                                                        ;   comes up on first use, not here
000000r 2                                                        ;   Does NOT reset the stack pointer
000000r 2                                                        ;   Does NOT enable interrupts (caller must CLI)
000000r 2                                                        ;   Does NOT play beep, print, or start BASIC
000000r 2                                                        ;   Does NOT halt if no console is detected
000000r 2                                                        ;   Modifies: All registers, flags
000000r 2               
000000r 2               KernalVersion       := $A07B             ; Get BIOS version
000000r 2                                                        ;   Out: A = major version, X = minor version
000000r 2               
000000r 2               ; --- Disk-banking & addressed storage (v1.1) ---
000000r 2               ;   CF_DISK ($030F) selects the current disk bank (0–255).
000000r 2               ;   All FS routines, StReadSector, and StWriteSector address the selected
000000r 2               ;   bank automatically.  Bank changes survive until the next reset.
000000r 2               
000000r 2               FsLoadFileAddr      := $A07E             ; Load named file from current disk to FS_IO_ADDR
000000r 2                                                        ;   In: STR_PTR = null-terminated filename
000000r 2                                                        ;       FS_IO_ADDR ($037F) = destination address
000000r 2                                                        ;   Out: C=0 success, FS_FILE_SIZE = bytes loaded; C=1 error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsSaveFileAddr      := $A081             ; Save FS_FILE_SIZE bytes from FS_IO_ADDR to a named file
000000r 2                                                        ;   In: STR_PTR = filename
000000r 2                                                        ;       FS_IO_ADDR ($037F) = source address
000000r 2                                                        ;       FS_FILE_SIZE ($034A) = byte count
000000r 2                                                        ;   Out: C=0 success, C=1 error (disk full or write error)
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsFormatDisk        := $A084             ; Zero the current disk's directory (erases all 16 entries)
000000r 2                                                        ;   Out: C=0 success, C=1 write error
000000r 2                                                        ;   No confirmation prompt — caller is responsible
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsSetDisk           := $A087             ; Select the current CF disk bank
000000r 2                                                        ;   In: A = disk number (0–255) → stored in CF_DISK ($030F)
000000r 2                                                        ;   Modifies: Flags
000000r 2               
000000r 2               FsGetDisk           := $A08A             ; Get the current CF disk bank
000000r 2                                                        ;   Out: A = CF_DISK value (0–255)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               FsPrintDisk         := $A08D             ; Print "DISK n" + CRLF via Chrout (decimal, no leading zeros)
000000r 2                                                        ;   Uses current CF_DISK
000000r 2                                                        ;   Modifies: Flags, A, X, Y
000000r 2               
000000r 2               ; --- General Output Utilities (console routed by IO_MODE via Chrout) ---
000000r 2               PrintStr            := $A090             ; Print a NUL-terminated string
000000r 2                                                        ;   In : A = string addr low, Y = string addr high
000000r 2                                                        ;   Modifies: Flags, A, Y, STR_PTR (X preserved)
000000r 2               PrintCRLF           := $A093             ; Print CR ($0D) then LF ($0A)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               PrintDecU16         := $A096             ; Print an unsigned 16-bit value as decimal
000000r 2                                                        ;   In : A = value low, X = value high (no leading zeros)
000000r 2                                                        ;   Modifies: Flags, A, X, Y, FS_FILE_SIZE, FS_DIR_IDX
000000r 2               
000000r 2               ; --- Keyboard Encoder Control (raw GPIO port access) ---
000000r 2               ;   Both keyboard encoders drive the VIA ports the joysticks share.  Disable
000000r 2               ;   them to read GPIO_PORTA/GPIO_PORTB directly, then re-enable them.  The
000000r 2               ;   ReadJoystick routines do this for you; call these only for custom reads.
000000r 2               KBDisable           := $A099             ; Release both encoders and wait for them to let go
000000r 2                                                        ;   Busy-waits ~200 us so the ports settle before reading
000000r 2                                                        ;   Safe to call while the caller owns the VIA timers
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               KBEnable            := $A09C             ; Re-enable both keyboard encoders
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               ; --- NVRAM Save Slots (DS1511Y) (v1.6) ---
000000r 2               ;   The 256 NVRAM bytes as 16 slots.  Slot n is NVRAM n*16 .. n*16+15:
000000r 2               ;     +$0      owner ID ($00 = free, otherwise a byte the game chooses)
000000r 2               ;     +$1      checksum over the owner ID and the 14 payload bytes
000000r 2               ;     +$2-$F   payload (NV_SLOT_DATA bytes)
000000r 2               ;   Checksum: ck = NV_CK_SEED, then ck = rol8(ck) EOR b for each covered byte
000000r 2               ;   (rol8 = shift left, bit 7 back into bit 0).  Each slot is validated alone.
000000r 2               ;
000000r 2               ;   All six:
000000r 2               ;     * Carry set means the call did nothing: no RTC fitted, slot >= NV_SLOTS,
000000r 2               ;       or the per-routine cases noted.  They check HW_PRESENT themselves.
000000r 2               ;     * The caller's D and I flags come back unchanged.  Interrupts are held
000000r 2               ;       off for a slot copy, which uses the DS1511Y's burst mode (every access
000000r 2               ;       of RTC_RAM_DATA advances RTC_RAM_ADDR); an NMI handler must not touch
000000r 2               ;       NVRAM.  Burst mode is off again on return.
000000r 2               NvStat              := $A09F             ; Report a slot's state
000000r 2                                                        ;   In:  X = slot (0-15)
000000r 2                                                        ;   Out: A = NV_EMPTY / NV_VALID / NV_BAD, Y = owner ID
000000r 2                                                        ;        C set if no RTC or bad slot (A, Y undefined)
000000r 2                                                        ;   Modifies: Flags, A, Y (X preserved)
000000r 2               
000000r 2               NvRead              := $A0A2             ; Copy a valid slot's 14 payload bytes
000000r 2                                                        ;   In:  X = slot, A/Y = destination lo/hi
000000r 2                                                        ;   Out: A = status, Y = owner ID
000000r 2                                                        ;        C clear and the buffer written only if A = NV_VALID
000000r 2                                                        ;        C set on a slot that is not valid (A, Y still the
000000r 2                                                        ;        status and owner) — the buffer is never touched
000000r 2                                                        ;   Modifies: Flags, A, Y, NV_PTR (X preserved)
000000r 2               
000000r 2               NvWrite             := $A0A5             ; Write a slot: owner ID, checksum and 14 payload bytes
000000r 2                                                        ;   In:  X = slot, A/Y = source lo/hi, NV_ID = owner ID ($01-$FF)
000000r 2                                                        ;   Out: C set if no RTC, bad slot or NV_ID = 0 (nothing written)
000000r 2                                                        ;   Modifies: Flags, A, Y, NV_PTR (X preserved)
000000r 2               
000000r 2               NvErase             := $A0A8             ; Zero all 16 bytes of a slot
000000r 2                                                        ;   In:  X = slot
000000r 2                                                        ;   Out: C set if no RTC or bad slot
000000r 2                                                        ;   Modifies: Flags, A, Y (X preserved)
000000r 2               
000000r 2               NvFind              := $A0AB             ; Lowest slot whose owner ID is A, valid or damaged
000000r 2                                                        ;   In:  A = owner ID ($00 finds the lowest free slot)
000000r 2                                                        ;   Out: X = slot; C set if no slot matched (X undefined)
000000r 2                                                        ;   Modifies: Flags, A, X
000000r 2               
000000r 2               NvFormat            := $A0AE             ; Erase all 16 slots
000000r 2                                                        ;   Out: C set if no RTC
000000r 2                                                        ;   Modifies: Flags, A, X, Y
000000r 2               
000000r 2               ; --- PICOVDP (v2.0) ---
000000r 2               ;   Each returns carry set, having written nothing, when no card is fitted
000000r 2               ;   (HW_VID clear) or an argument is out of range, and carry clear otherwise.
000000r 2               ;   Port A only, and VBANK = 0, VINC = +1 on the way out, like the console.
000000r 2               ;   Only VdpWriteReg and the entries built on it keep VID_MODE and the LxCTRL
000000r 2               ;   shadows; a program that writes VC_REG directly keeps its own records.
000000r 2               
000000r 2               VdpInfo             := $A0B1             ; What the boot probe found
000000r 2                                                        ;   Out: A = VDP_FW (STAT5), X = VDP_CAPS (STAT6),
000000r 2                                                        ;        Y = VC_ID ($AC), carry clear
000000r 2                                                        ;        No card: carry set, Y = 0, A = X = 0 (or, for a
000000r 2                                                        ;        PICOVDP without the font, what it reported)
000000r 2                                                        ;   Modifies: Flags, A, X, Y
000000r 2               
000000r 2               VdpWriteReg         := $A0B4             ; Write a register, keeping the Kernal's records of it
000000r 2                                                        ;   In: A = value, X = register (0-127, VC_REG_*)
000000r 2                                                        ;   A VMODE write sets VID_MODE (b7 set when it takes the
000000r 2                                                        ;   card back to Text or legacy from anything else); an
000000r 2                                                        ;   L0CTRL / L1CTRL write sets VDP_L0CTRL_SHADOW /
000000r 2                                                        ;   VDP_L1CTRL_SHADOW
000000r 2                                                        ;   Out: C set, nothing written, if no card or X > 127
000000r 2                                                        ;   Preserves: X, Y
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               VdpSetMode          := $A0B7             ; Write VMODE, and VID_MODE with it
000000r 2                                                        ;   In: A = VC_VMODE_TEXT, _COMPACT, _GRAPHICS or _FULL (1-4)
000000r 2                                                        ;   The register only: tables, layers and sprites are the
000000r 2                                                        ;   caller's to lay out.  The Text console is InitVideo
000000r 2                                                        ;   Out: C set, nothing written, if no card or A out of range
000000r 2                                                        ;   Modifies: Flags, A, X
000000r 2               
000000r 2               VdpPoke             := $A0BA             ; Write one byte anywhere in VRAM
000000r 2                                                        ;   In: A = value, X = address low, Y = address high
000000r 2                                                        ;       ($0000-$FFFF; VBANK is set and put back to 0)
000000r 2                                                        ;   Out: C set, nothing written, if no card
000000r 2                                                        ;   Modifies: Flags, A, X
000000r 2               
000000r 2               VdpPeek             := $A0BD             ; Read one byte anywhere in VRAM
000000r 2                                                        ;   In: X = address low, Y = address high ($0000-$FFFF)
000000r 2                                                        ;   Out: A = the byte; C set, nothing read, if no card
000000r 2                                                        ;   Modifies: Flags, A, X
000000r 2               
000000r 2               VdpSetPalette       := $A0C0             ; Set one palette entry, at VC_PALETTE + 2 × entry
000000r 2                                                        ;   In: X = entry (0-255), A = %0000RRRR, Y = %GGGGBBBB
000000r 2                                                        ;   Assumes PALBASE = $3F, where InitVideo puts it; a
000000r 2                                                        ;   program that moves PALBASE writes its own
000000r 2                                                        ;   Out: C set, nothing written, if no card
000000r 2                                                        ;   Modifies: Flags, A, X, Y
000000r 2               
000000r 2               WaitVBlank          := $A0C3             ; Return at the start of the next vertical blank
000000r 2                                                        ;   Polls STAT3 b0 on port A, then puts STATSEL_A back to
000000r 2                                                        ;   0 without reading STAT0: STAT0's flags and the STAT1
000000r 2                                                        ;   latches are left as they were
000000r 2                                                        ;   No card: waits 2 cs (SysDelay) and returns C set
000000r 2                                                        ;   Modifies: Flags, A, X, Y
000000r 2               
000000r 2               VdpLoadFile         := $A0C6             ; Load a named file from the current disk into VRAM
000000r 2                                                        ;   In: STR_PTR = filename, FS_IO_ADDR ($037F) = VRAM
000000r 2                                                        ;       address (any of the 64 KB)
000000r 2                                                        ;   Writes exactly the file's bytes, never the rest of
000000r 2                                                        ;   its last sector
000000r 2                                                        ;   Out: C clear, FS_FILE_SIZE = bytes written
000000r 2                                                        ;        C set if no card (nothing read), not found, or
000000r 2                                                        ;        read error
000000r 2                                                        ;   Modifies: Flags, A, X, Y, CF_LBA, CF_BUF_PTR,
000000r 2                                                        ;             XFER_REMAIN, FS sector buffer
000000r 2               
000000r 2               VdpLoadFont         := $A0C9             ; Load a built-in font into layer 0's pattern table
000000r 2                                                        ;   In: A = font ID; VC_FONT_CP437 ($00) is the only one
000000r 2                                                        ;   accepted.  Writes VC_REG_FONT for layer 0, which
000000r 2                                                        ;   copies to L0PAT × $800 as it stands at the call, and
000000r 2                                                        ;   returns at the next vertical blank (WaitVBlank), when
000000r 2                                                        ;   the copy has landed.  STAT0 is not read
000000r 2                                                        ;   Out: C set, nothing written, if no card or A <> $00
000000r 2                                                        ;   Modifies: Flags, A, X, Y
000000r 2               
000000r 2               VdpSprite           := $A0CC             ; Write one sprite's four attribute bytes
000000r 2                                                        ;   In: X = sprite (0-63), VDP_P0 = Y, VDP_P1 = X bits
000000r 2                                                        ;       7:0, VDP_P2 = pattern, VDP_P3 = attributes
000000r 2                                                        ;       (VC_ATTR_*: b7 X bit 8, b6 priority, b5:4 flips,
000000r 2                                                        ;       b3:0 sub-palette)
000000r 2                                                        ;   Assumes the sprite attribute table at VRAM $2000
000000r 2                                                        ;   (SPRATTR = $40, where BASIC's SCREEN 1-3 put it); a
000000r 2                                                        ;   program that moves SPRATTR writes sprites with VdpPoke
000000r 2                                                        ;   Sets VID_MODE b7 (disturbed)
000000r 2                                                        ;   Out: C set, nothing written, if no card or X > 63
000000r 2                                                        ;   Preserves: X
000000r 2                                                        ;   Modifies: Flags, A, Y
000000r 2               
000000r 2               VdpSetScroll        := $A0CF             ; Scroll a layer
000000r 2                                                        ;   In: X = layer (0-1), A = x bits 7:0, Y = y,
000000r 2                                                        ;       VDP_P0 = x bit 8 (0 or not)
000000r 2                                                        ;   Writes LxSCRX, LxSCRY and LxCTRL b6 (VC_LCTRL_SCRX8),
000000r 2                                                        ;   LxCTRL's other bits from its shadow
000000r 2                                                        ;   Sets VID_MODE b7 (disturbed)
000000r 2                                                        ;   Out: C set, nothing written, if no card or X > 1
000000r 2                                                        ;   Modifies: Flags, A, X
000000r 2               
000000r 2               VdpLayer            := $A0D2             ; Show or hide a layer
000000r 2                                                        ;   In: X = layer (0-1), A = 0 to hide, anything else to show
000000r 2                                                        ;   Sets or clears LxCTRL b4 (VC_LCTRL_ENABLE), its other
000000r 2                                                        ;   bits from the shadow
000000r 2                                                        ;   Sets VID_MODE b7 (disturbed)
000000r 2                                                        ;   Out: C set, nothing written, if no card or X > 1
000000r 2                                                        ;   Modifies: Flags, A, X
000000r 2               
000000r 2               VdpStatus           := $A0D5             ; Read a status register through port A
000000r 2                                                        ;   In: X = status register (0-15, VC_STAT*)
000000r 2                                                        ;   Out: A = its value; C set, nothing read, if no card
000000r 2                                                        ;        or X > 15
000000r 2                                                        ;   STATSEL_A goes back to 0 without reading STAT0.
000000r 2                                                        ;   Reading STAT0 itself clears its flags, and STAT1 its
000000r 2                                                        ;   latches (see the status registers in Section 6)
000000r 2                                                        ;   Preserves: X, Y
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 5: IO HARDWARE REGISTERS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- Banked RAM Low (IO 1: $8000-$83FF) ---
000000r 2               ;   256 banks × ~1 KB each.  Write bank number to latch, then access data window.
000000r 2               RAM_DATA_L          := $8000             ; R/W data window ($8000-$83FE)
000000r 2               RAM_BANK_L          := $83FF             ; Write-only bank latch ($00-$FF)
000000r 2               
000000r 2               ; --- Banked RAM High (IO 2: $8400-$87FF) ---
000000r 2               RAM_DATA_H          := $8400             ; R/W data window ($8400-$87FE)
000000r 2               RAM_BANK_H          := $87FF             ; Write-only bank latch ($00-$FF)
000000r 2               
000000r 2               ; --- RTC (DS1511Y) (IO 3: $8800-$881F) ---
000000r 2               RTC_SEC             := $8800             ; Seconds      (BCD, 00-59)
000000r 2               RTC_MIN             := $8801             ; Minutes      (BCD, 00-59)
000000r 2               RTC_HR              := $8802             ; Hours        (BCD, 00-23, 24h mode)
000000r 2               RTC_DAY             := $8803             ; Day of week  (1-7)
000000r 2               RTC_DATE            := $8804             ; Day of month (BCD, 01-31)
000000r 2               RTC_MON             := $8805             ; Month        (BCD, 01-12)
000000r 2               RTC_YR              := $8806             ; Year         (BCD, 00-99)
000000r 2               RTC_CENT            := $8807             ; Century      (BCD, 00-39)
000000r 2               RTC_ALARM_SEC       := $8808             ; Alarm seconds
000000r 2               RTC_ALARM_MIN       := $8809             ; Alarm minutes
000000r 2               RTC_ALARM_HR        := $880A             ; Alarm hours
000000r 2               RTC_ALARM_DATE      := $880B             ; Alarm day of month
000000r 2               RTC_WD_L            := $880C             ; Watchdog low
000000r 2               RTC_WD_H            := $880D             ; Watchdog high
000000r 2               RTC_CTRL_A          := $880E             ; Control Register A
000000r 2               RTC_CTRL_B          := $880F             ; Control Register B
000000r 2               RTC_RAM_ADDR        := $8810             ; NVRAM address register
000000r 2               RTC_RAM_DATA        := $8813             ; NVRAM data register
000000r 2               ; Control Register B bits:
000000r 2               RTC_CTRL_B_TE       := %10000000         ; Transfer Enable — 1 = counters update the user registers once a second, 0 = inhibited
000000r 2               RTC_CTRL_B_BME      := %00100000         ; Burst Mode Enable — 1 = RTC_RAM_ADDR auto-increments on each access of RTC_RAM_DATA
000000r 2               ; Month register ($8805) — the upper 3 bits are oscillator/SQW control, not month data.
000000r 2               ; Always mask with RTC_MON_MASK when reading the month, and preserve these bits on write.
000000r 2               RTC_MON_MASK        := %00011111         ; Month value occupies the low 5 bits
000000r 2               RTC_MON_EOSC        := %10000000         ; Oscillator Start/Stop (0 = oscillator running)
000000r 2               RTC_MON_E32K        := %01000000         ; 32 kHz square-wave enable (1 = SQW output disabled)
000000r 2               RTC_MON_BB32        := %00100000         ; Battery-backup 32 kHz SQW enable (1 = enabled in backup)
000000r 2               
000000r 2               ; --- CompactFlash / Storage (IO 4: $8C00-$8C07) ---
000000r 2               ;   8-bit IDE (True IDE) mode.  The BIOS issues Set Features $01 at boot
000000r 2               ;   to enable 8-bit data transfers.
000000r 2               ST_DATA             := $8C00             ; R/W — Data register
000000r 2               ST_ERROR            := $8C01             ; Read — Error register
000000r 2               ST_FEATURE          := $8C01             ; Write — Feature register
000000r 2               ST_SECT_CNT         := $8C02             ; R/W — Sector count
000000r 2               ST_LBA_0            := $8C03             ; R/W — LBA bits 0-7
000000r 2               ST_LBA_1            := $8C04             ; R/W — LBA bits 8-15
000000r 2               ST_LBA_2            := $8C05             ; R/W — LBA bits 16-23
000000r 2               ST_LBA_3            := $8C06             ; R/W — LBA bits 24-27 + drive/mode
000000r 2               ST_STATUS           := $8C07             ; Read — Status register
000000r 2               ST_CMD              := $8C07             ; Write — Command register
000000r 2               
000000r 2               ; CF Status Register bits:
000000r 2               ST_STATUS_ERR       := %00000001         ; Error occurred
000000r 2               ST_STATUS_IDX       := %00000010         ; Index mark
000000r 2               ST_STATUS_CORR      := %00000100         ; Corrected data
000000r 2               ST_STATUS_DRQ       := %00001000         ; Data request — ready for data transfer
000000r 2               ST_STATUS_DSC       := %00010000         ; Drive seek complete
000000r 2               ST_STATUS_DWF       := %00100000         ; Drive write fault
000000r 2               ST_STATUS_RDY       := %01000000         ; Drive ready
000000r 2               ST_STATUS_BSY       := %10000000         ; Drive busy — all other bits invalid while set
000000r 2               
000000r 2               ; CF Error Register bits:
000000r 2               ST_ERR_AMNF         := %00000001         ; Address mark not found
000000r 2               ST_ERR_ABRT         := %00000100         ; Command aborted
000000r 2               ST_ERR_IDNF         := %00010000         ; ID not found
000000r 2               ST_ERR_UNC          := %01000000         ; Uncorrectable data error
000000r 2               ST_ERR_BBK          := %10000000         ; Bad block detected
000000r 2               
000000r 2               ; ATA Command bytes:
000000r 2               ST_CMD_READ         := $20               ; Read Sectors
000000r 2               ST_CMD_WRITE        := $30               ; Write Sectors
000000r 2               ST_CMD_SET_FEAT     := $EF               ; Set Features
000000r 2               ST_FEAT_8BIT        := $01               ; Feature: Enable 8-bit data I/O
000000r 2               ST_LBA3_MASTER      := $E0               ; LBA mode, master drive (bits 7-5=111, bit 4=0)
000000r 2               
000000r 2               ; Filesystem constants:
000000r 2               FS_DIR_LBA          = 0                  ; Directory sector at LBA 0
000000r 2               FS_DATA_START       = 1                  ; Data sectors start at LBA 1
000000r 2               FS_MAX_FILES        = 16                 ; Maximum directory entries
000000r 2               FS_ENTRY_SIZE       = 32                 ; Bytes per directory entry
000000r 2               FS_ENTRY_FLAGS      = 11                 ; Offset: flags byte within entry
000000r 2               FS_ENTRY_START      = 12                 ; Offset: start sector (2 bytes, little-endian)
000000r 2               FS_ENTRY_FSIZE      = 14                 ; Offset: file size (2 bytes, little-endian)
000000r 2               FS_FLAG_USED        = %00000001          ; Flags bit 0: entry in use
000000r 2               FS_DISK_SECTORS     = 2048               ; Sectors per disk bank (2048 × 512 bytes = 1 MB); 256 banks = 256 MB total
000000r 2               
000000r 2               ; XModem protocol constants (used with XModemLoad / XModemSave):
000000r 2               XMODEM_SOH          = $01                ; Start of Header
000000r 2               XMODEM_EOT          = $04                ; End of Transmission
000000r 2               XMODEM_ACK          = $06                ; Acknowledge
000000r 2               XMODEM_NAK          = $15                ; Negative Acknowledge (receiver sends to initiate transfer)
000000r 2               XMODEM_CAN          = $18                ; Cancel
000000r 2               XMODEM_SUB          = $1A                ; Padding byte (fills unused bytes in last block)
000000r 2               XMODEM_BLKSZ        = 128                ; Data bytes per block
000000r 2               XMODEM_MAXRETRY     = 10                 ; Max retries per block during transfer
000000r 2               XMODEM_STARTRETRY   = 60                 ; Retries waiting for initial connect (~60s)
000000r 2               
000000r 2               ; --- Serial Card (R6551AP ACIA) (IO 5: $9000-$9003) ---
000000r 2               ;   Default config after InitSC: 8-N-1, 19200 baud, RX IRQ enabled
000000r 2               SC_DATA             := $9000             ; R/W — Data register
000000r 2               SC_RESET            := $9001             ; Write — Programmatic reset (write any value)
000000r 2               SC_STATUS           := $9001             ; Read — Status register
000000r 2               SC_CMD              := $9002             ; R/W — Command register
000000r 2               SC_CTRL             := $9003             ; R/W — Control register
000000r 2               
000000r 2               ; Serial Status Register bits:
000000r 2               SC_STATUS_IRQ       := %10000000         ; Interrupt occurred
000000r 2               SC_STATUS_DSR       := %01000000         ; Data Set Ready
000000r 2               SC_STATUS_DCD       := %00100000         ; Data Carrier Detect
000000r 2               SC_STATUS_TDRE      := %00010000         ; TX Data Register Empty (ready to send)
000000r 2               SC_STATUS_RDRF      := %00001000         ; RX Data Register Full (byte available)
000000r 2               SC_STATUS_OVR       := %00000100         ; Overrun error
000000r 2               SC_STATUS_FRME      := %00000010         ; Framing error
000000r 2               SC_STATUS_PARE      := %00000001         ; Parity error
000000r 2               
000000r 2               ; Serial Command Register bits:
000000r 2               SC_CMD_RXIRQ_OFF    := %00000010         ; Receiver interrupt disabled (set = off)
000000r 2                                                        ;   Set it before polling SC_DATA yourself,
000000r 2                                                        ;   as XModem does; while it is clear, Chrout
000000r 2                                                        ;   moves a received byte into the input buffer
000000r 2               
000000r 2               ; --- GPIO / Input Board (65C22 VIA) (IO 6: $9400-$940F) ---
000000r 2               ;   Port B = matrix keyboard / joystick 1
000000r 2               ;   Port A = PS/2 keyboard / joystick 2
000000r 2               ;   CB1/CA1 IRQs fire when a key scancode is ready
000000r 2               GPIO_PORTB          := $9400             ; Port B data (active keyboard/joystick 1 data)
000000r 2               GPIO_PORTA          := $9401             ; Port A data (active keyboard/joystick 2 data)
000000r 2               GPIO_DDRB           := $9402             ; Port B data direction (0=input, 1=output per bit)
000000r 2               GPIO_DDRA           := $9403             ; Port A data direction
000000r 2               GPIO_T1CL           := $9404             ; Timer 1 counter low (read=counter, write=latch)
000000r 2               GPIO_T1CH           := $9405             ; Timer 1 counter high (write starts timer)
000000r 2               GPIO_T1LL           := $9406             ; Timer 1 latch low
000000r 2               GPIO_T1LH           := $9407             ; Timer 1 latch high
000000r 2               GPIO_T2CL           := $9408             ; Timer 2 counter low
000000r 2               GPIO_T2CH           := $9409             ; Timer 2 counter high
000000r 2               GPIO_SR             := $940A             ; Shift register
000000r 2               GPIO_ACR            := $940B             ; Auxiliary control register
000000r 2               GPIO_PCR            := $940C             ; Peripheral control register
000000r 2               GPIO_IFR            := $940D             ; Interrupt flag register
000000r 2               GPIO_IER            := $940E             ; Interrupt enable register
000000r 2               GPIO_ORA            := $940F             ; Port A (no handshake)
000000r 2               
000000r 2               ; VIA Peripheral Control Register (PCR) mode bits:
000000r 2               GPIO_PCR_CB2_LO     := %11000000         ; CB2 = manual output low  (enable matrix keyboard encoder)
000000r 2               GPIO_PCR_CB2_HI     := %11100000         ; CB2 = manual output high (disable matrix keyboard encoder)
000000r 2               GPIO_PCR_CB1_NEG    := %00000000         ; CB1 = active on falling edge
000000r 2               GPIO_PCR_CA2_LO     := %00001100         ; CA2 = manual output low  (enable PS/2 keyboard encoder)
000000r 2               GPIO_PCR_CA2_HI     := %00001110         ; CA2 = manual output high (disable PS/2 keyboard encoder)
000000r 2               GPIO_PCR_CA1_NEG    := %00000000         ; CA1 = active on falling edge
000000r 2               
000000r 2               ; VIA Interrupt flag/enable bits:
000000r 2               GPIO_INT_CB1        := %00010000         ; Bit 4: CB1 interrupt (matrix keyboard data ready)
000000r 2               GPIO_INT_CA1        := %00000010         ; Bit 1: CA1 interrupt (PS/2 keyboard data ready)
000000r 2               GPIO_IER_SET        := %10000000         ; IER bit 7: 1=set named bits, 0=clear named bits
000000r 2               
000000r 2               ; --- Sound Card (SID / ARMSID) (IO 7: $9800-$981C) ---
000000r 2               ;   MOS 6581/8580 compatible.  3 voices, each with independent frequency,
000000r 2               ;   pulse width, waveform, and ADSR envelope.  Global filter and volume.
000000r 2               
000000r 2               ; Voice 1:
000000r 2               SID_V1_FREQ_LO      := $9800             ; Frequency low byte
000000r 2               SID_V1_FREQ_HI      := $9801             ; Frequency high byte
000000r 2               SID_V1_PW_LO        := $9802             ; Pulse width low byte (bits 0-7)
000000r 2               SID_V1_PW_HI        := $9803             ; Pulse width high nibble (bits 0-3)
000000r 2               SID_V1_CTRL         := $9804             ; Control register (waveform + gate)
000000r 2               SID_V1_AD           := $9805             ; Attack (high nibble) / Decay (low nibble)
000000r 2               SID_V1_SR           := $9806             ; Sustain (high nibble) / Release (low nibble)
000000r 2               
000000r 2               ; Voice 2:
000000r 2               SID_V2_FREQ_LO      := $9807
000000r 2               SID_V2_FREQ_HI      := $9808
000000r 2               SID_V2_PW_LO        := $9809
000000r 2               SID_V2_PW_HI        := $980A
000000r 2               SID_V2_CTRL         := $980B
000000r 2               SID_V2_AD           := $980C
000000r 2               SID_V2_SR           := $980D
000000r 2               
000000r 2               ; Voice 3:
000000r 2               SID_V3_FREQ_LO      := $980E
000000r 2               SID_V3_FREQ_HI      := $980F
000000r 2               SID_V3_PW_LO        := $9810
000000r 2               SID_V3_PW_HI        := $9811
000000r 2               SID_V3_CTRL         := $9812
000000r 2               SID_V3_AD           := $9813
000000r 2               SID_V3_SR           := $9814
000000r 2               
000000r 2               ; Global SID registers:
000000r 2               SID_FC_LO           := $9815             ; Filter cutoff low (bits 0-2)
000000r 2               SID_FC_HI           := $9816             ; Filter cutoff high (bits 0-7)
000000r 2               SID_RES_FILT        := $9817             ; Resonance (high nibble) / Filter enable per voice (bits 0-2)
000000r 2               SID_MODE_VOL        := $9818             ; Filter mode (high nibble) / Master volume (low nibble, 0-15)
000000r 2               SID_PADDLE_X        := $9819             ; Paddle X (read-only)
000000r 2               SID_PADDLE_Y        := $981A             ; Paddle Y (read-only)
000000r 2               SID_OSC3            := $981B             ; Oscillator 3 output (read-only)
000000r 2               SID_ENV3            := $981C             ; Envelope 3 output (read-only)
000000r 2               
000000r 2               ; SID Voice Control Register bits (apply to SID_Vn_CTRL):
000000r 2               SID_CTRL_GATE       := %00000001         ; Gate: 1=start attack, 0=start release
000000r 2               SID_CTRL_SYNC       := %00000010         ; Hard sync with preceding voice
000000r 2               SID_CTRL_RING       := %00000100         ; Ring modulation with preceding voice
000000r 2               SID_CTRL_TEST       := %00001000         ; Test bit (resets oscillator)
000000r 2               SID_CTRL_TRIANGLE   := %00010000         ; Triangle waveform
000000r 2               SID_CTRL_SAWTOOTH   := %00100000         ; Sawtooth waveform
000000r 2               SID_CTRL_PULSE      := %01000000         ; Pulse waveform
000000r 2               SID_CTRL_NOISE      := %10000000         ; Noise waveform
000000r 2               
000000r 2               ; SID Filter Mode bits (high nibble of SID_MODE_VOL):
000000r 2               SID_FILT_LP         := %00010000         ; Low-pass filter
000000r 2               SID_FILT_BP         := %00100000         ; Band-pass filter
000000r 2               SID_FILT_HP         := %01000000         ; High-pass filter
000000r 2               SID_FILT_3OFF       := %10000000         ; Disconnect voice 3 from output
000000r 2               
000000r 2               ; --- SID Frequency Table (1 MHz clock, equal temperament) ---
000000r 2               ;   Freq register = round(Hz × 16777216 / 1000000)
000000r 2               ;   Covers octaves 2-7 (C2=65 Hz to B7=3951 Hz), all 12 chromatic notes.
000000r 2               ;   Sharps and flats are provided as aliases (e.g. SID_NOTE_CS4 = SID_NOTE_Db4).
000000r 2               ;   Use SidPlayNote: A=voice (0-2), X=freq low byte, Y=freq high byte.
000000r 2               ;   Example: ldx #<SID_NOTE_A4 / ldy #>SID_NOTE_A4
000000r 2               
000000r 2               ; Octave 2 (C2=65.41 Hz .. B2=123.47 Hz)
000000r 2               SID_NOTE_C2         = $0449              ; ~65 Hz
000000r 2               SID_NOTE_CS2        = $048B              ; ~69 Hz
000000r 2               SID_NOTE_Db2        = SID_NOTE_CS2
000000r 2               SID_NOTE_D2         = $04D0              ; ~73 Hz
000000r 2               SID_NOTE_DS2        = $0519              ; ~78 Hz
000000r 2               SID_NOTE_Eb2        = SID_NOTE_DS2
000000r 2               SID_NOTE_E2         = $0567              ; ~82 Hz
000000r 2               SID_NOTE_F2         = $05B9              ; ~87 Hz
000000r 2               SID_NOTE_FS2        = $0610              ; ~93 Hz
000000r 2               SID_NOTE_Gb2        = SID_NOTE_FS2
000000r 2               SID_NOTE_G2         = $066C              ; ~98 Hz
000000r 2               SID_NOTE_GS2        = $06CE              ; ~104 Hz
000000r 2               SID_NOTE_Ab2        = SID_NOTE_GS2
000000r 2               SID_NOTE_A2         = $0735              ; ~110 Hz
000000r 2               SID_NOTE_AS2        = $07A3              ; ~117 Hz
000000r 2               SID_NOTE_Bb2        = SID_NOTE_AS2
000000r 2               SID_NOTE_B2         = $0817              ; ~123 Hz
000000r 2               
000000r 2               ; Octave 3 (C3=130.81 Hz .. B3=246.94 Hz)
000000r 2               SID_NOTE_C3         = $0893              ; ~131 Hz
000000r 2               SID_NOTE_CS3        = $0915              ; ~139 Hz
000000r 2               SID_NOTE_Db3        = SID_NOTE_CS3
000000r 2               SID_NOTE_D3         = $099F              ; ~147 Hz
000000r 2               SID_NOTE_DS3        = $0A32              ; ~156 Hz
000000r 2               SID_NOTE_Eb3        = SID_NOTE_DS3
000000r 2               SID_NOTE_E3         = $0ACD              ; ~165 Hz
000000r 2               SID_NOTE_F3         = $0B72              ; ~175 Hz
000000r 2               SID_NOTE_FS3        = $0C20              ; ~185 Hz
000000r 2               SID_NOTE_Gb3        = SID_NOTE_FS3
000000r 2               SID_NOTE_G3         = $0CD8              ; ~196 Hz
000000r 2               SID_NOTE_GS3        = $0D9C              ; ~208 Hz
000000r 2               SID_NOTE_Ab3        = SID_NOTE_GS3
000000r 2               SID_NOTE_A3         = $0E6B              ; ~220 Hz
000000r 2               SID_NOTE_AS3        = $0F46              ; ~233 Hz
000000r 2               SID_NOTE_Bb3        = SID_NOTE_AS3
000000r 2               SID_NOTE_B3         = $102F              ; ~247 Hz
000000r 2               
000000r 2               ; Octave 4 (C4=261.63 Hz .. B4=493.88 Hz) — middle octave
000000r 2               SID_NOTE_C4         = $1125              ; ~262 Hz (Middle C)
000000r 2               SID_NOTE_CS4        = $122A              ; ~277 Hz
000000r 2               SID_NOTE_Db4        = SID_NOTE_CS4
000000r 2               SID_NOTE_D4         = $133F              ; ~294 Hz
000000r 2               SID_NOTE_DS4        = $1464              ; ~311 Hz
000000r 2               SID_NOTE_Eb4        = SID_NOTE_DS4
000000r 2               SID_NOTE_E4         = $159A              ; ~330 Hz
000000r 2               SID_NOTE_F4         = $16E3              ; ~349 Hz
000000r 2               SID_NOTE_FS4        = $183F              ; ~370 Hz
000000r 2               SID_NOTE_Gb4        = SID_NOTE_FS4
000000r 2               SID_NOTE_G4         = $19B1              ; ~392 Hz
000000r 2               SID_NOTE_GS4        = $1B38              ; ~415 Hz
000000r 2               SID_NOTE_Ab4        = SID_NOTE_GS4
000000r 2               SID_NOTE_A4         = $1CD6              ; ~440 Hz (Concert A)
000000r 2               SID_NOTE_AS4        = $1E8D              ; ~466 Hz
000000r 2               SID_NOTE_Bb4        = SID_NOTE_AS4
000000r 2               SID_NOTE_B4         = $205E              ; ~494 Hz
000000r 2               
000000r 2               ; Octave 5 (C5=523.25 Hz .. B5=987.77 Hz)
000000r 2               SID_NOTE_C5         = $224B              ; ~523 Hz
000000r 2               SID_NOTE_CS5        = $2455              ; ~554 Hz
000000r 2               SID_NOTE_Db5        = SID_NOTE_CS5
000000r 2               SID_NOTE_D5         = $267E              ; ~587 Hz
000000r 2               SID_NOTE_DS5        = $28C8              ; ~622 Hz
000000r 2               SID_NOTE_Eb5        = SID_NOTE_DS5
000000r 2               SID_NOTE_E5         = $2B34              ; ~659 Hz
000000r 2               SID_NOTE_F5         = $2DC6              ; ~698 Hz
000000r 2               SID_NOTE_FS5        = $307F              ; ~740 Hz
000000r 2               SID_NOTE_Gb5        = SID_NOTE_FS5
000000r 2               SID_NOTE_G5         = $3361              ; ~784 Hz
000000r 2               SID_NOTE_GS5        = $366F              ; ~831 Hz
000000r 2               SID_NOTE_Ab5        = SID_NOTE_GS5
000000r 2               SID_NOTE_A5         = $39AC              ; ~880 Hz
000000r 2               SID_NOTE_AS5        = $3D1A              ; ~932 Hz
000000r 2               SID_NOTE_Bb5        = SID_NOTE_AS5
000000r 2               SID_NOTE_B5         = $40BC              ; ~988 Hz
000000r 2               
000000r 2               ; Octave 6 (C6=1046.50 Hz .. B6=1975.53 Hz)
000000r 2               SID_NOTE_C6         = $4495              ; ~1047 Hz
000000r 2               SID_NOTE_CS6        = $48A9              ; ~1109 Hz
000000r 2               SID_NOTE_Db6        = SID_NOTE_CS6
000000r 2               SID_NOTE_D6         = $4CFC              ; ~1175 Hz
000000r 2               SID_NOTE_DS6        = $518F              ; ~1245 Hz
000000r 2               SID_NOTE_Eb6        = SID_NOTE_DS6
000000r 2               SID_NOTE_E6         = $5669              ; ~1319 Hz
000000r 2               SID_NOTE_F6         = $5B8C              ; ~1397 Hz
000000r 2               SID_NOTE_FS6        = $60FE              ; ~1480 Hz
000000r 2               SID_NOTE_Gb6        = SID_NOTE_FS6
000000r 2               SID_NOTE_G6         = $66C2              ; ~1568 Hz
000000r 2               SID_NOTE_GS6        = $6CDF              ; ~1661 Hz
000000r 2               SID_NOTE_Ab6        = SID_NOTE_GS6
000000r 2               SID_NOTE_A6         = $7358              ; ~1760 Hz
000000r 2               SID_NOTE_AS6        = $7A34              ; ~1865 Hz
000000r 2               SID_NOTE_Bb6        = SID_NOTE_AS6
000000r 2               SID_NOTE_B6         = $8178              ; ~1976 Hz
000000r 2               
000000r 2               ; Octave 7 (C7=2093.00 Hz .. A7=3520.00 Hz; B7 overflows 16-bit register)
000000r 2               SID_NOTE_C7         = $892B              ; ~2093 Hz
000000r 2               SID_NOTE_CS7        = $9153              ; ~2217 Hz
000000r 2               SID_NOTE_Db7        = SID_NOTE_CS7
000000r 2               SID_NOTE_D7         = $99F7              ; ~2349 Hz
000000r 2               SID_NOTE_DS7        = $A31F              ; ~2489 Hz
000000r 2               SID_NOTE_Eb7        = SID_NOTE_DS7
000000r 2               SID_NOTE_E7         = $ACD2              ; ~2637 Hz
000000r 2               SID_NOTE_F7         = $B719              ; ~2794 Hz
000000r 2               SID_NOTE_FS7        = $C1FC              ; ~2960 Hz
000000r 2               SID_NOTE_Gb7        = SID_NOTE_FS7
000000r 2               SID_NOTE_G7         = $CD85              ; ~3136 Hz
000000r 2               SID_NOTE_GS7        = $D9BD              ; ~3322 Hz
000000r 2               SID_NOTE_Ab7        = SID_NOTE_GS7
000000r 2               SID_NOTE_A7         = $E6B0              ; ~3520 Hz
000000r 2               SID_NOTE_AS7        = $F467              ; ~3729 Hz
000000r 2               SID_NOTE_Bb7        = SID_NOTE_AS7
000000r 2               ; Note: B7 (~3951 Hz = $102F0) exceeds the 16-bit SID register — not defined
000000r 2               
000000r 2               ; --- Video Card (6502-PICOVDP) (IO 8: $9C00-$9C03) ---
000000r 2               ;   Two complete, independent port pairs.  Each has its own VRAM pointer,
000000r 2               ;   read-ahead byte, command flip-flop and status selector; both reach the
000000r 2               ;   same 64 KB of VRAM and the same registers (VBANK and VINC included).
000000r 2               ;   Use port A in foreground code and port B in interrupt handlers, and a
000000r 2               ;   handler never breaks a command pair half written — no sei/cli needed
000000r 2               ;   around VDP work.  A handler that writes VBANK or VINC puts them back.
000000r 2               ;
000000r 2               ;   The command protocol is the TMS9918's, on either port: two writes to the
000000r 2               ;   command port, a payload byte P and then a command byte C.
000000r 2               ;     Register write:    P = value,       C = VC_REG_WRITE  | register (0-127)
000000r 2               ;     VRAM write addr:   P = address low, C = VC_ADDR_WRITE | address bits 13:8
000000r 2               ;     VRAM read addr:    P = address low, C = address bits 13:8 (prefetches)
000000r 2               ;   Address bits 15:14 come from VBANK.  After each VC_DATA access the pointer
000000r 2               ;   moves by VINC (reset +1), carrying into the bank bits.
000000r 2               ;   Reading a status port returns the status register its STATSEL names, and
000000r 2               ;   resets that pair's flip-flop — read status once to resynchronize.
000000r 2               VC_DATA             := $9C00             ; R/W — Port A VRAM data (pointer advances by VINC)
000000r 2               VC_REG              := $9C01             ; Write — Port A command (register / address)
000000r 2               VC_STATUS           := $9C01             ; Read — Port A status (register named by STATSEL_A)
000000r 2               VC_DATA2            := $9C02             ; R/W — Port B VRAM data (for interrupt handlers)
000000r 2               VC_REG2             := $9C03             ; Write — Port B command
000000r 2               VC_STATUS2          := $9C03             ; Read — Port B status (register named by STATSEL_B)
000000r 2               
000000r 2               ; Command byte bits (second write to VC_REG / VC_REG2):
000000r 2               VC_REG_WRITE        = $80                ; %1rrrrrrr — write register r with the payload
000000r 2               VC_ADDR_WRITE       = $40                ; %01aaaaaa — set the VRAM pointer for writing
000000r 2                                                        ; %00aaaaaa — set it for reading (no bit to OR in)
000000r 2               
000000r 2               ; Register numbers (write-only; read state back through the status registers).
000000r 2               ;   Registers $02-$06 are aliases of L0NAME, L0ATTR, L0PAT, SPRATTR and SPRPAT,
000000r 2               ;   so a TMS9918 program's writes to registers 2-6 reach them.  The names
000000r 2               ;   below are the block addresses; the aliases get no names of their own.
000000r 2               ; $00-$07 — Legacy core
000000r 2               VC_REG_MODE0        = $00                ; b1 M3 (see VC_MODE0_*)
000000r 2               VC_REG_MODE1        = $01                ; DISP, IE, M1, M2, SPRSIZE, SPRMAG (see VC_MODE1_*)
000000r 2               VC_REG_COLOR        = $07                ; b7:4 default foreground, b3:0 backdrop/border
000000r 2               ; $08-$0F — Access and interrupts
000000r 2               VC_REG_VBANK        = $08                ; VRAM address bits 15:14 (b1:0), sampled by an address command
000000r 2               VC_REG_VINC         = $09                ; Pointer stride, signed -128..+127 ($00 = none; reset $01)
000000r 2               VC_REG_IRQEN        = $0A                ; Interrupt enables (see VC_IRQ_*)
000000r 2               VC_REG_IRQLINE      = $0B                ; Scanline compare, display line 0-255
000000r 2               VC_REG_PALBASE      = $0C                ; Palette base, b5:0 × $400 (reset $3F = VC_PALETTE)
000000r 2               VC_REG_VMODE        = $0D                ; Display mode (see VC_VMODE_*)
000000r 2               VC_REG_STATSEL_B    = $0E                ; Status register port B reads (0-15)
000000r 2               VC_REG_STATSEL_A    = $0F                ; Status register port A reads (0-15)
000000r 2               ; $10-$17 — Layer 0
000000r 2               VC_REG_L0NAME       = $10                ; Name table base, × $400 (alias $02)
000000r 2               VC_REG_L0ATTR       = $11                ; Attribute table base, × $400 (alias $03)
000000r 2               VC_REG_L0PAT        = $12                ; Pattern table base, × $800 (alias $04)
000000r 2               VC_REG_L0SCRX       = $13                ; Horizontal scroll, bits 7:0 (bit 8 is VC_LCTRL_SCRX8)
000000r 2               VC_REG_L0SCRY       = $14                ; Vertical scroll, pixels
000000r 2               VC_REG_L0CTRL       = $15                ; Depth, attribute source, enable, opacity (see VC_LCTRL_*; reset $3C)
000000r 2               VC_REG_L0PAL        = $16                ; b3:0 palette group high bits
000000r 2               ; $18-$1F — Layer 1 (reset: disabled, index 0 transparent)
000000r 2               VC_REG_L1NAME       = $18                ; Name table base, × $400
000000r 2               VC_REG_L1ATTR       = $19                ; Attribute table base, × $400
000000r 2               VC_REG_L1PAT        = $1A                ; Pattern table base, × $800
000000r 2               VC_REG_L1SCRX       = $1B                ; Horizontal scroll, bits 7:0 (bit 8 is VC_LCTRL_SCRX8)
000000r 2               VC_REG_L1SCRY       = $1C                ; Vertical scroll, pixels
000000r 2               VC_REG_L1CTRL       = $1D                ; As L0CTRL (reset $0C)
000000r 2               VC_REG_L1PAL        = $1E                ; b3:0 palette group high bits
000000r 2               ; $20-$27 — Sprites
000000r 2               VC_REG_SPRATTR      = $20                ; Sprite attribute table base, × $80 (alias $05)
000000r 2               VC_REG_SPRPAT       = $21                ; Sprite pattern table base, × $800 (alias $06)
000000r 2               VC_REG_SPRCOUNT     = $22                ; Active sprite slots, 0-64 (reset 32)
000000r 2               VC_REG_SPRCTRL      = $23                ; Enable, collision, $D0 terminator, depth (see VC_SPRCTRL_*; reset $27)
000000r 2               VC_REG_SPRLIMIT     = $24                ; Sprites drawn per scanline, 1-32 (reset 16)
000000r 2               VC_REG_SPRPAL       = $25                ; b3:0 palette group high bits for sprites
000000r 2               ; $28-$7F — Font, and reserved ($28-$2F are reserved for a blitter)
000000r 2               VC_REG_FONT         = $30                ; Load a built-in font: b7 layer, b6:0 font ID (see VC_FONT_*)
000000r 2               ; $17, $1F, $26-$27, $28-$2F and $31-$7F are reserved: write 0.
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 6: USEFUL CONSTANTS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- BIOS Version ---
000000r 2               BIOS_VERSION_MAJOR  = 2
000000r 2               BIOS_VERSION_MINOR  = 1
000000r 2               
000000r 2               ; --- NVRAM Save Slots (v1.6) ---
000000r 2               NV_SLOTS            = 16                 ; Save slots in RTC NVRAM
000000r 2               NV_SLOT_SIZE        = 16                 ; Bytes per slot (slot n at NVRAM n*16)
000000r 2               NV_SLOT_DATA        = 14                 ; Payload bytes per slot
000000r 2               NV_CK_SEED          = $A6                ; Checksum seed
000000r 2               NV_EMPTY            = 0                  ; NvStat: slot is free
000000r 2               NV_VALID            = 1                  ; NvStat: owner ID set, checksum agrees
000000r 2               NV_BAD              = 2                  ; NvStat: owner ID set, checksum does not
000000r 2               
000000r 2               ; --- ASCII Control Characters ---
000000r 2               CHAR_BEL            = $07                ; Bell (Beep via SID)
000000r 2               CHAR_BS             = $08                ; Backspace (cursor left + erase in video mode)
000000r 2               CHAR_LF             = $0A                ; Line Feed (cursor down, scroll if at bottom)
000000r 2               CHAR_CR             = $0D                ; Carriage Return (cursor to column 0)
000000r 2               CHAR_ESC            = $1B                ; Escape
000000r 2               CHAR_SPACE          = $20                ; Space
000000r 2               
000000r 2               ; --- Video Dimensions (Text mode) ---
000000r 2               ;   The text console's layout, which the PICOVDP's Text mode keeps.
000000r 2               VID_COLS            = 40                 ; Screen width in columns
000000r 2               VID_ROWS            = 24                 ; Screen height in rows
000000r 2               VID_NAME_TABLE      = $0000              ; VRAM address of name table (40×24 = 960 bytes; L0NAME = $00)
000000r 2               VID_ATTR_TABLE      = $0400              ; VRAM address of attribute table (960 bytes, fg<<4 | bg; L0ATTR = $01)
000000r 2               VID_PATTERN_TABLE   = $0800              ; VRAM address of pattern/character table (2048 bytes; L0PAT = $01)
000000r 2               
000000r 2               ; --- 6502-PICOVDP: MODE0 / MODE1 bits ---
000000r 2               ;   M1, M2 and M3 select the display mode only while VMODE is VC_VMODE_LEGACY.
000000r 2               VC_MODE0_M3         = %00000010          ; M3 legacy mode select
000000r 2               VC_MODE1_DISP       = %01000000          ; Display enable (clear: backdrop only)
000000r 2               VC_MODE1_IE         = %00100000          ; Vertical blank IRQ enable (alias of VC_IRQ_VBLANK in IRQEN)
000000r 2               VC_MODE1_M1         = %00010000          ; M1 legacy mode select (Text)
000000r 2               VC_MODE1_M2         = %00001000          ; M2 legacy mode select
000000r 2               VC_MODE1_SPRSIZE    = %00000010          ; Sprite size: 0 = 8×8, 1 = 16×16
000000r 2               VC_MODE1_SPRMAG     = %00000001          ; Magnify sprites ×2
000000r 2               
000000r 2               ; --- 6502-PICOVDP: VMODE values ---
000000r 2               VC_VMODE_LEGACY     = $0                 ; M1/M2/M3 select the mode (reset); $5-$F behave as $0
000000r 2               VC_VMODE_TEXT       = $1                 ; 40×24 cells of 6×8, 240×192
000000r 2               VC_VMODE_COMPACT    = $2                 ; 32×24 cells of 8×8, 256×192
000000r 2               VC_VMODE_GRAPHICS   = $3                 ; 32×30 cells of 8×8, 256×240
000000r 2               VC_VMODE_FULL       = $4                 ; 40×30 cells of 8×8, 320×240, no border
000000r 2               
000000r 2               ; --- 6502-PICOVDP: L0CTRL / L1CTRL bits ---
000000r 2               ;   Pick one depth and one attribute source, then OR in the flags.
000000r 2               VC_LCTRL_1BPP       = $00                ; b1:0 bit depth — 8 bytes per tile
000000r 2               VC_LCTRL_2BPP       = $01                ;   16 bytes per tile
000000r 2               VC_LCTRL_4BPP       = $02                ;   32 bytes per tile
000000r 2               VC_LCTRL_8BPP       = $03                ;   64 bytes per tile
000000r 2               VC_LCTRL_ATTR_CELL  = $00                ; b3:2 attribute source — one byte per cell at LxATTR + cell
000000r 2               VC_LCTRL_ATTR_GROUP = $04                ;   one byte per 8 patterns at LxATTR + (pattern >> 3)
000000r 2               VC_LCTRL_ATTR_ROW   = $08                ;   one byte per pattern row at LxATTR + pattern × 8 + row
000000r 2               VC_LCTRL_ATTR_NONE  = $0C                ;   no attribute fetch
000000r 2               VC_LCTRL_ENABLE     = $10                ; b4 layer enable
000000r 2               VC_LCTRL_OPAQUE     = $20                ; b5 index 0 opaque
000000r 2               VC_LCTRL_SCRX8      = $40                ; b6 horizontal scroll bit 8 (Full mode's 320 pixels)
000000r 2               
000000r 2               ; --- 6502-PICOVDP: attribute byte (layers at 2/4/8bpp, and sprites) ---
000000r 2               ;   At 1bpp a layer's colour byte is foreground (b7:4) and background (b3:0).
000000r 2               VC_ATTR_SUBPAL      = $0F                ; b3:0 sub-palette (ignored by an 8bpp layer)
000000r 2               VC_ATTR_FLIPH       = $10                ; b4 flip horizontally
000000r 2               VC_ATTR_FLIPV       = $20                ; b5 flip vertically
000000r 2               VC_ATTR_PRIORITY    = $40                ; b6 priority (layer tile in front of sprites; sprite in front of layer 1)
000000r 2               VC_ATTR_BIT8        = $80                ; b7 layer: pattern index bit 8 (2/4bpp); sprite: X bit 8
000000r 2               
000000r 2               ; --- 6502-PICOVDP: SPRCTRL bits ---
000000r 2               VC_SPRCTRL_ENABLE   = $01                ; b0 sprites enable
000000r 2               VC_SPRCTRL_COLLIDE  = $02                ; b1 collision detection enable
000000r 2               VC_SPRCTRL_TERM     = $04                ; b2 a Y of VC_SPRITE_END ends the sprite list
000000r 2               VC_SPRCTRL_DETAIL   = $08                ; b3 detailed collision map (STAT8-STAT15)
000000r 2               VC_SPRCTRL_1BPP     = $00                ; b5:4 sprite bit depth
000000r 2               VC_SPRCTRL_2BPP     = $10
000000r 2               VC_SPRCTRL_4BPP     = $20
000000r 2               VC_SPRCTRL_8BPP     = $30
000000r 2               
000000r 2               ; --- 6502-PICOVDP: interrupt sources (IRQEN bits, latched in STAT1) ---
000000r 2               VC_IRQ_VBLANK       = $01                ; b0 end of the active picture, once a frame
000000r 2               VC_IRQ_SCANLINE     = $02                ; b1 display line matches IRQLINE
000000r 2               VC_IRQ_OVERFLOW     = $04                ; b2 a sprite was dropped, at most once a frame
000000r 2               VC_IRQ_COLLISION    = $08                ; b3 two sprites collided, at most once a frame
000000r 2               
000000r 2               ; --- 6502-PICOVDP: status registers (values for STATSEL_A / STATSEL_B) ---
000000r 2               ;   Reading STAT0 clears its flags, STAT7, the collision map and the vblank,
000000r 2               ;   overflow and collision latches in STAT1.  Reading STAT1 clears only the
000000r 2               ;   STAT1 latches — so a handler on port B reads STAT1 and foreground code
000000r 2               ;   polling STAT0 on port A still sees F.  Read STAT7 and the collision map
000000r 2               ;   before STAT0.
000000r 2               VC_STAT0            = 0                  ; F, OVF, COL, first sprite dropped (TMS9918 status)
000000r 2               VC_STAT1            = 1                  ; Latched interrupt sources still enabled in IRQEN
000000r 2               VC_STAT2            = 2                  ; Current display line, low 8 bits
000000r 2               VC_STAT3            = 3                  ; Blanking (see VC_STAT3_*)
000000r 2               VC_STAT4            = 4                  ; Identification byte, VC_ID
000000r 2               VC_STAT5            = 5                  ; Firmware version, BCD (high nibble major, low nibble minor)
000000r 2               VC_STAT6            = 6                  ; Capabilities (see VC_CAP_*)
000000r 2               VC_STAT7            = 7                  ; Index (0-63) of the first sprite dropped on the latest overflowing line
000000r 2               VC_STAT_COLLIDE     = 8                  ; STAT8-STAT15: collision map, sprite s is bit s mod 8 of STAT(8 + s/8)
000000r 2               
000000r 2               VC_STAT0_F          = $80                ; A picture has ended (set whatever IRQEN holds)
000000r 2               VC_STAT0_OVF        = $40                ; A sprite has been dropped
000000r 2               VC_STAT0_COL        = $20                ; Two sprites have collided
000000r 2               VC_STAT0_SPRITE     = $1F                ; Low five bits of the first sprite dropped
000000r 2               
000000r 2               VC_STAT3_VBLANK     = $01                ; Vertical blanking (borders included)
000000r 2               VC_STAT3_HBLANK     = $02                ; Horizontal blanking (advisory)
000000r 2               
000000r 2               VC_ID               = $AC                ; STAT4 on a 6502-PICOVDP
000000r 2               
000000r 2               VC_CAP_LAYER2       = $01                ; STAT6 b0 two layers
000000r 2               VC_CAP_8BPP         = $02                ; STAT6 b1 8bpp layer
000000r 2               VC_CAP_FLIP         = $04                ; STAT6 b2 sprite flip
000000r 2               VC_CAP_SCROLL       = $08                ; STAT6 b3 hardware scroll
000000r 2               VC_CAP_SCANLINE     = $10                ; STAT6 b4 scanline IRQ
000000r 2               VC_CAP_VRAM64K      = $20                ; STAT6 b5 64 KB VRAM
000000r 2                                                        ; STAT6 b6 reserved (a blitter)
000000r 2               VC_CAP_FONT         = $80                ; STAT6 b7 built-in font: VC_REG_FONT and font $00, loaded at reset
000000r 2               
000000r 2               ; --- 6502-PICOVDP: FONT values ---
000000r 2               ;   Reset writes font VC_FONT_CP437 to $0800-$0FFF (VID_PATTERN_TABLE), so a
000000r 2               ;   program that selects Text and sets L0PAT = $01 finds it already there.
000000r 2               ;   InitVideo loads it again, and VdpLoadFont loads it for layer 0 and waits.
000000r 2               ;   A write to VC_REG_FONT loads a font into a layer's pattern table:
000000r 2               ;   OR a layer into a font ID, e.g. VC_FONT_LAYER1 | VC_FONT_CP437.
000000r 2               ;     * Every write is a command, even of the value already held.
000000r 2               ;     * The destination is LxPAT × $800, sampled at the write; a later write
000000r 2               ;       to L0PAT/L1PAT does not move a pending load.
000000r 2               ;     * A reserved font ID ($01-$7F) is stored and does nothing else.
000000r 2               ;     * One load is pending per layer; a second write for that layer replaces it.
000000r 2               ;     * The load completes at the line start where vertical blank fires, before
000000r 2               ;       VC_STAT0_F sets.  Until then the table keeps its old contents, and a
000000r 2               ;       write there is overwritten.  So: read STAT0 to clear F, write
000000r 2               ;       VC_REG_FONT, and wait for F before touching that range.
000000r 2               ;     * A reset cancels every pending load.
000000r 2               ;   Check VC_CAP_FONT in STAT6 first.
000000r 2               VC_FONT_LAYER0      = $00                ; b7 clear: layer 0's pattern table (L0PAT × $800)
000000r 2               VC_FONT_LAYER1      = $80                ; b7 set: layer 1's pattern table (L1PAT × $800)
000000r 2               VC_FONT_CP437       = $00                ; Font $00: CP437, 6×8, 2,048 bytes (glyph n at n × 8)
000000r 2               
000000r 2               ; --- 6502-PICOVDP: VRAM ---
000000r 2               VC_PALETTE          = $FC00              ; Palette at reset PALBASE: 256 entries of %0000RRRR, %GGGGBBBB
000000r 2               VC_SPRITE_END       = $D0                ; Sprite Y that ends the list while VC_SPRCTRL_TERM is set
000000r 2               
000000r 2               ; --- Colour Constants (palette row 0) ---
000000r 2               ;   The PICOVDP's default palette puts the sixteen TMS9918 colours in row 0
000000r 2               ;   at their TMS9918 indices, so these name the same colours they always did.
000000r 2               ;   At 1bpp they are the foreground and background nibbles, and for
000000r 2               ;   VideoSetColor (the pen; its background nibble is also the border).
000000r 2               ;   Index 0 is transparent unless the layer is opaque.
000000r 2               ;   Pass as: (foreground << 4) | background
000000r 2               ;   Example: white on black = $F0, green on black = $20
000000r 2               TMS_TRANSPARENT     = $0
000000r 2               TMS_BLACK           = $1
000000r 2               TMS_MED_GREEN       = $2
000000r 2               TMS_LT_GREEN        = $3
000000r 2               TMS_DK_BLUE         = $4
000000r 2               TMS_LT_BLUE         = $5
000000r 2               TMS_DK_RED          = $6
000000r 2               TMS_CYAN            = $7
000000r 2               TMS_MED_RED         = $8
000000r 2               TMS_LT_RED          = $9
000000r 2               TMS_DK_YELLOW       = $A
000000r 2               TMS_LT_YELLOW       = $B
000000r 2               TMS_DK_GREEN        = $C
000000r 2               TMS_MAGENTA         = $D
000000r 2               TMS_GRAY            = $E
000000r 2               TMS_WHITE           = $F
000000r 2               
000000r 1               .include "src/zeropage.inc"
000000r 2               ; =============================================================================
000000r 2               ;   zeropage.inc - constants, zero page and RAM layout for HexFleet
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- Game ---
000000r 2               NUM_SHIPS     = 4          ; the most ships in a battle; N_SHIPS is how many are
000000r 2               MOVE_RANGE    = 3          ; hexes a ship may move in a turn
000000r 2               TICKS         = 64         ; a turn is 64 ticks; ships glide across all of them
000000r 2               CHARGE_TICKS  = 16         ; a laser charges for the first quarter, then burns
000000r 2               EXTRA_TICKS   = 48         ; at most this many more for torpedoes and wrecks
000000r 2               FRAMES_A_TICK = 2
000000r 2               TORP_SPEED    = 240        ; x 4 = 960: 3.75 pixels a tick (3 hexes a step)
000000r 2               HEX_PIXELS    = 20         ; center to center along a row
000000r 2               SHIP_REACH    = 8          ; how near a beam's line must pass to touch a ship
000000r 2               TORP_REACH_SQ = 100        ; a torpedo touches inside 10 pixels (squared)
000000r 2               BEAM_STOP_SQ  = 64         ; a beam is drawn up to 8 pixels from its target
000000r 2               HALF_TURN     = 31         ; the tick jumps land and new mines arm
000000r 2               LAST_TICK     = TICKS - 1  ; the tick flak shells burst
000000r 2               
000000r 2               ; --- Specials, numbered like the factions that have them ---
000000r 2               SP_FLAK       = 0
000000r 2               SP_MINE       = 1
000000r 2               SP_CLOAK      = 2
000000r 2               SP_JUMP       = 3
000000r 2               FLAK_RANGE    = 5
000000r 2               JUMP_RANGE    = 6
000000r 2               FLAK_DAMAGE   = 45
000000r 2               MINE_DAMAGE   = 25
000000r 2               SHOCK_DAMAGE  = 20
000000r 2               RAM_DAMAGE    = 40
000000r 2               RAM_RECOIL    = 20
000000r 2               AREA_REACH    = 25         ; a blast catches a ship centered this near
000000r 2               AREA_REACH_SQ = 625
000000r 2               MINE_LIMIT    = 3          ; each
000000r 2               NUM_MINES     = 12
000000r 2               NUM_FX        = 4          ; blast rings at once
000000r 2               FX_STEP       = 5          ; ticks at each of a ring's three sizes
000000r 2               RING_POINTS   = 32
000000r 2               TORP_SHELL    = 2          ; TORP_ON: a flak shell, not a torpedo
000000r 2               VIEW_NONE     = $FF        ; VIEWER: nobody's hidden things show
000000r 2               VIEW_ALL      = $FE        ; the battle's over: everyone's do
000000r 2               AI_HURT       = 31         ; under this hull a CPU Wraith jumps away
000000r 2               
000000r 2               ; --- Screen: Full mode, 40 x 30 cells of 8 x 8 ---
000000r 2               BOARD_X       = 4          ; the board's top-left pixel
000000r 2               BOARD_Y       = 5
000000r 2               BOARD_RIGHT   = BOARD_X + 220
000000r 2               BOARD_BOTTOM  = BOARD_Y + 230
000000r 2               ROWS          = 15         ; rows 0..14; even rows hold 10 hexes, odd rows 11
000000r 2               BOARD_CELLS   = 29         ; layer 1 columns over the board
000000r 2               
000000r 2               PANEL_COL     = 29         ; the panel's first column
000000r 2               PANEL_W       = 11         ; its width in characters
000000r 2               
000000r 2               ROW_TURN      = 1
000000r 2               ROW_NAME0     = 3          ; a ship's name, then its hull bar on the next row
000000r 2               ROW_MSG1      = 11
000000r 2               ROW_MSG2      = 13
000000r 2               ROW_MSG3      = 14
000000r 2               ROW_MSG4      = 16
000000r 2               ROW_MSG5      = 17
000000r 2               ROW_MSG6      = 19
000000r 2               ROW_MSG7      = 21
000000r 2               ROW_MUSIC     = 13         ; title: the music setting
000000r 2               ROW_READY     = 12         ; a linked game: the other side has locked in
000000r 2               ROW_MODE      = 1          ; title: the kind of battle
000000r 2               ROW_SEATS     = 3          ; title: a row for each seat, 3..6
000000r 2               ROW_TIP0      = 8          ; title: the picked seat's ship
000000r 2               ROW_TIP1      = 9         ; title: the selected seat's special
000000r 2               ROW_TIP2      = 10
000000r 2               ROW_TIP3      = 11
000000r 2               ROW_SCORES    = 15         ; the high scores: a heading and 5 rows
000000r 2               ROW_HELP1     = 22
000000r 2               ROW_HELP2     = 23
000000r 2               ROW_HELP3     = 25
000000r 2               BAND_ROW      = 12         ; the band behind big text
000000r 2               BAND_ROWS     = 5
000000r 2               
000000r 2               ; --- Video memory (all below $4000 except what's loaded once) ---
000000r 2               V_L0NAME      = $0000
000000r 2               V_L1NAME      = $0800
000000r 2               V_L1ATTR      = $1000
000000r 2               V_SPRATTR     = $1600
000000r 2               V_L1PAT       = $2000
000000r 2               V_L0PAT       = $3800
000000r 2               V_FONT        = $1800      ; the card's font, 1 bit a pixel, read to build the text
000000r 2               V_POOL        = V_L1PAT + 128 * 16  ; layer 1 patterns the canvas draws in
000000r 2               POOL_TILES    = 255        ; how many: patterns 128..382
000000r 2               
000000r 2               ; Layer 1's colors. Each is a 4-color sub-palette, number ink + 3: its value 1 is
000000r 2               ; the ink and value 3 the dark behind big text. Sub-palettes 4 and 14 are the canvas:
000000r 2               ; values 1 and 2 are ships 1 and 2, and value 3 is ship 3 in one and ship 4 in the
