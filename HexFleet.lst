000CB4r 2  CA             dex
000CB5r 2  10 FA          bpl @noFx
000CB7r 2  20 rr rr       jsr ShowFx
000CBAr 2  20 rr rr       jsr CanvasClear
000CBDr 2  A2 00          ldx #0
000CBFr 2               @settle:
000CBFr 2  BD 24 08       lda PLAN_C,x
000CC2r 2  9D 18 08       sta SHIP_C,x
000CC5r 2  BD 28 08       lda PLAN_R,x
000CC8r 2  9D 1C 08       sta SHIP_R,x
000CCBr 2  BD rr rr       lda SLOT_TORP_HIDE,x
000CCEr 2  DA             phx
000CCFr 2  AA             tax
000CD0r 2  20 rr rr       jsr HideSprite
000CD3r 2  FA             plx
000CD4r 2  BD rr rr       lda SLOT_EXPL_HIDE,x
000CD7r 2  DA             phx
000CD8r 2  AA             tax
000CD9r 2  20 rr rr       jsr HideSprite
000CDCr 2  FA             plx
000CDDr 2  20 rr rr       jsr DrawHpLine
000CE0r 2  E8             inx
000CE1r 2  E0 02          cpx #NUM_SHIPS
000CE3r 2  D0 DA          bne @settle
000CE5r 2  20 rr rr       jsr ShowBoard
000CE8r 2  4C rr rr       jmp UploadSprites
000CEBr 2               
000CEBr 2               SLOT_TORP_HIDE:
000CEBr 2  04 05 06 07    .byte SLOT_TORP, SLOT_TORP + 1, SLOT_TORP + 2, SLOT_TORP + 3
000CEFr 2               SLOT_EXPL_HIDE:
000CEFr 2  08 09 0A 0B    .byte SLOT_EXPL, SLOT_EXPL + 1, SLOT_EXPL + 2, SLOT_EXPL + 3
000CF3r 2               
000CF3r 2               ; StillBusy - Z clear while anything is left to finish.
000CF3r 2               StillBusy:
000CF3r 2  A2 01          ldx #NUM_SHIPS - 1
000CF5r 2               @loop:
000CF5r 2  BD 58 08       lda TORP_ON,x
000CF8r 2  1D 7C 08       ora TORP_FLASH,x
000CFBr 2  1D 8C 08       ora EXPL_T,x
000CFEr 2  D0 0F          bne @done
000D00r 2  CA             dex
000D01r 2  10 F2          bpl @loop
000D03r 2  A2 03          ldx #NUM_FX - 1
000D05r 2               @fx:
000D05r 2  BD D0 09       lda FX_T,x
000D08r 2  D0 05          bne @done
000D0Ar 2  CA             dex
000D0Br 2  10 F8          bpl @fx
000D0Dr 2  A9 00          lda #0
000D0Fr 2               @done:
000D0Fr 2  60             rts
000D10r 2               
000D10r 2               ; SetupShip - ship X's course, heading and shot. Keeps X.
000D10r 2               SetupShip:
000D10r 2  86 D5          stx TI
000D12r 2  20 rr rr       jsr ShipCenter
000D15r 2  A5 7F          lda HX
000D17r 2  9D 3C 08       sta POS_X_HI,x
000D1Ar 2  9E 38 08       stz POS_X_LO,x
000D1Dr 2  A5 80          lda HY
000D1Fr 2  9D 44 08       sta POS_Y_HI,x
000D22r 2  9E 40 08       stz POS_Y_LO,x
000D25r 2                 ; where it's going: velocity is the distance * 4 (64 ticks, 8.8 pixels)
000D25r 2  BC 28 08       ldy PLAN_R,x
000D28r 2  BD 24 08       lda PLAN_C,x
000D2Br 2  AA             tax
000D2Cr 2  20 rr rr       jsr HexCenter
000D2Fr 2  A6 D5          ldx TI
000D31r 2  A5 7F          lda HX
000D33r 2  38             sec
000D34r 2  FD 3C 08       sbc POS_X_HI,x
000D37r 2  85 C0          sta HDX
000D39r 2  A9 00          lda #0
000D3Br 2  E9 00          sbc #0
000D3Dr 2  85 C1          sta HDX+1
000D3Fr 2  A5 80          lda HY
000D41r 2  38             sec
000D42r 2  FD 44 08       sbc POS_Y_HI,x
000D45r 2  85 C2          sta HDY
000D47r 2  A9 00          lda #0
000D49r 2  E9 00          sbc #0
000D4Br 2  85 C3          sta HDY+1
000D4Dr 2  A5 C0          lda HDX
000D4Fr 2  85 40          sta T0
000D51r 2  A5 C1          lda HDX+1
000D53r 2  85 41          sta T1
000D55r 2  06 40          asl T0
000D57r 2  26 41          rol T1
000D59r 2  06 40          asl T0
000D5Br 2  26 41          rol T1
000D5Dr 2  A5 40          lda T0
000D5Fr 2  9D 48 08       sta VEL_X_LO,x
000D62r 2  A5 41          lda T1
000D64r 2  9D 4C 08       sta VEL_X_HI,x
000D67r 2  A5 C2          lda HDY
000D69r 2  85 40          sta T0
000D6Br 2  A5 C3          lda HDY+1
000D6Dr 2  85 41          sta T1
000D6Fr 2  06 40          asl T0
000D71r 2  26 41          rol T1
000D73r 2  06 40          asl T0
000D75r 2  26 41          rol T1
000D77r 2  A5 40          lda T0
000D79r 2  9D 50 08       sta VEL_Y_LO,x
000D7Cr 2  A5 41          lda T1
000D7Er 2  9D 54 08       sta VEL_Y_HI,x
000D81r 2  20 rr rr       jsr HeadingOf
000D84r 2  A6 D5          ldx TI
000D86r 2  C9 FF          cmp #$FF
000D88r 2  F0 03          beq @noTurn
000D8Ar 2  9D 20 08       sta SHIP_HEAD,x
000D8Dr 2               @noTurn:
000D8Dr 2  BD 84 09       lda PLAN_SPECIAL,x
000D90r 2  F0 0A          beq @aim
000D92r 2  BD 00 08       lda SHIP_FACTION,x
000D95r 2  C9 03          cmp #SP_JUMP
000D97r 2  D0 03          bne @aim
000D99r 2  20 rr rr       jsr StartJump
000D9Cr 2               @aim:
000D9Cr 2  BC 30 08       ldy AIM_R,x
000D9Fr 2  BD 2C 08       lda AIM_C,x
000DA2r 2  AA             tax
000DA3r 2  20 rr rr       jsr HexCenter
000DA6r 2  A6 D5          ldx TI
000DA8r 2  A5 7F          lda HX
000DAAr 2  9D 94 08       sta AIM_X,x
000DADr 2  A5 80          lda HY
000DAFr 2  9D 98 08       sta AIM_Y,x
000DB2r 2  BD 84 09       lda PLAN_SPECIAL,x
000DB5r 2  F0 0F          beq @shot
000DB7r 2  BD 00 08       lda SHIP_FACTION,x
000DBAr 2  D0 03          bne @notFlak
000DBCr 2  4C rr rr       jmp LaunchShell
000DBFr 2               @notFlak:
000DBFr 2  C9 01          cmp #SP_MINE
000DC1r 2  D0 13          bne @noShot                      ; a cloak or a jump takes the shot's place
000DC3r 2  20 rr rr       jsr LayMine
000DC6r 2               @shot:
000DC6r 2  BD 34 08       lda PLAN_WEAPON,x
000DC9r 2  D0 0C          bne LaunchTorpedo
000DCBr 2  A9 01          lda #1
000DCDr 2  9D 9C 08       sta FIRING,x
000DD0r 2  9E 80 08       stz BEAM_DX,x
000DD3r 2  9E 84 08       stz BEAM_DY,x
000DD6r 2               @noShot:
000DD6r 2  60             rts
000DD7r 2               
000DD7r 2               ; LaunchTorpedo - from where ship X starts, through its aim, 3.75 pixels a tick.
000DD7r 2               LaunchTorpedo:
000DD7r 2  20 rr rr       jsr AimVector
000DDAr 2  20 rr rr       jsr ScaleDir
000DDDr 2  08             php
000DDEr 2  A6 D5          ldx TI
000DE0r 2  28             plp
000DE1r 2  D0 01          bne @aimed
000DE3r 2  60             rts
000DE4r 2               @aimed:
000DE4r 2  20 rr rr       jsr DirLength
000DE7r 2  A5 90          lda DIRX
000DE9r 2  20 rr rr       jsr TorpSpeed
000DECr 2  A6 D5          ldx TI
000DEEr 2  A5 5B          lda QUOT
000DF0r 2  9D 6C 08       sta TORP_VX_LO,x
000DF3r 2  A5 5C          lda QUOT+1
000DF5r 2  9D 70 08       sta TORP_VX_HI,x
000DF8r 2  A5 91          lda DIRY
000DFAr 2  20 rr rr       jsr TorpSpeed
000DFDr 2  A6 D5          ldx TI
000DFFr 2  A5 5B          lda QUOT
000E01r 2  9D 74 08       sta TORP_VY_LO,x
000E04r 2  A5 5C          lda QUOT+1
000E06r 2  9D 78 08       sta TORP_VY_HI,x
000E09r 2  BD 3C 08       lda POS_X_HI,x
