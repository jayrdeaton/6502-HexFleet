000284r 2  85 78          sta TXT_INK
000286r 2  20 rr rr       jsr LineStart
000289r 2  A2 rr          ldx #<TxtTurn
00028Br 2  A0 rr          ldy #>TxtTurn
00028Dr 2  20 rr rr       jsr LineStr
