000EB8r 2  A9 0C          lda #ROW_TIP1
000EBAr 2  20 rr rr       jsr Print
000EBDr 2  A9 03          lda #INK_GRAY
000EBFr 2  85 78          sta TXT_INK
000EC1r 2  A4 AB          ldy MN_I
000EC3r 2  B9 rr rr       lda TipA+1,y
000EC6r 2  48             pha
000EC7r 2  B9 rr rr       lda TipA,y
000ECAr 2  AA             tax
000ECBr 2  7A             ply
000ECCr 2  A9 0D          lda #ROW_TIP2
000ECEr 2  20 rr rr       jsr Print
000ED1r 2  A4 AB          ldy MN_I
000ED3r 2  B9 rr rr       lda TipB+1,y
000ED6r 2  48             pha
000ED7r 2  B9 rr rr       lda TipB,y
000EDAr 2  AA             tax
000EDBr 2  7A             ply
000EDCr 2  A9 0E          lda #ROW_TIP3
000EDEr 2  4C rr rr       jmp Print
