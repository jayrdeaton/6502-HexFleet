0002CEr 2  F0 0E          beq @person
0002D0r 2  20 rr rr       jsr VsCpu
0002D3r 2  90 09          bcc @person
0002D5r 2  A9 41          lda #'A'                         ; "AI RAIDER"
0002D7r 2  20 rr rr       jsr LineChar
0002DAr 2  A9 49          lda #'I'
0002DCr 2  80 0A          bra @tag
0002DEr 2               @person:
0002DEr 2  A9 50          lda #'P'
0002E0r 2  20 rr rr       jsr LineChar
0002E3r 2  A5 D0          lda HPL_SHIP
0002E5r 2  18             clc
0002E6r 2  69 31          adc #'1'
0002E8r 2               @tag:
0002E8r 2  20 rr rr       jsr LineChar
0002EBr 2  A9 20          lda #' '
0002EDr 2  20 rr rr       jsr LineChar
0002F0r 2  A6 D0          ldx HPL_SHIP
0002F2r 2  20 rr rr       jsr AddShipName
0002F5r 2  A6 D0          ldx HPL_SHIP
0002F7r 2  20 rr rr       jsr ShipRow
0002FAr 2  20 rr rr       jsr LineShow
0002FDr 2  A6 D0          ldx HPL_SHIP
0002FFr 2  60             rts
000300r 2               
000300r 2               ; DrawHpLine - ship X's hull: a 7-cell bar and the number. Keeps X.
