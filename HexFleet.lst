00031Dr 2  A6 D0          ldx HPL_SHIP
00031Fr 2  BC 00 08       ldy SHIP_FACTION,x
000322r 2  B9 rr rr       lda MaxHull,y
000325r 2  85 5A          sta DIVISOR
000327r 2  20 rr rr       jsr Div16
00032Ar 2  A5 5B          lda QUOT
00032Cr 2  85 D2          sta HPL_W
00032Er 2  20 rr rr       jsr LineStart
000331r 2  A0 07          ldy #7
