001A1Cr 2  A2 rr          ldx #<TxtSaved
001A1Er 2  A0 rr          ldy #>TxtSaved
001A20r 2               @say:
001A20r 2  20 rr rr       jsr Print
001A23r 2  4C rr rr       jmp ShowOver
001A26r 2               @done:
001A26r 2  60             rts
001A27r 2               
001A27r 1               .include "src/link.asm"
001A27r 2               ; =============================================================================
001A27r 2               ;   link.asm - two machines, one battle, over the serial port
001A27r 2               ; =============================================================================
001A27r 2               ;   Each player plans on their own machine. Turns need no dice, so once both
001A27r 2               ;   machines hold both plans they each play the same turn and get the same
001A27r 2               ;   result, and only the plans cross the cable.
001A27r 2               ;
001A27r 2               ;   Everything is sent as 11-byte frames: $A5, type, turn, 6 bytes, a 2-byte check.
001A27r 2               ;   A frame that arrives damaged is dropped, and whatever it carried is sent
001A27r 2               ;   again until the other machine answers, so a noisy cable only costs time.
001A27r 2               ;     HELLO  finds the other machine: who it is, its ship, how far along it is.
001A27r 2               ;     PLAN   a turn's orders, and a checksum of the battle so far: two machines
001A27r 2               ;            that disagree stop and say so rather than play on.
001A27r 2               ;     ACK    that turn's plan arrived.
001A27r 2               ;   A machine plays the turn once it has the other's plan and knows its own got
001A27r 2               ;   through. Received bytes go into a ring from the interrupt (SysIrq, in
001A27r 2               ;   sound.asm), so nothing is lost while a turn is playing.
001A27r 2               ; =============================================================================
001A27r 2               
001A27r 2               .segment "CART"
001A27r 2               
001A27r 2               ; SerialQuiet - no serial interrupts: another machine calling must not reach the
001A27r 2               ; keyboard buffer while this one isn't linked.
001A27r 2               SerialQuiet:
001A27r 2  AD 0D 03       lda HW_PRESENT
001A2Ar 2  29 10          and #HW_SC
001A2Cr 2  F0 08          beq @done
001A2Er 2  AD 02 90       lda SC_CMD
001A31r 2  09 02          ora #SC_CMD_RXIRQ_OFF
001A33r 2  8D 02 90       sta SC_CMD
001A36r 2               @done:
001A36r 2  60             rts
001A37r 2               
001A37r 2               .segment "BANK00"
001610r 2               
001610r 2               FRAME_SYNC    = $A5
001610r 2               FRAME_SIZE    = 11
001610r 2               FR_HELLO      = 1
001610r 2               FR_PLAN       = 2
001610r 2               FR_ACK        = 3
001610r 2               LINK_VERSION  = 1
001610r 2               LINK_RESEND   = 20                 ; frames between tries
001610r 2               POLL_BYTES    = 40                 ; bytes handled a frame at most
001610r 2               BAD_SYNC      = 1                  ; LINK_BAD
001610r 2               BAD_VERSION   = 2
001610r 2               
001610r 2  4C 49 4E 4B  TxtLink:       .asciiz "LINK"
001614r 2  00           
001615r 2  20 4C 49 4E  TxtLinked:     .asciiz " LINKED"
001619r 2  4B 45 44 00  
00161Dr 2  4C 49 4E 4B  TxtLinking:    .asciiz "LINKING"
001621r 2  49 4E 47 00  
001625r 2  57 41 49 54  TxtWaitOther:  .asciiz "WAITING FOR"
001629r 2  49 4E 47 20  
00162Dr 2  46 4F 52 00  
001631r 2  4F 54 48 45  TxtOtherCart:  .asciiz "OTHER CART"
001635r 2  52 20 43 41  
001639r 2  52 54 00     
00163Cr 2  42 2F 58 3A  TxtQuit:       .asciiz "B/X: QUIT"
001640r 2  20 51 55 49  
001644r 2  54 00        
001646r 2  4E 4F 20 53  TxtNoSerial:   .asciiz "NO SERIAL"
00164Ar 2  45 52 49 41  
00164Er 2  4C 00        
001650r 2  4F 55 54 20  TxtOutOfSync:  .asciiz "OUT OF SYNC"
001654r 2  4F 46 20 53  
001658r 2  59 4E 43 00  
00165Cr 2  4F 54 48 45  TxtWrongCart:  .asciiz "OTHER BUILD"
001660r 2  52 20 42 55  
001664r 2  49 4C 44 00  
001668r 2  59 4F 55 52  TxtOrders:     .asciiz "YOUR ORDERS"
00166Cr 2  20 4F 52 44  
001670r 2  45 52 53 00  
001674r 2  4F 54 48 45  TxtOtherReady: .asciiz "OTHER READY"
001678r 2  52 20 52 45  
00167Cr 2  41 44 59 00  
001680r 2  59 4F 55 20  TxtYouLose:    .asciiz "YOU LOSE"
001684r 2  4C 4F 53 45  
001688r 2  00           
001689r 2               
001689r 2               ; IsLink - Z set in a linked game.
001689r 2               IsLink:
001689r 2  A5 E6          lda MODE
00168Br 2  C9 02          cmp #M_LINK
00168Dr 2  60             rts
00168Er 2               
00168Er 2               ; --- Starting and stopping ---
00168Er 2               
00168Er 2               LinkOn:
00168Er 2  78             sei
00168Fr 2  9C 00 0E       stz RX_HEAD
001692r 2  9C 01 0E       stz RX_TAIL
001695r 2  20 4E A0       jsr InitSC
001698r 2  58             cli
001699r 2  9C 12 0E       stz PARSE_N
00169Cr 2  9C 13 0E       stz LINK_UP
00169Fr 2  9C 14 0E       stz LINK_BAD
0016A2r 2  9C 0E 0E       stz HAVE_HELLO
0016A5r 2  9C 0F 0E       stz PEER_HAS
0016A8r 2  9C 15 0E       stz HAVE_PLAN
0016ABr 2  9C 16 0E       stz PEER_ACK
0016AEr 2  A9 01          lda #1
0016B0r 2  8D 04 0E       sta LINK_ON
0016B3r 2  AD D4 0C       lda CFG_FAC
0016B6r 2  8D 06 0E       sta MY_FACTION
0016B9r 2  8D 07 0E       sta TITLE_F
0016BCr 2  AD D5 0C       lda CFG_FAC+1
0016BFr 2  8D 08 0E       sta TITLE_F+1
0016C2r 2  60             rts
0016C3r 2               
0016C3r 2               ; LinkOff - back to a machine on its own, with the title's ships as they were.
0016C3r 2               LinkOff:
0016C3r 2  AD 04 0E       lda LINK_ON
0016C6r 2  F0 12          beq @done
0016C8r 2  9C 04 0E       stz LINK_ON
0016CBr 2  20 rr rr       jsr SerialQuiet
0016CEr 2  AD 07 0E       lda TITLE_F
0016D1r 2  8D D4 0C       sta CFG_FAC
0016D4r 2  AD 08 0E       lda TITLE_F+1
0016D7r 2  8D D5 0C       sta CFG_FAC+1
0016DAr 2               @done:
0016DAr 2  60             rts
0016DBr 2               
0016DBr 2               NewNonce:
0016DBr 2  20 rr rr       jsr Rnd
0016DEr 2  8D 09 0E       sta MY_NONCE
0016E1r 2  20 rr rr       jsr Rnd
0016E4r 2  8D 0A 0E       sta MY_NONCE+1
0016E7r 2  60             rts
0016E8r 2               
0016E8r 2               EnterLink:
0016E8r 2  AD 0D 03       lda HW_PRESENT
0016EBr 2  29 10          and #HW_SC
0016EDr 2  D0 07          bne @card
0016EFr 2  A2 rr          ldx #<TxtNoSerial
0016F1r 2  A0 rr          ldy #>TxtNoSerial
0016F3r 2  4C rr rr       jmp LinkFail
0016F6r 2               @card:
0016F6r 2  20 rr rr       jsr LinkOn
0016F9r 2  20 rr rr       jsr NewNonce
0016FCr 2  A9 06          lda #ST_LINK
0016FEr 2  85 6E          sta STATE
001700r 2  A9 01          lda #1
001702r 2  8D 10 0E       sta LINK_T
001705r 2  20 rr rr       jsr ClearMessages
001708r 2  A9 02          lda #INK_WHITE
00170Ar 2  85 78          sta TXT_INK
00170Cr 2  A9 0B          lda #ROW_MSG1
00170Er 2  A2 rr          ldx #<TxtLinking
001710r 2  A0 rr          ldy #>TxtLinking
001712r 2  20 rr rr       jsr Print
001715r 2  A9 03          lda #INK_GRAY
001717r 2  85 78          sta TXT_INK
001719r 2  A9 0D          lda #ROW_MSG2
00171Br 2  A2 rr          ldx #<TxtWaitOther
00171Dr 2  A0 rr          ldy #>TxtWaitOther
00171Fr 2  20 rr rr       jsr Print
001722r 2  A9 0E          lda #ROW_MSG3
001724r 2  A2 rr          ldx #<TxtOtherCart
001726r 2  A0 rr          ldy #>TxtOtherCart
001728r 2  20 rr rr       jsr Print
00172Br 2                 ; falls through
00172Br 2               
00172Br 2               PrintQuit:
00172Br 2  A9 03          lda #INK_GRAY
00172Dr 2  85 78          sta TXT_INK
00172Fr 2  A9 13          lda #ROW_MSG6
001731r 2  A2 rr          ldx #<TxtQuit
001733r 2  A0 rr          ldy #>TxtQuit
001735r 2  4C rr rr       jmp Print
001738r 2               
001738r 2               ; LinkFail - the message X (low), Y (high), and back to the menu from there.
001738r 2               LinkFail:
001738r 2  DA             phx
001739r 2  5A             phy
00173Ar 2  A9 04          lda #ST_OVER
00173Cr 2  85 6E          sta STATE
00173Er 2  20 rr rr       jsr SoundOff
001741r 2  20 rr rr       jsr HideMarkers
001744r 2  20 rr rr       jsr UploadSprites
001747r 2  20 rr rr       jsr CanvasClear
00174Ar 2  20 rr rr       jsr ClearMessages
00174Dr 2  A9 09          lda #INK_RED
00174Fr 2  85 78          sta TXT_INK
001751r 2  7A             ply
001752r 2  FA             plx
001753r 2  A9 0D          lda #ROW_MSG2
001755r 2  20 rr rr       jsr Print
001758r 2  A9 02          lda #INK_WHITE
00175Ar 2  85 78          sta TXT_INK
00175Cr 2  A9 0E          lda #ROW_MSG3
00175Er 2  A2 rr          ldx #<TxtFireMenu
001760r 2  A0 rr          ldy #>TxtFireMenu
001762r 2  4C rr rr       jmp Print
001765r 2               
001765r 2               LinkBroken:
001765r 2  AD 14 0E       lda LINK_BAD
001768r 2  C9 02          cmp #BAD_VERSION
00176Ar 2  F0 07          beq @version
00176Cr 2  A2 rr          ldx #<TxtOutOfSync
00176Er 2  A0 rr          ldy #>TxtOutOfSync
001770r 2  4C rr rr       jmp LinkFail
001773r 2               @version:
001773r 2  A2 rr          ldx #<TxtWrongCart
001775r 2  A0 rr          ldy #>TxtWrongCart
001777r 2  4C rr rr       jmp LinkFail
00177Ar 2               
00177Ar 2               ; --- Each frame ---
00177Ar 2               
00177Ar 2               LinkFrame:
00177Ar 2  20 rr rr       jsr LinkPoll
00177Dr 2  AD 14 0E       lda LINK_BAD
001780r 2  D0 E3          bne LinkBroken
001782r 2  AD 0E 0E       lda HAVE_HELLO
001785r 2  F0 05          beq @waiting
001787r 2  AD 0F 0E       lda PEER_HAS
00178Ar 2  D0 15          bne LinkGo
00178Cr 2               @waiting:
00178Cr 2  A5 6C          lda EV_SWAP
00178Er 2  F0 03          beq @timer
001790r 2  4C rr rr       jmp EnterTitle
001793r 2               @timer:
001793r 2  CE 10 0E       dec LINK_T
001796r 2  D0 08          bne @done
001798r 2  A9 14          lda #LINK_RESEND
00179Ar 2  8D 10 0E       sta LINK_T
00179Dr 2  4C rr rr       jmp SendHello
0017A0r 2               @done:
0017A0r 2  60             rts
0017A1r 2               
0017A1r 2               ; LinkGo - both machines know each other: the lower number takes the first seat.
0017A1r 2               LinkGo:
0017A1r 2  A9 01          lda #1
0017A3r 2  8D 13 0E       sta LINK_UP
0017A6r 2  A2 01          ldx #1
0017A8r 2  AD 09 0E       lda MY_NONCE
0017ABr 2  CD 0B 0E       cmp PEER_NONCE
0017AEr 2  AD 0A 0E       lda MY_NONCE+1
0017B1r 2  ED 0C 0E       sbc PEER_NONCE+1
0017B4r 2  B0 02          bcs @seat
0017B6r 2  A2 00          ldx #0
0017B8r 2               @seat:
0017B8r 2  8E 05 0E       stx MY_SEAT
0017BBr 2  AD 06 0E       lda MY_FACTION
0017BEr 2  9D D4 0C       sta CFG_FAC,x
0017C1r 2  8A             txa
0017C2r 2  49 01          eor #1
0017C4r 2  AA             tax
0017C5r 2  AD 0D 0E       lda PEER_FACTION
0017C8r 2  9D D4 0C       sta CFG_FAC,x
0017CBr 2  20 rr rr       jsr SendHello
0017CEr 2  4C rr rr       jmp StartBattle
0017D1r 2               
0017D1r 2               ; LinkNewTurn - nothing heard yet for this turn.
0017D1r 2               LinkNewTurn:
0017D1r 2  9C 15 0E       stz HAVE_PLAN
0017D4r 2  9C 16 0E       stz PEER_ACK
0017D7r 2  60             rts
0017D8r 2               
0017D8r 2               ; EnterLinkWait - orders are in: send them and wait for the other machine.
0017D8r 2               EnterLinkWait:
0017D8r 2  A9 07          lda #ST_WAIT
0017DAr 2  85 6E          sta STATE
0017DCr 2  20 rr rr       jsr HideMarkers
0017DFr 2  20 rr rr       jsr UploadSprites
0017E2r 2  20 rr rr       jsr CanvasClear
0017E5r 2  20 rr rr       jsr ClearMessages
0017E8r 2  A9 02          lda #INK_WHITE
0017EAr 2  85 78          sta TXT_INK
0017ECr 2  A9 0D          lda #ROW_MSG2
0017EEr 2  A2 rr          ldx #<TxtOrdersIn
0017F0r 2  A0 rr          ldy #>TxtOrdersIn
0017F2r 2  20 rr rr       jsr Print
0017F5r 2  A9 03          lda #INK_GRAY
0017F7r 2  85 78          sta TXT_INK
0017F9r 2  A9 0E          lda #ROW_MSG3
0017FBr 2  A2 rr          ldx #<TxtWaitOther
0017FDr 2  A0 rr          ldy #>TxtWaitOther
0017FFr 2  20 rr rr       jsr Print
001802r 2  A9 10          lda #ROW_MSG4
001804r 2  A2 rr          ldx #<TxtOtherCart
001806r 2  A0 rr          ldy #>TxtOtherCart
001808r 2  20 rr rr       jsr Print
00180Br 2  20 rr rr       jsr PrintQuit
00180Er 2  A9 14          lda #LINK_RESEND
001810r 2  8D 10 0E       sta LINK_T
001813r 2  4C rr rr       jmp SendPlan
001816r 2               
001816r 2               LinkWaitFrame:
001816r 2  20 rr rr       jsr LinkPoll
001819r 2  AD 14 0E       lda LINK_BAD
00181Cr 2  F0 03          beq @fine
00181Er 2  4C rr rr       jmp LinkBroken
001821r 2               @fine:
001821r 2  AD 15 0E       lda HAVE_PLAN
001824r 2  F0 35          beq @waiting
001826r 2  AD 16 0E       lda PEER_ACK
001829r 2  F0 30          beq @waiting
00182Br 2                 ; both machines have both plans
00182Br 2  AD 05 0E       lda MY_SEAT
00182Er 2  49 01          eor #1
001830r 2  AA             tax
001831r 2  AD 17 0E       lda PEER_PLAN
001834r 2  9D 24 08       sta PLAN_C,x
001837r 2  AD 18 0E       lda PEER_PLAN+1
00183Ar 2  9D 28 08       sta PLAN_R,x
00183Dr 2  AD 19 0E       lda PEER_PLAN+2
001840r 2  9D 2C 08       sta AIM_C,x
001843r 2  AD 1A 0E       lda PEER_PLAN+3
001846r 2  9D 30 08       sta AIM_R,x
001849r 2  AD 1B 0E       lda PEER_PLAN+4
00184Cr 2  29 01          and #1
00184Er 2  9D 34 08       sta PLAN_WEAPON,x
001851r 2  AD 1B 0E       lda PEER_PLAN+4
001854r 2  4A             lsr a
001855r 2  9D 84 09       sta PLAN_SPECIAL,x
001858r 2  4C rr rr       jmp PlayTurn
00185Br 2               @waiting:
00185Br 2  A5 6C          lda EV_SWAP
00185Dr 2  F0 03          beq @timer
00185Fr 2  4C rr rr       jmp EnterTitle
001862r 2               @timer:
001862r 2  CE 10 0E       dec LINK_T
001865r 2  D0 08          bne @done
001867r 2  A9 14          lda #LINK_RESEND
001869r 2  8D 10 0E       sta LINK_T
00186Cr 2  4C rr rr       jmp SendPlan
00186Fr 2               @done:
00186Fr 2  60             rts
001870r 2               
001870r 2               ; --- Sending ---
001870r 2               
001870r 2               ; SendFrame - TX_FRAME, with its sync and checksum.
001870r 2               SendFrame:
001870r 2  A9 A5          lda #FRAME_SYNC
001872r 2  8D 30 0E       sta TX_FRAME
001875r 2  A9 30          lda #<TX_FRAME
001877r 2  A2 0E          ldx #>TX_FRAME
001879r 2  20 rr rr       jsr FrameCheck
00187Cr 2  AD 1D 0E       lda CK_A
00187Fr 2  8D 39 0E       sta TX_FRAME + FRAME_SIZE - 2
001882r 2  AD 1E 0E       lda CK_B
001885r 2  8D 3A 0E       sta TX_FRAME + FRAME_SIZE - 1
001888r 2  A2 00          ldx #0
00188Ar 2               @send:
00188Ar 2  BD 30 0E       lda TX_FRAME,x
00188Dr 2  20 rr rr       jsr SendByte
001890r 2  E8             inx
001891r 2  E0 0B          cpx #FRAME_SIZE
001893r 2  D0 F5          bne @send
001895r 2  60             rts
001896r 2               
001896r 2               ; FrameCheck - CK_A, CK_B = the check of the frame at A (low), X (high). Two sums,
001896r 2               ; the second over the first, so a frame put together from the pieces of two
001896r 2               ; others, after a lost byte, doesn't pass by chance.
001896r 2               FrameCheck:
001896r 2  85 43          sta SV_PTR
001898r 2  86 44          stx SV_PTR+1
00189Ar 2  A9 5A          lda #$5A
00189Cr 2  8D 1D 0E       sta CK_A
00189Fr 2  A9 A5          lda #$A5
0018A1r 2  8D 1E 0E       sta CK_B
0018A4r 2  A0 01          ldy #1
0018A6r 2               @byte:
0018A6r 2  B1 43          lda (SV_PTR),y
0018A8r 2  18             clc
0018A9r 2  6D 1D 0E       adc CK_A
0018ACr 2  8D 1D 0E       sta CK_A
0018AFr 2  18             clc
0018B0r 2  6D 1E 0E       adc CK_B
0018B3r 2  8D 1E 0E       sta CK_B
0018B6r 2  C8             iny
0018B7r 2  C0 09          cpy #FRAME_SIZE - 2
0018B9r 2  D0 EB          bne @byte
0018BBr 2  60             rts
0018BCr 2               
0018BCr 2               ; SendByte - A out of the serial port, once the last byte has gone. Not the
0018BCr 2               ; Kernal's routine: while it waits it puts arriving bytes in the keyboard buffer,
0018BCr 2               ; where they'd read as key presses. Here they go in the ring. Keeps X.
0018BCr 2               SendByte:
0018BCr 2  48             pha
0018BDr 2  78             sei
0018BEr 2               @wait:
0018BEr 2  AD 01 90       lda SC_STATUS
0018C1r 2  8D 1C 0E       sta LINK_S
0018C4r 2  29 08          and #SC_STATUS_RDRF
0018C6r 2  F0 0E          beq @noByte
0018C8r 2  DA             phx
0018C9r 2  AD 00 90       lda SC_DATA
0018CCr 2  AE 00 0E       ldx RX_HEAD
0018CFr 2  9D 00 0D       sta RX_BUF,x
0018D2r 2  EE 00 0E       inc RX_HEAD
0018D5r 2  FA             plx
0018D6r 2               @noByte:
0018D6r 2  AD 1C 0E       lda LINK_S
0018D9r 2  29 10          and #SC_STATUS_TDRE
0018DBr 2  F0 E1          beq @wait
0018DDr 2  68             pla
0018DEr 2  8D 00 90       sta SC_DATA
0018E1r 2  58             cli
0018E2r 2  60             rts
0018E3r 2               
0018E3r 2               ; SendHello - who this machine is, and how far along: 0 looking, 1 has heard the
0018E3r 2               ; other machine, 2 has started.
0018E3r 2               SendHello:
0018E3r 2  A9 01          lda #FR_HELLO
0018E5r 2  8D 31 0E       sta TX_FRAME+1
0018E8r 2  9C 32 0E       stz TX_FRAME+2
0018EBr 2  AD 09 0E       lda MY_NONCE
0018EEr 2  8D 33 0E       sta TX_FRAME+3
0018F1r 2  AD 0A 0E       lda MY_NONCE+1
0018F4r 2  8D 34 0E       sta TX_FRAME+4
0018F7r 2  AD 06 0E       lda MY_FACTION
0018FAr 2  8D 35 0E       sta TX_FRAME+5
0018FDr 2  AD 13 0E       lda LINK_UP
001900r 2  F0 04          beq @notUp
001902r 2  A9 02          lda #2
001904r 2  80 03          bra @stage
001906r 2               @notUp:
001906r 2  AD 0E 0E       lda HAVE_HELLO
001909r 2               @stage:
001909r 2  8D 36 0E       sta TX_FRAME+6
00190Cr 2  A9 01          lda #LINK_VERSION
00190Er 2  8D 37 0E       sta TX_FRAME+7
001911r 2  9C 38 0E       stz TX_FRAME+8
001914r 2  4C rr rr       jmp SendFrame
001917r 2               
001917r 2               SendPlan:
001917r 2  AE 05 0E       ldx MY_SEAT
00191Ar 2  A9 02          lda #FR_PLAN
00191Cr 2  8D 31 0E       sta TX_FRAME+1
00191Fr 2  A5 73          lda TURN
001921r 2  8D 32 0E       sta TX_FRAME+2
001924r 2  BD 24 08       lda PLAN_C,x
001927r 2  8D 33 0E       sta TX_FRAME+3
00192Ar 2  BD 28 08       lda PLAN_R,x
00192Dr 2  8D 34 0E       sta TX_FRAME+4
001930r 2  BD 2C 08       lda AIM_C,x
001933r 2  8D 35 0E       sta TX_FRAME+5
001936r 2  BD 30 08       lda AIM_R,x
001939r 2  8D 36 0E       sta TX_FRAME+6
00193Cr 2  BD 84 09       lda PLAN_SPECIAL,x
00193Fr 2  0A             asl a
001940r 2  1D 34 08       ora PLAN_WEAPON,x
001943r 2  8D 37 0E       sta TX_FRAME+7
001946r 2  20 rr rr       jsr StateSum
001949r 2  8D 38 0E       sta TX_FRAME+8
00194Cr 2  4C rr rr       jmp SendFrame
00194Fr 2               
00194Fr 2               ; SendAck - turn A's plan arrived.
00194Fr 2               SendAck:
00194Fr 2  8D 32 0E       sta TX_FRAME+2
001952r 2  A9 03          lda #FR_ACK
001954r 2  8D 31 0E       sta TX_FRAME+1
001957r 2  A2 03          ldx #3
001959r 2               @clear:
001959r 2  9E 30 0E       stz TX_FRAME,x
00195Cr 2  E8             inx
00195Dr 2  E0 09          cpx #FRAME_SIZE - 2
00195Fr 2  D0 F8          bne @clear
001961r 2  4C rr rr       jmp SendFrame
001964r 2               
001964r 2               ; StateSum - A = a checksum of everything a turn is played from.
001964r 2               StateSum:
001964r 2  A9 00          lda #0
001966r 2  18             clc
001967r 2  A6 8E          ldx N_SHIPS
001969r 2  CA             dex
00196Ar 2               @ship:
00196Ar 2  7D 10 08       adc SHIP_HP_LO,x
00196Dr 2  7D 14 08       adc SHIP_HP_HI,x
001970r 2  7D 18 08       adc SHIP_C,x
001973r 2  7D 1C 08       adc SHIP_R,x
001976r 2  7D 0C 08       adc SHIP_ALIVE,x
001979r 2  7D 80 09       adc SPECIAL_WAIT,x
00197Cr 2  7D 88 09       adc CLOAKED,x
00197Fr 2  CA             dex
001980r 2  10 E8          bpl @ship
001982r 2  A2 0B          ldx #NUM_MINES - 1
001984r 2               @mine:
001984r 2  7D 60 0C       adc MINE_OWNER,x
001987r 2  7D 6C 0C       adc MINE_C,x
00198Ar 2  7D 78 0C       adc MINE_R,x
00198Dr 2  CA             dex
00198Er 2  10 F4          bpl @mine
001990r 2  60             rts
001991r 2               
001991r 2               ; --- Receiving ---
001991r 2               
001991r 2               ; LinkPoll - take what has arrived, a limited amount a frame.
001991r 2               LinkPoll:
001991r 2  AD 04 0E       lda LINK_ON
001994r 2  F0 3C          beq @done
001996r 2  A9 28          lda #POLL_BYTES
001998r 2  8D 11 0E       sta LINK_N
00199Br 2               @next:
00199Br 2  AE 01 0E       ldx RX_TAIL
00199Er 2  EC 00 0E       cpx RX_HEAD
0019A1r 2  F0 2F          beq @done
0019A3r 2  BD 00 0D       lda RX_BUF,x
0019A6r 2  EE 01 0E       inc RX_TAIL
0019A9r 2  AE 12 0E       ldx PARSE_N
0019ACr 2  D0 04          bne @inFrame
0019AEr 2  C9 A5          cmp #FRAME_SYNC
0019B0r 2  D0 1B          bne @count
0019B2r 2               @inFrame:
0019B2r 2  9D 20 0E       sta FRAME,x
0019B5r 2  E8             inx
0019B6r 2  8E 12 0E       stx PARSE_N
0019B9r 2  E0 0B          cpx #FRAME_SIZE
0019BBr 2  D0 10          bne @count
0019BDr 2  9C 12 0E       stz PARSE_N
0019C0r 2  20 rr rr       jsr FrameOk
0019C3r 2  90 05          bcc @damaged
0019C5r 2  20 rr rr       jsr TakeFrame
0019C8r 2  80 03          bra @count
0019CAr 2               @damaged:
0019CAr 2  20 rr rr       jsr Resync
0019CDr 2               @count:
0019CDr 2  CE 11 0E       dec LINK_N
0019D0r 2  D0 C9          bne @next
0019D2r 2               @done:
0019D2r 2  60             rts
0019D3r 2               
0019D3r 2               ; FrameOk - carry set if the frame that just came in passes its check.
0019D3r 2               FrameOk:
0019D3r 2  A9 20          lda #<FRAME
0019D5r 2  A2 0E          ldx #>FRAME
0019D7r 2  20 rr rr       jsr FrameCheck
0019DAr 2  AD 1D 0E       lda CK_A
0019DDr 2  CD 29 0E       cmp FRAME + FRAME_SIZE - 2
0019E0r 2  D0 0A          bne @bad
0019E2r 2  AD 1E 0E       lda CK_B
0019E5r 2  CD 2A 0E       cmp FRAME + FRAME_SIZE - 1
0019E8r 2  D0 02          bne @bad
0019EAr 2  38             sec
0019EBr 2  60             rts
0019ECr 2               @bad:
0019ECr 2  18             clc
0019EDr 2  60             rts
0019EEr 2               
0019EEr 2               ; Resync - a frame that failed its check starts again from the next sync byte
0019EEr 2               ; inside it. After a lost byte that's the start of the frame behind it, which
0019EEr 2               ; would otherwise be lost as well. A sync byte that turns out to be data fails
0019EEr 2               ; its check in turn and the search moves on.
0019EEr 2               Resync:
0019EEr 2  A2 01          ldx #1
0019F0r 2               @find:
0019F0r 2  BD 20 0E       lda FRAME,x
0019F3r 2  C9 A5          cmp #FRAME_SYNC
0019F5r 2  F0 06          beq @found
0019F7r 2  E8             inx
0019F8r 2  E0 0B          cpx #FRAME_SIZE
0019FAr 2  D0 F4          bne @find
0019FCr 2  60             rts                              ; none: wait for the next one
0019FDr 2               @found:
0019FDr 2  A0 00          ldy #0
0019FFr 2               @move:
0019FFr 2  BD 20 0E       lda FRAME,x
001A02r 2  99 20 0E       sta FRAME,y
001A05r 2  C8             iny
001A06r 2  E8             inx
001A07r 2  E0 0B          cpx #FRAME_SIZE
001A09r 2  D0 F4          bne @move
001A0Br 2  8C 12 0E       sty PARSE_N
001A0Er 2  60             rts
001A0Fr 2               
001A0Fr 2               ; TakeFrame - act on a frame that passed its check.
001A0Fr 2               TakeFrame:
001A0Fr 2  AD 21 0E       lda FRAME+1
001A12r 2  C9 01          cmp #FR_HELLO
001A14r 2  F0 69          beq TakeHello
001A16r 2  C9 02          cmp #FR_PLAN
001A18r 2  F0 11          beq TakePlan
001A1Ar 2  C9 03          cmp #FR_ACK
001A1Cr 2  D0 0C          bne @done
001A1Er 2  AD 22 0E       lda FRAME+2
001A21r 2  C5 73          cmp TURN
001A23r 2  D0 05          bne @done
001A25r 2  A9 01          lda #1
001A27r 2  8D 16 0E       sta PEER_ACK
001A2Ar 2               @done:
001A2Ar 2  60             rts
001A2Br 2               
001A2Br 2               TakePlan:
001A2Br 2  AD 13 0E       lda LINK_UP
001A2Er 2  F0 0C          beq @done
001A30r 2  AD 22 0E       lda FRAME+2
001A33r 2  C5 73          cmp TURN
001A35r 2  F0 06          beq @now
001A37r 2  1A             inc a                            ; last turn's, when our answer got lost
001A38r 2  C5 73          cmp TURN
001A3Ar 2  F0 3D          beq @answer
001A3Cr 2               @done:
001A3Cr 2  60             rts
001A3Dr 2               @now:
001A3Dr 2  A5 6E          lda STATE                        ; after the battle the state has moved on
001A3Fr 2  C9 04          cmp #ST_OVER
001A41r 2  F0 36          beq @answer
001A43r 2  20 rr rr       jsr StateSum
001A46r 2  CD 28 0E       cmp FRAME+8
001A49r 2  F0 06          beq @same
001A4Br 2  A9 01          lda #BAD_SYNC
001A4Dr 2  8D 14 0E       sta LINK_BAD
001A50r 2  60             rts
001A51r 2               @same:
001A51r 2  AD 15 0E       lda HAVE_PLAN
001A54r 2  D0 23          bne @answer
001A56r 2  A2 04          ldx #4
001A58r 2               @copy:
001A58r 2  BD 23 0E       lda FRAME+3,x
001A5Br 2  9D 17 0E       sta PEER_PLAN,x
001A5Er 2  CA             dex
001A5Fr 2  10 F7          bpl @copy
001A61r 2  A9 01          lda #1
001A63r 2  8D 15 0E       sta HAVE_PLAN
001A66r 2  A5 6E          lda STATE
001A68r 2  C9 02          cmp #ST_PLAN
001A6Ar 2  D0 0D          bne @answer
001A6Cr 2  A9 03          lda #INK_GRAY
001A6Er 2  85 78          sta TXT_INK
001A70r 2  A9 0C          lda #ROW_READY
001A72r 2  A2 rr          ldx #<TxtOtherReady
001A74r 2  A0 rr          ldy #>TxtOtherReady
001A76r 2  20 rr rr       jsr Print
001A79r 2               @answer:
001A79r 2  AD 22 0E       lda FRAME+2
001A7Cr 2  4C rr rr       jmp SendAck
001A7Fr 2               
001A7Fr 2               TakeHello:
001A7Fr 2  AD 27 0E       lda FRAME+7
001A82r 2  C9 01          cmp #LINK_VERSION
001A84r 2  F0 06          beq @version
001A86r 2  A9 02          lda #BAD_VERSION
001A88r 2  8D 14 0E       sta LINK_BAD
001A8Br 2  60             rts
001A8Cr 2               @version:
001A8Cr 2  AD 13 0E       lda LINK_UP
001A8Fr 2  F0 1A          beq @looking
001A91r 2                 ; already playing: it may not know yet
001A91r 2  AD 23 0E       lda FRAME+3
001A94r 2  CD 0B 0E       cmp PEER_NONCE
001A97r 2  D0 4E          bne @done
001A99r 2  AD 24 0E       lda FRAME+4
001A9Cr 2  CD 0C 0E       cmp PEER_NONCE+1
001A9Fr 2  D0 46          bne @done
001AA1r 2  AD 26 0E       lda FRAME+6
001AA4r 2  C9 02          cmp #2
001AA6r 2  B0 3F          bcs @done
001AA8r 2  4C rr rr       jmp SendHello
001AABr 2               @looking:
001AABr 2  AD 23 0E       lda FRAME+3
001AAEr 2  CD 09 0E       cmp MY_NONCE
001AB1r 2  D0 11          bne @other
001AB3r 2  AD 24 0E       lda FRAME+4
001AB6r 2  CD 0A 0E       cmp MY_NONCE+1
001AB9r 2  D0 09          bne @other
001ABBr 2  9C 0E 0E       stz HAVE_HELLO                   ; the same number: both pick again
001ABEr 2  9C 0F 0E       stz PEER_HAS
001AC1r 2  4C rr rr       jmp NewNonce
001AC4r 2               @other:
001AC4r 2  AD 23 0E       lda FRAME+3
001AC7r 2  8D 0B 0E       sta PEER_NONCE
001ACAr 2  AD 24 0E       lda FRAME+4
001ACDr 2  8D 0C 0E       sta PEER_NONCE+1
001AD0r 2  AD 25 0E       lda FRAME+5
001AD3r 2  29 03          and #3
001AD5r 2  8D 0D 0E       sta PEER_FACTION
001AD8r 2  A9 01          lda #1
001ADAr 2  8D 0E 0E       sta HAVE_HELLO
001ADDr 2  AD 26 0E       lda FRAME+6
001AE0r 2  F0 06          beq @answer
001AE2r 2  A9 01          lda #1
001AE4r 2  8D 0F 0E       sta PEER_HAS
001AE7r 2               @done:
001AE7r 2  60             rts
001AE8r 2               @answer:
001AE8r 2  4C rr rr       jmp SendHello
001AEBr 2               
001AEBr 1               .include "src/sound.asm"
001AEBr 2               ; =============================================================================
001AEBr 2               ;   sound.asm - sound effects and music on the SID
001AEBr 2               ; =============================================================================
001AEBr 2               ;   The HexFleet app's sounds and music, rebuilt for the SID's three voices
001AEBr 2               ;   (tools/build-sound.mjs holds them). Music plays on all three. An effect takes
001AEBr 2               ;   over voice 3, or voice 2 when it needs a second voice or 3 is busy with
001AEBr 2               ;   something that matters more, and the music picks the voice up again at its
001AEBr 2               ;   next note.
001AEBr 2               ;
001AEBr 2               ;   A timer interrupt runs SoundTick 60 times a second from bank 3, so the sound
001AEBr 2               ;   keeps time however busy the game is. The game only leaves requests in a queue.
001AEBr 2               ;   This fixed-bank half holds those calls and the interrupt handler.
001AEBr 2               ; =============================================================================
001AEBr 2               
001AEBr 2               .segment "CART"
001A37r 2               
001A37r 2               TIMER_FRAME   = 16600              ; a 60th of a second, less the time to restart it
001A37r 2               REQ_LASER_OFF = $F0
001A37r 2               REQ_ALL_OFF   = $F1
001A37r 2               SOUND_BANK    = 3
001A37r 2               
001A37r 2               ; SoundInit - silence, then start the timer and take over the interrupt.
001A37r 2               SoundInit:
001A37r 2  A2 6F          ldx #S_VARS_END - S_REG - 1
001A39r 2               @clear:
001A39r 2  9E 00 0F       stz S_REG,x
001A3Cr 2  CA             dex
001A3Dr 2  10 FA          bpl @clear
001A3Fr 2  64 D7          stz SND_LASER
001A41r 2  A9 0F          lda #15
001A43r 2  8D 32 0F       sta S_MASTER
001A46r 2  A9 01          lda #1
001A48r 2  8D 2D 0F       sta MUS_ON
001A4Br 2  AD 00 03       lda IRQ_PTR
001A4Er 2  8D 02 0E       sta OLD_IRQ
001A51r 2  AD 01 03       lda IRQ_PTR+1
001A54r 2  8D 03 0E       sta OLD_IRQ+1
001A57r 2  78             sei
001A58r 2  A9 rr          lda #<SysIrq
001A5Ar 2  8D 00 03       sta IRQ_PTR
001A5Dr 2  A9 rr          lda #>SysIrq
001A5Fr 2  8D 01 03       sta IRQ_PTR+1
001A62r 2  AD 0D 03       lda HW_PRESENT
001A65r 2  29 40          and #HW_SID
001A67r 2  F0 2B          beq @noSid
001A69r 2  A2 18          ldx #$18
001A6Br 2               @sid:
001A6Br 2  9E 00 98       stz SID_V1_FREQ_LO,x
001A6Er 2  CA             dex
001A6Fr 2  10 FA          bpl @sid
001A71r 2  AD 0D 03       lda HW_PRESENT
001A74r 2  29 20          and #HW_GPIO
001A76r 2  F0 1C          beq @noSid
001A78r 2  A9 01          lda #1
001A7Ar 2  8D 31 0F       sta S_ON
001A7Dr 2  AD 0B 94       lda GPIO_ACR
001A80r 2  29 DF          and #%11011111                   ; timer 2 counts clock cycles
001A82r 2  8D 0B 94       sta GPIO_ACR
001A85r 2  A9 A0          lda #GPIO_IER_SET | GPIO_INT_T2
001A87r 2  8D 0E 94       sta GPIO_IER
001A8Ar 2  A9 D8          lda #<TIMER_FRAME
001A8Cr 2  8D 08 94       sta GPIO_T2CL
001A8Fr 2  A9 40          lda #>TIMER_FRAME
001A91r 2  8D 09 94       sta GPIO_T2CH
001A94r 2               @noSid:
001A94r 2  58             cli
001A95r 2  60             rts
001A96r 2               
001A96r 2               ; SysIrq - the machine's interrupt handler from now on: serial bytes while linked,
001A96r 2               ; the keyboard as the Kernal handles it, and the sound timer. The sound runs with
001A96r 2               ; interrupts back on, so a long tick can't make the serial port lose a byte.
001A96r 2               SysIrq:
001A96r 2  48             pha
001A97r 2  DA             phx
001A98r 2  5A             phy
001A99r 2  BA             tsx
001A9Ar 2  BD 04 01       lda $104,x                       ; the saved flags: a BRK is the Kernal's
001A9Dr 2  29 10          and #$10
001A9Fr 2  D0 6C          bne @brk
001AA1r 2  AD 04 0E       lda LINK_ON
001AA4r 2  F0 13          beq @keys
001AA6r 2  AD 01 90       lda SC_STATUS
001AA9r 2  29 08          and #SC_STATUS_RDRF
001AABr 2  F0 0C          beq @keys
001AADr 2  AD 00 90       lda SC_DATA
001AB0r 2  AE 00 0E       ldx RX_HEAD
001AB3r 2  9D 00 0D       sta RX_BUF,x
001AB6r 2  EE 00 0E       inc RX_HEAD
001AB9r 2               @keys:
001AB9r 2  AD 0D 03       lda HW_PRESENT
001ABCr 2  29 20          and #HW_GPIO
001ABEr 2  F0 49          beq @exit
001AC0r 2  AD 0D 94       lda GPIO_IFR
001AC3r 2  29 10          and #GPIO_INT_CB1
001AC5r 2  F0 08          beq @ps2
001AC7r 2  AD 00 94       lda GPIO_PORTB
001ACAr 2  20 06 A0       jsr WriteBuffer
001ACDr 2  80 0D          bra @timer
001ACFr 2               @ps2:
001ACFr 2  AD 0D 94       lda GPIO_IFR
001AD2r 2  29 02          and #GPIO_INT_CA1
001AD4r 2  F0 06          beq @timer
001AD6r 2  AD 01 94       lda GPIO_PORTA
001AD9r 2  20 06 A0       jsr WriteBuffer
001ADCr 2               @timer:
001ADCr 2  AD 0D 94       lda GPIO_IFR
001ADFr 2  29 20          and #GPIO_INT_T2
001AE1r 2  F0 26          beq @exit
001AE3r 2  A9 D8          lda #<TIMER_FRAME
001AE5r 2  8D 08 94       sta GPIO_T2CL
001AE8r 2  A9 40          lda #>TIMER_FRAME
001AEAr 2  8D 09 94       sta GPIO_T2CH                    ; also clears the flag
001AEDr 2  AD 2A 0F       lda S_BUSY
001AF0r 2  D0 17          bne @exit                        ; the last tick is still running
001AF2r 2  EE 2A 0F       inc S_BUSY
001AF5r 2  A5 3A          lda BANKSHDW
001AF7r 2  48             pha
001AF8r 2  A9 03          lda #SOUND_BANK
001AFAr 2  8D 00 E0       sta BANK
001AFDr 2  58             cli
001AFEr 2  20 rr rr       jsr SoundTick
001B01r 2  78             sei
001B02r 2  68             pla
001B03r 2  8D 00 E0       sta BANK
001B06r 2  9C 2A 0F       stz S_BUSY
001B09r 2               @exit:
001B09r 2  7A             ply
001B0Ar 2  FA             plx
001B0Br 2  68             pla
001B0Cr 2  40             rti
001B0Dr 2               @brk:
001B0Dr 2  7A             ply
001B0Er 2  FA             plx
001B0Fr 2  68             pla
001B10r 2  6C 02 0E       jmp (OLD_IRQ)
001B13r 2               
001B13r 2               ; --- What the game calls. These keep X and Y. ---
001B13r 2               
001B13r 2               ; SoundRequest - leave request A for the next tick.
001B13r 2               SoundRequest:
001B13r 2  DA             phx
001B14r 2  AE 31 0F       ldx S_ON
001B17r 2  F0 10          beq @done
001B19r 2  AE 28 0F       ldx S_QH
001B1Cr 2  9D 20 0F       sta S_Q,x
001B1Fr 2  E8             inx
001B20r 2  E0 08          cpx #8
001B22r 2  90 02          bcc @stored
001B24r 2  A2 00          ldx #0
001B26r 2               @stored:
001B26r 2  8E 28 0F       stx S_QH
001B29r 2               @done:
001B29r 2  FA             plx
001B2Ar 2  60             rts
001B2Br 2               
001B2Br 2               .macro SOUND name, effect
001B2Br 2               name:
001B2Br 2                 lda #effect
001B2Br 2                 jmp SoundRequest
001B2Br 2               .endmacro
001B2Br 2               
001B2Br 2  A9 01 4C rr  SOUND SndPick, SFX_PRESS
001B2Fr 2  rr           
001B30r 2  A9 02 4C rr  SOUND SndBack, SFX_BACK
001B34r 2  rr           
001B35r 2  A9 03 4C rr  SOUND SndCommit, SFX_COMMIT
001B39r 2  rr           
001B3Ar 2  A9 04 4C rr  SOUND SndError, SFX_ERROR
001B3Er 2  rr           
001B3Fr 2  A9 07 4C rr  SOUND SndHit, SFX_HIT
001B43r 2  rr           
001B44r 2  A9 08 4C rr  SOUND SndTorpHit, SFX_TORPHIT
001B48r 2  rr           
001B49r 2  A9 0A 4C rr  SOUND SndBoom, SFX_BOOM
001B4Dr 2  rr           
001B4Er 2  A9 0C 4C rr  SOUND SndBlast, SFX_BLAST
001B52r 2  rr           
001B53r 2  A9 06 4C rr  SOUND SndTorpedo, SFX_TORPEDO
001B57r 2  rr           
001B58r 2  A9 0E 4C rr  SOUND SndThrust, SFX_THRUST
001B5Cr 2  rr           
001B5Dr 2  A9 0F 4C rr  SOUND SndWarp, SFX_JUMP
001B61r 2  rr           
001B62r 2  A9 10 4C rr  SOUND SndCloak, SFX_CLOAK
001B66r 2  rr           
001B67r 2  A9 11 4C rr  SOUND SndMine, SFX_MINE
001B6Br 2  rr           
001B6Cr 2               
001B6Cr 2               SndLaserOn:
001B6Cr 2  A5 D7          lda SND_LASER
001B6Er 2  D0 07          bne @done
001B70r 2  E6 D7          inc SND_LASER
001B72r 2  A9 05          lda #SFX_LASER
001B74r 2  4C rr rr       jmp SoundRequest
001B77r 2               @done:
001B77r 2  60             rts
001B78r 2               
001B78r 2               SndLaserOff:
001B78r 2  A5 D7          lda SND_LASER
001B7Ar 2  F0 07          beq @done
001B7Cr 2  64 D7          stz SND_LASER
001B7Er 2  A9 F0          lda #REQ_LASER_OFF
001B80r 2  4C rr rr       jmp SoundRequest
001B83r 2               @done:
001B83r 2  60             rts
001B84r 2               
001B84r 2               SoundOff:
001B84r 2  64 D7          stz SND_LASER
001B86r 2  A9 F1          lda #REQ_ALL_OFF
001B88r 2  4C rr rr       jmp SoundRequest
001B8Br 2               
001B8Br 2               ; PlayMusic - tune A from the top, unless it's already playing.
001B8Br 2               PlayMusic:
001B8Br 2  8D 2C 0F       sta MUS_WANT
001B8Er 2  60             rts
001B8Fr 2               
001B8Fr 2               ToggleMusic:
001B8Fr 2  AD 2D 0F       lda MUS_ON
001B92r 2  49 01          eor #1
001B94r 2  8D 2D 0F       sta MUS_ON
001B97r 2  60             rts
001B98r 2               
001B98r 2               ; =============================================================================
001B98r 2               ;   The driver, in bank 3. Everything here runs in the interrupt, so it keeps to
001B98r 2               ;   its own memory and calls nothing outside this bank.
001B98r 2               ; =============================================================================
001B98r 2               
001B98r 2               .segment "BANK03"
000000r 2               
000000r 2               .include "sounddata.inc"
000000r 3               ; =============================================================================
000000r 3               ;   sounddata.inc - GENERATED by tools/build-sound.mjs (make assets).
000000r 3               ;   Do not edit by hand: change the script and run it again.
000000r 3               ; =============================================================================
000000r 3               
000000r 3               SFX_PRESS = 1
000000r 3               SFX_BACK = 2
000000r 3               SFX_COMMIT = 3
000000r 3               SFX_ERROR = 4
000000r 3               SFX_LASER = 5
000000r 3               SFX_TORPEDO = 6
000000r 3               SFX_HIT = 7
000000r 3               SFX_TORPHIT = 8
000000r 3               SFX_SUBHIT = 9
000000r 3               SFX_BOOM = 10
000000r 3               SFX_SUBBOOM = 11
000000r 3               SFX_BLAST = 12
000000r 3               SFX_SUBBLAST = 13
000000r 3               SFX_THRUST = 14
000000r 3               SFX_JUMP = 15
000000r 3               SFX_CLOAK = 16
000000r 3               SFX_MINE = 17
000000r 3               SFX_THUMP = 18
000000r 3               SFX_COUNT = 18
000000r 3               TUNE_MENU = 1
000000r 3               TUNE_BATTLE = 2
000000r 3               KICK_NOTE = $FD
000000r 3               
000000r 3               .segment "BANK03"
000000r 3               
000000r 3               ; Indexed by effect number (0 is nothing)
000000r 3               FxPrio:
000000r 3  00 03 02 05    .byte $00,$03,$02,$05,$05,$03,$05,$04,$06,$02,$08,$02,$07,$02,$01,$06
000004r 3  05 03 05 04  
000008r 3  06 02 08 02  
000010r 3  05 05 00       .byte $05,$05,$00
000013r 3               FxVoice:
000013r 3  00 02 02 02    .byte $00,$02,$02,$02,$02,$01,$02,$02,$02,$01,$02,$01,$02,$01,$02,$02
000017r 3  02 01 02 02  
00001Br 3  02 01 02 01  
000023r 3  02 02 02       .byte $02,$02,$02
000026r 3               FxOther:
000026r 3  00 01 01 01    .byte $00,$01,$01,$01,$01,$00,$01,$01,$01,$00,$01,$00,$01,$00,$00,$01
00002Ar 3  01 00 01 01  
00002Er 3  01 00 01 00  
000036r 3  01 01 00       .byte $01,$01,$00
000039r 3               FxPair:
000039r 3  00 00 00 00    .byte $00,$00,$00,$00,$00,$00,$00,$00,$09,$00,$0B,$00,$0D,$00,$00,$00
00003Dr 3  00 00 00 00  
000041r 3  09 00 0B 00  
000049r 3  00 00 00       .byte $00,$00,$00
00004Cr 3               FxLo:
00004Cr 3  00 rr rr rr    .byte 0, <FxPRESS, <FxBACK, <FxCOMMIT, <FxERROR, <FxLASER, <FxTORPEDO, <FxHIT, <FxTORPHIT, <FxSUBHIT, <FxBOOM, <FxSUBBOOM, <FxBLAST, <FxSUBBLAST, <FxTHRUST, <FxJUMP, <FxCLOAK, <FxMINE, <FxTHUMP
000050r 3  rr rr rr rr  
