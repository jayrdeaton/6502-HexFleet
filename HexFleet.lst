0008A3r 1               .include "src/math.asm"
0008A3r 2               ; =============================================================================
0008A3r 2               ;   math.asm - multiply, divide, square root, absolute value
0008A3r 2               ; =============================================================================
0008A3r 2               
0008A3r 2               .segment "CART"
0008A3r 2               
0008A3r 2               ; Mul8 - A * X, unsigned, into PROD (16-bit). Clobbers A, X.
0008A3r 2               Mul8:
0008A3r 2  85 DB          sta MUL1
0008A5r 2  86 DC          stx MUL2
0008A7r 2  A9 00          lda #0
0008A9r 2  A2 08          ldx #8
0008ABr 2  46 DC          lsr MUL2
0008ADr 2               @loop:
0008ADr 2  90 03          bcc @noAdd
0008AFr 2  18             clc
0008B0r 2  65 DB          adc MUL1
0008B2r 2               @noAdd:
0008B2r 2  6A             ror a
0008B3r 2  66 56          ror PROD
0008B5r 2  46 DC          lsr MUL2
0008B7r 2  CA             dex
0008B8r 2  D0 F3          bne @loop
0008BAr 2  85 57          sta PROD+1
0008BCr 2  60             rts
0008BDr 2               
0008BDr 2               ; SMul - MA (signed byte) * MB (signed 16-bit, |MB| < 256) into PROD,
0008BDr 2               ; signed. Clobbers A, X.
0008BDr 2               SMul:
0008BDr 2  64 DD          stz MSIGN
0008BFr 2  A5 55          lda MB+1
0008C1r 2  10 0D          bpl @bPos
0008C3r 2  A5 54          lda MB                           ; |MB| = -MB, which fits in a byte
0008C5r 2  49 FF          eor #$FF
0008C7r 2  18             clc
0008C8r 2  69 01          adc #1
0008CAr 2  85 DE          sta MAGB
0008CCr 2  E6 DD          inc MSIGN
0008CEr 2  80 04          bra @a
0008D0r 2               @bPos:
0008D0r 2  A5 54          lda MB
0008D2r 2  85 DE          sta MAGB
0008D4r 2               @a:
0008D4r 2  A5 53          lda MA
0008D6r 2  10 0D          bpl @aPos
0008D8r 2  49 FF          eor #$FF
0008DAr 2  18             clc
0008DBr 2  69 01          adc #1
0008DDr 2  48             pha
0008DEr 2  A5 DD          lda MSIGN
0008E0r 2  49 01          eor #1
0008E2r 2  85 DD          sta MSIGN
0008E4r 2  68             pla
0008E5r 2               @aPos:
0008E5r 2  A6 DE          ldx MAGB
0008E7r 2  20 rr rr       jsr Mul8
0008EAr 2  A5 DD          lda MSIGN
0008ECr 2  F0 03          beq @done
0008EEr 2  4C rr rr       jmp NegProd
0008F1r 2               @done:
0008F1r 2  60             rts
0008F2r 2               
0008F2r 2               ; NegProd - PROD = -PROD.
0008F2r 2               NegProd:
0008F2r 2  A5 56          lda PROD
