000984r 2  60             rts
000985r 2               
000985r 2               ; FilterTick - the filter breathes, opens on each bass note and settles back.
000985r 2               FilterTick:
000985r 2  AD 2B 0F       lda MUS_ID
000988r 2  0A             asl a
000989r 2  6D 2B 0F       adc MUS_ID
00098Cr 2  A8             tay                              ; 3 bytes a tune
00098Dr 2  AD 2E 0F       lda M_LFO
000990r 2  18             clc
000991r 2  79 rr rr       adc TuneFilter+1,y
000994r 2  8D 2E 0F       sta M_LFO
000997r 2  90 03          bcc @phase
000999r 2  EE 2F 0F       inc M_LFO+1
00099Cr 2               @phase:
00099Cr 2  AD 2F 0F       lda M_LFO+1
00099Fr 2  0A             asl a
0009A0r 2  90 02          bcc @rising
0009A2r 2  49 FF          eor #$FF
0009A4r 2               @rising:
0009A4r 2  4A             lsr a
0009A5r 2  4A             lsr a
0009A6r 2  4A             lsr a
0009A7r 2  18             clc
0009A8r 2  79 rr rr       adc TuneFilter,y
0009ABr 2  85 D9          sta S_B
