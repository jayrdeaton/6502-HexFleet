0008F5r 2               ; DrawRange - an outline round every hex within RANGE of the ship, along the
0008F5r 2               ; board's own lines.
0008F5r 2               DrawRange:
0008F5r 2  20 rr rr       jsr CanvasBegin
0008F8r 2  A6 6F          ldx PLAYER
0008FAr 2  20 rr rr       jsr SetPen
0008FDr 2  20 rr rr       jsr ShipToHex
000900r 2  64 B8          stz RR
000902r 2               @row:
000902r 2  A5 B8          lda RR
000904r 2  20 rr rr       jsr RowLen
000907r 2  85 42          sta T2
000909r 2  64 B7          stz RC
00090Br 2               @hex:
