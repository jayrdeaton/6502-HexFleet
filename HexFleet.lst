001579r 2  20 rr rr       jsr HexDist
00157Cr 2  C9 02          cmp #2
00157Er 2  B0 0A          bcs @far
001580r 2  A4 FC          ldy AI_K
001582r 2  B9 10 09       lda AI_EW,y
001585r 2  18             clc
001586r 2  65 FD          adc AI_S
001588r 2  85 FD          sta AI_S
00158Ar 2               @far:
